# Frozen release bundles are byte-addressed artifacts. Disable checkout-time
# line-ending conversion so their SHA-256 manifests verify on every platform.
/crates/aspis-prover/fixtures/** -text
/release/**/*.bin -text
/release/**/*.so -text
/release/**/*.pdf -text

# Captured compiler stderr is retained byte-for-byte, including terminal blank
# lines emitted by Cargo/rustc.
/results/v7-registry-v2-release-audit-20260831/agave-runs/**/*.stderr whitespace=-blank-at-eof

# Preserve exact public-cluster CLI output, including its terminal blank line.
/results/v7-registry-v2-release-audit-20260831/devnet-feature-gate-r2/*.txt whitespace=-blank-at-eof

# Unified diffs require a single-space marker on blank context lines.
/aeneas-verif/**/*.patch whitespace=-blank-at-eol
