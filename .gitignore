# The superseded devnet paper is preserved in the archive tag; ignore any
# local build remnants left at its former default-branch path.

# LaTeX build intermediates (publication PDFs are committed explicitly).
/paper/aspis-spend/*.aux
/paper/aspis-spend/*.bbl
/paper/aspis-spend/*.blg
/paper/aspis-spend/*.fdb_latexmk
/paper/aspis-spend/*.fls
/paper/aspis-spend/*.log
/paper/aspis-spend/*.out

# Local review context and unsanitized network-run diagnostics. Publication
