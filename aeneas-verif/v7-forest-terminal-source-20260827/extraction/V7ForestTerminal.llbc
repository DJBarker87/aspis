lse}}}],"ptr_metadata":"None"},{"def_id":58,"item_meta":{"name":[{"Ident":["aspis_statement",0]},{"Ident":["pool_v1",0]},{"Ident":["pair_forest_accounts",0]},{"Ident":["PoolV1PairForestMasterV1",0]}],"span":{"data":{"file_id":31,"beg":{"line":127,"col":0},"end":{"line":135,"col":1}},"generated_from_span":null},"source_text":"pub struct PoolV1PairForestMasterV1 {\n    pub identity: PoolIdentityV1,\n    pub verifier_policy: VerifierPolicyV1,\n    pub initialized_lane_mask: u8,\n    pub has_checkpoint: bool,\n    /// Sequence assigned to the next immutable checkpoint account.\n    pub next_checkpoint_sequence: u64,\n    pub last_checkpoint_lane_sequences: [u64; POOL_V1_PAIR_FOREST_LANE_COUNT],\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":31,"beg":{"line":128,"col":4},"end":{"line":128,"col":32}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"identity","ty":{"HashConsedValue":[6082,{"Adt":{"id":{"Adt":66},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}},{"span":{"data":{"file_id":31,"beg":{"line":129,"col":4},"end":{"line":129,"col":41}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"verifier_policy","ty":{"HashConsedValue":[38011,{"Adt":{"id":{"Adt":76},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}},{"span":{"data":{"file_id":31,"beg":{"line":130,"col":4},"end":{"line":130,"col":33}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"initialized_lane_mask","ty":{"Deduplicated":1341}},{"span":{"data":{"file_id":31,"beg":{"line":131,"col":4},"end"