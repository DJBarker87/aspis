erics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":38029}],"output":{"HashConsedValue":[38037,{"Adt":{"id":{"Adt":70},"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":38006}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":132,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["chain",0]}],"span":{"data":{"file_id":46,"beg":{"line":510,"col":4},"end":{"line":513,"col":51}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Takes two iterators and creates a new iterator over both in sequence."},{"DocComment":""},{"DocComment":" `chain()` will return a new iterator which will first iterate over"},{"DocComment":" values from the first iterator and then over values from the second"},{"DocComment":" iterator."},{"DocComment":""},{"DocComment":" In other words, it links two iterators together, in a chain. 🔗"},{"DocComment":""},{"DocComment":" [`once`] is commonly used to adapt a single value into a chain of"},{"DocComment":" other kinds of iteration."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s1 = \"abc\".chars();"},{"DocComment":" let s2 = \"def\".chars();"},{"DocComment":""},{"DocComment":" let mut iter = s1.chain(s2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some('a'));"},{"DocComment":" assert_eq!(iter.next(), Some('b'));"},{"DocComment":" assert_eq!(iter.next(), Some('c'));"},{"DocComment":" assert_eq!(iter.next(), Some('d'));"},{"DocComment":" assert_eq!(iter.next(), Some('e'));"},{"DocComment":" assert_eq!(iter.next(), Some('f'));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since the argument to `chain()` uses [`IntoIterator`], we can pass"},{"DocComment":" anything that can be converted into an [`Iterator`], not just an"},{"DocComment":" [`Iterator`] itself. For example, arrays (`[T]`) implement"},{"DocComment":" [`IntoIterator`], and so can be passed to `chain()` directly:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a1 = [1, 2, 3];"},{"DocComment":" let a2 = [4, 5, 6];"},{"DocComment":""},{"DocComment":" let mut iter = a1.into_iter().chain(a2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), Some(5));"},{"DocComment":" assert_eq!(iter.next(), Some(6));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you work with Windows API, you may wish to convert [`OsStr`] to `Vec<u16>`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[cfg(windows)]"},{"DocComment":" fn os_str_to_utf16(s: &std::ffi::OsStr) -> Vec<u16> {"},{"DocComment":"     use std::os::windows::ffi::OsStrExt;"},{"DocComment":"     s.encode_wide().chain(std::iter::once(0)).collect()"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`once`]: crate::iter::once"},{"DocComment":" [`OsStr`]: ../../std/ffi/struct.OsStr.html"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"U"},{"index":2,"name":"Clause0_Item"},{"index":3,"name":"Clause1_IntoIter"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":2,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":15,"generics":{"regions":[],"types":[{"Deduplicated":38006},{"Deduplicated":38013}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":46,"beg":{"line":513,"col":11},"end":{"line":513,"col":50}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":38007},{"Deduplicated":38013},{"Deduplicated":38058}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":38006},{"Deduplicated":38007}],"output":{"HashConsedValue":[38398,{"Adt":{"id":{"Adt":69},"generics":{"regions":[],"types":[{"Deduplicated":38006},{"Deduplicated":38058}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":15,"generics":{"regions":[],"types":[{"Deduplicated":38006},{"Deduplicated":38013}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":8}}},"is_global_initializer":null,"body":"Opaque"},{"def_id":133,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["flatten",0]}],"span":{"data":{"file_id":46,"beg":{"line":1617,"col":4},"end":{"line":1620,"col":33}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that flattens nested structure."},{"DocComment":""},{"DocComment":" This is useful when you have an iterator of iterators or an iterator of"},{"DocComment":" things that can be turned into iterators and you want to remove one"},{"DocComment":" level of indirection."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let data = vec![vec![1, 2, 3, 4], vec![5, 6]];"},{"DocComment":" let flattened: Vec<_> = data.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(flattened, [1, 2, 3, 4, 5, 6]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Mapping and then flattening:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let words = [\"alpha\", \"beta\", \"gamma\"];"},{"DocComment":""},{"DocComment":" // chars() returns an iterator"},{"DocComment":" let merged: String = words.iter()"},{"DocComment":"                           .map(|s| s.chars())"},{"DocComment":"                           .flatten()"},{"DocComment":"                           .collect();"},{"DocComment":" assert_eq!(merged, \"alphabetagamma\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also rewrite this in terms of [`flat_map()`], which is preferable"},{"DocComment":" in this case since it conveys intent more clearly:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let words = [\"alpha\", \"beta\", \"gamma\"];"},{"DocComment":""},{"DocComment":" // chars() returns an iterator"},{"DocComment":" let merged: String = words.iter()"},{"DocComment":"                           .flat_map(|s| s.chars())"},{"DocComment":"                           .collect();"},{"DocComment":" assert_eq!(merged, \"alphabetagamma\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Flattening works on any `IntoIterator` type, including `Option` and `Result`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let options = vec![Some(123), Some(321), None, Some(231)];"},{"DocComment":" let flattened_options: Vec<_> = options.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(flattened_options, [123, 321, 231]);"},{"DocComment":""},{"DocComment":" let results = vec![Ok(123), Ok(321), Err(456), Ok(231)];"},{"DocComment":" let flattened_results: Vec<_> = results.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(flattened_results, [123, 321, 231]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Flattening only removes one level of nesting at a time:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let d3 = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];"},{"DocComment":""},{"DocComment":" let d2: Vec<_> = d3.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(d2, [[1, 2], [3, 4], [5, 6], [7, 8]]);"},{"DocComment":""},{"DocComment":" let d1: Vec<_> = d3.into_iter().flatten().flatten().collect();"},{"DocComment":" assert_eq!(d1, [1, 2, 3, 4, 5, 6, 7, 8]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Here we see that `flatten()` does not perform a \"deep\" flatten."},{"DocComment":" Instead, only one level of nesting is removed. That is, if you"},{"DocComment":" `flatten()` a three-dimensional array, the result will be"},{"DocComment":" two-dimensional and not one-dimensional. To get a one-dimensional"},{"DocComment":" structure, you have to `flatten()` again."},{"DocComment":""},{"DocComment":" [`flat_map()`]: Iterator::flat_map"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"},{"index":2,"name":"Clause1_Item"},{"index":3,"name":"Clause1_IntoIter"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":2,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":15,"generics":{"regions":[],"types":[{"Deduplicated":38006},{"Deduplicated":38007}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":46,"beg":{"line":1620,"col":20},"end":{"line":1620,"col":32}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":38007},{"Deduplicated":38013},{"Deduplicated":38058}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs"