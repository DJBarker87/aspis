 ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]); // This is a `RangeFrom`"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"RangeFrom"},"generics":{"regions":[],"types":[{"index":0,"name":"Idx"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":36,"beg":{"line":200,"col":4},"end":{"line":200,"col":18}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" The lower bound of the range (inclusive)."}],"inline":null,"rename":null,"public":true},"name":"start","ty":{"Deduplicated":15376}}]},"layout":[],"ptr_metadata":"None"},{"def_id":82,"item_meta":{"name":[{"Ident":["aspis_core",0]},{"Ident":["v6_onefold",0]},{"Ident":["decode_packed_m31_eight_aligned",0]},{"Ident":["closure",0]}],"span":{"data":{"file_id":8,"beg":{"line":367,"col":12},"end":{"line":367,"col":27}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":403}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"Closure":{"info":{"kind":"Fn","fn_once_impl":{"regions":[],"skip_binder":{"id":85,"generics":{"regions":[{"Var":{"Free":0}}],"types":[],"const_generics":[{"kind":{"Var":{"Free":0}},"ty":{"Deduplicated":403}}],"trait_refs":[]}}},"fn_mut_impl":{"regions":[],"skip_binder":{"id":86,"generics":{"regions":[{"Var":{"Free":0}}],"types":[],"const_generics":[{"kind":{"Var":{"Free":0}},"ty":{"Deduplicated":403}}],"trait_refs":[]}}},"fn_impl":{"regions":[],"skip_binder":