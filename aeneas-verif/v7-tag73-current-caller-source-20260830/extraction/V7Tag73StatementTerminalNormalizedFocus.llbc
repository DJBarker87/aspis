ays not iterators."},{"DocComment":""},{"DocComment":" If `N == 0`, this produces an empty array without ever calling `f`."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" // type inference is helping us here, the way `from_fn` knows how many"},{"DocComment":" // elements to produce is the length of array down there: only arrays of"},{"DocComment":" // equal lengths can be compared, so the const generic parameter `N` is"},{"DocComment":" // inferred to be 5, thus creating array of 5 elements."},{"DocComment":""},{"DocComment":" let array = core::array::from_fn(|i| i);"},{"DocComment":" // indexes are:    0  1  2  3  4"},{"DocComment":" assert_eq!(array, [0, 1, 2, 3, 4]);"},{"DocComment":""},{"DocComment":" let array2: [usize; 8] = core::array::from_fn(|i| i * 2);"},{"DocComment":" // indexes are:     0  1  2  3  4  5   6   7"},{"DocComment":" assert_eq!(array2, [0, 2, 4, 6, 8, 10, 12, 14]);"},{"DocComment":""},{"DocComment":" let bool_arr = core::array::from_fn::<_, 5, _>(|i| i % 2 == 0);"},{"DocComment":" // indexes are:       0     1      2     3      4"},{"DocComment":" assert_eq!(bool_arr, [true, false, true, false, true]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also capture things, for example to create an array full of clones"},{"DocComment":" where you can't just use `[item; N]` because it's not `Copy`:"},{"DocComment":" ```"},{"DocComment":" let my_string: [String; 2] = std::array::from_fn(|i| format!(\"Hello {i}\"));"},{"DocComment":" assert_eq!(my_string, [\"Hello 0\", \"Hello 1\"]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The array is generated in ascending index order, starting from the front"},{"DocComment":" and going towards the back, so you can use closures with mutable state:"},{"DocComment":" ```"},{"DocComment":" let mut state = 1;"},{"DocComment":" let a = std::array::from_fn(|_| { let x = state; state *= 2; x });"},{"DocComment":" assert_eq!(a, [1, 2, 4, 8, 16, 32]);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"F"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":834}}],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":31,"beg":{"line":110,"col":24},"end":{"line":110,"col":40}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":20153}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":31,"beg":{"line":112,"col":7},"end":{"line":112,"col":32}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":20154},{"Deduplicated":2396},{"Deduplicated":20153}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":31,"beg":{"line":112,"col":35},"end":{"line":112,"col":51}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":20154}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":20154}],"output":{"HashConsedValue":[20237,{"Array":[{"Deduplicated":20153},{"kind":{"Var":{"Free":0}},"ty":{"Deduplicated":834}}]}]}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":27,"item_meta":{"name":[{"Ident":["aspis_statement",0]},{"Ident":["atomic_state_only_terminal",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":2186},"kind":"InherentImplBlock"}}},{"Ident":["boxed_at_point",0]}],"span":{"data":{"file