+                InterpAbs.merge_into_first_abstraction span fresh_abs_kind
+                  ~can_end:true ~with_abs_conts:false None ctx anchor aid
+              in
+              let merged_abs = ctx_lookup_abs ctx merged_aid in
+              let merged_abs = { merged_abs with abs_id = anchor } in
+              [%sanity_check] span
+                (Option.is_none (ctx_lookup_abs_opt ctx anchor));
+              let ctx, replaced =
+                ctx_subst_abs span ctx merged_aid merged_abs
+              in
+              [%sanity_check] span (Option.is_some replaced);
+              if record_removed_input && List.mem aid input_abs then
+                removed_shared_group_input_aids :=
+                  AbsId.Set.add aid !removed_shared_group_input_aids;
+              if !Config.sanity_checks then
+                Invariants.check_unique_abs_ids span ctx;
+              ctx)
+          eligible_aids ctx
+  in
