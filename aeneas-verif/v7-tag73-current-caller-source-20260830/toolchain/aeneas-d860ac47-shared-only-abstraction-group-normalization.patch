+  let removed_shared_group_input_aids = ref AbsId.Set.empty in
+  let canonicalize_shared_only_abs_group ~(record_removed_input : bool)
+      (opposing_aids : AbsId.Set.t) (ctx : eval_ctx) : eval_ctx =
+    (* Immutable, parentless abstractions carry no backward write-back state.
+       A loop join may group the same shared loans into one abstraction on one
+       side and several on the other.  If the two sides retain a common
+       abstraction id, merge every such comparison-only group into that
+       common anchor.  The actual contexts and continuations are unchanged. *)
+    let absl = AbsId.Map.values (ctx_get_abs ctx) in
+    let has_no_children (abs : abs) =
+      List.for_all
+        (fun (other : abs) ->
+          not (AbsId.Set.mem abs.abs_id other.parents))
+        absl
+    in
+    let eligible (abs : abs) =
+      abs.can_end && AbsId.Set.is_empty abs.parents
+      && AbsLevelSet.is_empty abs.ended_subabs && has_no_children abs
+      && not (AbsId.Set.mem abs.abs_id (ctx_get_frozen_abs_set ctx))
+      && abs.avalues <> []
+      && List.for_all
+           (fun (av : tavalue) ->
+             not (ty_has_mut_borrows ctx.type_ctx.type_infos av.ty))
+           abs.avalues
+    in
+    let eligible_aids =
+      AbsId.Set.of_list
+        (List.filter_map
+           (fun (abs : abs) ->
+             if eligible abs then Some abs.abs_id else None)
+           absl)
+    in
+    let common = AbsId.Set.inter eligible_aids opposing_aids in
+    match AbsId.Set.elements common with
+    | [] -> ctx
+    | anchor :: _ ->
+        AbsId.Set.fold
