+// A slice iterator whose value becomes dead on two distinct exits from a
+// nested loop. This is the control-flow shape used by the Aspis radix-4
+// verifier: an early function return and ordinary iterator exhaustion must
+// produce the same post-loop borrow state.
+pub fn nested_slice_iterator_return(masks: &[u8], stop: u8) -> bool {
+    let mut outer = 0u32;
+    while outer < 2 {
+        for &present in masks {
+            for slot in 0..4u8 {
+                if present & (1u8 << slot) != 0 && slot == stop {
+                    return false;
+                }
+            }
+        }
+        outer += 1;
+    }
+    true
+}
+
+// The fuller shape used by the radix verifier: the nested loop reads a
+// separately borrowed value, writes through a loop-local mutable subslice,
+// and performs a check after the slice iterator is exhausted.  A failed read
+// returns from inside both iterator loops; successful inner-loop exhaustion
+// must leave the outer slice iterator live for its next call to `next`.
+pub fn nested_slice_iterator_with_reads(
+    masks: &[u8],
+    values: &[[u8; 4]],
+    expected_reads: usize,
+) -> bool {
+    let mut round = 0u32;
+    while round < 2 {
+        let mut value_pos = 0usize;
+        for &present in masks {
+            let mut input = [0u8; 17];
+            for slot in 0..4usize {
+                let child = &mut input[1 + slot * 4..1 + (slot + 1) * 4];
+                if present & (1u8 << slot) != 0 {
+                    let Some(value) = values.get(value_pos) else {
+                        return false;
+                    };
+                    child.copy_from_slice(value);
+                    value_pos += 1;
+                } else {
+                    child.fill(slot as u8);
+                }
+            }
+        }
+        if value_pos != expected_reads {
+            return false;
+        }
+        round += 1;
+    }
+    true
+}
+
+// The deployed radix verifier copies either an authenticated value or a
+// frontier node into a loop-local mutable subslice.  Its reconstructed inner
+// loop exits by continuing the enclosing slice loop.  A lowered early return
+// must not kill that enclosing iterator on the ordinary continue path.
+pub fn nested_slice_iterator_with_node_reads(
+    masks: &[u8],
+    values: &[[u8; 32]],
+    node_bytes: &[u8],
+) -> bool {
+    let mut round = 0u32;
