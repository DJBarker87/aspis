diff --git a/src/PrePasses.ml b/src/PrePasses.ml
index b613aba1..1063ee9e 100644
--- a/src/PrePasses.ml
+++ b/src/PrePasses.ml
@@ -87,6 +87,306 @@ let erase_body_regions (crate : crate) (f : fun_decl) : fun_decl =
     ^ Print.fun_decl_to_string env "" "  " f];
