+/-- [slice_pattern_metadata::matches_tuple]:
+    Source: 'tests/src/slice-pattern-metadata.rs', lines 3:0-10:1 -/
+def matches_tuple
+  (indices : Slice Std.U32) (values : Slice (Array Std.U8 32#usize)) :
+  Result Std.U8
+  := do
+  let i := Slice.len indices
+  if i = 1#usize
+  then
+    let i1 := Slice.len values
+    if i1 = 1#usize
+    then
+      let i2 ← Slice.index_usize indices 0#usize
+      match i2 with
+      | 0#uscalar =>
+        let value ← Slice.index_usize values 0#usize
+        Array.index_usize value 0#usize
+      | _ =>
+        let value ← Slice.index_usize values 0#usize
+        let i3 ← lift (UScalar.cast .U8 i2)
+        let i4 ← Array.index_usize value 0#usize
+        ok (core.num.U8.wrapping_add i3 i4)
+    else ok 0#u8
+  else
+    let i1 := Slice.len indices
+    if i1 = 2#usize
+    then
+      let i2 := Slice.len values
+      if i2 = 2#usize
+      then
+        let i3 ← Slice.index_usize indices 0#usize
+        match i3 with
+        | 0#uscalar =>
+          let i4 ← Slice.index_usize indices 1#usize
+          match i4 with
+          | 1#uscalar =>
+            let left ← Slice.index_usize values 0#usize
+            let right ← Slice.index_usize values 1#usize
+            let i5 ← Array.index_usize left 0#usize
+            let i6 ← Array.index_usize right 0#usize
+            ok (core.num.U8.wrapping_add i5 i6)
+          | _ => ok 0#u8
+        | _ => ok 0#u8
+      else ok 0#u8
+    else ok 0#u8
+
+/-- [slice_pattern_metadata::metadata_precedes_reference_reassignment]:
+    Source: 'tests/src/slice-pattern-metadata.rs', lines 12:0-17:1 -/
+def metadata_precedes_reference_reassignment
+  (first : Slice Std.U32) (second : Slice Std.U32) : Result Std.Usize := do
+  let i := Slice.len first
+  let matched_before_reassignment ←
+    if i = 1#usize
+    then
+      do
+      let i1 ← Slice.index_usize first 0#usize
+      match i1 with
+      | 1#uscalar => ok true
+      | _ => ok false
+    else ok false
+  let i1 ← lift (UScalar.cast_fromBool .Usize matched_before_reassignment)
+  let i2 := Slice.len second
+  let i3 ← 10#usize * i2
+  i1 + i3
+
+end slice_pattern_metadata
