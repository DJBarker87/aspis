+//@ [lean] no-check-output
+//@ [!lean] skip
+
+fn metadata_then_dereference(values: &[u32]) -> usize {
+    let pointer = &raw const *values;
+    let len = pointer.len();
+    let first = unsafe { (*pointer)[0] };
+    len + first as usize
+}
