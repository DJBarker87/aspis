+#[derive(Clone, Copy)]
+pub enum FillError {
+    Rejected,
+}
+
+fn checked_coefficient(index: usize, reject_at: usize) -> Result<u32, FillError> {
+    if index == reject_at {
+        Err(FillError::Rejected)
+    } else {
+        Ok((index as u32) + 1)
+    }
+}
+
+pub fn fill_with_enumerated_iter_mut(
+    output: &mut [u32; 7],
+    reject_at: usize,
+) -> Result<(), FillError> {
+    for (index, slot) in output.iter_mut().enumerate() {
+        *slot = checked_coefficient(index, reject_at)?;
+    }
+    Ok(())
