+//@ [coq,fstar] skip
+// The foreign standard-library slice iterator `find` has the erased bound
+// `for<'b> FnMut(&'b &'a T)`. This exact shared/shared shape is supported;
+// user-defined higher-ranked implied bounds remain rejected by the three
+// `higher_ranked_implied_bounds_*` negative tests.
+
+pub fn contains(values: &[u32], wanted: u32) -> bool {
+    values.iter().find(|&&value| value == wanted).is_some()
+}
