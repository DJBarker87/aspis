+//@ [coq,fstar] skip
+// Regression test for a closure which captures a shared reference to a value
+// that itself contains a shared reference with a longer lifetime.
+
+pub struct Parsed<'a> {
+    pub bytes: &'a [u8],
+}
+
+#[inline(never)]
+fn read_parsed(parsed: &Parsed<'_>) -> usize {
+    parsed.bytes.len()
+}
+
+pub fn closure_nested_shared_capture(parsed: &Parsed<'_>) -> usize {
+    let owned = 1usize;
+    let read = || owned + read_parsed(parsed);
+    read()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn nested_capture_reads_the_referent() {
+        let bytes = [2u8, 3, 5];
+        let parsed = Parsed { bytes: &bytes };
+        assert_eq!(closure_nested_shared_capture(&parsed), 4);
+    }
+}
