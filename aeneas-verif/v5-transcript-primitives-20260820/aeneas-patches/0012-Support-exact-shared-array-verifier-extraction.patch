+import Aeneas
+
+open Aeneas Aeneas.Std
+
+/-! Regression tests for Rust's mixed-type wrapping shift amounts. -/
+
+-- A small unsigned right-hand side is accepted without changing its type.
+example : U32.wrapping_shr 2147483648#u32 31#u8 = 1#u32 := by
+  native_decide
+
+-- An oversized `usize` amount is reduced modulo the left operand's width.
+example : U8.wrapping_shl 1#u8 9#usize = 2#u8 := by
+  native_decide
+
+-- The largest `u8` amount has the same low-bit wrapping semantics as Rust.
+example : U8.wrapping_shl 1#u8 255#u8 = 128#u8 := by
+  native_decide
+
+-- A negative signed amount is interpreted by its machine-word bit pattern.
+example : U8.wrapping_shl 1#u8 (-1)#i32 = 128#u8 := by
+  native_decide
+
+example :
+    U32.wrapping_shl 1#u32 (-1)#i32 =
+      U32.wrapping_shl 1#u32 4294967295#u32 := by
+  native_decide
-- 
