diff --git a/backends/lean/Aeneas/Std/Scalar/Core.lean b/backends/lean/Aeneas/Std/Scalar/Core.lean
index 83148453..34d09f52 100644
--- a/backends/lean/Aeneas/Std/Scalar/Core.lean
+++ b/backends/lean/Aeneas/Std/Scalar/Core.lean
@@ -81,6 +81,24 @@ deriving Repr, BEq, DecidableEq
 
 def IScalar.val {ty} (x : IScalar ty) : ℤ := x.bv.toInt
 
+/-- Integer values accepted on the right-hand side of Rust shift operations.
+
+Rust implements shifts for several right-hand-side integer types (for example,
+`u32 >> i32` and `u8 << usize`). Keeping the shift amount abstract lets an
+extracted term retain the exact Rust operand type. Signed values use their
+machine-word bit pattern, matching Rust's wrapping-shift semantics. -/
+class ScalarShiftAmount (α : Type) where
+  toNat : α → Nat
+
+instance {ty : UScalarTy} : ScalarShiftAmount (UScalar ty) where
+  toNat x := x.bv.toNat
+
+instance {ty : IScalarTy} : ScalarShiftAmount (IScalar ty) where
+  toNat x := x.bv.toNat
+
+@[simp] theorem scalarShiftAmount_toNat_uscalar {ty : UScalarTy}
+    (x : UScalar ty) : ScalarShiftAmount.toNat x = x.val := rfl
+
 /-!
 # Bounds, Size
 
