+  (* A projected loop over immutable parser results can leave an exact,
+     balanced loan/borrow projector pair in the return context.  It carries no
+     write-back state, but following it while synthesizing a backward function
+     creates a spurious self-cycle.  Discharge only that shared-only pair before
+     ending the input abstractions; mutable projection state remains intact. *)
+  let ctx =
+    InterpReduceCollapse.normalize_projected_shared_projection_pairs
+      AbsId.Set.empty ctx
+  in
+
   (* Set the abstrations as endable *)
   let ctx = InterpBorrowsCore.update_endable ctx target_abs_ids ~can_end:true in
 
