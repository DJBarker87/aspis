diff --git a/src/extract/Extract.ml b/src/extract/Extract.ml
index 67af2e59..cd31f363 100644
--- a/src/extract/Extract.ml
+++ b/src/extract/Extract.ml
@@ -3667,11 +3667,43 @@ let extract_trait_impl (ctx : extraction_ctx) (fmt : F.formatter)
         extract_trait_impl_item ctx fmt item_name ty)
       (List.combine trait_decl.implied_clauses impl.parent_trait_refs);
 
-    (* The methods *)
+    (* The methods.
+
+       A builtin backend model may deliberately expose only a subset of a Rust
+       trait.  For example, the Lean model of [Iterator] currently contains
+       [next] and a few adapter methods, while rustc's concrete iterator impls
+       may also override methods such as [any] and [find].  Those overrides are
+       still translated as ordinary functions when used, but they must not be
+       emitted as fields of the smaller builtin structure: Lean would reject
+       the resulting record literal because the fields do not exist.
+
+       Keep every method for non-builtin traits.  For builtin traits, emit only
+       the methods named by the backend model. *)
+    let translated_trait_decl =
+      TraitDeclId.Map.find trait_decl_id ctx.trans_trait_decls
+    in
+    let methods =
+      match translated_trait_decl.builtin_info with
+      | None -> impl.methods
+      | Some info ->
+          let modeled =
+            StringSet.of_list (List.map (fun (name, _) -> name) info.methods)
+          in
+          List.filter
+            (fun (method_id, _name, _bound_fn) ->
+              match
+                List.find_opt
+                  (fun (meth : trait_method) -> meth.method_id = method_id)
+                  translated_trait_decl.methods
+              with
+              | Some meth -> StringSet.mem meth.item_name modeled
+              | None -> false)
+            impl.methods
+    in
     List.iter
       (fun (method_id, _name, bound_fn) ->
         extract_trait_impl_method_items ctx fmt impl method_id bound_fn)
-      impl.methods;
+      methods;
 
     (* Close the outer boxes for the definition, as well as the brackets *)
     F.pp_close_box fmt ();
