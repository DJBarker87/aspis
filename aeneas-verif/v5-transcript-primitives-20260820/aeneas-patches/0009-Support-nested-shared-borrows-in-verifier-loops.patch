+pub fn result_through_match_and_nested_loops(
+    input: Option<u32>,
+    stop: u32,
+) -> Result<u32, u32> {
+    let seed = match input {
+        Some(value) => value,
+        None => return Err(1),
+    };
+    let mut total = seed;
+    for outer in 0..2 {
+        for inner in [0u32, 1].iter() {
+            if outer + *inner == stop {
+                return Err(2);
+            }
+            total += outer + *inner;
+        }
+    }
+    Ok(total)
+}
