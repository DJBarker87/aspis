+pub struct SharedView<'a> {
+    pub records: &'a [u8],
+    pub frontier: &'a [u8],
+}
+
+pub fn value_for_monotone_index<'a>(
+    view: &SharedView<'a>,
+    indices: &[u32],
+    ordinal: &mut usize,
+    index: u32,
+) -> Option<&'a u8> {
+    while *ordinal < indices.len() && indices[*ordinal] < index {
+        *ordinal += 1;
+    }
+    if indices.get(*ordinal).copied() != Some(index) {
+        return None;
+    }
+    view.records.get(*ordinal)
+}
