+(** Open the region binder on a shared-reference function-pointer signature.
+    Bound regions on a higher-ranked pointer are call-local and cannot escape.
+    We represent them as static for symbolic execution so they create no
+    backward borrow abstraction; the Pure translation erases either form. The
+    dynamic-call translator separately rejects mutable-reference inputs and
+    outputs, for which this simplification would be invalid. *)
+let open_dynamic_fun_sig (span : Meta.span) (ctx : eval_ctx)
+    (signature : fun_sig region_binder) : bound_fun_sig =
+  ignore ctx;
+  let visitor =
+    object
+      inherit [_] map_ty
+
+      method! visit_RVar _ var =
+        match var with
+        | Bound _ -> RStatic
+        | Free _ ->
+            [%craise] span
+              "Function pointers capturing an outer free lifetime are not \
+               supported"
+    end
+  in
+  let item_binder_value = visitor#visit_fun_sig () signature.binder_value in
+  { item_binder_params = empty_generic_params; item_binder_value }
+
+let eval_dynamic_function_call_symbolic_inst (span : Meta.span)
+    (callee : operand) (ctx : eval_ctx) : symbolic_fun_call_inst =
+  let callee_ty =
+    match callee with
+    | Copy p | Move p -> p.ty
+    | Constant cv -> cv.ty
+  in
+  let signature =
+    match callee_ty with
+    | TFnPtr signature -> open_dynamic_fun_sig span ctx signature
+    | ty ->
+        [%craise] span
+          ("Dynamic call operand does not have a function-pointer type: "
+         ^ ty_to_string ctx ty)
+  in
+  let call_generics =
+    Substitute.generic_args_of_params_erase_regions (Some span)
+      signature.item_binder_params
+  in
+  let tr_self = UnknownTrait "dynamic function pointer call" in
+  {
+    call_kind = SymbolicDynamic callee;
+    call_generics;
+    call_span = span;
+    call_sig = signature;
+    call_inst_sig =
+      instantiate_fun_sig (Some span) ctx call_generics tr_self signature;
+  }
+
