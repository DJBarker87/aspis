@@ -82,6 +82,36 @@ let access_rplace_reorganize_and_read (config : config) (span : Meta.span)
   (* Compose *)
   (lid, value, ctx, cc)
 
+(** Prepare and read a place whose value is used only for its ADT discriminant.
+
+    Rust permits reading an enum discriminant after one of the active variant's
+    payload fields has been moved. Such a value contains bottoms below the outer
+    constructor, so the ordinary full-value reader correctly rejects it. A
+    discriminant read does not observe those payload fields; keep the normal
+    loan reorganization and reserved-borrow check, but defer the outer-shape
+    check to the [Match] evaluator. *)
+let access_rplace_reorganize_and_read_discriminant (config : config)
+    (span : Meta.span) (greedy_expand : bool) (access : access_kind) (p : place)
+    (ctx : eval_ctx) :
+    loan_id option * tvalue * eval_ctx * (SymbolicAst.expr -> SymbolicAst.expr)
+    =
+  (* Make sure we can evaluate the path. *)
+  let ctx, cc = update_ctx_along_read_place config span access p ctx in
+  (* End the proper loans at the place itself. *)
+  let ctx, cc = comp cc (end_loans_at_place config span access p ctx) in
+  (* Expand copyable symbolic values containing borrows, as for a normal
+     read. *)
+  let ctx, cc =
+    comp cc
+      (if greedy_expand then expand_if_borrows_at_place span access p ctx
+       else (ctx, fun e -> e))
+  in
+  let lid, value = read_place span access p ctx in
+  [%cassert] span
+    (not (reserved_in_value value))
+    "There should be no reserved borrows in a discriminant value";
+  (lid, value, ctx, cc)
+
 let access_rplace_reorganize (config : config) (span : Meta.span)
     (greedy_expand : bool) (access : access_kind) (p : place) : cm_fun =
  fun ctx ->
