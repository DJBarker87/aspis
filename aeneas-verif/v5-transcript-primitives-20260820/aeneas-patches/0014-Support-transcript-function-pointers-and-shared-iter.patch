+                      ( PNone,
+                        (AProjLoans { proj; _ } | AProjBorrows { proj; _ }) ) ->
+                      ty_has_mut_borrows src_ctx.type_ctx.type_infos
+                        proj.proj_ty
+                  | _ -> true)
+                abs.avalues;
+          })
+        src_ctx
+    in
     let ignored (av : tavalue) =
       match av.value with
       | AIgnored _ -> true
