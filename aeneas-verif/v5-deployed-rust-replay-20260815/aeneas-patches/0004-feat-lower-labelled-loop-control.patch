+//@ [!lean] skip
+
+fn nested_control_trace(mode: u8) -> (u32, u64) {
+    let mut outer = 0u32;
+    let mut trace = 0u64;
+
+    'outer: while outer < 3 {
+        outer += 1;
+        trace = trace * 10 + outer as u64;
+        let mut inner = 0u32;
+        let inner_limit = if mode == 0 { 1 } else { 2 };
+
+        while inner < inner_limit {
+            inner += 1;
+            trace = trace * 10 + inner as u64;
+
+            if mode == 1 && inner == 1 {
+                trace = trace * 10 + 8;
+                break;
+            }
+            if mode == 2 && outer < 3 && inner == 1 {
+                trace = trace * 10 + 7;
+                continue 'outer;
+            }
+            if mode == 3 && outer == 2 && inner == 1 {
+                trace = trace * 10 + 6;
+                break 'outer;
+            }
+        }
+
+        trace = trace * 10 + 9;
+    }
+
+    (outer, trace)
+}
+
+fn triple_nested_control(stop_on_second: bool) -> (u32, u64) {
+    let mut outer = 0u32;
+    let mut trace = 0u64;
+
+    'outer: while outer < 3 {
+        outer += 1;
+        loop {
+            loop {
+                trace = trace * 10 + outer as u64;
+                if stop_on_second && outer == 2 {
+                    trace = trace * 10 + 6;
+                    break 'outer;
+                }
+                trace = trace * 10 + 7;
+                continue 'outer;
+            }
+        }
+    }
+
+    (outer, trace)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn preserves_nested_control_and_evaluation_order() {
+        assert_eq!(nested_control_trace(0), (3, 119_219_319));
+        assert_eq!(nested_control_trace(1), (3, 118_921_893_189));
+        assert_eq!(nested_control_trace(2), (3, 1_172_173_129));
+        assert_eq!(nested_control_trace(3), (2, 1_129_216));
+        assert_eq!(triple_nested_control(false), (3, 172_737));
+        assert_eq!(triple_nested_control(true), (2, 1_726));
+    }
+}
