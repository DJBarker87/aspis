theorem field.PreparedQm31Multiplier.mul_eq_authentic
    (self : field.PreparedQm31Multiplier) (rhs : field.QM31) :
    field.PreparedQm31Multiplier.mul self rhs = (do
      let value ←
        AuthenticFieldPreparedMul.field.PreparedQm31Multiplier.mul
          { components := self.components }
          { c0 := { a := rhs.c0.a, b := rhs.c0.b },
            c1 := { a := rhs.c1.a, b := rhs.c1.b } }
      .ok ({
        c0 := { a := value.c0.a, b := value.c0.b },
        c1 := { a := value.c1.a, b := value.c1.b }
      } : field.QM31)) := by
  rfl

