      let value ← AuthenticFieldPow.field.CM31.mul
        { a := self.a, b := self.b } { a := rhs.a, b := rhs.b }
      .ok ({ a := value.a, b := value.b } : field.CM31)) := by
  rfl

theorem field.QM31.sub_eq_authentic (self rhs : field.QM31) :
    field.QM31.sub self rhs = (do
      let value ← AuthenticFieldSub.field.QM31.sub
        { c0 := { a := self.c0.a, b := self.c0.b },
          c1 := { a := self.c1.a, b := self.c1.b } }
        { c0 := { a := rhs.c0.a, b := rhs.c0.b },
          c1 := { a := rhs.c1.a, b := rhs.c1.b } }
      .ok ({
        c0 := { a := value.c0.a, b := value.c0.b },
        c1 := { a := value.c1.a, b := value.c1.b }
      } : field.QM31)) := by
  rfl

