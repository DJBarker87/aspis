   let span = def.item_meta.span in
 
+  (* Reordering a loop is only a simplification.  A loop body can contain a
+     function-level early return encoded with the same [LoopResult::Break]
+     constructor but a different payload arity.  Such a break does not belong
+     to the loop output tuple and must not be rewritten.  Conservatively skip
+     this optional reordering whenever the body contains one. *)
+  let loop_break_arities_match (output_indices : int list) (loop : loop) =
+    let expected = List.length output_indices in
+    let rec check (e : texpr) =
+      match e.e with
+      | FVar _
+      | BVar _
+      | CVar _
+      | Const _
+      | Lambda _
+      | StructUpdate _
+      | Loop _
+      | EError _ -> true
+      | App _ | Qualif _ -> (
+          match
+            opt_destruct_loop_result_decompose_outputs ctx span
+              ~intro_let:true ~opened_vars:false e
+          with
+          | Some ({ variant_id; args; _ }, _)
+            when variant_id = loop_result_break_id ->
+              List.length args = expected
+          | _ -> true)
+      | Let (_, pat, _, next) ->
+          let _, _, next = open_binder ctx span pat next in
+          check next
+      | Switch (_, switch) -> (
+          match switch with
+          | If (e0, e1) -> check e0 && check e1
+          | Match branches ->
+              List.for_all
+                (fun ({ pat; branch } : match_branch) ->
+                  let _, _, branch = open_binder ctx span pat branch in
+                  check branch)
+                branches)
+      | Meta (_, e) -> check e
+    in
+    check loop.loop_body.loop_body
+  in
+
