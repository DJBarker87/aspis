import Tag67WorkWireCore

open Aeneas Aeneas.Std Result ControlFlow Error

namespace AspisTag67WorkWire

open aspis_verifier.v5_cu_probe

theorem extracted_work_offsets_exact :
    V5_CU_PROBE_RELATION_FINAL_OFFSET_EXACT.val = 11048 ∧
      V5_CU_PROBE_BATCH_NONCE_OFFSET_EXACT.val = 11080 ∧
      V5_CU_PROBE_FINAL_NONCE_OFFSET_EXACT.val = 19127 ∧
      V5_CU_PROBE_QUERY_SELECTOR_OFFSET_EXACT.val = 19135 := by
  simp [V5_CU_PROBE_RELATION_FINAL_OFFSET_EXACT,
    V5_CU_PROBE_BATCH_NONCE_OFFSET_EXACT,
    V5_CU_PROBE_FINAL_NONCE_OFFSET_EXACT,
    V5_CU_PROBE_QUERY_SELECTOR_OFFSET_EXACT]

theorem extracted_batch_work_difficulty_exact :
    v5_batch_work_difficulty ⦃ value => value.val = 37 ⦄ := by
  simp [v5_batch_work_difficulty, Std.WP.spec, Std.WP.theta, Std.WP.wp_return]

theorem extracted_fold_work_difficulties_exact :
    v5_fold_work_difficulty 0#usize ⦃ value => value = some 34#u8 ⦄ ∧
      v5_fold_work_difficulty 1#usize ⦃ value => value = some 33#u8 ⦄ ∧
      v5_fold_work_difficulty 2#usize ⦃ value => value = some 30#u8 ⦄ ∧
      v5_fold_work_difficulty 3#usize ⦃ value => value = some 25#u8 ⦄ := by
  simp [v5_fold_work_difficulty, Std.WP.spec, Std.WP.theta, Std.WP.wp_return]

theorem extracted_final_work_difficulty_exact :
    v5_final_work_difficulty ⦃ value => value.val = 32 ⦄ := by
  simp [v5_final_work_difficulty, Std.WP.spec, Std.WP.theta, Std.WP.wp_return]

theorem extracted_fold_difficulty_out_of_range_four :
    v5_fold_work_difficulty 4#usize ⦃ value => value = none ⦄ := by
  simp [v5_fold_work_difficulty, Std.WP.spec, Std.WP.theta, Std.WP.wp_return]

theorem extracted_batch_and_final_records_are_le64 (nonce : Std.U64) :
    v5_batch_work_record nonce ⦃ value =>
        value = core.num.U64.to_le_bytes nonce ⦄ ∧
      v5_final_work_record nonce ⦃ value =>
        value = core.num.U64.to_le_bytes nonce ⦄ := by
  constructor <;> simp [v5_batch_work_record, v5_final_work_record,
    Std.WP.spec, Std.WP.theta, Std.WP.wp_return]

theorem extracted_selector_is_exact_range_check (selected : Std.U8) :
    v5_query_selector_is_valid selected = ok ((selected < 3#u8) : Bool) := by
  rfl

theorem extracted_selector_accepts_exact_candidates :
    v5_query_selector_is_valid 0#u8 ⦃ value => value = true ⦄ ∧
      v5_query_selector_is_valid 1#u8 ⦃ value => value = true ⦄ ∧
      v5_query_selector_is_valid 2#u8 ⦃ value => value = true ⦄ := by
  simp [v5_query_selector_is_valid, Std.WP.spec, Std.WP.theta, Std.WP.wp_return]

theorem extracted_selector_rejects_three :
    v5_query_selector_is_valid 3#u8 ⦃ value => value = false ⦄ := by
  simp [v5_query_selector_is_valid, Std.WP.spec, Std.WP.theta, Std.WP.wp_return]

theorem extracted_selector_rejects_255 :
    v5_query_selector_is_valid 255#u8 ⦃ value => value = false ⦄ := by
  simp [v5_query_selector_is_valid, Std.WP.spec, Std.WP.theta, Std.WP.wp_return]

theorem extracted_batch_and_final_positions_are_distinct :
    V5_CU_PROBE_BATCH_NONCE_OFFSET_EXACT.val ≠
      V5_CU_PROBE_FINAL_NONCE_OFFSET_EXACT.val := by
  simp [V5_CU_PROBE_BATCH_NONCE_OFFSET_EXACT,
    V5_CU_PROBE_FINAL_NONCE_OFFSET_EXACT]

theorem extracted_fold_zero_and_one_positions_are_distinct :
    V5_CU_PROBE_RELATION_FINAL_OFFSET_EXACT.val ≠ 11056 := by
  simp [V5_CU_PROBE_RELATION_FINAL_OFFSET_EXACT]

theorem extracted_batch_and_final_difficulties_are_distinct :
    (37#u8 : Std.U8) ≠ 32#u8 := by
  decide

theorem extracted_fold_round_zero_and_one_difficulties_are_distinct :
    (34#u8 : Std.U8) ≠ 33#u8 := by
  decide

theorem extracted_fold_absorb_input_exact
    (round : Std.Usize) (nonce : Std.U64)
    (record : Array Std.U8 9#usize)
    (hrecord : v5_fold_work_record round nonce = ok record) :
    v5_fold_work_absorb_input round nonce ⦃ output =>
      output.1.val = 20 ∧ output.2 = record ⦄ := by
  simp [v5_fold_work_absorb_input, hrecord,
    aspis_verifier.aspis_core.transcript.label.M31_CIRCLE_FOLD_POW_NONCE,
    Std.WP.spec, Std.WP.theta, Std.WP.wp_return]

theorem extracted_batch_absorb_input_exact (nonce : Std.U64) :
    v5_batch_work_absorb_input nonce ⦃ output =>
      output.1.val = 28 ∧
        output.2 = core.num.U64.to_le_bytes nonce ⦄ := by
  simp [v5_batch_work_absorb_input, v5_batch_work_record,
    aspis_verifier.aspis_core.transcript.label.M31_PAYMENT_BATCH_POW_NONCE,
    Std.WP.spec, Std.WP.theta, Std.WP.wp_return]

theorem extracted_final_absorb_input_exact (nonce : Std.U64) :
    v5_final_work_absorb_input nonce ⦃ output =>
      output.1.val = 5 ∧
        output.2 = core.num.U64.to_le_bytes nonce ⦄ := by
  simp [v5_final_work_absorb_input, v5_final_work_record,
    aspis_verifier.aspis_core.transcript.label.GRIND_NONCE,
    Std.WP.spec, Std.WP.theta, Std.WP.wp_return]

/-- The source-extracted projection preserves all six nonce positions and the
selector order.  Its hypotheses are executions of the generated byte reader,
not a handwritten parser model. -/
theorem extracted_projection_preserves_exact_order
    (data : Slice Std.U8)
    (fold0 fold1 fold2 fold3 batch final : Std.U64)
    (selector : Std.U8)
    (hfold0 : v5_work_wire_u64 data 11048#usize = ok fold0)
    (hfold1 : v5_work_wire_u64 data 11056#usize = ok fold1)
    (hfold2 : v5_work_wire_u64 data 11064#usize = ok fold2)
    (hfold3 : v5_work_wire_u64 data 11072#usize = ok fold3)
    (hbatch : v5_work_wire_u64 data 11080#usize = ok batch)
    (hfinal : v5_work_wire_u64 data 19127#usize = ok final)
    (hselector : Slice.index_usize data 19135#usize = ok selector) :
    project_v5_work_wire data ⦃ projection =>
      projection.fold_nonces.val = [fold0, fold1, fold2, fold3] ∧
      projection.batch_nonce = batch ∧
      projection.final_nonce = final ∧
      projection.query_selector = selector ⦄ := by
  have hadd8 : Std.Usize.wrapping_add 11048#usize 8#usize = 11056#usize := by
    apply UScalar.eq_of_val_eq
    cases System.Platform.numBits_eq <;>
      simp_all [Usize.size, Usize.numBits]
  have hadd16 : Std.Usize.wrapping_add 11048#usize 16#usize = 11064#usize := by
    apply UScalar.eq_of_val_eq
    cases System.Platform.numBits_eq <;>
      simp_all [Usize.size, Usize.numBits]
  have hadd24 : Std.Usize.wrapping_add 11048#usize 24#usize = 11072#usize := by
    apply UScalar.eq_of_val_eq
    cases System.Platform.numBits_eq <;>
      simp_all [Usize.size, Usize.numBits]
  simp [project_v5_work_wire,
    V5_CU_PROBE_RELATION_FINAL_OFFSET_EXACT,
    V5_CU_PROBE_BATCH_NONCE_OFFSET_EXACT,
    V5_CU_PROBE_FINAL_NONCE_OFFSET_EXACT,
    V5_CU_PROBE_QUERY_SELECTOR_OFFSET_EXACT,
    hadd8, hadd16, hadd24,
    hfold0, hfold1, hfold2, hfold3, hbatch, hfinal, hselector,
    Array.make, lift, Std.WP.spec, Std.WP.theta, Std.WP.wp_return]

