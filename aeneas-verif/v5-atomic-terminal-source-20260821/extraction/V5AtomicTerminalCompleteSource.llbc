ated by the [`iter_mut`] method on [slices]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // First, we need a slice to call the `iter_mut` method on:"},{"DocComment":" let slice = &mut [1, 2, 3];"},{"DocComment":""},{"DocComment":" // Then we call `iter_mut` on the slice to get the `IterMut` iterator,"},{"DocComment":" // iterate over it and increment each element value:"},{"DocComment":" for element in slice.iter_mut() {"},{"DocComment":"     *element += 1;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // We now have \"[2, 3, 4]\":"},{"DocComment":" println!(\"{slice:?}\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`iter_mut`]: slice::iter_mut"},{"DocComment":" [slices]: slice"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Mutable"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":6896},{"Var":{"Free":0}}]},{"regions":[],"skip_binder":[{"Deduplicated":6896},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"aarch64-apple-darwin","value":{"size":16,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,8,16],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,null,{"def_id":19,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["iter",0]},{"Ident":["IntoIter",0]}],"span":{"data":{"file_id":33,"beg":{"line":20,"col":0},"end":{"line":20,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A by-value [array] iterator."}],"inline":null,"rename":null,"pub