+//@ [coq,fstar] skip
+// Regression test for returning several shared slices derived from one input,
+// together with the unconsumed remainder, while reusing mutable scratch space.
+
+pub struct Opening<'a> {
+    pub records: &'a [u8],
+    pub frontier: &'a [u8],
+}
+
+pub struct FiveOpenings<'a> {
+    pub first: Opening<'a>,
+    pub second: Opening<'a>,
+    pub later: [Opening<'a>; 3],
+}
+
+pub fn parse_opening<'a>(
+    proof: &'a [u8],
+    level: &mut Vec<[u8; 32]>,
+    next: &mut Vec<[u8; 32]>,
+) -> Option<(Opening<'a>, &'a [u8])> {
+    if proof.len() < 2 {
+        return None;
+    }
+
+    level.clear();
+    next.clear();
+    level.push([proof[0]; 32]);
+    next.push([proof[1]; 32]);
+
+    let (records, tail) = proof.split_at(1);
+    let (frontier, remainder) = tail.split_at(1);
+    Some((Opening { records, frontier }, remainder))
+}
+
+pub fn parse_five<'a>(
+    proof: &'a [u8],
+    level: &mut Vec<[u8; 32]>,
+    next: &mut Vec<[u8; 32]>,
+) -> Option<(FiveOpenings<'a>, &'a [u8])> {
+    let (first, proof) = parse_opening(proof, level, next)?;
+    let (second, proof) = parse_opening(proof, level, next)?;
+    let (third, proof) = parse_opening(proof, level, next)?;
+    let (fourth, proof) = parse_opening(proof, level, next)?;
+    let (fifth, remainder) = parse_opening(proof, level, next)?;
+
+    Some((
+        FiveOpenings {
+            first,
+            second,
+            later: [third, fourth, fifth],
+        },
+        remainder,
+    ))
+}
+
+pub fn parse_five_exact<'a>(
+    proof: &'a [u8],
+    level: &mut Vec<[u8; 32]>,
+    next: &mut Vec<[u8; 32]>,
+) -> Option<FiveOpenings<'a>> {
+    let (openings, remainder) = parse_five(proof, level, next)?;
+    if remainder.is_empty() {
+        Some(openings)
+    } else {
+        None
+    }
+}
