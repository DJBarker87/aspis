+//@ [coq,fstar] skip
+// Regression tests for returns which must cross two or more loop boundaries.
+
+pub fn find_pair(rows: u32, columns: u32, wanted: u32) -> Option<(u32, u32)> {
+    let mut row = 0;
+    while row < rows {
+        let mut column = 0;
+        while column < columns {
+            if row == wanted && column == wanted {
+                return Some((row, column));
+            }
+            if column == 3 {
+                break;
+            }
+            column += 1;
+        }
+        row += 1;
+    }
+    None
+}
+
+pub fn sequential_loops(stop: u32) -> u32 {
+    let mut value = 0;
+    let mut outer = 0;
+    while outer < 2 {
+        let mut inner = 0;
+        while inner < 2 {
+            if value == stop {
+                return value + 10;
+            }
+            value += 1;
+            inner += 1;
+        }
+        outer += 1;
+    }
+
+    let mut tail = 0;
+    while tail < 2 {
+        value += 2;
+        tail += 1;
+    }
+    value
+}
+
+pub fn triple_nested_return(stop: u32) -> u32 {
+    let mut first = 0;
+    while first < 2 {
+        let mut second = 0;
+        while second < 2 {
+            let mut third = 0;
+            while third < 2 {
+                if first + second + third == stop {
+                    return first * 4 + second * 2 + third + 1;
+                }
+                third += 1;
+            }
+            second += 1;
+        }
+        first += 1;
+    }
+    0
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub struct NonCopy {
+    pub value: u32,
+}
+
+pub fn non_copy_result(stop: u32) -> Result<NonCopy, u32> {
+    let mut outer = 0;
+    while outer < 2 {
+        let mut inner = 0;
+        while inner < 2 {
+            if outer + inner == stop {
+                return Ok(NonCopy {
+                    value: outer * 2 + inner,
+                });
+            }
+            inner += 1;
+        }
+        outer += 1;
+    }
+    Err(7)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn nested_return_paths_and_normal_paths_agree_with_rust() {
+        assert_eq!(find_pair(5, 5, 2), Some((2, 2)));
+        assert_eq!(find_pair(5, 5, 4), None);
+        assert_eq!(sequential_loops(1), 11);
+        assert_eq!(sequential_loops(99), 8);
+        assert_eq!(triple_nested_return(0), 1);
+        assert_eq!(triple_nested_return(3), 8);
+        assert_eq!(triple_nested_return(4), 0);
+        assert_eq!(non_copy_result(0), Ok(NonCopy { value: 0 }));
+        assert_eq!(non_copy_result(9), Err(7));
+    }
+}
