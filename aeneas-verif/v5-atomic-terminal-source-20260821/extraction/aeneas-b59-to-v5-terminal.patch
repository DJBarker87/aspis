@@ -0,0 +1,33 @@
+//@ [!lean] skip
+
+fn matches_tuple(indices: &[u32], values: &[[u8; 32]]) -> u8 {
+    match (indices, values) {
+        ([0], [value]) => value[0],
+        ([0, 1], [left, right]) => left[0].wrapping_add(right[0]),
+        ([index], [value]) => (*index as u8).wrapping_add(value[0]),
+        _ => 0,
+    }
+}
+
+fn metadata_precedes_reference_reassignment(first: &[u32], second: &[u32]) -> usize {
+    let mut selected = first;
+    let matched_before_reassignment = matches!(selected, [1]);
+    selected = second;
+    matched_before_reassignment as usize + 10 * selected.len()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn slice_patterns_have_the_expected_rust_behavior() {
+        let a = [7u8; 32];
+        let b = [9u8; 32];
+        assert_eq!(matches_tuple(&[0], &[a]), 7);
+        assert_eq!(matches_tuple(&[0, 1], &[a, b]), 16);
+        assert_eq!(matches_tuple(&[3], &[a]), 10);
+        assert_eq!(matches_tuple(&[], &[]), 0);
+        assert_eq!(metadata_precedes_reference_reassignment(&[1], &[2, 3]), 21);
+    }
+}
