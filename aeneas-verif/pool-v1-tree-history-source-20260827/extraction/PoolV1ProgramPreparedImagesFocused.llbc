,\n        M31(871749117),\n        M31(98906847),\n        M31(2026788776),\n        M31(1504737042),\n        M31(407274798),\n        M31(1800828893),\n    ],\n    [\n        M31(986339640),\n        M31(660349625),\n        M31(1012157959),\n        M31(454024326),\n        M31(987656904),\n        M31(622864739),\n        M31(1150440730),\n        M31(1280042062),\n    ],\n    [\n        M31(2118470693),\n        M31(1706590589),\n        M31(2128512933),\n        M31(167263577),\n        M31(409542414),\n        M31(1323179656),\n        M31(1880070613),\n        M31(2053396184),\n    ],\n    [\n        M31(260546973),\n        M31(1375125357),\n        M31(1584234519),\n        M31(1097072342),\n        M31(1685367984),\n        M31(1070989054),\n        M31(2113798037),\n        M31(958210542),\n    ],\n    [\n        M31(1239966481),\n        M31(992485427),\n        M31(1397515674),\n        M31(466658549),\n        M31(2071909237),\n        M31(712995354),\n        M31(2047452742),\n        M31(1680224983),\n    ],\n    [\n        M31(1796237568),\n        M31(1862343136),\n        M31(1954463912),\n        M31(1190686266),\n        M31(364700025),\n        M31(46960257),\n        M31(671215600),\n        M31(1214723477),\n    ],\n    [\n        M31(1127845264),\n        M31(662862400),\n        M31(84021756),\n        M31(995080286),\n        M31(1419670571),\n        M31(1966281459),\n        M31(837284626),\n        M31(2083375353),\n    ],\n    [\n        M31(1321679286),\n        M31(782621548),\n        M31(1415820264),\n        M31(74436574),\n        M31(776350425),\n        M31(323154748),\n        M31(429051705),\n        M31(1299980413),\n    ],\n    [\n        M31(1519171444),\n        M31(1235587172),\n        M31(1671492368),\n        M31(1449613582),\n        M31(547369941),\n        M31(1621086153),\n        M31(266860322),\n        M31(450526803),\n    ],\n    [\n        M31(19381883),\n        M31(1308966873),\n        M31(251977766),\n        M31(474343397),\n        M31(2069732268),\n        M31(1863820229),\n        M31(152153379),\n        M31(665567443),\n    ],\n];\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn pinned_table_matches_recursive_poseidon_v3_construction() {\n        assert_eq!(\n            POOL_V1_EMPTY_ROOTS,\n            aspis_statement::pool_v1::pool_v1_empty_roots()\n        );\n    }\n}\n"},{"id":48,"name":{"Local":"/rustc/library/core/src/array/equality.rs"},"crate_name":"core","contents":null},{"id":49,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":50,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null},{"id":51,"name":{"Local":"/rustc/library/core/src/array/iter.rs"},"crate_name":"core","contents":null},{"id":52,"name":{"Local":"/rustc/library/core/src/num/nonzero.rs"},"crate_name":"core","contents":null},{"id":53,"name":{"Local":"/rustc/library/core/src/iter/adapters/step_by.rs"},"crate_name":"core","contents":null},{"id":54,"name":{"Local":"/rustc/library/core/src/iter/adapters/chain.rs"},"crate_name":"core","contents":null},{"id":55,"name":{"Local":"/rustc/library/core/src/iter/adapters/zip.rs"},"crate_name":"core","contents":null},{"id":56,"name":{"Local":"/rustc/library/core/src/iter/adapters/intersperse.rs"},"crate_name":"core","contents":null},{"id":57,"name":{"Local":"/rustc/library/core/src/iter/adapters/map.rs"},"crate_name":"core","contents":null},{"id":58,"name":{"Local":"/rustc/library/core/src/iter/adapters/filter.rs"},"crate_name":"core","contents":null},{"id":59,"name":{"Local":"/rustc/library/core/src/iter/adapters/filter_map.rs"},"crate_name":"core","contents":null},{"id":60,"name":{"Local":"/rustc/library/core/src/iter/adapters/peekable.rs"},"crate_name":"core","contents":null},{"id":61,"name":{"Local":"/rustc/library/core/src/iter/adapters/skip_while.rs"},"crate_name":"core","contents":null},{"id":62,"name":{"Local":"/rustc/library/core/src/iter