nant":{"Scalar":{"Signed":["Isize","1"]}}},{"id":2,"span":{"data":{"file_id":38,"beg":{"line":65,"col":4},"end":{"line":65,"col":17}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"FeeOutOfRange","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","2"]}}},{"id":3,"span":{"data":{"file_id":38,"beg":{"line":66,"col":4},"end":{"line":66,"col":21}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"PathDepthMismatch","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","3"]}}},{"id":4,"span":{"data":{"file_id":38,"beg":{"line":67,"col":4},"end":{"line":67,"col":28}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"InsertionIndexOutOfRange","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","4"]}}},{"id":5,"span":{"data":{"file_id":38,"beg":{"line":68,"col":4},"end":{"line":68,"col":25}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"CurrentAnchorMismatch","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","5"]}}},{"id":6,"span":{"data":{"file_id":38,"beg":{"line":69,"col":4},"end":{"line":69,"col":24}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"OutputAnchorMismatch","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","6"]}}}]},"layout":[{"key":"aarch64-apple-darwin","value":{"size":1,"align":1,"discriminator":{"Branch":{"offset":0,"int_ty":{"Unsigned":"U8"},"children":[[{"start":{"Unsigned":["U8","0"]},"end":{"Unsigned":["U8","0"]}},{"Known":0}],[{"start":{"Unsigned":["U8","1"]},"end":{"Unsigned":["U8","1"]}},{"Known":1}],[{"start":{"Unsigned":["U8","2"]},"end":{"Unsigned":["U8","2"]}},{"Known":2}],[{"start":{"Unsigned":["U8","3"]},"end":{"Unsigned":["U8","3"]}},{"Known":3}],[{"start":{"Unsigned":["U8","4"]},"end":{"Unsigned":["U8","4"]}},{"Known":4}],