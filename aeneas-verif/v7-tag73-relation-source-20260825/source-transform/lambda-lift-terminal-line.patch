+    // Extraction-only lambda lift of the `dot` line accumulator.  All state
+    // is returned by value so Aeneas does not have to merge a closure's
+    // captured mutable borrows across the exact indexed batch loop.
+    fn accumulate_terminal_line_extraction(
+        line_deferred_halvings: u8,
+        mut line_count: usize,
+        mut line_constant_limbs: [M31; 4],
+        mut line_raw: [[u64; 4]; 3],
+        mut line_sums: [[M31; 4]; 3],
+        mut scale: QM31,
+        x: M31,
+        mut halvings: u8,
+    ) -> (usize, [M31; 4], [[u64; 4]; 3], [[M31; 4]; 3]) {
+        while halvings < line_deferred_halvings {
+            scale = scale.add(scale);
+            halvings += 1;
+        }
+        let high = Self::double_x_m31(x);
+        let factors = [x, high, x.mul(high)];
+        let limbs = [scale.c0.a.0, scale.c0.b.0, scale.c1.a.0, scale.c1.b.0];
+        for limb in 0..4 {
+            line_constant_limbs[limb] = line_constant_limbs[limb].add(M31(limbs[limb]));
+            for slot in 0..3 {
+                line_raw[slot][limb] +=
+                    u64::from(limbs[limb]) * u64::from(factors[slot].0);
+            }
+        }
+        line_count += 1;
+        if line_count % 4 == 0 {
+            for slot in 0..3 {
+                for limb in 0..4 {
+                    line_sums[slot][limb] = line_sums[slot][limb]
+                        .add(M31::reduce_u64(line_raw[slot][limb]));
+                    line_raw[slot][limb] = 0;
+                }
+            }
+        }
+        (line_count, line_constant_limbs, line_raw, line_sums)
+    }
