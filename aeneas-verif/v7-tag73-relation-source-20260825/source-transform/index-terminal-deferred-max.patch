+    // Extraction-only indexed spelling of
+    // `components.iter().filter_map(...).max().unwrap_or(0)`.  Deferred
+    // halvings are `u8`, so starting at zero and retaining every larger
+    // value is exactly the same maximum, including the empty case.
+    fn terminal_component_deferred_halvings_extraction(
+        component: &WeightComponent,
+    ) -> u8 {
+        match component {
+            WeightComponent::LineM31Batch {
+                deferred_halvings, ..
+            } => *deferred_halvings,
+            _ => 0,
+        }
+    }
+
+    fn terminal_line_deferred_halvings_extraction(
+        components: &[WeightComponent],
+    ) -> u8 {
+        let mut maximum = 0u8;
+        let mut component_index = 0usize;
+        while component_index < components.len() {
+            let candidate = Self::terminal_component_deferred_halvings_extraction(
+                &components[component_index],
+            );
+            if maximum < candidate {
+                maximum = candidate;
+            }
+            component_index += 1;
+        }
+        maximum
+    }
