ex += 1;\n                if position & 1 == 0 {\n                    (\n                        node_hash_v7(hash, &c1, &c1_sibling),\n                        node_hash_v7(hash, &c2, &c2_sibling),\n                    )\n                } else {\n                    (\n                        node_hash_v7(hash, &c1_sibling, &c1),\n                        node_hash_v7(hash, &c2_sibling, &c2),\n                    )\n                }\n            };\n            next.push((position >> 1, parent.0, parent.1));\n        }\n        core::mem::swap(level, next);\n    }\n\n    node_pos == node_bytes.0.len()\n        && level.len() == 1\n        && level[0].0 == 0\n        && level[0].1 == *roots.0\n        && level[0].2 == *roots.1\n}","attr_info":{"attributes":[{"DocComment":" Verify both typed V7 trees over one sorted query topology. Hashes remain"},{"DocComment":" independent; only the public index walk and scratch allocation are shared."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"},{"index":3,"name":null,"mutability":"Unknown"},{"index":4,"name":null,"mutability":"Unknown"},{"index":5,"name":null,"mutability":"Unknown"},{"index":6,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":960},{"HashConsedValue":[7153,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":7145},{"Deduplicated":7146}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":1335},{"HashConsedValue":[7154,{"Ref":[{"Var":{"Free":2}},{"Deduplicated":1337},"Shared"]}]},{"HashConsedValue":[7157,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"HashConsedValue":[7155