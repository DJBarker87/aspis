,{"DocComment":" ```text"},{"DocComment":" [f(0), f(1), f(2), …, f(N - 2), f(N - 1)]"},{"DocComment":" ```"},{"DocComment":" and is similar to `(0..i).map(f)`, just for arrays not iterators."},{"DocComment":""},{"DocComment":" If `N == 0`, this produces an empty array without ever calling `f`."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" // type inference is helping us here, the way `from_fn` knows how many"},{"DocComment":" // elements to produce is the length of array down there: only arrays of"},{"DocComment":" // equal lengths can be compared, so the const generic parameter `N` is"},{"DocComment":" // inferred to be 5, thus creating array of 5 elements."},{"DocComment":""},{"DocComment":" let array = core::array::from_fn(|i| i);"},{"DocComment":" // indexes are:    0  1  2  3  4"},{"DocComment":" assert_eq!(array, [0, 1, 2, 3, 4]);"},{"DocComment":""},{"DocComment":" let array2: [usize; 8] = core::array::from_fn(|i| i * 2);"},{"DocComment":" // indexes are:     0  1  2  3  4  5   6   7"},{"DocComment":" assert_eq!(array2, [0, 2, 4, 6, 8, 10, 12, 14]);"},{"DocComment":""},{"DocComment":" let bool_arr = core::array::from_fn::<_, 5, _>(|i| i % 2 == 0);"},{"DocComment":" // indexes are:       0     1      2     3      4"},{"DocComment":" assert_eq!(bool_arr, [true, false, true, false, true]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also capture things, for example to create an array full of clones"},{"DocComment":" where you can't just use `[item; N]` because it's not `Copy`:"},{"DocComment":" ```"},{"DocComment":" let my_string: [String; 2] = std::array::from_fn(|i| format!(\"Hello {i}\"));"},{"DocComment":" assert_eq!(my_string, [\"Hello 0\", \"Hello 1\"]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The array is generated in ascending index order, starting from the front"},{"DocComment":" and going towards the back, so you can use closures with mutable state:"},{"DocComment":" ```"},{"DocComment":" let mut state = 1;"},{"DocComment":" let a = std::array::from_fn(|_| { let x = state; state *= 2; x });"},{"DocComment":" assert_eq!(a, [1, 2, 4, 8, 16, 32]);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"F"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":448}}],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":13,"beg":{"line":110,"col":24},"end":{"line":110,"col":40}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":11280}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":13,"beg":{"line":112,"col":7},"end":{"line":112,"col":32}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":11281},{"Deduplicated":1361},{"Deduplicated":11280}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":13,"beg":{"line":112,"col":35},"end":{"line":112,"col":51}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":11281}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":11281}],"output":{"HashConsedValue":[11296,{"Array":[{"Deduplicated":11280},{"kind":{"Var":{"Free":0}},"ty":{"Deduplicated":448}}]}]}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":2,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1525},"kind":"InherentImplBlock"}}},{"Ident":["sort_unstable_by_key",0]}],"span":{"data":{"file_id":8,"beg":{"line":3241,"col":4},"end":{"line":3244,"col":15}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Sorts the slice in ascending order with a key extraction function, **without** preserving"},{"DocComment":" the initial order of equal elements."},{"DocComment":""},{"DocComment":" This sort is unstable (i.e., may reorder equal elements), in-place (i.e., does not"},{"DocComment":" allocate), and *O*(*n* \\* log(*n*)) worst-case."},{"DocComment":""},{"DocComment":" If the implementation of [`Ord`] for `K` does not implement a [total order], the function"},{"DocComment":" may panic; even if the function exits normally, the resulting order of elements in the slice"},{"DocComment":" is unspecified. See also the note on panicking below."},{"DocComment":""},{"DocComment":" For example `|a, b| (a - b).cmp(a)` is a comparison function that is neither transitive nor"},{"DocComment":" reflexive nor total, `a < b < c < a` with `a = 1, b = 2, c = 3`. For more information and"},{"DocComment":" examples see the [`Ord`] documentation."},{"DocComment":""},{"DocComment":" All original elements will remain in the slice and any possible modifications via interior"},{"DocComment":" mutability are observed in the input. Same is true if the implementation of [`Ord`] for `K` panics."},{"DocComment":""},{"DocComment":" # Current implementation"},{"DocComment":""},{"DocComment":" The current implementation is based on [ipnsort] by Lukas Bergdoll and Orson Peters, which"},{"DocComment":" combines the fast average case of quicksort with the fast worst case of heapsort, achieving"},{"DocComment":" linear time on fully sorted and reversed inputs. On inputs with k distinct elements, the"},{"DocComment":" expected time to sort the data is *O*(*n* \\* log(*k*))."},{"DocComment":""},{"DocComment":" It is typically faster than stable sorting, except in a few special cases, e.g., when the"},{"DocComment":" slice is partially sorted."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" May panic if the implementation of [`Ord`] for `K` does not implement a [total order], or if"},{"DocComment":" the [`Ord`] implementation panics."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut v = [4i32, -5, 1, -3, 2];"},{"DocComment":""},{"DocComment":" v.sort_unstable_by_key(|k| k.abs());"},{"DocComment":" assert_eq!(v, [1, 2, -3, 4, -5]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [ipnsort]: https://github.com/Voultapher/sort-research-rs/tree/main/ipnsort"},{"DocComment":" [total order]: https://en.wikipedia.org/wiki/Total_order"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"},{"index":1,"name":"K"},{"index":2,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":8,"beg":{"line":3243,"col":11},"end":{"line":3243,"col":25}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"HashConsedValue":[11307,{"TypeVar":{"Free":2}}]},{"HashConsedValue":[11408,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"HashConsedValue":[11361,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":11280},"Shared"]}]}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":11281}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":8,"beg":{"line":3244,"col":11},"end":{"line":3244,"col":14}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":11281}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[11409,{"Ref":[{"Var":{"Free":0}},{"HashConsedValue":[11291,{"Slice":{"Deduplicated":11280}}]},"Mut"]}]},{"Deduplicated":11307}],"output":{"Deduplicated":819}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":3,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1525},"kind":"InherentImplBlock"}}},{"Ident":["windows",0]}],"span":{"data":{"file_id":8,"beg":{"line":1116,"col":4},"end":{"line":1116,"col":62}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns an iterator over all contiguous windows of length"},{"DocComment":" `size`. The windows overlap. If the slice is shorter than"},{"DocComment":" `size`, the iterator returns no values."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `size` is zero."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let slice = ['l', 'o', 'r', 'e', 'm'];"},{"DocComment":" let mut iter = slice.windows(3);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['l', 'o', 'r']);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['o', 'r', 'e']);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['r', 'e', 'm']);"},{"DocComment":" assert!(iter.next().is_none());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If the slice is shorter than `size`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let slice = ['f', 'o', 'o'];"},{"DocComment":" let mut iter = slice.windows(4);"},{"DocComment":" assert!(iter.next().is_none());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because the [Iterator] trait cannot represent the required lifetimes,"},{"DocComment":" there is no `windows_mut` analog to `windows`;"},{"DocComment":" `[0,1,2].windows_mut(2).collect()` would violate [the rules of references]"},{"DocComment":" (though a [LendingIterator] analog is possible). You can sometimes use"},{"DocComment":" [`Cell::as_slice_of_cells`](crate::cell::Cell::as_slice_of_cells) in"},{"DocComment":" conjunction with `windows` instead:"},{"DocComment":""},{"DocComment":" [the rules of references]: https://doc.rust-lang.org/book/ch04-02-references-and-borrowing.html#the-rules-of-references"},{"DocComment":" [LendingIterator]: https://blog.rust-lang.org/2022/10/28/gats-stabilization.html"},{"DocComment":" ```"},{"DocComment":" use std::cell::Cell;"},{"DocComment":""},{"DocComment":" let mut array = ['R', 'u', 's', 't', ' ', '2', '0', '1', '5'];"},{"DocComment":" let slice = &mut array[..];"},{"DocComment":" let slice_of_cells: &[Cell<char>] = Cell::from_mut(slice).as_slice_of_cells();"},{"DocComment":" for w in slice_of_cells.windows(3) {"},{"DocComment":"     Cell::swap(&w[0], &w[2]);"},{"DocComment":" }"},{"DocComment":" assert_eq!(array, ['s', 't', ' ', '2', '0', '1', '5', 'u', 'R']);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[11292,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":11291},"Shared"]}]},{"Deduplicated":448}],"output":{"HashConsedValue":[11290,{"Adt":{"id":{"Adt":7},"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":11280}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":4,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["any",0]}],"span":{"data":{"file_id":21,"beg":{"line":2885,"col":4},"end":{"line":2888,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Tests if any element of the iterator matches a predicate."},{"DocComment":""},{"DocComment":" `any()` takes a closure that returns `true` or `false`. It applies"},{"DocComment":" this closure to each element of the iterator, and if any of them return"},{"DocComment":" `true`, then so does `any()`. If they all return `false`, it"},{"DocComment":" returns `false`."},{"DocComment":""},{"DocComment":" `any()` is short-circuiting; in other words, it will stop processing"},{"DocComment":" as soon as it finds a `true`, given that no matter what else happens,"},{"DocComment":" the result will also be `true`."},{"DocComment":""},{"DocComment":" An empty iterator returns `false`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert!(a.into_iter().any(|x| x > 0));"},{"DocComment":""},{"DocComment":" assert!(!a.into_iter().any(|x| x > 5));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert!(iter.any(|x| x != 2));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"F"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":11280},{"Deduplicated":11307}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":21,"beg":{"line":2888,"col":11},"end":{"line":2888,"col":36}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":11281},{"HashConsedValue":[11410,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":11307}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":850}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[11322,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":11280},"Mut"]}]},{"Deduplicated":11281}],"output":{"Deduplicated":850}},"src":{"TraitDecl":{"trait_ref":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":11280},{"Deduplicated":11307}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":42}}},"is_global_initializer":null,"body":"Opaque"},{"def_id":5,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":10813},"kind":"InherentImplBlock"}}},{"Ident":["with_capacity",0]}],"span":{"data":{"file_id":9,"beg":{"line":523,"col":4},"end":{"line":523,"col":55}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Constructs a new, empty `Vec<T>` with at least the specified capacity."},{"DocComment":""},{"DocComment":" The vector will be able to hold at least `capacity` elements without"},{"DocComment":" reallocating. This method is allowed to allocate for more elements than"},{"DocComment":" `capacity`. If `capacity` is zero, the vector will not allocate."},{"DocComment":""},{"DocComment":" It is important to note that although the returned vector has the"},{"DocComment":" minimum *capacity* specified, the vector will have a zero *length*. For"},{"DocComment":" an explanation of the difference between length and capacity, see"},{"DocComment":" *[Capacity and reallocation]*."},{"DocComment":""},{"DocComment":" If it is important to know the exact allocated capacity of a `Vec`,"},{"DocComment":" always use the [`capacity`] method after construction."},{"DocComment":""},{"DocComment":" For `Vec<T>` where `T` is a zero-sized type, there will be no allocation"},{"DocComment":" and the capacity will always be `usize::MAX`."},{"DocComment":""},{"DocComment":" [Capacity and reallocation]: #capacity-and-reallocation"},{"DocComment":" [`capacity`]: Vec::capacity"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if the new capacity exceeds `isize::MAX` _bytes_."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec = Vec::with_capacity(10);"},{"DocComment":""},{"DocComment":" // The vector contains no items, even though it has capacity for more"},{"DocComment":" assert_eq!(vec.len(), 0);"},{"DocComment":" assert!(vec.capacity() >= 10);"},{"DocComment":""},{"DocComment":" // These are all done without reallocating..."},{"DocComment":" for i in 0..10 {"},{"DocComment":"     vec.push(i);"},{"DocComment":" }"},{"DocComment":" assert_eq!(vec.len(), 10);"},{"DocComment":" assert!(vec.capacity() >= 10);"},{"DocComment":""},{"DocComment":" // ...but this may make the vector reallocate"},{"DocComment":" vec.push(11);"},{"DocComment":" assert_eq!(vec.len(), 11);"},{"DocComment":" assert!(vec.capacity() >= 11);"},{"DocComment":""},{"DocComment":" // A vector of a zero-sized type will always over-allocate, since no"},{"DocComment":" // allocation is necessary"},{"DocComment":" let vec_units = Vec::<()>::with_capacity(10);"},{"DocComment":" assert_eq!(vec_units.capacity(), usize::MAX);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"vec_with_capacity"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":448}],"output":{"HashConsedValue":[11299,{"Adt":{"id":{"Adt":9},"generics":{"regions":[],"types":[{"Deduplicated":11280}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":6,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["iter",0]},{"Impl":{"Trait":10}},{"Ident":["into_iter",0]}],"span":{"data":{"file_id":12,"beg":{"line":56,"col":4},"end":{"line":56,"col":40}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates a consuming iterator, that is, one that moves each value out of"},{"DocComment":" the array (from start to end)."},{"DocComment":""},{"DocComment":" The array cannot be used after calling this unless `T` implements"},{"DocComment":" `Copy`, so the whole array is copied."},{"DocComment":""},{"DocComment":" Arrays have special behavior when calling `.into_iter()` prior to the"},{"DocComment":" 2021 edition -- see the [array] Editions section for more information."},{"DocComment":""},{"DocComment":" [array]: prim@array"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":