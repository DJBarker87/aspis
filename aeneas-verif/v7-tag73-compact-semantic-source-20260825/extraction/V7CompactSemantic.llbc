lice(data);\n            self.state = (self.hash)(&[&input[..34 + data.len()]]);\n        } else {\n            self.state = (self.hash)(&[&self.state, &[DOM_ABSORB, label], data]);\n        }\n    }","attr_info":{"attributes":[],"inline":"Never","rename":null,"public":true},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":7936},{"Deduplicated":1191},{"HashConsedValue":[7974,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":1198},"Shared"]}]}],"output":{"Deduplicated":1140}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":18,"item_meta":{"name":[{"Ident":["aspis_core",0]},{"Ident":["transcript",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":581},"kind":"InherentImplBlock"}}},{"Ident":["challenge_qm31",0]}],"span":{"data":{"file_id":2,"beg":{"line":365,"col":4},"end":{"line":403,"col":5}},"generated_from_span":null},"source_text":"pub fn challenge_qm31(&mut self) -> Result<QM31, ChallengeSampleExhausted> {\n        let mut limbs = [M31::ZERO; 4];\n        let mut block = self.squeeze_block();\n        let mut word_index = 0usize;\n        for limb in limbs.iter_mut() {\n            let mut accepted = false;\n            for _ in 0..CHALLENGE_RETRY_LIMIT {\n                if word_index == 8 {\n                    block = self.squeeze_block();\n                    word_index = 0;\n                }\n                let word = u32::from_le_bytes(\n                    block[word_index * 4..word_index * 4 + 4]\n                        .try_into()\n                        .unwrap(),\n                );\n                word_index += 1;\n                let masked = word & crate::field::P;\n                if masked != crate::field::P {\n                    *limb = M31(masked);\n                    accepted = true;\n                    break;\n                }\n            }\n            if !accepted {\n                return Err(ChallengeSampleExhausted);\n            }\n        }\n        Ok(QM31 {\n            c0: crate::field::CM31 {\n                a: limbs[0],\n                b: limbs[1],\n            },\n            c1: crate::field::CM31 {\n                a: limbs[2],\n                b: limbs[3],\n            },\n        })\n    }","attr_info":{"attributes":[{"DocComment":" Sample a QM31 challenge by per-limb rejection sampling (exactly"},{"DocComment":" uniform; soundness-note §3 T9)."},{"DocComment":""},{"DocComment":" Each limb draw takes 31 bits of a LE u32 and REJECTS the single"},{"DocComment":" non-canonical value P, redrawing from fresh transcript bytes: retries"},{"DocComment":" consume the next word of the block stream, and a spent block is"},{"DocComment":" replaced via `squeeze_block`, which advances the duplex state — no"},{"DocComment":" input is ever re-hashed, so retries cannot repeat a rejected value"},{"DocComment":" deterministically. The retry loop is bounded (`CHALLENGE_RETRY_LIMIT`)"},{"DocComment":" and exhaustion is an error the verifier surfaces as proof rejection:"},{"DocComment":" per-limb exhaustion probability is (2^-31)^8 = 2^-248, a completeness"},{"DocComment":" event (soundness-note §6), the correct trade on a CU-metered chain"},{"DocComment":" versus an unmetered loop."},{"DocComment":""},{"DocComment":" In the non-rejecting case (all real transcripts, whp) this consumes"},{"DocComment":" exactly one block and produces the same limbs as the pre-fix sampler"},{"DocComment":" except on a P-hit, where the old code folded P to 0 (the ~2^-31"},{"DocComment":" per-limb bias this fix removes)."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":7936}],"output":{"Deduplicated":1396}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":19,"item_meta":{"name":[{"Ident":["aspis_core",0]},{"Ident":["state_only_sumcheck",0]},{"Ident":["evaluate_state_only_polynomial",0]}],"span":{"data":{"file_id":28,"beg":{"line":160,"col":0},"end":{"line":187,"col":1}},"generated_from_span":null},"source_text":"pub fn evaluate_state_only_polynomial(\n    polynomial: &StateOnlySumcheckPolynomial,\n    challenge: QM31,\n) -> QM31 {\n    let x2 = challenge.square();\n    let x3 = challenge.mul(x2);\n    let x4 = x2.square();\n    let powers = [challenge, x2, x3];\n    let prepared_x4 = PreparedQm31Multiplier::new(x4);\n    let block_value = |block: usize| {\n        let start = 4 * block;\n        polynomial[start].add(qm31_sum_products3(\n            powers,\n            [\n                polynomial[start + 1],\n                polynomial[start + 2],\n                polynomial[start + 3],\n            ],\n        ))\n    };\n    let mut accumulator = block_value(6);\n    let mut block = 6usize;\n    while block > 0 {\n        block -= 1;\n        accumulator = prepared_x4.mul(accumulator).add(block_value(block));\n    }\n    accumulator\n}","attr_info":{"attributes":[{"DocComment":" Exact degree-27 radix-four evaluation."},{"DocComment":""},{"DocComment":" The seven blocks are `c[4j] + x*c[4j+1] + x^2*c[4j+2] +"},{"DocComment":" x^3*c[4j+3]`. Their three nonconstant products share one lazy reduction,"},{"DocComment":" after which the block values are combined by Horner evaluation at `x^4`."},{"DocComment":" This preserves the polynomial while trading 