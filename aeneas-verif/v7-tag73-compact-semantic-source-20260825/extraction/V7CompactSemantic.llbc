=\n        assert!((STATE_ONLY_SUMCHECK_COEFFICIENTS as u64 + 1) * (P as u64) < (1u64 << 36));\n    let first = polynomial[0];\n    let mut limbs = [\n        2 * u64::from(first.c0.a.0),\n        2 * u64::from(first.c0.b.0),\n        2 * u64::from(first.c1.a.0),\n        2 * u64::from(first.c1.b.0),\n    ];\n    for coefficient in &polynomial[1..] {\n        limbs[0] += u64::from(coefficient.c0.a.0);\n        limbs[1] += u64::from(coefficient.c0.b.0);\n        limbs[2] += u64::from(coefficient.c1.a.0);\n        limbs[3] += u64::from(coefficient.c1.b.0);\n    }\n    QM31 {\n        c0: CM31::new(M31::reduce_u64(limbs[0]), M31::reduce_u64(limbs[1])),\n        c1: CM31::new(M31::reduce_u64(limbs[2]), M31::reduce_u64(limbs[3])),\n    }\n}","attr_info":{"attributes":[{"DocComment":" Literal `p(0) + p(1)` for a complete degree-27 round polynomial."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":7874}],"output":{"Deduplicated":824}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":28,"beg":{"line":110,"col":0},"end":{"line":134,"col":1}},"generated_from_span":null},"bound_body_regions":28,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":28,"beg":{"line":110,"col":76},"end":{"line":110,"col":80}},"generated_from_span":null},"ty":{"Deduplicated":824}},{"index":1,"name":"polynomial","span":{"data":{"file_id":28,"beg":{"line":110,"col":31},"end":{"line":110,"col":41}},"generated_from_span":null},"ty":{"HashConsedValue":[5215,{"Ref":[{"Body":1},{"Deduplicated":1188},"Shared"]}]}},{"index":2,"name":"first","span":{"data":{"file_id":28,"beg":{"line":117,"col":8},"end":{"l