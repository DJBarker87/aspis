before":[]},{"span":{"data":{"file_id":3,"beg":{"line":865,"col":5},"end":{"line":865,"col":5}},"generated_from_span":null},"id":998,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":3,"beg":{"line":865,"col":5},"end":{"line":865,"col":5}},"generated_from_span":null},"id":999,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":5,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1238},"kind":"InherentImplBlock"}}},{"Ident":["sort_unstable",0]}],"span":{"data":{"file_id":10,"beg":{"line":3134,"col":4},"end":{"line":3136,"col":15}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Sorts the slice in ascending order **without** preserving the initial order of equal elements."},{"DocComment":""},{"DocComment":" This sort is unstable (i.e., may reorder equal elements), in-place (i.e., does not"},{"DocComment":" allocate), and *O*(*n* \\* log(*n*)) worst-case."},{"DocComment":""},{"DocComment":" If the implementation of [`Ord`] for `T` does not implement a [total order], the function"},{"DocComment":" may panic; even if the function exits normally, the resulting order of elements in the slice"},{"DocComment":" is unspecified. See also the note on panicking below."},{"DocComment":""},{"DocComment":" For example `|a, b| (a - b).cmp(a)` is a comparison function that is neither transitive nor"},{"DocComment":" reflexive nor total, `a < b < c < a` with `a = 1, b = 2, c = 3`. For more information and"},{"DocComment":" examples see the [`Ord`] documentation."},{"DocComment":""},{"DocComment":""},{"DocComment":" All original elements will remain in the slice and any possible modifications via interior"},{"DocComment":" mutability are observed in the input. Same is true if the implementation of [`Ord`] for `T` panics."},{"DocComment":""},{"DocComment":" Sorting types that only implement [`PartialOrd`] such as [`f32`] and [`f64`] require"},{"DocComment":" additional precautions. For example, `f32::NAN != f32::NAN`, which doesn't fulfill the"},{"DocComment":" reflexivity requirement of [`Ord`]. By using an alternative comparison function with"},{"DocComment":" `slice::sort_unstable_by` such as [`f32::total_cmp`] or [`f64::total_cmp`] that defines a"},{"DocComment":" [total order] users can sort slices containing floating-point values. Alternatively, if all"},{"DocComment":" values in the slice are guaranteed to be in a subset for which [`PartialOrd::partial_cmp`]"},{"DocComment":" forms a [total order], it's possible to sort the slice with `sort_unstable_by(|a, b|"},{"DocComment":" a.partial_cmp(b).unwrap())`."},{"DocComment":""},{"DocComment":" # Current implementation"},{"DocComment":""},{"DocComment":" The current implementation is based on [ipnsort] by Lukas Bergdoll and Orson Peters, which"},{"DocComment":" combines the fast average case of quicksort with the fast worst case of heapsort, achieving"},{"DocComment":" linear time on fully sorted and reversed inputs. On inputs with k distinct elements, the"},{"DocComment":" expected time to sort the data is *O*(*n* \\* log(*k*))."},{"DocComment":""},{"DocComment":" It is typically faster than stable sorting, except in a few special cases, e.g., when the"},{"DocComment":" slice is partially sorted."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" May panic if the implementation of [`Ord`] for `T` does not implement a [total order], or if"},{"DocComment":" the [`Ord`] implementation panics."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut v = [4, -5, 1, -3, 2];"},{"DocComment":""},{"DocComment":" v.sort_unstable();"},{"DocComment":" assert_eq!(v, [-5, -3, 1, 2, 4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [ipnsort]: https://github.com/Voultapher/sort-research-rs/tree/main/ipnsort"},{"DocComment":" [total order]: https://en.wikipedia.org/wiki/Total_order"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":10,"beg":{"line":3136,"col":11},"end":{"line":3136,"col":14}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":7690}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[7766,{"Ref":[{"Var":{"Free":0}},{"HashConsedValue":[7698,{"Slice":{"Deduplicated":7690}}]},"Mut"]}]}],"output":{"Deduplicated":593}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":6,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1238},"kind":"InherentImplBlock"}}},{"Ident":["windows",0]}],"span":{"data":{"file_id":10,"beg":{"line":1116,"col":4},"end":{"line":1116,"col":62}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns an iterator over all contiguous windows of length"},{"DocComment":" `size`. The windows overlap. If the slice is shorter than"},{"DocComment":" `size`, the iterator returns no values."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `size` is zero."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let slice = ['l', 'o', 'r', 'e', 'm'];"},{"DocComment":" let mut iter = slice.windows(3);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['l', 'o', 'r']);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['o', 'r', 'e']);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['r', 'e', 'm']);"},{"DocComment":" assert!(iter.next().is_none());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If the slice is shorter than `size`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let slice = ['f', 'o', 'o'];"},{"DocComment":" let mut iter = slice.windows(4);"},{"DocComment":" assert!(iter.next().is_none());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because the [Iterator] trait cannot represent the required lifetimes,"},{"DocComment":" there is no `windows_mut` analog to `windows`;"},{"DocComment":" `[0,1,2].windows_mut(2).collect()` would violate [the rules of references]"},{"DocComment":" (though a [LendingIterator] analog is possible). You can sometimes use"},{"DocComment":" [`Cell::as_slice_of_cells`](crate::cell::Cell::as_slice_of_cells) in"},{"DocComment":" conjunction with `windows` instead:"},{"DocComment":""},{"DocComment":" [the rules of references]: https://doc.rust-lang.org/book/ch04-02-references-and-borrowing.html#the-rules-of-references"},{"DocComment":" [LendingIterator]: https://blog.rust-lang.org/2022/10/28/gats-stabilization.html"},{"DocComment":" ```"},{"DocComment":" use std::cell::Cell;"},{"DocComment":""},{"DocComment":" let mut array = ['R', 'u', 's', 't', ' ', '2', '0', '1', '5'];"},{"DocComment":" let slice = &mut array[..];"},{"DocComment":" let slice_of_cells: &[Cell<char>] = Cell::from_mut(slice).as_slice_of_cells();"},{"DocComment":" for w in slice_of_cells.windows(3) {"},{"DocComment":"     Cell::swap(&w[0], &w[2]);"},{"DocComment":" }"},{"DocComment":" assert_eq!(array, ['s', 't', ' ', '2', '0', '1', '5', 'u', 'R']);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":fals