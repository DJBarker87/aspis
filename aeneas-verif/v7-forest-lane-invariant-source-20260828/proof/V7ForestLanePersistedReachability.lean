namespace V7ForestLaneInvariantGenerated

/-- A successful fast image is byte-for-byte the strict canonical image once
    the mathematical invariant has discharged the omitted reconstruction. -/
def ByteExactStrictLaneImage
    (lane : LaneState)
    (empty_roots : Array Digest 21#usize) : Prop :=
  ∃ bytes : Array Std.U8 768#usize,
    fast_encode_projected lane empty_roots true = ok (.Ok bytes) ∧
      strict_encode_projected lane empty_roots true = ok (.Ok bytes)

theorem checked_deposit_success_has_byte_exact_strict_image
    (before after out : LaneState)
    (append_checked : Bool)
    (empty_roots : Array Digest 21#usize)
    (hrun :
      apply_production_lane_write
          (.CheckedDepositAppend before after append_checked) empty_roots =
        ok (.Ok out)) :
    ByteExactStrictLaneImage out empty_roots := by
  have relation := checked_deposit_success_has_exact_source_relation
    before after out append_checked empty_roots hrun
  rw [relation.output_eq]
  rcases relation.fast_image_exists with ⟨bytes, hfast⟩
  exact ⟨bytes, hfast,
    fast_encoder_bytes_are_strict_encoder_bytes after empty_roots bytes hfast⟩

theorem authenticated_settlement_success_has_byte_exact_strict_image
    (before after out : LaneState)
    (asr8_authenticated : Bool)
    (empty_roots : Array Digest 21#usize)
    (hrun :
      apply_production_lane_write
          (.AuthenticatedAsr8Settlement before after asr8_authenticated)
          empty_roots = ok (.Ok out)) :
    ByteExactStrictLaneImage out empty_roots := by
  have relation := authenticated_settlement_success_has_exact_source_relation
    before after out asr8_authenticated empty_roots hrun
  rw [relation.output_eq]
  rcases relation.fast_image_exists with ⟨bytes, hfast⟩
  exact ⟨bytes, hfast,
    fast_encoder_bytes_are_strict_encoder_bytes after empty_roots bytes hfast⟩

/-- Exact translated reachability generated by the exhaustive three-way
    production writer projection.  Checkpoint has no constructor because the
    source audit proves that it cannot write lane data. -/
inductive TranslatedPersistedLaneReachable
    (empty_roots : Array Digest 21#usize) : LaneState → Prop where
  | initialized
      (master : Array Std.U8 32#usize)
      (lane_id : Std.U8)
      (out : LaneState)
      (hrun : apply_production_lane_write (.Initialize master lane_id)
        empty_roots = ok (.Ok out)) :
      TranslatedPersistedLaneReachable empty_roots out
  | checkedDeposit
      {before after out : LaneState}
      (append_checked : Bool)
      (sourceReachable : TranslatedPersistedLaneReachable empty_roots before)
      (hrun : apply_production_lane_write
        (.CheckedDepositAppend before after append_checked) empty_roots =
          ok (.Ok out)) :
      TranslatedPersistedLaneReachable empty_roots out
  | authenticatedSettlement
      {before after out : LaneState}
      (asr8_authenticated : Bool)
      (sourceReachable : TranslatedPersistedLaneReachable empty_roots before)
      (hrun : apply_production_lane_write
        (.AuthenticatedAsr8Settlement before after asr8_authenticated)
          empty_roots = ok (.Ok out)) :
      TranslatedPersistedLaneReachable empty_roots out

def TranslatedGenesisLaneOutput
    (empty_roots : Array Digest 21#usize)
    (out : LaneState) : Prop :=
  ∃ master lane_id,
    apply_production_lane_write (.Initialize master lane_id) empty_roots =
      ok (.Ok out)

def TranslatedAuthenticatedTransitionOutput
    (empty_roots : Array Digest 21#usize)
    (out : LaneState) : Prop :=
  (∃ before after append_checked,
      TranslatedPersistedLaneReachable empty_roots before ∧
      apply_production_lane_write
          (.CheckedDepositAppend before after append_checked) empty_roots =
        ok (.Ok out) ∧
      ByteExactStrictLaneImage out empty_roots) ∨
  (∃ before after asr8_authenticated,
      TranslatedPersistedLaneReachable empty_roots before ∧
      apply_production_lane_write
          (.AuthenticatedAsr8Settlement before after asr8_authenticated)
          empty_roots = ok (.Ok out) ∧
      ByteExactStrictLaneImage out empty_roots)

/-- Source-level induction: every reachable persisted lane is a genesis output
    or the byte-exact output of a checked deposit/authenticated ASR8 write. -/
theorem translated_reachable_is_genesis_or_byte_exact_authenticated_output
    (empty_roots : Array Digest 21#usize)
    (out : LaneState)
    (reachable : TranslatedPersistedLaneReachable empty_roots out) :
    TranslatedGenesisLaneOutput empty_roots out ∨
      TranslatedAuthenticatedTransitionOutput empty_roots out := by
  cases reachable with
  | initialized master lane_id out hrun =>
      exact Or.inl ⟨master, lane_id, hrun⟩
  | checkedDeposit append_checked sourceReachable hrun =>
      exact Or.inr (Or.inl ⟨_, _, append_checked, sourceReachable, hrun,
        checked_deposit_success_has_byte_exact_strict_image _ _ _ _ _ hrun⟩)
  | authenticatedSettlement asr8_authenticated sourceReachable hrun =>
      exact Or.inr (Or.inr ⟨_, _, asr8_authenticated, sourceReachable, hrun,
        authenticated_settlement_success_has_byte_exact_strict_image
          _ _ _ _ _ hrun⟩)

/-- Instantiating the named mathematical capability closes the source
    induction for every reachable translated output. -/
theorem translated_reachable_preserves_program_owned_invariant
    (capability : ProgramOwnedLaneInvariantCapability)
    (empty_roots : Array Digest 21#usize)
    (out : LaneState)
    (reachable : TranslatedPersistedLaneReachable empty_roots out) :
    capability.Holds out := by
  induction reachable with
  | initialized master lane_id out hrun =>
      exact translated_production_lane_write_preserves_program_owned_invariant
        capability (.Initialize master lane_id) empty_roots out True.intro hrun
  | checkedDeposit append_checked sourceReachable hrun sourceInvariant =>
      exact translated_production_lane_write_preserves_program_owned_invariant
        capability (.CheckedDepositAppend _ _ append_checked) empty_roots _
          sourceInvariant hrun
  | authenticatedSettlement asr8_authenticated sourceReachable
      hrun sourceInvariant =>
      exact translated_production_lane_write_preserves_program_owned_invariant
        capability (.AuthenticatedAsr8Settlement _ _ asr8_authenticated)
          empty_roots _ sourceInvariant hrun

