InvalidQuerySchedule)?;\n        combined[ordinal] =\n            gamma_combine_v6_packed_layer0(record.c1_packed, record.c2_packed, powers)?;\n        entries.push((\n            query,\n            private_leaf_hash_v7(hash, V7_C1_TREE_TAG, record.c1_packed, record.salt),\n            private_leaf_hash_v7(hash, V7_C2_TREE_TAG, record.c2_packed, record.salt),\n        ));\n    }\n    let mut level = Vec::with_capacity(V6_QUERY_COUNT);\n    let mut next = Vec::with_capacity(V6_QUERY_COUNT);\n    if !verify_two_minimal_subtrees_v7_bytes(\n        hash,\n        (wire.c1_root, wire.c2_root),\n        18,\n        &entries,\n        (wire.c1_frontier, wire.c2_frontier),\n        &mut level,\n        &mut next,\n    ) {\n        return Err(V6WireError::MerkleMismatch);\n    }\n    Ok(combined)\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[446,{"FnPtr":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"skip_binder":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[443,{"Ref":[{"Var":{"Bound":[0,0]}},{"HashConsedValue":[442,{"Slice":{"HashConsedValue":[441,{"Ref":[{"Var":{"Bound":[0,1]}},{"Deduplicated":440},"Shared"]}]}}]},"Shared"]}]}],"output":{"Deduplicated":445}}}}]},{"HashConsedValue":[7521,{"Ref":[{"Var":{"Free":0}},{"HashConsedValue":[7520,{"Adt":{"id":{"Adt":0},"generics":{"regions":[{"Var":{"Free":1}}],"types":[],"const_generics":[],"trait_refs":[]}}}]},"Shared"]}]},{"Deduplicated":469},{"HashConsedValue":[7522,{"Ref"