dent":["SliceIndex",0]},{"Ident":["get_mut",0]}],"span":{"data":{"file_id":62,"beg":{"line":176,"col":4},"end":{"line":176,"col":65}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a mutable reference to the output at this location, if in"},{"DocComment":" bounds."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":7446},{"HashConsedValue":[7512,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":7447},"Mut"]}]}],"output":{"HashConsedValue":[7514,{"Adt":{"id":{"Adt":12},"generics":{"regions":[],"types":[{"HashConsedValue":[7513,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":7477},"Mut"]}]}],"const_generics":[],"trait_refs":[]}}}]}},"default":null},"kind":{"TraitMethod":[23,1]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"get_unchecked","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Ident":["SliceIndex",0]},{"Ident":["get_unchecked",0]}],"span":{"data":{"file_id":62,"beg":{"line":186,"col":4},"end":{"line":186,"col":74}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a pointer to the output at this location, without"},{"DocComment":" performing any bounds checking."},{"DocComment":""},{"DocComment":" Calling this method with an out-of-bounds index or a dangling `slice` pointer"},{"DocComment":" is *[undefined behavior]* even if the resulting pointer is not used."},{"DocComment":""},{"DocComment":" [undefined behavior]: https://doc.rust-lang.org/reference/behavior-considered-undefined.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated