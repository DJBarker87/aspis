| node_bytes.0.len() % V7_MERKLE_DIGEST_BYTES != 0\n        || node_bytes.1.len() % V7_MERKLE_DIGEST_BYTES != 0\n        || node_bytes.0.len() != node_bytes.1.len()\n    {\n        return false;\n    }\n    if entries.windows(2).any(|pair| pair[0].0 >= pair[1].0)\n        || entries.last().unwrap().0 >= (1u32 << depth)\n    {\n        return false;\n    }\n\n    let mut node_pos = 0usize;\n    level.clear();\n    level.extend_from_slice(entries);\n    for _ in 0..depth {\n        next.clear();\n        let mut index = 0usize;\n        while index < level.len() {\n            let (position, c1, c2) = level[index];\n            let parent = if position & 1 == 0\n                && index + 1 < level.len()\n                && level[index + 1].0 == position + 1\n            {\n                let (_, c1_right, c2_right) = level[index + 1];\n                index += 2;\n                (\n                    node_hash_v7(hash, &c1, &c1_right),\n                    node_hash_v7(hash, &c2, &c2_right),\n                )\n            } else {\n                if node_pos + V7_MERKLE_DIGEST_BYTES > node_bytes.0.len() {\n                    return false;\n                }\n                let c1_sibling: V7Digest = node_bytes.0\n                    [node_pos..node_pos + V7_MERKLE_DIGEST_BYTES]\n                    .try_into()\n                    .unwrap();\n                let c2_sibling: V7Digest = node_bytes.1\n                    [node_pos..node_pos + V7_MERKLE_DIGEST_BYTES]\n                    .try_into()\n                    .unwrap();\n                node_pos += V7_MERKLE_DIGEST_BYTES;\n                index += 1;\n                if position & 1 == 0 {\n                    (\n                        node_hash_v7(hash, &c1, &c1_sibling),\n                        node_hash_v7(hash, &c2, &c2_sibling),\n                    )\n                } else {\n                    (\n                        node_hash_v7(hash, &c1_sibling, &c1),\n                        node_hash_v7(hash, &c2_sibling, &c2),\n                    )\n                }\n            };\n            next.push((position >> 1, parent.0, parent.1));\n        }\n        core::mem::swap(level, next);\n    }\n\n    node_pos == node_bytes.0.len()\n        && level.len() == 1\n        && level[0].0 == 0\n        && level[0].1 == *roots.0\n        && level[0].2 == *roots.1\n}","attr_info":{"attributes":[{"DocComment":" Verify both typed V7 trees over one sorted query topology. Hashes remain"},{"DocComment":" independent; only the public index walk and scratch allocation are shared."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"},{"index":3,"name":null,"mutability":"Unknown"},{"index":4,"name":null,"mutability":"Unknown"},{"index":5,"name":null,"mutability":"Unknown"},{"index":6,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":446},{"HashConsedValue":[7564,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":7442},{"HashConsedValue":[7563,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":1048},"Shared"]}]}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":468},{"HashConsedValue":[7565,{"Ref":[{"Var":{"Free":2}},{"Deduplicated":1284},"Shared"]}]},{"HashConsedValue":[7568,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"HashConsedValue":[7566,{"Ref":[{"Var":{"Free":3}},{"Deduplicated":440},"Shared"]}]},{"HashConsedValue":[7567,{"Ref":[{"Var":{"Free":4}},{"Deduplicated":440},"Shared"]}]}],"const_generics":[],"trait_refs":[]}}}]},{"HashConsedValue":[7569,{"Ref":[{"Var":{"Free":5}},{"Deduplicated":7196},"Mut"]}]},{"HashConsedValue":[7570,{"Ref":[{"