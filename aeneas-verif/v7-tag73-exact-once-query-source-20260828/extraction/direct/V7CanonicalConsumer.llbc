:[]},{"span":{"data":{"file_id":0,"beg":{"line":216,"col":1},"end":{"line":216,"col":1}},"generated_from_span":null},"id":1766,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":216,"col":1},"end":{"line":216,"col":1}},"generated_from_span":null},"id":1767,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":216,"col":1},"end":{"line":216,"col":1}},"generated_from_span":null},"id":2571,"kind":{"StorageDead":90},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":216,"col":1},"end":{"line":216,"col":1}},"generated_from_span":null},"id":2572,"kind":{"StorageDead":89},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":216,"col":1},"end":{"line":216,"col":1}},"generated_from_span":null},"id":2573,"kind":{"StorageDead":88},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":216,"col":1},"end":{"line":216,"col":1}},"generated_from_span":null},"id":2574,"kind":{"StorageDead":87},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":216,"col":1},"end":{"line":216,"col":1}},"generated_from_span":null},"id":1768,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":1,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["from_fn",0]}],"span":{"data":{"file_id":13,"beg":{"line":110,"col":0},"end":{"line":112,"col":52}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an array where each element is produced by calling `f` with"},{"DocComment":" that element's index while walking forward through the array."},{"DocComment":""},{"DocComment":" This is essentially the same as writing"},{"DocComment":" ```text"},{"DocComment":" [f(0), f(1), f(2), …, f(N - 2), f(N - 1)]"},{"DocComment":" ```"},{"DocComment":" and is similar to `(0..i).map(f)`, just for arrays not iterators."},{"DocComment":""},{"DocComment":" If `N == 0`, this produces an empty array without ever calling `f`."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" // type inference is helping us here, the way `from_fn` knows how many"},{"DocComment":" // elements to produce is the length of array down there: only arrays of"},{"DocComment":" // equal lengths can be compared, so the const generic parameter `N` is"},{"DocComment":" // inferred to be 5, thus creating array of 5 elements."},{"DocComment":""},{"DocComment":" let array = core::array::from_fn(|i| i);"},{"DocComment":" // indexes are:    0  1  2  3  4"},{"DocComment":" assert_eq!(array, [0, 1, 2, 3, 4]);"},{"DocComment":""},{"DocComment":" let array2: [usize; 8] = core::array::from_fn(|i| i * 2);"},{"DocComment":" // indexes are:     0  1  2  3  4  5   6   7"},{"DocComment":" assert_eq!(array2, [0, 2, 4, 6, 8, 10, 12, 14]);"},{"DocComment":""},{"DocComment":" let bool_arr = core::array::from_fn::<_, 5, _>(|i| i % 2 == 0);"},{"DocComment":" // indexes are:       0     1      2     3      4"},{"DocComment":" assert_eq!(bool_arr, [true, false, true, false, true]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also capture things, for example to create an array full of clones"},{"DocComment":" where you can't just use `[item; N]` because it's not `Copy`:"},{"DocComment":" ```"},{"DocComment":" let my_string: [String; 2] = std::array::from_fn(|i| format!(\"Hello {i}\"));"},{"DocComment":" assert_eq!(my_string, [\"Hello 0\", \"Hello 1\"]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The array is generated in ascending index order, starting from the front"},{"DocComment":" and going towards the back, so you can use closures with mutable state:"},{"DocComment":" ```"},{"DocComment":" let mut state = 1;"},{"DocComment":" let a = std::array::from_fn(|_| { let x = state; state *= 2; x });"},{"DocComment":" assert_eq!(a, [1, 2, 4, 8, 16, 32]);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"F"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":444}}],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":13,"beg":{"line":110,"col":24},"end":{"line":110,"col":40}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":7446}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":13,"beg":{"line":112,"col":7},"end":{"line":112,"col":32}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":7447},{"Deduplicated":1360},{"Deduplicated":7446}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":13,"beg":{"line":112,"col":35},"end":{"line":112,"col":51}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":7447}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":7447}],"output":{"HashConsedValue":[7466,{"Array":[{"Deduplicated":7446},{"kind":{"Var":{"Free":0}},"ty":{"Deduplicated":444}}]}]}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":2,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1524},"kind":"InherentImplBlock"}}},{"Ident":["sort_unstable_by_key",0]}],"span":{"data":{"file_id":8,"beg":{"line":3241,"col":4},"end":{"line":3244,"col":15}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Sorts the slice in ascending order with a key extraction function, **without** preserving"},{"DocComment":" the initial order of equal elements."},{"DocComment":""},{"DocComment":" This sort is unstable (i.e., may reorder equal elements), in-place (i.e., does not"},{"DocComment":" allocate), and *O*(*n* \\* log(*n*)) worst-case."},{"DocComment":""},{"DocComment":" If the implementation of [`Ord`] for `K` does not implement a [total order], the function"},{"DocComment":" may panic; even if the function exits normally, the resulting order of elements in the slice"},{"DocComment":" is unspecified. See also the note on panicking below."},{"DocComment":""},{"DocComment":" For example `|a, b| (a - b).cmp(a)` is a comparison function that is neither transitive nor"},{"DocComment":" reflexive nor total, `a < b < c < a` with `a = 1, b = 2, c = 3`. For more information and"},{"DocComment":" examples see the [`Ord`] documentation."},{"DocComment":""},{"DocComment":" All original elements will remain in the slice and any possible modifications via interior"},{"DocComment":" mutability are observed in the input. Same is true if the implementation of [`Ord`] for `K` panics."},{"DocComment":""},{"DocComment":" # Current implementation"},{"DocComment":""},{"DocComment":" The current implementation is based on [ipnsort] by Lukas Bergdoll and Orson Peters, which"},{"DocComment":" combines the fast average case of quicksort with the fast worst case of heapsort, achieving"},{"DocComment":" linear time on fully sorted and reversed inputs. On inputs with k distinct elements, the"},{"DocComment":" expected time to sort the data is *O*(*n* \\* log(*k*))."},{"DocComment":""},{"DocComment":" It is typically faster than stable sorting, except in a few special cases, e.g., when the"},{"DocComment":" slice is partially sorted."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" May panic if the implementation of [`Ord`] for `K` does not implement a [total order], or if"},{"DocComment":" the [`Ord`] implementation panics."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut v = [4i32, -5, 1, -3, 2];"},{"DocComment":""},{"DocComment":" v.sort_unstable_by_key(|k| k.abs());"},{"DocComment":" assert_eq!(v, [1, 2, -3, 4, -5]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [ipnsort]: https://github.com/Voultapher/sort-research-rs/tree/main/ipnsort"},{"DocComment":" [total order]: https://en.wikipedia.org/wiki/Total_order"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"},{"index":1,"name":"K"},{"index":2,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":8,"beg":{"line":3243,"col":11},"end":{"line":3243,"col":25}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"HashConsedValue":[7477,{"TypeVar":{"Free":2}}]},{"HashConsedValue":[7544,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"HashConsedValue":[7495,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":7446},"Shared"]}]}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":7447}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":8,"beg":{"line":3244,"col":11},"end":{"line":3244,"col":14}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":7447}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[7545,{"Ref":[{"Var":{"Free":0}},{"HashConsedValue":[7461,{"Slice":{"Deduplicated":7446}}]},"Mut"]}]},{"Deduplicated":7477}],"output":{"Deduplicated":818}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":3,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1524},"kind":"InherentImplBlock"}}},{"Ident":["windows",0]}],"span":{"data":{"file_id":8,"beg":{"line":1116,"col":4},"end":{"line":1116,"col":62}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns an iterator over all contiguous windows of length"},{"DocComment":" `size`. The windows overlap. If the slice is shorter than"},{"DocComment":" `size`, the iterator returns no values."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `size` is zero."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let slice = ['l', 'o', 'r', 'e', 'm'];"},{"DocComment":" let mut iter = slice.windows(3);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['l', 'o', 'r']);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['o', 'r', 'e']);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['r', 'e', 'm']);"},{"DocComment":" assert!(iter.next().is_none());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If the slice is shorter than `size`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let slice = ['f', 'o', 'o'];"},{"DocComment":" let mut iter = slice.windows(4);"},{"DocComment":" assert!(iter.next().is_none());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because the [Iterator] trait cannot represent the required lifetimes,"},{"DocComment":" there is no `windows_mut` analog to `windows`;"},{"DocComment":" `[0,1,2].windows_mut(2).collect()` would violate [the rules of references]"},{"DocComment":" (though a [LendingIterator] analog is possible). You can sometimes use"},{"DocComment":" [`Cell::as_slice_of_cells`](crate::cell::Cell::as_slice_of_cells) in"},{"DocComment":" conjunction with `windows` instead:"},{"DocComment":""},{"DocComment":" [the rules of references]: https://doc.rust-lang.org/book/ch04-02-references-and-borrowing.html#the-rules-of-references"},{"DocComment":" [LendingIterator]: https://blog.rust-lang.org/2022/10/28/gats-stabilization.html"},{"DocComment":" ```"},{"DocComment":" use std::cell::Cell;"},{"DocComment":""},{"DocComment":" let mut array = ['R', 'u', 's', 't', ' ', '2', '0', '1', '5'];"},{"DocComment":" let slice = &mut array[..];"},{"DocComment":" let slice_of_cells: &[Cell<char>] = Cell::from_mut(slice).as_slice_of_cells();"},{"DocComment":" for w in slice_of_cells.windows(3) {"},{"DocComment":"     Cell::swap(&w[0], &w[2]);"},{"DocComment":" }"},{"DocComment":" assert_eq!(array, ['s', 't', ' ', '2', '0', '1', '5', 'u', 'R']);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[7462,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":7461},"Shared"]}]},{"Deduplicated":444}],"output":{"HashConsedValue":[7460,{"Adt":{"id":{"Adt":7},"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":7446}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":4,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["any",0]}],"span":{"data":{"file_id":21,"beg":{"line":2885,"col":4},"end":{"line":2888,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Tests if any element of the iterator matches a predicate."},{"DocComment":""},{"DocComment":" `any()` takes a closure that returns `true` or `false`. It applies"},{"DocComment":" this closure to each element of the iterator, and if any of them return"},{"DocComment":" `true`, then so does `any()`. If they all return `false`, it"},{"DocComment":" returns `false`."},{"DocComment":""},{"DocComment":" `any()` is short-circuiting; in other words, it will stop processing"},{"DocComment":" as soon as it finds a `true`, given that no matter what else happens,"},{"DocComment":" the result will also be `true`."},{"DocComment":""},{"DocComment":" An empty iterator returns `false`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert!(a.into_iter().any(|x| x > 0));"},{"DocComment":""},{"DocComment":" assert!(!a.into_iter().any(|x| x > 5));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert!(iter.any(|x| x != 2));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"F"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regi