 may not return `None`. Here, they always will."},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"next"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[8224,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":8184},"Mut"]}]}],"output":{"HashConsedValue":[8225,{"Adt":{"id":{"Adt":4},"generics":{"regions":[],"types":[{"Deduplicated":8185}],"const_generics":[],"trait_refs":[]}}}]}},"default":null},"kind":{"TraitMethod":[0,0]}},null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],"vtable":{"id":{"Adt":8},"generics":{"regions":[],"types":[{"Deduplicated":8185}],"const_generics":[],"trait_refs":[]}}},{"def_id":1,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["range",0]},{"Ident":["Step",0]}],"span":{"data":{"file_id":15,"beg":{"line":34,"col":0},"end":{"line":34,"col":64}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Objects that have a notion of *successor* and *predecessor* operations."},{"DocComment":""},{"DocComment":" The *successor* operation moves towards values that compare greater."},{"DocComment":" The *predecessor* operation moves towards values that compare lesser."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"range_step"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"claus