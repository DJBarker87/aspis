_i floor(log2(q[i] XOR q[i + 1]))`."},{"DocComment":""},{"DocComment":" This is the level-walk count written in terms of adjacent common prefixes:"},{"DocComment":" at level `l`, the number of active parents is one plus the number of"},{"DocComment":" adjacent pairs whose shifted indices still differ. It avoids rebuilding"},{"DocComment":" all eighteen parent levels for every rejected compact-query candidate."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[{"index":0,"name":"Q","ty":{"Deduplicated":463}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[5360,{"Array":[{"Deduplicated":464},{"kind":{"Var":{"Free":0}},"ty":{"Deduplicated":463}}]}]},{"HashConsedValue":[466,{"Literal":{"UInt":"U8"}}]}],"output":{"HashConsedValue":[503,{"Adt":{"id":{"Adt":0},"generics":{"regions":[],"types":[{"Deduplicated":463},{"HashConsedValue":[502,{"Adt":{"id":{"Adt":1},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":0,"beg":{"line":435,"col":0},"end":{"line":473,"col":1}},"generated_from_span":null},"bound_body_regions":40,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":0,"beg":{"line":438,"col":5},"end":{"line":438,"col":31}},"generated_from_span":null},"ty":{"Deduplicated":503}},{"index":1,"name":"queries","span":{"data":{"file_id":0,"beg":{"line":436,"col":4},"end":{"line":436,"col":15}},"generated_from_span":null},"ty":{"Deduplicated":5360}},{"index":2,"name":"depth","span":{"data":{"file_id":0,"beg":{"line":437,"col":4},"end":{"line":437,"col":9}},"generated_from_span":null},"ty":{"Deduplicated":466}},{"index":3,"name":null,"span":{"data":{"f