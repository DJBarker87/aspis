"attributes":[{"DocComment":" Minimal proof-carried append result for the one-terminal transaction."},{"DocComment":""},{"DocComment":" This is not the execution-time append experiment above.  The selected"},{"DocComment":" verifier has checked the twenty late Poseidon parents against the exact"},{"DocComment":" live snapshot and returns the resulting state.  The Pool performs only"},{"DocComment":" canonical byte validation, checks `next_pair_index = current + 1`, and"},{"DocComment":" persists these bytes atomically with history and the nullifier marker."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":35,"beg":{"line":117,"col":4},"end":{"line":117,"col":28}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"next_pair_index","ty":{"Deduplicated":2657}},{"span":{"data":{"file_id":35,"beg":{"line":118,"col":4},"end":{"line":118,"col":25}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"next_root","ty":{"Deduplicated":2874}},{"span":{"data":{"file_id":35,"beg":{"line":119,"col":4},"end":{"line":119,"col":63}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"next_frontier","ty":{"HashConsedValue":[6660,{"Array":[{"Deduplicated":2874},{"kind":{"Literal":{"Scalar":{"Unsigned":["Usize","20"]}}},"ty":{"Deduplicated":1179}}]}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":680,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[672,640,0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"No