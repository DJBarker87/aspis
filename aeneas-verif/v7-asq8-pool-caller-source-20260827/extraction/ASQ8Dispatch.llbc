:[[0,{"Unsigned":["U8","33"]}]]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":17,"item_meta":{"name":[{"Ident":["aspis_pool",0]},{"Ident":["pair_forest_dispatch",0]},{"Ident":["invoke_pair_forest_terminal_with_runtime_v1",0]},{"Ident":["closure",0]}],"span":{"data":{"file_id":0,"beg":{"line":210,"col":17},"end":{"line":210,"col":66}},"generated_from_span":null},"source_text":"|_| PoolV1ProgramError::InvalidVerifierReturnData","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"R"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"Closure":{"info":{"kind":"FnOnce","fn_once_impl":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":6654}],"const_generics":[],"trait_refs":[{"HashConsedValue":[6659,{"kind":{"BuiltinOrAuto":{"builtin_data":"RemovedAdtClause","parent_trait_refs":[],"types":[]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":6654}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"fn_mut_impl":null,"fn_impl":null,"signature":{"regions":[],"skip_binder":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[1889,{"Adt":{"id":{"Adt":16},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}],"output":{"HashConsedValue":[1011,{"Adt":{"id":{"Adt":8},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}}}}},"kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":18,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["manually_drop",0]},{"Ident":["ManuallyDrop",0]}],"span":{"data":{"file_id":26,"beg":{"line":161,"col":0},"end":{"line":161,"col":34}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper to inhibit the compiler from automatically calling `T`’s"},{"DocComment":" destructor. This wrapper is 0-cost."},{"DocComment":""},{"DocComment":" `ManuallyDrop<T>` is guaranteed to have the same layout and bit validity as"},{"DocComment":" `T`, and is subject to the same layout optimizations as `T`. As a"},{"DocComment":" consequence, it has *no effect* on the assumptions that the compiler makes"},{"DocComment":" about its contents. For example, initializing a `ManuallyDrop<&mut T>` with"},{"DocComment":" [`mem::zeroed`] is undefined behavior. If you need to handle uninitialized"},{"DocComment":" data, use [`MaybeUninit<T>`] instead."},{"DocComment":""},{"DocComment":" Note that accessing the value inside a `ManuallyDrop<T>` is safe. This means"},{"DocComment":" that a `ManuallyDrop<T>` whose content has been dropped must not be exposed"},{"DocComment":" through a public safe API. Correspondingly, `ManuallyDrop::drop` is unsafe."},{"DocComment":""},{"DocComment":" # `ManuallyDrop` and drop order"},{"DocComment":""},{"DocComment":" Rust has a well-defined [drop order] of values. To make sure that fields or"},{"DocComment":" locals are dropped in a specific order, reorder the declarations such that"},{"DocComment":" the implicit drop order is the correct one."},{"DocComment":""},{"DocComment":" It is possible to use `ManuallyDrop` to control the drop order, but this"},{"DocComment":" requires unsafe code and is hard to do correctly in the presence of"},{"DocComment":" unwinding."},{"DocComment":""},{"DocComment":" For example, if you want to make sure that a specific field is dropped after"},{"DocComment":" the others, make it the last field of a struct:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Context;"},{"DocComment":""},{"DocComment":" struct Widget {"},{"DocComment":"     children: Vec<Widget>,"},{"DocComment":"     // `context` will be dropped after `children`."},{"DocComment":"     // Rust guarantees that fields are dropped in the order of declaration."},{"DocComment":"     context: Context,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Interaction with `Box`"},{"DocComment":""},{"DocComment":" Currently, if you have a `ManuallyDrop<T>`, where the type `T` is a `Box` or"},{"DocComment":" contains a `Box` inside, then dropping the `T` followed by moving the"},{"DocComment":" `ManuallyDrop<T>` is [considered to be undefined"},{"DocComment":" behavior](https://github.com/rust-lang/unsafe-code-guidelines/issues/245)."},{"DocComment":" That is, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" let mut x = ManuallyDrop::new(Box::new(42));"},{"DocComment":" unsafe {"},{"DocComment":"     ManuallyDrop::drop(&mut x);"},{"DocComment":" }"},{"DocComment":" let y = x; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is [likely to change in the"},{"DocComment":" future](https://rust-lang.github.io/rfcs/3336-maybe-dangling.html). In the"},{"DocComment":" meantime, consider using [`MaybeUninit`] instead."},{"DocComment":""},{"DocComment":" # Safety hazards when storing `ManuallyDrop` in a struct or an enum."},{"DocComment":""},{"DocComment":" Special care is needed when all of the conditions below are met:"},{"DocComment":" * A struct or enum contains a `ManuallyDrop`."},{"DocComment":" * The `ManuallyDrop` is not inside a `union`."},{"DocComment":" * The struct or enum is part of public API, or is stored in a struct or an"},{"DocComment":"   enum that is part of public API."},{"DocComment":" * There is code that drops the contents of the `ManuallyDrop` field, and"},{"DocComment":"   this code is outside the struct or enum's `Drop` implementation."},{"DocComment":""},{"DocComment":" In particular, the following hazards may occur:"},{"DocComment":""},{"DocComment":" #### Storing generic types"},{"DocComment":""},{"DocComment":" If the `ManuallyDrop` contains a client-supplied generic type, the client"},{"DocComment":" might provide a `Box` as that type. This would cause undefined behavior when"},{"DocComment":" the struct or enum is later moved, as mentioned in the previous section. For"},{"DocComment":" example, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" pub struct BadOption<T> {"},{"DocComment":"     // Invariant: Has been dropped if `is_some` is false."},{"DocComment":"     value: ManuallyDrop<T>,"},{"DocComment":"     is_some: bool,"},{"DocComment":" }"},{"DocComment":" impl<T> BadOption<T> {"},{"DocComment":"     pub fn new(value: T) -> Self {"},{"DocComment":"         Self { value: ManuallyDrop::new(value), is_some: true }"},{"DocComment":"     }"},{"DocComment":"     pub fn change_to_none(&mut self) {"},{"DocComment":"         if self.is_some {"},{"DocComment":"             self.is_some = false;"},{"DocComment":"             unsafe {"},{"DocComment":"                 // SAFETY: `value` hasn't been dropped yet, as per the invariant"},{"DocComment":"                 // (This is actually unsound!)"},{"DocComment":"                 ManuallyDrop::drop(&mut self.value);"},{"DocComment":"             }"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let mut option = BadOption::new(Box::new(42));"},{"DocComment":" option.change_to_none();"},{"DocComment":" let option2 = option; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" #### Deriving traits"},{"DocComment":""},{"DocComment":" Deriving `Debug`, `Clone`, `PartialEq`, `PartialOrd`, `Ord`, or `Hash` on"},{"DocComment":" the struct or enum could be unsound, since the derived implementations of"},{"DocComment":" these traits would access the `ManuallyDrop` field. For example, the"},{"DocComment":" following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" // This derive is unsound in combination with the `ManuallyDrop::drop` call."},{"DocComment":" #[derive(Debug)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     value: ManuallyDrop<String>,"},{"DocComment":" }"},{"DocComment":" impl Foo {"},{"DocComment":"     pub fn new() -> Self {"},{"DocComment":"         let mut temp = Self {"},{"DocComment":"             value: ManuallyDrop::new(String::from(\"Unsafe rust is hard.\"))"},{"DocComment":"         };"},{"DocComment":"         unsafe {"},{"DocComment":"             // SAFETY: `value` hasn't been dropped yet."},{"DocComment":"             ManuallyDrop::drop(&mut temp.value);"},{"DocComment":"         }"},{"DocComment":"         temp"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let foo = Foo::new();"},{"DocComment":" println!(\"{:?}\", foo); // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [drop order]: https://doc.rust-lang.org/reference/destructors.html"},{"DocComment":" [`mem::zeroed`]: crate::mem::zeroed"},{"DocComment":" [`MaybeUninit<T>`]: crate::mem::MaybeUninit"},{"DocComment":" [`MaybeUninit`]: crate::mem::MaybeUninit"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"manually_drop"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":19,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_dangling",0]},{"Ident":["MaybeDangling",0]}],"span":{"data":{"file_id":27,"beg":{"line":74,"col":0},"end":{"line":74,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Allows wrapped [references] and [boxes] to dangle."},{"DocComment":""},{"DocComment":" That is, if a reference (or a `Box`) is wrapped in `MaybeDangling` (including when in a"},{"DocComment":" (nested) field of a compound type wrapped in `MaybeDangling`), it does not have to follow"},{"DocComment":" pointer aliasing rules or be dereferenceable."},{"DocComment":""},{"DocComment":" This can be useful when the value can become dangling while the function holding it is still"},{"DocComment":" executing (particularly in concurrent code). As a somewhat absurd example, consider this code:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" #![feature(box_as_ptr)]"},{"DocComment":" # use std::alloc::{dealloc, Layout};"},{"DocComment":" # use std::mem;"},{"DocComment":""},{"DocComment":" let mut boxed = Box::new(0_u32);"},{"DocComment":" let ptr = Box::as_mut_ptr(&mut boxed);"},{"DocComment":""},{"DocComment":" // Safety: the pointer comes from a box and thus was allocated before; `box` is not used afterwards"},{"DocComment":" unsafe { dealloc(ptr.cast(), Layout::new::<u32>()) };"},{"DocComment":""},{"DocComment":" mem::forget(boxed); // <-- this is UB!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Even though the `Box`'s destructor is not run (and thus we don't have a double free bug), this"},{"DocComment":" code is still UB. This is because when moving `boxed` into `forget`, its validity invariants"},{"DocComment":" are asserted, causing UB since the `Box` is dangling. The safety comment is as such wrong, as"},{"DocComment":" moving the `boxed` variable as part of the `forget` call *is* a use."},{"DocComment":""},{"DocComment":" To fix this we could use `MaybeDangling`:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" #![feature(maybe_dangling, box_as_ptr)]"},{"DocComment":" # use std::alloc::{dealloc, Layout};"},{"DocComment":" # use std::mem::{self, MaybeDangling};"},{"DocComment":""},{"DocComment":" let mut boxed = MaybeDangling::new(Box::new(0_u32));"},{"DocComment":" let ptr = Box::as_mut_ptr(boxed.as_mut());"},{"DocComment":""},{"DocComment":" // Safety: the pointer comes from a box and thus was allocated before; `box` is not used afterwards"},{"DocComment":" unsafe { dealloc(ptr.cast(), Layout::new::<u32>()) };"},{"DocComment":""},{"DocComment":" mem::forget(boxed); // <-- this is OK!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that the bit pattern must still be valid for the wrapped type. That is, [references]"},{"DocComment":" (and [boxes]) still must be aligned and non-null."},{"DocComment":""},{"DocComment":" Additionally note that safe code can still assume that the inner value in a `MaybeDangling` is"},{"DocComment":" **not** dangling -- functions like [`as_ref`] and [`into_inner`] are safe. It is not sound to"},{"DocComment":" return a dangling reference in a `MaybeDangling` to safe code. However, it *is* sound"},{"DocComment":" to hold such values internally inside your code -- and there's no way to do that without"},{"DocComment":" this type. Note that other types can use this type and thus get the same effect; in particular,"},{"DocComment":" [`ManuallyDrop`] will use `MaybeDangling`."},{"DocComment":""},{"DocComment":" Note that `MaybeDangling` doesn't prevent drops from being run, which can lead to UB if the"},{"DocComment":" drop observes a dangling value. If you need to prevent drops from being run use [`ManuallyDrop`]"},{"DocComment":" instead."},{"DocComment":""},{"DocComment":" [references]: prim@reference"},{"DocComment":" [boxes]: ../../std/boxed/struct.Box.html"},{"DocComment":" [`into_inner`]: MaybeDangling::into_inner"},{"DocComment":" [`as_ref`]: MaybeDangling::as_ref"},{"DocComment":" [`ManuallyDrop`]: crate::mem::ManuallyDrop"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"maybe_dangling"},"generics":{"regions":[],"types":[{"index":0,"name":"P"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},null,{"def_id":21,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["rc",0]},{"Ident":["Rc",0]}],"span":{"data":{"file_id":29,"beg":{"line":320,"col":0},"end":{"line":323,"col":1}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A single-threaded reference-counting pointer. 'Rc' stands for 'Reference"},{"DocComment":" Counted'."},{"DocComment":""},{"DocComment":" See the [module-level documentation](./index.html) for more details."},{"DocComment":""},{"DocComment":" The inherent methods of `Rc` are all associated functions, which means"},{"DocComment":" that you have to call them as e.g., [`Rc::get_mut(&mut value)`][get_mut] instead of"},{"DocComment":" `value.get_mut()`. This avoids conflicts with methods of the inner type `T`."},{"DocComment":""},{"DocComment":" [get_mut]: Rc::get_mut"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Rc"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":22,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["cell",0]},{"Ident":["RefCell",0]}],"span":{"data":{"file_id":30,"beg":{"line":849,"col":0},"end":{"line":849,"col":29}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A mutable memory location with dynamically checked borrow rules"},{"DocComment":""},{"DocComment":" See the [module-level documentation](self) for more."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"RefCell"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":23,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["string",0]},{"Ident":["String",0]}],"span":{"data":{"file_id":31,"beg":{"line":353,"col":0},"end":{"line":353,"col":17}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A UTF-8–encoded, growable string."},{"DocComment":""},{"DocComment":" `String` is the most common string type. It has ownership over the contents"},{"DocComment":" of the string, stored in a heap-allocated buffer (see [Representation](#representation))."},{"DocComment":" It is closely related to its borrowed counterpart, the primitive [`str`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" You can create a `String` from [a literal string][`&str`] with [`String::from`]:"},{"DocComment":""},{"DocComment":" [`String::from`]: From::from"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let hello = String::from(\"Hello, world!\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can append a [`char`] to a `String` with the [`push`] method, and"},{"DocComment":" append a [`&str`] with the [`push_str`] method:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut hello = String::from(\"Hello, \");"},{"DocComment":""},{"DocComment":" hello.push('w');"},{"DocComment":" hello.push_str(\"orld!\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`push`]: String::push"},{"DocComment":" [`push_str`]: String::push_str"},{"DocComment":""},{"DocComment":" If you have a vector of UTF-8 bytes, you can create a `String` from it with"},{"DocComment":" the [`from_utf8`] method:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // some bytes, in a vector"},{"DocComment":" let sparkle_heart = vec![240, 159, 146, 150];"},{"DocComment":""},{"DocComment":" // We know these bytes are valid, so we'll use `unwrap()`."},{"DocComment":" let sparkle_heart = String::from_utf8(sparkle_heart).unwrap();"},{"DocComment":""},{"DocComment":" assert_eq!(\"💖\", sparkle_heart);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`from_utf8`]: String::from_utf8"},{"DocComment":""},{"DocComment":" # UTF-8"},{"DocComment":""},{"DocComment":" `String`s are always valid UTF-8. If you need a non-UTF-8 string, consider"},{"DocComment":" [`OsString`]. It is similar, but without the UTF-8 constraint. Because UTF-8"},{"DocComment":" is a variable width encoding, `String`s are typically smaller than an array of"},{"DocComment":" the same `char`s:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // `s` is ASCII which represents each `char` as one byte"},{"DocComment":" let s = \"hello\";"},{"DocComment":" assert_eq!(s.len(), 5);"},{"DocComment":""},{"DocComment":" // A `char` array with the same contents would be longer because"},{"DocComment":" // every `char` is four bytes"},{"DocComment":" let s = ['h', 'e', 'l', 'l', 'o'];"},{"DocComment":" let size: usize = s.into_iter().map(|c| size_of_val(&c)).sum();"},{"DocComment":" assert_eq!(size, 20);"},{"DocComment":""},{"DocComment":" // However, for non-ASCII strings, the difference will be smaller"},{"DocComment":" // and sometimes they are the same"},{"DocComment":" let s = \"💖💖💖💖💖\";"},{"DocComment":" assert_eq!(s.len(), 20);"},{"DocComment":""},{"DocComment":" let s = ['💖', '💖', '💖', '💖', '💖'];"},{"DocComment":" let size: usize = s.into_iter().map(|c| size_of_val(&c)).sum();"},{"DocComment":" assert_eq!(size, 20);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This raises interesting questions as to how `s[i]` should work."},{"DocComment":" What should `i` be here? Several options include byte indices and"},{"DocComment":" `char` indices but, because of UTF-8 encoding, only byte indices"},{"DocComment":" would provide constant time indexing. Getting the `i`th `char`, for"},{"DocComment":" example, is available using [`chars`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = \"hello\";"},{"DocComment":" let third_character = s.chars().nth(2);"},{"DocComment":" assert_eq!(third_character, Some('l'));"},{"DocComment":""},{"DocComment":" let s = \"💖💖💖💖💖\";"},{"DocComment":" let third_character = s.chars().nth(2);"},{"DocComment":" assert_eq!(third_character, Some('💖'));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Next, what should `s[i]` return? Because indexing returns a reference"},{"DocComment":" to underlying data it could be `&u8`, `&[u8]`, or something similar."},{"DocComment":" Since we're only providing one index, `&u8` makes the most sense but that"},{"DocComment":" might not be what the user expects and can be explicitly achieved with"},{"DocComment":" [`as_bytes()`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // The first byte is 104 - the byte value of `'h'`"},{"DocComment":" let s = \"hello\";"},{"DocComment":" assert_eq!(s.as_bytes()[0], 104);"},{"DocComment":" // or"},{"DocComment":" assert_eq!(s.as_bytes()[0], b'h');"},{"DocComment":""},{"DocComment":" // The first byte is 240 which isn't obviously useful"},{"DocComment":" let s = \"💖💖💖💖💖\";"},{"DocComment":" assert_eq!(s.as_bytes()[0], 240);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Due to these ambiguities/restrictions, indexing with a `usize` is simply"},{"DocComment":" forbidden:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" let s = \"hello\";"},{"DocComment":""},{"DocComment":" // The following will not compile!"},{"DocComment":" println!(\"The first letter of s is {}\", s[0]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It is more clear, however, how `&s[i..j]` should work (that is,"},{"DocComment":" indexing with a range). It should accept byte indices (to be constant-time)"},{"DocComment":" and return a `&str` which is UTF-8 encoded. This is also called \"string slicing\"."},{"DocComment":" Note this will panic if the byte indices provided are not character"},{"DocComment":" boundaries - see [`is_char_boundary`] for more details. See the implementations"},{"DocComment":" for [`SliceIndex<str>`] for more details on string slicing. For a non-panicking"},{"DocComment":" version of string slicing, see [`get`]."},{"DocComment":""},{"DocComment":" [`OsString`]: ../../std/ffi/struct.OsString.html \"ffi::OsString\""},{"DocComment":" [`SliceIndex<str>`]: core::slice::SliceIndex"},{"DocComment":" [`as_bytes()`]: str::as_bytes"},{"DocComment":" [`get`]: str::get"},{"DocComment":" [`is_char_boundary`]: str::is_char_boundary"},{"DocComment":""},{"DocComment":" The [`bytes`] and [`chars`] methods return iterators over the bytes and"},{"DocComment":" codepoints of the string, respectively. To iterate over codepoints along"},{"DocComment":" with byte indices, use [`char_indices`]."},{"DocComment":""},{"DocComment":" [`bytes`]: str::bytes"},{"DocComment":" [`chars`]: str::chars"},{"DocComment":" [`char_indices`]: str::char_indices"},{"DocComment":""},{"DocComment":" # Deref"},{"DocComment":""},{"DocComment":" `String` implements <code>[Deref]<Target = [str]></code>, and so inherits all of [`str`]'s"},{"DocComment":" methods. In addition, this means that you can pass a `String` to a"},{"DocComment":" function which takes a [`&str`] by using an ampersand (`&`):"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn takes_str(s: &str) { }"},{"DocComment":""},{"DocComment":" let s = String::from(\"Hello\");"},{"DocComment":""},{"DocComment":" takes_str(&s);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will create a [`&str`] from the `String` and pass it in. This"},{"DocComment":" conversion is very inexpensive, and so generally, functions will accept"},{"DocComment":" [`&str`]s as arguments unless they need a `String` for some specific"},{"DocComment":" reason."},{"DocComment":""},{"DocComment":" In certain cases Rust doesn't have enough information to make this"},{"DocComment":" conversion, known as [`Deref`] coercion. In the following example a string"},{"DocComment":" slice [`&'a str`][`&str`] implements the trait `TraitExample`, and the function"},{"DocComment":" `example_func` takes anything that implements the trait. In this case Rust"},{"DocComment":" would need to make two implicit conversions, which Rust doesn't have the"},{"DocComment":" means to do. For that reason, the following example will not compile."},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" trait TraitExample {}"},{"DocComment":""},{"DocComment":" impl<'a> TraitExample for &'a str {}"},{"DocComment":""},{"DocComment":" fn example_func<A: TraitExample>(example_arg: A) {}"},{"DocComment":""},{"DocComment":" let example_string = String::from(\"example_string\");"},{"DocComment":" example_func(&example_string);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are two options that would work instead. The first would be to"},{"DocComment":" change the line `example_func(&example_string);` to"},{"DocComment":" `example_func(example_string.as_str());`, using the method [`as_str()`]"},{"DocComment":" to explicitly extract the string slice containing the string. The second"},{"DocComment":" way changes `example_func(&example_string);` to"},{"DocComment":" `example_func(&*example_string);`. In this case we are dereferencing a"},{"DocComment":" `String` to a [`str`], then referencing the [`str`] back to"},{"DocComment":" [`&str`]. The second way is more idiomatic, however both work to do the"},{"DocComment":" conversion explicitly rather than relying on the implicit conversion."},{"DocComment":""},{"DocComment":" # Representation"},{"DocComment":""},{"DocComment":" A `String` is made up of three components: a pointer to some bytes, a"},{"DocComment":" length, and a capacity. The pointer points to the internal buffer which `String`"},{"DocComment":" uses to store its data. The length is the number of bytes currently stored"},{"DocComment":" in the buffer, and the capacity is the size of the buffer in bytes. As such,"},{"DocComment":" the length will always be less than or equal to the capacity."},{"DocComment":""},{"DocComment":" This buffer is always stored on the heap."},{"DocComment":""},{"DocComment":" You can look at these with the [`as_ptr`], [`len`], and [`capacity`]"},{"DocComment":" methods:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let story = String::from(\"Once upon a time...\");"},{"DocComment":""},{"DocComment":" // Deconstruct the String into parts."},{"DocComment":" let (ptr, len, capacity) = story.into_raw_parts();"},{"DocComment":""},{"DocComment":" // story has nineteen bytes"},{"DocComment":" assert_eq!(19, len);"},{"DocComment":""},{"DocComment":" // We can re-build a String out of ptr, len, and capacity. This is all"},{"DocComment":" // unsafe because we are responsible for making sure the components are"},{"DocComment":" // valid:"},{"DocComment":" let s = unsafe { String::from_raw_parts(ptr, len, capacity) } ;"},{"DocComment":""},{"DocComment":" assert_eq!(String::from(\"Once upon a time...\"), s);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`as_ptr`]: str::as_ptr"},{"DocComment":" [`len`]: String::len"},{"DocComment":" [`capacity`]: String::capacity"},{"DocComment":""},{"DocComment":" If a `String` has enough capacity, adding elements to it will not"},{"DocComment":" re-allocate. For example, consider this program:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut s = String::new();"},{"DocComment":""},{"DocComment":" println!(\"{}\", s.capacity());"},{"DocComment":""},{"DocComment":" for _ in 0..5 {"},{"DocComment":"     s.push_str(\"hello\");"},{"DocComment":"     println!(\"{}\", s.capacity());"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will output the following:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" 0"},{"DocComment":" 8"},{"DocComment":" 16"},{"DocComment":" 16"},{"DocComment":" 32"},{"DocComment":" 32"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" At first, we have no memory allocated at all, but as we append to the"},{"DocComment":" string, it increases its capacity appropriately. If we instead use the"},{"DocComment":" [`with_capacity`] method to allocate the correct capacity initially:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut s = String::with_capacity(25);"},{"DocComment":""},{"DocComment":" println!(\"{}\", s.capacity());"},{"DocComment":""},{"DocComment":" for _ in 0..5 {"},{"DocComment":"     s.push_str(\"hello\");"},{"DocComment":"     println!(\"{}\", s.capacity());"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`with_capacity`]: String::with_capacity"},{"DocComment":""},{"DocComment":" We end up with a different output:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Here, there's no need to allocate more memory inside the loop."},{"DocComment":""},{"DocComment":" [str]: prim@str \"str\""},{"DocComment":" [`str`]: prim@str \"str\""},{"DocComment":" [`&str`]: prim@str \"&str\""},{"DocComment":" [Deref]: core::ops::Deref \"ops::Deref\""},{"DocComment":" [`Deref`]: core::ops::Deref \"ops::Deref\""},{"DocComment":" [`as_str()`]: String::as_str"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"String"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":24,"item_meta":{"name":[{"Ident":["aspis_statement",0]},{"Ident":["pool_v1",0]},{"Ident":["historical_anchor",0]},{"Ident":["PoolV1TransitionKind",0]}],"span":{"data":{"file_id":32,"beg":{"line":32,"col":0},"end":{"line":32,"col":29}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Spend shapes that consume an authenticated historical anchor."},{"DocComment":""},{"DocComment":" Zero is deliberately invalid.  Deposit is absent because it consumes no"},{"DocComment":" private input and therefore must never authorize through this envelope."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":32,"beg":{"line":33,"col":4},"end":{"line":33,"col":19}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"PrivateTransfer","fields":[],"discriminant":{"Scalar":{"Unsigned":["U8","1"]}}},{"id":1,"span":{"data":{"file_id":32,"beg":{"line":34,"col":4},"end":{"line":34,"col":14}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"Withdrawal","fields":[],"discriminant":{"Scalar":{"Unsigned":["U8","2"]}}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":1,"align":1,"discriminator":{"Branch":{"offset":0,"int_ty":{"