            },
            "generated_from_span": null
          },
          "source_text": "pub fn inv(self) -> M31 {\n        assert!(self.0 != 0, \"inverse of zero\");\n\n        // Build x^(2^k - 1) at k = 2, 4, 8, 16, 24, 28, 29.\n        // The final exponent is 4*(2^29 - 1) + 1 = 2^31 - 3 = P - 2.\n        // This takes 38 M31 multiplications instead of the generic binary\n        // exponentiation's 61 for this fixed exponent.\n        let t2 = self.mul(self).mul(self);\n        let t4 = square_n(t2, 2).mul(t2);\n        let t8 = square_n(t4, 4).mul(t4);\n        let t16 = square_n(t8, 8).mul(t8);\n        let t24 = square_n(t16, 8).mul(t8);\n        let t28 = square_n(t24, 4).mul(t4);\n        let t29 = t28.mul(t28).mul(self);\n        let t30 = t29.mul(t29);\n        t30.mul(t30).mul(self)\n    }",
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Multiplicative inverse via a fixed addition chain for `P - 2`."
              },
              {
                "DocComment": " Panics on zero."
              }
            ],
            "inline": null,
            "rename": null,
            "public": true
          },
          "is_local": true,
          "opacity": "Transparent",
          "lang_item": null
        },
