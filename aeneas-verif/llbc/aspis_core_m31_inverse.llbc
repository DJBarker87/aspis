              }
            },
            "generated_from_span": null
          },
          "source_text": "pub fn inv_with(self, inverse: fn(M31) -> M31) -> CM31 {\n        let norm = self.a.mul(self.a).add(self.b.mul(self.b));\n        let inv_norm = inverse(norm);\n        CM31 {\n            a: self.a.mul(inv_norm),\n            b: self.b.neg().mul(inv_norm),\n        }\n    }",
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Inverse with an injected base-field inversion backend, without"
              },
              {
                "DocComment": " coupling the no_std verifier core to a particular runtime."
              }
            ],
            "inline": null,
            "rename": null,
            "public": true
          },
          "is_local": true,
          "opacity": "Transparent",
          "lang_item": null
        },
