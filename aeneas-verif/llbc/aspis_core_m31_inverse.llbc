            "generated_from_span": null
          },
          "source_text": "pub fn try_inv(self) -> Option<QM31> {\n        if self.is_zero() {\n            return None;\n        }\n        let norm = self.c0.square().sub(mul_by_r(self.c1.square()));\n        let inverse_norm = norm.inv();\n        Some(QM31 {\n            c0: self.c0.mul(inverse_norm),\n            c1: self.c1.neg().mul(inverse_norm),\n        })\n    }",
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Inverse in the quadratic extension over CM31:"
              },
              {
                "DocComment": " `(a + bu)^-1 = (a - bu) / (a^2 - (2+i)b^2)`."
              }
            ],
            "inline": null,
            "rename": null,
            "public": true
          },
          "is_local": true,
          "opacity": "Transparent",
          "lang_item": null
        },
