            "generated_from_span": null
          },
          "source_text": "pub fn square(self) -> CM31 {\n        CM31 {\n            a: self.a.add(self.b).mul(self.a.sub(self.b)),\n            b: self.a.mul(self.b).double(),\n        }\n    }",
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Complex squaring with two M31 multiplications instead of the three"
              },
              {
                "DocComment": " used by generic Karatsuba multiplication."
              }
            ],
            "inline": "Always",
            "rename": null,
            "public": true
          },
          "is_local": true,
          "opacity": "Transparent",
          "lang_item": null
