                "source_text": null,
                "attr_info": {
                  "attributes": [
                    {
                      "DocComment": " Returns the value that would be obtained by taking the *successor*"
                    },
                    {
                      "DocComment": " of `self` `count` times."
                    },
                    {
                      "DocComment": ""
                    },
                    {
                      "DocComment": " If this would overflow the range of values supported by `Self`, returns `None`."
                    },
                    {
                      "DocComment": ""
                    },
                    {
                      "DocComment": " # Invariants"
                    },
                    {
                      "DocComment": ""
                    },
                    {
                      "DocComment": " For any `a`, `n`, and `m`:"
                    },
                    {
                      "DocComment": ""
                    },
                    {
                      "DocComment": " * `Step::forward_checked(a, n).and_then(|x| Step::forward_checked(x, m)) == Step::forward_checked(a, m).and_then(|x| Step::forward_checked(x, n))`"
                    },
                    {
                      "DocComment": " * `Step::forward_checked(a, n).and_then(|x| Step::forward_checked(x, m)) == try { Step::forward_checked(a, n.checked_add(m)) }`"
                    },
                    {
                      "DocComment": ""
                    },
                    {
                      "DocComment": " For any `a` and `n`:"
                    },
                    {
                      "DocComment": ""
                    },
                    {
                      "DocComment": " * `Step::forward_checked(a, n) == (0..n).try_fold(a, |x, _| Step::forward_checked(&x, 1))`"
                    },
                    {
                      "DocComment": "   * Corollary: `Step::forward_checked(a, 0) == Some(a)`"
                    }
                  ],
                  "inline": null,
                  "rename": null,
                  "public": true
                },
                "is_local": false,
                "opacity": "Foreign",
