          },
          "source_text": "fn mul_by_r(x: CM31) -> CM31 {\n    // (2 + i)(a + bi) = (2a - b) + (a + 2b) i\n    CM31 {\n        a: x.a.double().sub(x.b),\n        b: x.a.add(x.b.double()),\n    }\n}",
          "attr_info": {
            "attributes": [
              {
                "DocComment": " The non-residue R = 2 + i used to define QM31."
              }
            ],
            "inline": "Always",
            "rename": null,
            "public": false
          },
          "is_local": true,
          "opacity": "Transparent",
          "lang_item": null
