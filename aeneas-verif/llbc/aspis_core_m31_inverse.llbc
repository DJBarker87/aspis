            "generated_from_span": null
          },
          "source_text": "pub fn mul(self, rhs: CM31) -> CM31 {\n        let m0 = self.a.mul(rhs.a);\n        let m1 = self.b.mul(rhs.b);\n        let m2 = self.a.add(self.b).mul(rhs.a.add(rhs.b));\n        CM31 {\n            a: m0.sub(m1),\n            b: m2.sub(m0).sub(m1),\n        }\n    }",
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Karatsuba complex multiplication: 3 M31 muls."
              }
            ],
            "inline": "Always",
            "rename": null,
            "public": true
          },
          "is_local": true,
          "opacity": "Transparent",
          "lang_item": null
        },
