          "attr_info": {
            "attributes": [
              {
                "DocComment": " A marker trait for primitive types which can be zero."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " This is an implementation detail for <code>[NonZero]\\<T></code> which may disappear or be replaced at any time."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Safety"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Types implementing this trait must be primitives that are valid when zeroed."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " The associated `Self::NonZeroInner` type must have the same size+align as `Self`,"
              },
              {
                "DocComment": " but with a niche and bit validity making it so the following `transmutes` are sound:"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " - `Self::NonZeroInner` to `Option<Self::NonZeroInner>`"
              },
              {
                "DocComment": " - `Option<Self::NonZeroInner>` to `Self`"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " (And, consequently, `Self::NonZeroInner` to `Self`.)"
              }
            ],
            "inline": null,
            "rename": null,
            "public": true
          },
          "is_local": false,
          "opacity": "Foreign",
          "lang_item": null
        },
