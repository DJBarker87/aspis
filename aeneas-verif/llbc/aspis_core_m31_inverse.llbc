              }
            },
            "generated_from_span": null
          },
          "source_text": "fn reduce_u64(x: u64) -> u32 {\n    // reference_canonical: two mask/shift folds bring any u64 to at most\n    // P+3, then one conditional subtract canonicalizes. Supporting the full\n    // u64 range lets four maximal M31 products be accumulated before one\n    // reduction: 4*(P-1)^2 < 2^64.\n    let x = (x & P as u64) + (x >> 31u32);\n    let x = (x & P as u64) + (x >> 31u32);\n    let x = x as u32;\n    if x >= P {\n        x - P\n    } else {\n        x\n    }\n}",
          "attr_info": {
            "attributes": [],
            "inline": "Always",
            "rename": null,
            "public": false
          },
          "is_local": true,
          "opacity": "Transparent",
          "lang_item": null
        },
