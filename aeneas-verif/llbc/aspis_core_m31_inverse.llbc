                0
              ]
            }
          ],
          "span": {
            "data": {
              "file_id": 6,
              "beg": {
                "line": 965,
                "col": 4
              },
              "end": {
                "line": 965,
                "col": 45
              }
            },
            "generated_from_span": null
          },
          "source_text": null,
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Returns the contained [`Some`] value, consuming the `self` value."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Panics"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Panics if the value is a [`None`] with a custom panic message provided by"
              },
              {
                "DocComment": " `msg`."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " let x = Some(\"value\");"
              },
              {
                "DocComment": " assert_eq!(x.expect(\"fruits are healthy\"), \"value\");"
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```should_panic"
              },
              {
                "DocComment": " let x: Option<&str> = None;"
              },
              {
                "DocComment": " x.expect(\"fruits are healthy\"); // panics with `fruits are healthy`"
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Recommended Message Style"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " We recommend that `expect` messages are used to describe the reason you"
              },
              {
                "DocComment": " _expect_ the `Option` should be `Some`."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```should_panic"
              },
              {
                "DocComment": " # let slice: &[u8] = &[];"
              },
              {
                "DocComment": " let item = slice.get(0)"
              },
              {
                "DocComment": "     .expect(\"slice should not be empty\");"
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " **Hint**: If you're having trouble remembering how to phrase expect"
              },
              {
                "DocComment": " error messages remember to focus on the word \"should\" as in \"env"
              },
              {
                "DocComment": " variable should be set by blah\" or \"the given binary should be available"
              },
              {
                "DocComment": " and executable by the current user\"."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " For more detail on expect message styles and the reasoning behind our"
              },
              {
                "DocComment": " recommendation please refer to the section on [\"Common Message"
              },
              {
                "DocComment": " Styles\"](../../std/error/index.html#common-message-styles) in the [`std::error`](../../std/error/index.html) module docs."
              }
            ],
            "inline": "Hint",
            "rename": null,
            "public": true
          },
          "is_local": false,
          "opacity": "Foreign",
          "lang_item": "option_expect"
