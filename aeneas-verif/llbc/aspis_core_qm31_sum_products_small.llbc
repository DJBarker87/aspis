   left[index].c0.a,\n                left[index].c0.b,\n                left[index].c0.a.add(left[index].c0.b),\n            ],\n            [\n                left[index].c1.a,\n                left[index].c1.b,\n                left[index].c1.a.add(left[index].c1.b),\n            ],\n            [left_sum.a, left_sum.b, left_sum.a.add(left_sum.b)],\n        ];\n        let right_components = [\n            [\n                right[index].c0.a,\n                right[index].c0.b,\n                right[index].c0.a.add(right[index].c0.b),\n            ],\n            [\n                right[index].c1.a,\n                right[index].c1.b,\n                right[index].c1.a.add(right[index].c1.b),\n            ],\n            [right_sum.a, right_sum.b, right_sum.a.add(right_sum.b)],\n        ];\n        for component in 0..3 {\n            for channel in 0..3 {\n                sums[component][channel] += left_components[component][channel].0 as u64\n                    * right_components[component][channel].0 as u64;\n            }\n        }\n    }\n\n    qm31_from_karatsuba_channel_sums(sums)\n}","attr_info":{"attributes":[{"DocComment":" Sum up to four QM31 products with one M31 reduction per Karatsuba channel."},{"DocComment":""},{"DocComment":" Each canonical M31 factor is at most `P - 1`, so four products satisfy"},{"DocComment":" `4 * (P - 1)^2 < 2^64`.  Accumulating the nine product channels before"},{"DocComment":" reconstructing CM31/QM31 is exact because reconstruction is M31-linear."},{"DocComment":" The fixed public arities below keep that overflow bound local and auditable."}],"inline":"Always","rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":434}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashCo