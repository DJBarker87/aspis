diff --git a/tests/src/mutable-iterator-handback.rs b/tests/src/mutable-iterator-handback.rs
index fe06be9a..484527f1 100644
--- a/tests/src/mutable-iterator-handback.rs
+++ b/tests/src/mutable-iterator-handback.rs
@@ -44,3 +44,35 @@ pub fn fill_with_direct_iter_mut(
     }
     Ok(())
 }
+
+pub struct BorrowedInput<'a> {
+    pub values: &'a [u32],
+}
+
+fn checked_from_prefix(
+    prefix: &[u32],
+    index: usize,
+    reject_at: usize,
+) -> Result<u32, FillError> {
+    if index == reject_at {
+        Err(FillError::Rejected)
+    } else {
+        Ok(prefix[index] + 1)
+    }
+}
+
+// The shared sub-slice creates a child abstraction whose parent is not fixed
+// across the mutable iterator loop. The child must follow its parent into the
+// non-fixed join suffix rather than being compared after only the parent id was
+// refreshed.
+pub fn fill_with_shared_parent_and_enumerated_iter_mut(
+    input: &BorrowedInput<'_>,
+    output: &mut [u32; 4],
+    reject_at: usize,
+) -> Result<(), FillError> {
+    let prefix = &input.values[..4];
+    for (index, slot) in output.iter_mut().enumerate() {
+        *slot = checked_from_prefix(prefix, index, reject_at)?;
+    }
+    Ok(())
+}
