def core.slice.sortInsert
    {T : Type} (ordInst : core.cmp.Ord T) (value : T) :
    (values : List T) →
      Result { output : List T // output.length = values.length + 1 }
  | [] => .ok ⟨[value], by simp⟩
  | head :: tail => do
      let ordering ← ordInst.cmp value head
      if ordering = .gt then
        let inserted ← core.slice.sortInsert ordInst value tail
        .ok ⟨head :: inserted.val, by simp [inserted.property]⟩
      else .ok ⟨value :: head :: tail, by simp⟩

def core.slice.sortList
    {T : Type} (ordInst : core.cmp.Ord T) :
    (values : List T) →
      Result { output : List T // output.length = values.length }
  | [] => .ok ⟨[], rfl⟩
  | head :: tail => do
      let sortedTail ← core.slice.sortList ordInst tail
      let inserted ← core.slice.sortInsert ordInst head sortedTail.val
      .ok ⟨inserted.val, by
        simpa [sortedTail.property] using inserted.property⟩

@[rust_fun "core::slice::{[@T]}::sort_unstable"]
def core.slice.Slice.sort_unstable
    {T : Type} (ordInst : core.cmp.Ord T) (slice : Slice T) :
    Result (Slice T) := do
  let sorted ← core.slice.sortList ordInst slice.val
  .ok ⟨sorted.val, by rw [sorted.property]; exact slice.property⟩

