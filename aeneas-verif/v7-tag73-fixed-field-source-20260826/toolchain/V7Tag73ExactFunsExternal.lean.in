def core.slice.iter.IterMut.Insts.CoreIterTraitsIteratorIteratorMutAT.any
    {T F : Type} (fnMut : core.ops.function.FnMut F T Bool)
    (iterator : core.slice.iter.IterMut T) (closure : F) :
