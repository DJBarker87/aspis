def core.iter.adapters.filter_map.FilterMap.nextLoop
    {B I F Item : Type}
    (iteratorInst : core.iter.traits.iterator.Iterator I Item)
    (fnMut : core.ops.function.FnMut F Item (Option B))
    (state : core.iter.adapters.filter_map.FilterMap I F) :
    Result (Option B × core.iter.adapters.filter_map.FilterMap I F) :=
  loop
    (fun current => do
      let (item, iteratorNext) ← iteratorInst.next current.iter
      match item with
      | none => .ok (.done (none, { current with iter := iteratorNext }))
      | some value =>
        let (mapped, closureNext) ← fnMut.call_mut current.f value
        let next := { iter := iteratorNext, f := closureNext }
        match mapped with
        | none => .ok (.cont next)
        | some output => .ok (.done (some output, next)))
    state

