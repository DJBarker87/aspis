@[rust_fun
  "core::array::iter::{core::iter::traits::iterator::Iterator<core::array::iter::IntoIter<@T, @N>, @T>}::next"]
def core.array.iter.IntoIter.Insts.CoreIterTraitsIteratorIterator.next
    {T : Type} {N : Std.Usize}
    (iterator : core.array.iter.IntoIter T N) :
    Result (Option T × core.array.iter.IntoIter T N) :=
  if h : iterator.index < iterator.array.val.length then
    .ok (some iterator.array.val[iterator.index],
      { iterator with index := iterator.index + 1 })
  else
    .ok (none, iterator)

def core.array.iter.IntoIter.foldAux
    {T Acc Fold : Type} {N : Std.Usize}
    (fnMut : core.ops.function.FnMut Fold (Acc × T) Acc) :
    Nat → core.array.iter.IntoIter T N → Acc → Fold → Result Acc
  | 0, _, accumulator, _ => .ok accumulator
  | fuel + 1, iterator, accumulator, closure => do
      let (item, iteratorNext) ←
        core.array.iter.IntoIter.Insts.CoreIterTraitsIteratorIterator.next
          iterator
      match item with
      | none => .ok accumulator
      | some value =>
        let (accumulatorNext, closureNext) ←
          fnMut.call_mut closure (accumulator, value)
        core.array.iter.IntoIter.foldAux fnMut fuel iteratorNext
          accumulatorNext closureNext

