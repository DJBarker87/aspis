  core.array.iter.IntoIter.foldAux fnMut
    (iterator.array.val.length - iterator.index + 1) iterator accumulator closure

@[trait_default, rust_fun "core::iter::traits::iterator::Iterator::any"]
def core.iter.traits.iterator.Iterator.any.default
    {Self F Item : Type}
    (iteratorInst : core.iter.traits.iterator.Iterator Self Item)
    (fnMut : core.ops.function.FnMut F Item Bool) :
    Self → F → Result (Bool × Self) :=
  fun iterator closure => do
    let result : Result (Bool × Self × F) :=
      loop
        (fun (iteratorState, closureState) => do
          let (item, iteratorNext) ← iteratorInst.next iteratorState
          match item with
          | none => .ok (.done (false, iteratorNext, closureState))
          | some value =>
            let (found, closureNext) ← fnMut.call_mut closureState value
            if found then .ok (.done (true, iteratorNext, closureNext))
            else .ok (.cont (iteratorNext, closureNext)))
        (iterator, closure)
    let (found, iteratorFinal, _) ← result
    .ok (found, iteratorFinal)

@[trait_default, rust_fun "core::iter::traits::iterator::Iterator::max"]
def core.iter.traits.iterator.Iterator.max.default
    {Self Item : Type}
    (iteratorInst : core.iter.traits.iterator.Iterator Self Item)
    (ordInst : core.cmp.Ord Item) (iterator : Self) :
    Result (Option Item) := do
  let (head, iteratorNext) ← iteratorInst.next iterator
  match head with
  | none => .ok none
  | some first =>
    loop
      (fun (state, best) => do
        let (item, stateNext) ← iteratorInst.next state
        match item with
        | none => .ok (.done (some best))
        | some value =>
          let takeValue ← ordInst.partialOrdInst.le best value
          .ok (.cont (stateNext, if takeValue then value else best)))
      (iteratorNext, first)

