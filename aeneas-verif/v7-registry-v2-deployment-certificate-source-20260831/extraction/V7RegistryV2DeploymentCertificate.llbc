a);\n    }\n    match observation.programdata_decode {\n        ProgramDataDecode::Immutable => {}\n        ProgramDataDecode::Mutable => return Err(DeploymentError::VerifierNotImmutable),\n        ProgramDataDecode::DecodeError | ProgramDataDecode::OtherVariant => {\n            return Err(DeploymentError::InvalidProgramData)\n        }\n    }\n\n    if observation.executable_sha256 == [0u8; 32] {\n        return Err(DeploymentError::InvalidProgramData);\n    }\n\n    Ok(ImmutableDeploymentCertificate {\n        program: observation.expected_program,\n        loader_v3: observation.loader_v3,\n        programdata_address: linked_programdata,\n        executable_sha256: observation.executable_sha256,\n    })\n}","attr_info":{"attributes":[{"DocComment":" Fixed-width projection of production"},{"DocComment":" `authenticate_immutable_loader_v3_deployment_v2` after the three named"},{"DocComment":" source primitives above have returned.  Branch order and errors follow"},{"DocComment":" `programs/aspis-registry/src/processor.rs:212-285`."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":360}],"output":{"Deduplicated":401}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":0,"beg":{"line":81,"col":0},"end":{"line":139,"col":1}},"generated_from_span":null},"bound_body_regions":40,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":0,"beg":{"line":83,"col":5},"end":{"line":83,"col":60}},"generated_from_span":null},"ty":{"Deduplicated":401}},{"index":1,"name":"observation","span":{"data":{"file_id":0,"beg":{"line":82,"col":4},"end":{"line":82,"col":15}},"generated_from_span":null},"ty":{"Deduplicated":360}},{"index":2