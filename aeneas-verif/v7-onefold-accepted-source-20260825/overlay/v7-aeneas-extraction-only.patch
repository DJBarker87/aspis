+/// Extraction-only schedule-explicit copy of the deployed acceptance kernel.
+/// The deployed root above calls the same parser, constructs the same context,
+/// and supplies the two frozen schedule functions at these two arguments.
+/// This wrapper is never compiled into the deployed SBF; it exists because the
+/// pinned Aeneas revision cannot synthesize a frozen borrow returned by an
+/// opaque static-schedule function.
+#[allow(clippy::too_many_arguments)]
+#[inline(always)]
+pub(crate) fn verify_v7_read_only_with_statement_digest_and_schedule(
+    hash: HashFn,
+    proof: &[u8],
+    frontier_nodes: usize,
+    program_id: &Pubkey,
+    release_binding: [u8; 32],
+    attempt_id: &Pubkey,
+    statement: &AtomicPaymentStatementV4,
+    statement_digest: [u8; 32],
+    inactive_row_groups: &[u8; 64],
+    inactive_group_masks: &[u16],
+    check_pow: bool,
+) -> Result<VerifiedV7ReadOnly, V7VerifyError> {
+    let wire = parse_v7_compact_onefold_wire_deferred(proof, frontier_nodes)?;
+    let context = V6TranscriptContext {
+        program_id: program_id.to_bytes(),
+        release_binding,
+        statement_digest,
+        attempt_id: attempt_id.to_bytes(),
+    };
+    let transcript = verify_v7_compact_transcript_and_relation_prepared(
+        hash,
+        &wire,
+        &context,
+        inactive_row_groups,
+        inactive_group_masks,
+        check_pow,
+        |view| crate::v6_verifier::terminal_matches(statement, view),
+        |view| authenticate_and_fold_queries(hash, &wire, view),
+    )?;
+    let folded_query_sum = transcript.folded_query_sum;
+    Ok(VerifiedV7ReadOnly {
+        transcript,
+        folded_query_sum,
+    })
+}
