+                       ( control_place,
+                         Use (mk_control_operand (code_for action), NoRetag) ))
+                in
+                let leave_current_loop =
+                  mk_statement original.span [] (Break 0)
+                in
+                [ set_control; leave_current_loop ]
+              in
+              let rec rewrite_block (block : block) : block =
+                {
