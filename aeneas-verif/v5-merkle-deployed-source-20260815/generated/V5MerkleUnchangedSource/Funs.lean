        vvpo.bytes_consumed i))
  | core.ops.control_flow.ControlFlow.Break residual =>
    core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
      private_openings.VerifiedV5PrivateOpenings (core.convert.FromSame
      private_openings.V5PrivateOpeningError) residual

end v5_merkle_fixed_hash_adapter
