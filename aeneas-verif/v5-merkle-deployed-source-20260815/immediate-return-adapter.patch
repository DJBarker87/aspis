+/// Fill the four children of one radix-four parent from left to right. This
+/// recursive spelling is extraction-only: it has the same first-error return
+/// point as the deployed inner loop, without lowering a return through nested
+/// loops to an unsupported outer-loop `continue` in Aeneas.
+fn fixed_fill_radix_children(
+    node_bytes: &[u8],
+    level: &[[u8; 32]],
+    present: u8,
+    slot: usize,
+    node_pos: usize,
+    value_pos: usize,
+    mut input: [u8; 129],
+) -> Option<([u8; 129], usize, usize)> {
+    if slot >= 4 {
+        return Some((input, node_pos, value_pos));
+    }
+
+    let (child, next_node_pos, next_value_pos) = if present & (1u8 << slot) != 0 {
+        let value = match level.get(value_pos).copied() {
+            Some(value) => value,
+            None => return None,
+        };
+        (value, node_pos, value_pos + 1)
+    } else {
+        if node_pos + 32 > node_bytes.len() {
+            return None;
+        }
+        let mut value = [0u8; 32];
+        let mut byte = 0usize;
+        while byte < 32 {
+            value[byte] = node_bytes[node_pos + byte];
+            byte += 1;
+        }
+        (value, node_pos + 32, value_pos)
+    };
+    fixed_write_radix_child(&mut input, slot, &child);
+    fixed_fill_radix_children(
+        node_bytes,
+        level,
+        present,
+        slot + 1,
+        next_node_pos,
+        next_value_pos,
+        input,
+    )
+}
