+fn fixed_hash_radix_levels(
+    topology: &Radix4BinaryCapTopology,
+    node_bytes: &[u8],
+    plan_level: usize,
+    node_pos: usize,
+    mut level: Vec<[u8; 32]>,
+    mut next: Vec<[u8; 32]>,
+) -> Option<(Vec<[u8; 32]>, Vec<[u8; 32]>, usize)> {
