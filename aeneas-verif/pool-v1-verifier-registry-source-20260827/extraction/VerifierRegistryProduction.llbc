ses_default":false}},"is_global_initializer":null,"body":"Opaque"},{"def_id":30,"item_meta":{"name":[{"Ident":["solana_pubkey",0]},{"Impl":{"Trait":22}},{"Ident":["as_ref",0]}],"span":{"data":{"file_id":2,"beg":{"line":991,"col":4},"end":{"line":991,"col":29}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":4234}],"output":{"Deduplicated":4332}},"src":{"TraitImpl":{"impl_ref":{"id":22,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}},"trait_ref":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":469},{"Deduplicated":1421}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":0},"reuses_default":true}},"is_global_initializer":null,"body":"Opaque"},{"def_id":31,"item_meta":{"name":[{"Ident":["solana_pubkey",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":469},"kind":"InherentImplBlock"}}},{"Ident":["find_program_address",0]}],"span":{"data":{"file_id":2,"beg":{"line":800,"col":4},"end":{"line":800,"col":85}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Find a valid [program derived address][pda] and its corresponding bump seed."},{"DocComment":""},{"DocComment":" [pda]: https://solana.com/docs/core/cpi#program-derived-addresses"},{"DocComment":""},{"DocComment":" Program derived addresses (PDAs) are account keys that only the program,"},{"DocComment":" `program_id`, has the authority to sign. The address is of the same form"},{"DocComment":" as a Solana `Pubkey`, except they are ensured to not be on the ed25519"},{"DocComment":" curve and thus have no associated private key. When performing"},{"DocComment":" cross-program invocations the program can \"sign\" for the key by calling"},{"DocComment":" [`invoke_signed`] and passing the same seeds used to generate the"},{"DocComment":" address, along with the calculated _bump seed_, which this function"},{"DocComment":" returns as the second tuple element. The runtime will verify that the"},{"DocComment":" program associated with this address is the caller and thus authorized"},{"DocComment":" to be the signer."},{"DocComment":""},{"DocComment":" [`invoke_signed`]: https://docs.rs/solana-program/latest/solana_program/program/fn.invoke_signed.html"},{"DocComment":""},{"DocComment":" The `seeds` are application-specific, and must be carefully selected to"},{"DocComment":" uniquely derive accounts per application requirements. It is common to"},{"DocComment":" use static strings and other pubkeys as seeds."},{"DocComment":""},{"DocComment":" Because the program address must not lie on the ed25519 curve, there may"},{"DocComment":" be seed and program id combinations that are invalid. For this reason,"},{"DocComment":" an extra seed (the bump seed) is calculated that results in a"},{"DocComment":" point off the curve. The bump seed must be passed as an additional seed"},{"DocComment":" when calling `invoke_signed`."},{"DocComment":""},{"DocComment":" The processes of finding a valid program address is by trial and error,"},{"DocComment":" and even though it is deterministic given a set of inputs it can take a"},{"DocComment":" variable amount of time to succeed across different inputs.  This means"},{"DocComment":" that when called from an on-chain program it may incur a variable amount"},{"DocComment":" of the program's compute budget.  Programs that are meant to be very"},{"DocComment":" performant may not want to use this function because it could take a"},{"DocComment":" considerable amount of time. Programs that are already at risk"},{"DocComment":" of exceeding their compute budget should call this with care since"},{"DocComment":" there is a chance that the program's budget may be occasionally"},{"DocComment":" and unpredictably exceeded."},{"DocComment":""},{"DocComment":" As all account addresses accessed by an on-chain Solana program must be"},{"DocComment":" explicitly passed to the program, it is typical for the PDAs to be"},{"DocComment":" derived in off-chain client programs, avoiding the compute cost of"},{"DocComment":" generating the address on-chain. The address may or may not then be"},{"DocComment":" verified by re-deriving it on-chain, depending on the requirements of"},{"DocComment":" the program. This verification may be performed without the overhead of"},{"DocComment":" re-searching for the bump key by using the [`create_program_address`]"},{"DocComment":" function."},{"DocComment":""},{"DocComment":" [`create_program_address`]: Pubkey::create_program_address"},{"DocComment":""},{"DocComment":" **Warning**: Because of the way the seeds are hashed there is a potential"},{"DocComment":" for program address collisions for the same program id.  The seeds are"},{"DocComment":" hashed sequentially which means that seeds {\"abcdef\"}, {\"abc\", \"def\"},"},{"DocComment":" and {\"ab\", \"cd\", \"ef\"} will all result in the same program address given"},{"DocComment":" the same program id. Since the chance of collision is local to a given"},{"DocComment":" program id, the developer of that program must take care to choose seeds"},{"DocComment":" that do not collide with each other. For seed schemes that are susceptible"},{"DocComment":" to this type of hash collision, a common remedy is to insert separators"},{"DocComment":" between seeds, e.g. transforming {\"abc\", \"def\"} into {\"abc\", \"-\", \"def\"}."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics in the statistically improbable event that a bump seed could not be"},{"DocComment":" found. Use [`try_find_program_address`] to handle this case."},{"DocComment":""},{"DocComment":" [`try_find_program_address`]: Pubkey::try_find_program_address"},{"DocComment":""},{"DocComment":" Panics if any of the following are true:"},{"DocComment":""},{"DocComment":" - the number of provided seeds is greater than, _or equal to_,  [`MAX_SEEDS`],"},{"DocComment":" - any individual seed's length is greater than [`MAX_SEED_LEN`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" This example illustrates a simple case of creating a \"vault\" account"},{"DocComment":" which is derived from the payer account, but owned by an on-chain"},{"DocComment":" program. The program derived address is derived in an off-chain client"},{"DocComment":" program, which invokes an on-chain Solana program that uses the address"},{"DocComment":" to create a new account owned and controlled by the program itself."},{"DocComment":""},{"DocComment":" By convention, the on-chain program will be compiled for use in two"},{"DocComment":" different contexts: both on-chain, to interpret a custom program"},{"DocComment":" instruction as a Solana transaction; and off-chain, as a library, so"},{"DocComment":" that clients can share the instruction data structure, constructors, and"},{"DocComment":" other common code."},{"DocComment":""},{"DocComment":" First the on-chain Solana program:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use borsh::{BorshSerialize, BorshDeserialize};"},{"DocComment":" # use solana_pubkey::Pubkey;"},{"DocComment":" # use solana_program::{"},{"DocComment":" #     entrypoint::ProgramResult,"},{"DocComment":" #     program::invoke_signed,"},{"DocComment":" #     system_instruction,"},{"DocComment":" #     account_info::{"},{"DocComment":" #         AccountInfo,"},{"DocComment":" #         next_account_info,"},{"DocComment":" #     },"},{"DocComment":" # };"},{"DocComment":" // The custom instruction processed by our program. It includes the"},{"DocComment":" // PDA's bump seed, which is derived by the client program. This"},{"DocComment":" // definition is also imported into the off-chain client program."},{"DocComment":" // The computed address of the PDA will be passed to this program via"},{"DocComment":" // the `accounts` vector of the `Instruction` type."},{"DocComment":" #[derive(BorshSerialize, BorshDeserialize, Debug)]"},{"DocComment":" # #[borsh(crate = \"borsh\")]"},{"DocComment":" pub struct InstructionData {"},{"DocComment":"     pub vault_bump_seed: u8,"},{"DocComment":"     pub lamports: u64,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // The size in bytes of a vault account. The client program needs"},{"DocComment":" // this information to calculate the quantity of lamports necessary"},{"DocComment":" // to pay for the account's rent."},{"DocComment":" pub static VAULT_ACCOUNT_SIZE: u64 = 1024;"},{"DocComment":""},{"DocComment":" // The entrypoint of the on-chain program, as provided to the"},{"DocComment":" // `entrypoint!` macro."},{"DocComment":" fn process_instruction("},{"DocComment":"     program_id: &Pubkey,"},{"DocComment":"     accounts: &[AccountInfo],"},{"DocComment":"     instruction_data: &[u8],"},{"DocComment":" ) -> ProgramResult {"},{"DocComment":"     let account_info_iter = &mut accounts.iter();"},{"DocComment":"     let payer = next_account_info(account_info_iter)?;"},{"DocComment":"     // The vault PDA, derived from the payer's address"},{"DocComment":"     let vault = next_account_info(account_info_iter)?;"},{"DocComment":""},{"DocComment":"     let mut instruction_data = instruction_data;"},{"DocComment":"     let instr = InstructionData::deserialize(&mut instruction_data)?;"},{"DocComment":"     let vault_bump_seed = instr.vault_bump_seed;"},{"DocComment":"     let lamports = instr.lamports;"},{"DocComment":"     let vault_size = VAULT_ACCOUNT_SIZE;"},{"DocComment":""},{"DocComment":"     // Invoke the system program to create an account while virtually"},{"DocComment":"     // signing with the vault PDA, which is owned by this caller program."},{"DocComment":"     invoke_signed("},{"DocComment":"         &system_instruction::create_account("},{"DocComment":"             &payer.key,"},{"DocComment":"             &vault.key,"},{"DocComment":"             lamports,"},{"DocComment":"             vault_size,"},{"DocComment":"             &program_id,"},{"DocComment":"         ),"},{"DocComment":"         &["},{"DocComment":"             payer.clone(),"},{"DocComment":"             vault.clone(),"},{"DocComment":"         ],"},{"DocComment":"         // A slice of seed slices, each seed slice being the set"},{"DocComment":"         // of seeds used to generate one of the PDAs required by the"},{"DocComment":"         // callee program, the final seed being a single-element slice"},{"DocComment":"         // containing the `u8` bump seed."},{"DocComment":"         &["},{"DocComment":"             &["},{"DocComment":"                 b\"vault\","},{"DocComment":"                 payer.key.as_ref(),"},{"DocComment":"                 &[vault_bump_seed],"},{"DocComment":"             ],"},{"DocComment":"         ]"},{"DocComment":"     )?;"},{"DocComment":""},{"DocComment":"     Ok(())"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The client program:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use borsh::{BorshSerialize, BorshDeserialize};"},{"DocComment":" # use solana_program::example_mocks::{solana_sdk, solana_rpc_client};"},{"DocComment":" # use solana_pubkey::Pubkey;"},{"DocComment":" # use solana_program::{"},{"DocComment":" #     instruction::Instruction,"},{"DocComment":" #     hash::Hash,"},{"DocComment":" #     instruction::AccountMeta,"},{"DocComment":" #     system_program,"},{"DocComment":" # };"},{"DocComment":" # use solana_sdk::{"},{"DocComment":" #     signature::Keypair,"},{"DocComment":" #     signature::{Signer, Signature},"},{"DocComment":" #     transaction::Transaction,"},{"DocComment":" # };"},{"DocComment":" # use solana_rpc_client::rpc_client::RpcClient;"},{"DocComment":" # use std::convert::TryFrom;"},{"DocComment":" # use anyhow::Result;"},{"DocComment":" #"},{"DocComment":" # #[derive(BorshSerialize, BorshDeserialize, Debug)]"},{"DocComment":" # #[borsh(crate = \"borsh\")]"},{"DocComment":" # struct InstructionData {"},{"DocComment":" #    pub vault_bump_seed: u8,"},{"DocComment":" #    pub lamports: u64,"},{"DocComment":" # }"},{"DocComment":" #"},{"DocComment":" # pub static VAULT_ACCOUNT_SIZE: u64 = 1024;"},{"DocComment":" #"},{"DocComment":" fn create_vault_account("},{"DocComment":"     client: &RpcClient,"},{"DocComment":"     program_id: Pubkey,"},{"DocComment":"     payer: &Keypair,"},{"DocComment":" ) -> Result<()> {"},{"DocComment":"     // Derive the PDA from the payer account, a string representing the unique"},{"DocComment":"     // purpose of the account (\"vault\"), and the address of our on-chain program."},{"DocComment":"     let (vault_pubkey, vault_bump_seed) = Pubkey::find_program_address("},{"DocComment":"         &[b\"vault\", payer.pubkey().as_ref()],"},{"DocComment":"         &program_id"},{"DocComment":"     );"},{"DocComment":""},{"DocComment":"     // Get the amount of lamports needed to pay for the vault's rent"},{"DocComment":"     let vault_account_size = usize::try_from(VAULT_ACCOUNT_SIZE)?;"},{"DocComment":"     let lamports = client.get_minimum_balance_for_rent_exemption(vault_account_size)?;"},{"DocComment":""},{"DocComment":"     // The on-chain program's instruction data, imported from that program's crate."},{"DocComment":"     let instr_data = InstructionData {"},{"DocComment":"         vault_bump_seed,"},{"DocComment":"         lamports,"},{"DocComment":"     };"},{"DocComment":""},{"DocComment":"     // The accounts required by both our on-chain program and the system program's"},{"DocComment":"     // `create_account` instruction, including the vault's address."},{"DocComment":"     let accounts = vec!["},{"DocComment":"         AccountMeta::new(payer.pubkey(), true),"},{"DocComment":"         AccountMeta::new(vault_pubkey, false),"},{"DocComment":"         AccountMeta::new(system_program::ID, false),"},{"DocComment":"     ];"},{"DocComment":""},{"DocComment":"     // Create the instruction by serializing our instruction data via borsh"},{"DocComment":"     let instruction = Instruction::new_with_borsh("},{"DocComment":"         program_id,"},{"DocComment":"         &instr_data,"},{"DocComment":"         accounts,"},{"DocComment":"     );"},{"DocComment":""},{"DocComment":"     let blockhash = client.get_latest_blockhash()?;"},{"DocComment":""},{"DocComment":"     let transaction = Transaction::new_signed_with_payer("},{"DocComment":"         &[instruction],"},{"DocComment":"         Some(&payer.pubkey()),"},{"DocComment":"         &[payer],"},{"DocComment":"         blockhash,"},{"DocComment":"     );"},{"DocComment":""},{"DocComment":"     client.send_and_confirm_transaction(&transaction)?;"},{"DocComment":""},{"DocComment":"     Ok(())"},{"DocComment":" }"},{"DocComment":" # let program_id = Pubkey::new_unique();"},{"DocComment":" # let payer = Keypair::new();"},{"DocComment":" # let client = RpcClient::new(String::new());"},{"DocComment":" #"},{"DocComment":" # create_vault_account(&client, program_id, &payer)?;"},{"DocComment":" #"},{"DocComment":" # Ok::<(), anyhow::Error>(())"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"input