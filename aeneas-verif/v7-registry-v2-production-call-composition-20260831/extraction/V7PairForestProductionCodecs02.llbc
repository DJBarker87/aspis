`false`."},{"DocComment":""},{"DocComment":" `all()` is short-circuiting; in other words, it will stop processing"},{"DocComment":" as soon as it finds a `false`, given that no matter what else happens,"},{"DocComment":" the result will also be `false`."},{"DocComment":""},{"DocComment":" An empty iterator returns `true`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert!(a.into_iter().all(|x| x > 0));"},{"DocComment":""},{"DocComment":" assert!(!a.into_iter().all(|x| x > 2));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `false`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert!(!iter.all(|x| x != 2));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"F"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":12139},{"Deduplicated":12155}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":47,"beg":{"line":2834,"col":11},"end":{"line":2834,"col":36}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":12140},{"HashConse