:" that element's index while walking forward through the array."},{"DocComment":""},{"DocComment":" This is essentially the same as writing"},{"DocComment":" ```text"},{"DocComment":" [f(0), f(1), f(2), …, f(N - 2), f(N - 1)]"},{"DocComment":" ```"},{"DocComment":" and is similar to `(0..i).map(f)`, just for arrays not iterators."},{"DocComment":""},{"DocComment":" If `N == 0`, this produces an empty array without ever calling `f`."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" // type inference is helping us here, the way `from_fn` knows how many"},{"DocComment":" // elements to produce is the length of array down there: only arrays of"},{"DocComment":" // equal lengths can be compared, so the const generic parameter `N` is"},{"DocComment":" // inferred to be 5, thus creating array of 5 elements."},{"DocComment":""},{"DocComment":" let array = core::array::from_fn(|i| i);"},{"DocComment":" // indexes are:    0  1  2  3  4"},{"DocComment":" assert_eq!(array, [0, 1, 2, 3, 4]);"},{"DocComment":""},{"DocComment":" let array2: [usize; 8] = core::array::from_fn(|i| i * 2);"},{"DocComment":" // indexes are:     0  1  2  3  4  5   6   7"},{"DocComment":" assert_eq!(array2, [0, 2, 4, 6, 8, 10, 12, 14]);"},{"DocComment":""},{"DocComment":" let bool_arr = core::array::from_fn::<_, 5, _>(|i| i % 2 == 0);"},{"DocComment":" // indexes are:       0     1      2     3      4"},{"DocComment":" assert_eq!(bool_arr, [true, false, true, false, true]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also capture things, for example to create an array full of clones"},{"DocComment":" where you can't just use `[item; N]` because it's not `Copy`:"},{"DocComment":" ```"},{"DocComment":" let my_string: [String; 2] = std::array::from_fn(|i| format!(\"Hello {i}\"));"},{"DocComment":" assert_eq!(my_string, [\"Hello 0\", \"Hello 1\"]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The array is generated in ascending index order, starting from the front"},{"DocComment":" and going towards the back, so you can use closures with mutable state:"},{"DocComment":" ```"},{"DocComment":" let mut state = 1;"},{"DocComment":" let a = std::array::from_fn(|_| { let x = state; state *= 2; x });"},{"DocComment":" assert_eq!(a, [1, 2, 4, 8, 16, 32]);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"F"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":1554}}],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":15,"beg":{"line":110,"col":24},"end":{"line":110,"col":40}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":8567}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":15,"beg":{"line":112,"col":7},"end":{"line":112,"col":32}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":8579},{"Deduplicated":2200},{"Deduplicated":8567}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":15,"beg":{"line":112,"col":35},"end":{"line":112,"col":51}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":8579}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":8579}],"output":{"HashConsedValue":[8643,{"Array":[{"Deduplicated":8567},{"kind":{"Var":{"Free":0}},"ty":{"Deduplicated":1554}}]}]}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":10,"item_meta":{"name":[{"Ident":["aspis_core",0]},{"Ident":["fiel