import AspisFormal.K1.V7Tag73CoupledReplayAlignment

/-!
# Executable ordered-history matcher for generated Tag-73 checkpoints

The generic coupling records untyped adversary SHA calls.  This file derives
the expected ordered query/answer trace directly from the successful
`TableExecutionTrace`: each pre-action core is zipped with the corresponding
literal `actionReplies` entry, and `actionInputs` supplies the exact query
bytes.  A squeeze reply contributes both output and advance calls atomically.

The matcher asks whether the generated schedule prefix is an ordered sublist
of the actual adversary prefix, allowing unrelated adversary SHA calls between
protocol calls, and checks the actual pause input against the generated next
squeeze.  It is a Boolean computation, not a trace-cover field.  Outside the
explicit event that two distinct generated checkpoints have the same
pre-squeeze state/input, at most one generated checkpoint can match.

What remains for the probabilistic coupling is to prove that the matcher
returns `true` on fresh acceptance outside the named raw bad events.  Generic
`IsOperationalCoupling` alone cannot prove that: it contains no Tag-73 role
labels and compares replay histories only after erasing query actors.
-/

set_option autoImplicit false

namespace AspisK1.V7Tag73ExecutableHistoryMatcher

open AspisK1.V7Tag73TranscriptSchedule
open AspisK1.V7Tag73DeterministicRefinement
open AspisK1.V7Tag73ConcreteQueryDag
open AspisK1.V7Tag73InteractiveAncestor
open AspisK1.V7Tag73InteractiveExecution
open AspisK1.V7Tag73DagActionAlignment
open AspisK1.V7Tag73ConcreteStateRestoration
open AspisK1.V7Tag73CoupledReplayAlignment
open AspisK1.V7FsAokExperiment
open AspisK1.V7FsStateRestorationCoupling

/-! ## Ordered query/answer trace generated by the interactive execution -/

def replyOutputs : VerifierReply → List Digest256
  | .none => []
  | .single output => [output]
  | .squeeze output advance => [output, advance]

/-- Exact query/answer pairs made by one complete action.  `List.zip` is used
only on data derived from a successful trace; the squeeze theorem below proves
that its two inputs and two outputs are retained together. -/
def actionQueryAnswers (bindings : FixedBindings) (core : RuntimeCore)
    (action : VerifierAction) (reply : VerifierReply) :
    List (ShaInput × ShaOutput) :=
  (actionInputs bindings core action).zip (replyOutputs reply)

/-- Ordered queries made by the first `actionCount` complete actions.  The
definition uses the trace's literal `actionReplies` list and the corresponding
pre-action cores; it does not accept a caller-supplied trace. -/
def traceQueryAnswerPrefix
    {table : FixedOracleTable} {bindings : FixedBindings}
    {core : RuntimeCore} {actions : List VerifierAction}
    (trace : TableExecutionTrace table bindings core actions)
    (actionCount : Nat) : List (ShaInput × ShaOutput) :=
  ((trace.cores.zip trace.actionReplies).take actionCount).flatMap fun entry =>
    actionQueryAnswers bindings entry.1 entry.2.1 entry.2.2

@[simp] theorem trace_query_answer_prefix_zero
    {table : FixedOracleTable} {bindings : FixedBindings}
    {core : RuntimeCore} {actions : List VerifierAction}
    (trace : TableExecutionTrace table bindings core actions) :
    traceQueryAnswerPrefix trace 0 = [] := by
  simp [traceQueryAnswerPrefix]

theorem derived_squeeze_contributes_atomic_output_advance_pair
    (table : FixedOracleTable) (bindings : FixedBindings)
    (core : RuntimeCore) (owner : SqueezeOwner) (block : Nat)
    (reply : VerifierReply)
    (derived : deriveReply table bindings core (.squeezePair owner block) =
      some reply) :
    ∃ output advance,
      reply = .squeeze output advance ∧
      actionQueryAnswers bindings core (.squeezePair owner block) reply =
        [(bytes core.digest ++ [domSqueeze], output),
         (bytes core.digest ++ [domAdvance], advance)] := by
  obtain ⟨output, advance, equals, _, _, _⟩ :=
    derived_squeeze_uses_two_distinct_same_state_inputs
      table bindings core owner block reply derived
  subst reply
  exact ⟨output, advance, rfl, rfl⟩

/-- The concrete schedule prefix before the generated next squeeze. -/
noncomputable def expectedGeneratedQueryAnswerPrefix
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (generated : GeneratedReplayPrefix dag) :
    List (ShaInput × ShaOutput) :=
  let restoration := concreteRestoration execution generated
  traceQueryAnswerPrefix execution.trace restoration.actionCursor.val

/-! ## Executable match against an actual adversary pause -/

/-- Ordered-sublist matching permits other adversary SHA calls to occur
between Tag-73 transcript calls.  The second conjunct pins the actual pause to
the output half of the generated next squeeze. -/
noncomputable def generatedHistoryMatches
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (generated : GeneratedReplayPrefix dag)
    (actualPrefix : List QueryRecord) (driving : QueryRecord) : Bool :=
  decide
    (List.Sublist (expectedGeneratedQueryAnswerPrefix execution generated)
        (queryAnswerTrace actualPrefix) ∧
      driving.input = generatedDrivingInput execution generated)

theorem generated_history_matches_iff
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (generated : GeneratedReplayPrefix dag)
    (actualPrefix : List QueryRecord) (driving : QueryRecord) :
    generatedHistoryMatches execution generated actualPrefix driving = true ↔
      List.Sublist (expectedGeneratedQueryAnswerPrefix execution generated)
        (queryAnswerTrace actualPrefix) ∧
      driving.input = generatedDrivingInput execution generated := by
  simp [generatedHistoryMatches]

noncomputable def coupledReplayMatchesGenerated
    {RandomTape Statement Proof Result : Type*}
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (generated : GeneratedReplayPrefix dag)
    (output : CoupledReplay RandomTape Statement Proof Result) : Bool :=
  generatedHistoryMatches execution generated output.replayPrefix output.driving

theorem coupled_replay_match_success_exposes_exact_schedule_and_pause
    {RandomTape Statement Proof Result : Type*}
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (generated : GeneratedReplayPrefix dag)
    (output : CoupledReplay RandomTape Statement Proof Result)
    (matched : coupledReplayMatchesGenerated execution generated output = true) :
    List.Sublist (expectedGeneratedQueryAnswerPrefix execution generated)
        (queryAnswerTrace output.replayPrefix) ∧
      output.driving.input = generatedDrivingInput execution generated := by
  exact (generated_history_matches_iff execution generated
    output.replayPrefix output.driving).mp matched

/-! ## Explicit input/state collision event and uniqueness -/

def GeneratedCheckpointInputCollision
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape) : Prop :=
  ∃ first second : GeneratedReplayPrefix dag,
    first ≠ second ∧
      generatedDrivingInput execution first =
        generatedDrivingInput execution second

def GeneratedCheckpointStateCollision
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape) : Prop :=
  ∃ first second : GeneratedReplayPrefix dag,
    first ≠ second ∧
      (concreteRestoration execution first).snapshot.core.digest =
        (concreteRestoration execution second).snapshot.core.digest

theorem equal_generated_driving_inputs_imply_equal_checkpoint_states
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (first second : GeneratedReplayPrefix dag)
    (equalInputs : generatedDrivingInput execution first =
      generatedDrivingInput execution second) :
    (concreteRestoration execution first).snapshot.core.digest =
      (concreteRestoration execution second).snapshot.core.digest := by
  unfold generatedDrivingInput at equalInputs
  apply List.ofFn_injective
  exact (List.append_left_inj [domSqueeze]).mp equalInputs

theorem generated_checkpoint_input_collision_iff_state_collision
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape) :
    GeneratedCheckpointInputCollision execution ↔
      GeneratedCheckpointStateCollision execution := by
  constructor
  · rintro ⟨first, second, distinct, equalInputs⟩
    exact ⟨first, second, distinct,
      equal_generated_driving_inputs_imply_equal_checkpoint_states
        execution first second equalInputs⟩
  · rintro ⟨first, second, distinct, equalStates⟩
    refine ⟨first, second, distinct, ?_⟩
    simp only [generatedDrivingInput]
    rw [equalStates]

/-- Matching the ordered schedule prefix plus the exact pause identifies at
most one generated checkpoint unless the explicit input/state-collision event
occurs.  Owner and block need not be encoded in the SHA input. -/
theorem matching_identifies_generated_checkpoint_outside_collision
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (actualPrefix : List QueryRecord) (driving : QueryRecord)
    (noCollision : ¬ GeneratedCheckpointInputCollision execution)
    (first second : GeneratedReplayPrefix dag)
    (firstMatches :
      generatedHistoryMatches execution first actualPrefix driving = true)
    (secondMatches :
      generatedHistoryMatches execution second actualPrefix driving = true) :
    first = second := by
  by_contra distinct
  apply noCollision
  refine ⟨first, second, distinct, ?_⟩
  have firstInput := (generated_history_matches_iff execution first
    actualPrefix driving).mp firstMatches
  have secondInput := (generated_history_matches_iff execution second
    actualPrefix driving).mp secondMatches
  exact firstInput.2.symm.trans secondInput.2

theorem matched_coupled_replay_pairs_with_complete_restoration
    {RandomTape Statement Proof Result : Type*}
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (generated : GeneratedReplayPrefix dag)
    (output : CoupledReplay RandomTape Statement Proof Result)
    (matched : coupledReplayMatchesGenerated execution generated output = true) :
    let restoration := concreteRestoration execution generated
    List.Sublist (expectedGeneratedQueryAnswerPrefix execution generated)
        (queryAnswerTrace output.replayPrefix) ∧
      output.driving.input = generatedDrivingInput execution generated ∧
      (fullPlan dag.tape).get restoration.actionCursor =
        .squeezePair restoration.checkpoint.owner
          restoration.checkpoint.block ∧
      IsComplete restoration.snapshot ∧
      PreviouslySeen restoration.snapshot
        restoration.sourceExecution.interactiveState := by
  have exactMatch := coupled_replay_match_success_exposes_exact_schedule_and_pause
    execution generated output matched
  let restoration := concreteRestoration execution generated
  exact ⟨exactMatch.1, exactMatch.2,
    restoration_next_action_is_exact_squeeze_pair restoration,
    restoration_snapshot_is_complete restoration,
    restoration_snapshot_is_previously_seen restoration⟩

/-! ## What generic operational coupling does and does not retain -/

theorem operational_replay_prefix_contains_only_adversary_records
    {RandomTape Observation Statement Proof Result : Type*}
    (capability : SameTapeStartCapability RandomTape Observation Result)
    (record : FixedFirstRunRecord
      RandomTape Observation Statement Proof Result)
    (output : CoupledReplay RandomTape Statement Proof Result)
    (operational : IsOperationalCoupling capability record output)
    (query : QueryRecord) (member : query ∈ output.replayPrefix) :
    query.actor = .adversary := by
  rcases operational with
    ⟨_, _, q1, decomposition, _, _, _, _, _, _, _, _, _, _, _, _, _, _⟩
  have inOutputQ1 : query ∈ output.q1 := by
    rw [decomposition]
    simp only [List.mem_append]
    exact Or.inl member
  rw [q1] at inOutputQ1
  exact frozen_q1_contains_only_adversary_calls
    record.firstRun.stateAtAdversaryHalt query inOutputQ1

/-- The equality used by generic replay intentionally erases the actor.  Thus
it cannot by itself prove a role/actor alignment for the interactive trace. -/
theorem query_answer_trace_erases_actor
    (input : ShaInput) (output : ShaOutput)
    (firstActor secondActor : QueryActor)
    (origin : AnswerOrigin) :
    queryAnswerTrace
        [{ input := input, output := output, actor := firstActor,
           origin := origin }] =
      queryAnswerTrace
        [{ input := input, output := output, actor := secondActor,
           origin := origin }] := by
  rfl

