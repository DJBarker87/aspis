/-! ## The actual verifier checkpoint -/

/-- The two raw inputs generated by a concrete future-free squeeze
transition.  Non-squeeze transitions have no pair. -/
def squeezePairInputsOfTransition
    (transition : FutureFreeTransition) : Option (ShaInput × ShaInput) :=
  match transition.event with
  | .verifier (.squeezePair _owner _block) _reply =>
      some
        (bytes transition.before.core.digest ++ [domSqueeze],
          bytes transition.before.core.digest ++ [domAdvance])
  | _ => none

/-- Executable first matching squeeze in the actual future-free transition
history. -/
def firstMatchingSqueezeTransition
    (outputInput advanceInput : ShaInput)
    (state : FutureFreeVerifierState) : Option FutureFreeTransition :=
  state.transitions.find? fun transition =>
    decide (squeezePairInputsOfTransition transition =
      some (outputInput, advanceInput))

structure LocatedActualFutureFreeSqueeze
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    (execution : RawVerifierExecution source)
    (outputInput advanceInput : ShaInput) where
  transition : FutureFreeTransition
  found : firstMatchingSqueezeTransition outputInput advanceInput
    execution.finalState = some transition

theorem located_actual_squeeze_is_transition_member
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    (location : LocatedActualFutureFreeSqueeze execution outputInput
      advanceInput) :
    location.transition ∈ execution.finalState.transitions := by
  have found := location.found
  unfold firstMatchingSqueezeTransition at found
  exact List.mem_of_find?_eq_some found

theorem located_actual_squeeze_inputs_are_exact
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    (location : LocatedActualFutureFreeSqueeze execution outputInput
      advanceInput) :
    squeezePairInputsOfTransition location.transition =
      some (outputInput, advanceInput) := by
  have found := location.found
  unfold firstMatchingSqueezeTransition at found
  have foundSpec := List.find?_eq_some_iff_append.mp found
  exact of_decide_eq_true foundSpec.1

private theorem squeeze_pair_inputs_some_has_literal_pair_state
    (transition : FutureFreeTransition)
    (outputInput advanceInput : ShaInput)
    (exactInputs : squeezePairInputsOfTransition transition =
      some (outputInput, advanceInput)) :
    ∃ owner block reply,
      transition.event = .verifier (.squeezePair owner block) reply ∧
        outputInput = bytes transition.before.core.digest ++ [domSqueeze] ∧
        advanceInput = bytes transition.before.core.digest ++ [domAdvance] := by
  rcases transition with ⟨before, event, after⟩
  cases event with
  | proverC1 root => simp [squeezePairInputsOfTransition] at exactInputs
  | proverC2 lambda chi commitment =>
      simp [squeezePairInputsOfTransition] at exactInputs
  | proverPayload payload =>
      simp [squeezePairInputsOfTransition] at exactInputs
  | proverWorkNonce stage nonce =>
      simp [squeezePairInputsOfTransition] at exactInputs
  | verifier action reply =>
      cases action with
      | squeezePair owner block =>
          simp only [squeezePairInputsOfTransition, Option.some.injEq,
            Prod.mk.injEq] at exactInputs
          exact ⟨owner, block, reply, rfl, exactInputs.1.symm,
            exactInputs.2.symm⟩
      | absorb payload => simp [squeezePairInputsOfTransition] at exactInputs
      | requestRootSalt tree =>
          simp [squeezePairInputsOfTransition] at exactInputs
      | absorbC1 root => simp [squeezePairInputsOfTransition] at exactInputs
      | absorbC2 lambda chi commitment =>
          simp [squeezePairInputsOfTransition] at exactInputs
      | workProbe stage nonce kind =>
          simp [squeezePairInputsOfTransition] at exactInputs
      | checkpoint checkpoint =>
          simp [squeezePairInputsOfTransition] at exactInputs
      | markQ16Base => simp [squeezePairInputsOfTransition] at exactInputs
      | q16CandidateAbsorb counter outcome selected =>
          simp [squeezePairInputsOfTransition] at exactInputs
      | q16Restore counter =>
          simp [squeezePairInputsOfTransition] at exactInputs
      | q16Selected counter =>
          simp [squeezePairInputsOfTransition] at exactInputs
      | q16SamplerAbortReject counter =>
          simp [squeezePairInputsOfTransition] at exactInputs
      | q16AllNoncompactReject =>
          simp [squeezePairInputsOfTransition] at exactInputs
      | terminal => simp [squeezePairInputsOfTransition] at exactInputs

/-- The matching transition really is one concrete paired squeeze and both
inputs are derived from the same preceding 256-bit state. -/
theorem located_actual_squeeze_has_literal_pair_state
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    (location : LocatedActualFutureFreeSqueeze execution outputInput
      advanceInput) :
    ∃ owner block reply,
      location.transition.event =
          .verifier (.squeezePair owner block) reply ∧
        outputInput = bytes location.transition.before.core.digest ++
          [domSqueeze] ∧
        advanceInput = bytes location.transition.before.core.digest ++
      [domAdvance] := by
  exact squeeze_pair_inputs_some_has_literal_pair_state location.transition
    outputInput advanceInput
    (located_actual_squeeze_inputs_are_exact location)

theorem located_actual_squeeze_checkpoint_was_previously_seen
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    (location : LocatedActualFutureFreeSqueeze execution outputInput
      advanceInput) :
    location.transition.before ∈ execution.finalState.seen := by
  have invariant := raw_verifier_execution_has_exact_run_invariant execution
  exact (invariant.1.2.2 location.transition
    (located_actual_squeeze_is_transition_member location)).1

/-- Restore the complete future-free state to a concrete prior snapshot.  The
new execution history starts with exactly that snapshot and contains no stale
post-checkpoint transition; in particular it cannot reveal the discarded
future suffix. -/
def restoreActualFutureFreeCheckpoint
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    (location : LocatedActualFutureFreeSqueeze execution outputInput
      advanceInput) : FutureFreeVerifierState where
  current := location.transition.before
  seen := [location.transition.before]
  transitions := []

theorem restored_actual_checkpoint_is_complete_nonempty_and_fixed
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    (location : LocatedActualFutureFreeSqueeze execution outputInput
      advanceInput) :
    FutureFreeRunInvariant
      (FixedBindings.ofContext execution.adversaryValue.rawMessages.context)
      (restoreActualFutureFreeCheckpoint location) := by
  have invariant := raw_verifier_execution_has_exact_run_invariant execution
  have beforeSeen :=
    located_actual_squeeze_checkpoint_was_previously_seen location
  have beforeFixed := invariant.2.2 location.transition.before beforeSeen
  constructor
  · simp [FutureFreeHistoryClosed, restoreActualFutureFreeCheckpoint]
  · simp [FutureFreeBindingsFixed, restoreActualFutureFreeCheckpoint,
      beforeFixed]

/-! ## Deterministically join the two executable searches -/

inductive ActualCheckpointedReplacementFailure where
  | adversaryPairAbsent
  | verifierCheckpointAbsent
  | replacement (reason : ScheduledStrictReplacementFailure)
  deriving DecidableEq, Repr

structure ActualCheckpointedRawReplacement
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    (execution : RawVerifierExecution source)
    (outputInput advanceInput : ShaInput)
    (configuration : AtomicPairReplayConfiguration) where
  rawExecution : NormallyReturnedRawExecution source
  rawExecutionExact : rawExecution.returnedValue = execution.adversaryValue
  checkpoint : LocatedActualFutureFreeSqueeze execution outputInput advanceInput
  replacement : RawScheduledRootReplacement rawExecution outputInput
    advanceInput configuration

noncomputable def constructActualCheckpointedRawReplacement
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    (execution : RawVerifierExecution source)
    (outputInput advanceInput : ShaInput)
    (configuration : AtomicPairReplayConfiguration) :
    Except ActualCheckpointedReplacementFailure
      (ActualCheckpointedRawReplacement execution outputInput advanceInput
        configuration) :=
  let rawExecution : NormallyReturnedRawExecution source :=
    { returnedValue := execution.adversaryValue
      normallyReturned := execution.adversaryReturned }
  match adversaryScan : firstPairInOperationalPath outputInput advanceInput
      (rawRootReplayPath rawExecution) with
  | none => .error .adversaryPairAbsent
  | some scanLocation =>
      match verifierScan : firstMatchingSqueezeTransition outputInput
          advanceInput execution.finalState with
      | none => .error .verifierCheckpointAbsent
      | some transition =>
          match constructRawScheduledRootReplacement rawExecution outputInput
              advanceInput configuration scanLocation adversaryScan with
          | .error reason => .error (.replacement reason)
          | .ok replacement => .ok
              { rawExecution := rawExecution
                rawExecutionExact := rfl
                checkpoint := { transition := transition, found := verifierScan }
                replacement := replacement }

/-! ## Run the returned child from the restored checkpoint -/

def ActualCheckpointedRawReplacement.rawChildMessages
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    (replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration) : RawTag73ProverMessages :=
  replacement.replacement.rawResidualMessages

def ActualCheckpointedRawReplacement.restoredState
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    (replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration) : FutureFreeVerifierState :=
  restoreActualFutureFreeCheckpoint replacement.checkpoint

def rawStrictReplacementSuffixProgram
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    (replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration)
    (driverFuel : Nat) : OracleMachine FutureFreeVerifierState :=
  driveRawFutureFree execution.environment replacement.rawChildMessages
    driverFuel replacement.restoredState

def rawStrictReplacementSuffixRun
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    (replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration)
    (driverFuel verifierFuel : Nat) : MachineRun FutureFreeVerifierState :=
  runMachine configuration.postForkController configuration.oracleLimits
    .verifier verifierFuel
    replacement.replacement.scheduled.scheduled.completed.continuationRun.oracle
    (rawStrictReplacementSuffixProgram replacement driverFuel)

inductive RawStrictReplacementSuffixFailure where
  | bindingMismatch
  | oracleAbort (reason : OracleAbort)
  | timeout
  deriving DecidableEq, Repr

structure ReturnedRawStrictReplacementSuffix
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    (replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration)
    (driverFuel verifierFuel : Nat) where
  childBindingExact :
    FixedBindings.ofContext replacement.rawChildMessages.context =
      replacement.restoredState.current.bindings
  finalState : FutureFreeVerifierState
  normallyReturned :
    (rawStrictReplacementSuffixRun replacement driverFuel verifierFuel).halt =
      .returned finalState

noncomputable def constructReturnedRawStrictReplacementSuffix
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    (replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration)
    (driverFuel verifierFuel : Nat) :
    Except RawStrictReplacementSuffixFailure
      (ReturnedRawStrictReplacementSuffix replacement driverFuel
        verifierFuel) := by
  classical
  exact if bindingExact :
      FixedBindings.ofContext replacement.rawChildMessages.context =
        replacement.restoredState.current.bindings then
    match returned :
        (rawStrictReplacementSuffixRun replacement driverFuel verifierFuel).halt
      with
    | .oracleAbort reason => .error (.oracleAbort reason)
    | .outOfFuel => .error .timeout
    | .returned finalState => .ok
        { childBindingExact := bindingExact
          finalState := finalState
          normallyReturned := returned }
    else
      .error .bindingMismatch

/-! ## Exact child suffix semantics and accounting -/

def ReturnedRawStrictReplacementSuffix.verifierHistory
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    {replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration}
    {driverFuel verifierFuel : Nat}
    (suffix : ReturnedRawStrictReplacementSuffix replacement driverFuel
      verifierFuel) : List QueryRecord :=
  historySince
    replacement.replacement.scheduled.scheduled.completed.continuationRun.oracle
    (rawStrictReplacementSuffixRun replacement driverFuel verifierFuel).oracle

def ActualCheckpointedRawReplacement.proverReplayHistory
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    (replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration) : List QueryRecord :=
  historySince
    replacement.replacement.scheduled.scheduled.completed.programming.afterBoth
    replacement.replacement.scheduled.scheduled.completed.continuationRun.oracle

/-- The same-tape residual prover has a literal ordered query path ending in
the raw child value used below; it is not reconstructed from a child DAG. -/
theorem checkpointed_raw_replacement_prover_has_exact_query_path
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    (replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration) :
    ∃ pairs : List (ShaInput × ShaOutput),
      MachineQueryPath
        replacement.replacement.scheduled.scheduled.completed.paused.residualProgram
        pairs
        replacement.replacement.scheduled.scheduled.completed.returnedValue ∧
      queryAnswerTrace replacement.proverReplayHistory = pairs ∧
      (∀ record ∈ replacement.proverReplayHistory,
        record.actor = .extractorReplay) ∧
      ∀ pair ∈ pairs,
        tableLookup (fixedTableOfOracleState
          replacement.replacement.scheduled.scheduled.completed.continuationRun.oracle)
          pair.1 = some pair.2 := by
  have runExact :
      replacement.replacement.scheduled.scheduled.completed.continuationRun =
        runMachine configuration.postForkController configuration.oracleLimits
          .extractorReplay configuration.replayFuel
          replacement.replacement.scheduled.scheduled.completed.programming.afterBoth
          replacement.replacement.scheduled.scheduled.completed.paused.residualProgram := by
    simpa [ScheduledCompletedStrictReplacement.completed] using
      replacement.replacement.scheduled.scheduled.completed.runExact
  have returned :
      (runMachine configuration.postForkController configuration.oracleLimits
        .extractorReplay configuration.replayFuel
        replacement.replacement.scheduled.scheduled.completed.programming.afterBoth
        replacement.replacement.scheduled.scheduled.completed.paused.residualProgram).halt =
          .returned
            replacement.replacement.scheduled.scheduled.completed.returnedValue := by
    rw [← runExact]
    exact replacement.replacement.scheduled.scheduled.completed.normallyReturned
  simpa [ActualCheckpointedRawReplacement.proverReplayHistory, runExact] using
    run_machine_returned_has_exact_query_path configuration.postForkController
      configuration.oracleLimits .extractorReplay configuration.replayFuel
      replacement.replacement.scheduled.scheduled.completed.programming.afterBoth
      replacement.replacement.scheduled.scheduled.completed.paused.residualProgram
      replacement.replacement.scheduled.scheduled.completed.returnedValue
      returned

theorem returned_raw_suffix_has_exact_query_path
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    {replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration}
    {driverFuel verifierFuel : Nat}
    (suffix : ReturnedRawStrictReplacementSuffix replacement driverFuel
      verifierFuel) :
    ∃ pairs : List (ShaInput × ShaOutput),
      MachineQueryPath (rawStrictReplacementSuffixProgram replacement
          driverFuel) pairs suffix.finalState ∧
      queryAnswerTrace suffix.verifierHistory = pairs ∧
      (∀ record ∈ suffix.verifierHistory, record.actor = .verifier) ∧
      ∀ pair ∈ pairs,
        tableLookup (fixedTableOfOracleState
          (rawStrictReplacementSuffixRun replacement driverFuel
            verifierFuel).oracle) pair.1 = some pair.2 := by
  simpa [rawStrictReplacementSuffixRun,
    ReturnedRawStrictReplacementSuffix.verifierHistory] using
    run_machine_returned_has_exact_query_path configuration.postForkController
      configuration.oracleLimits .verifier verifierFuel
      replacement.replacement.scheduled.scheduled.completed.continuationRun.oracle
      (rawStrictReplacementSuffixProgram replacement driverFuel)
      suffix.finalState suffix.normallyReturned

theorem returned_raw_suffix_query_count_le_fuel
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    {replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration}
    {driverFuel verifierFuel : Nat}
    (suffix : ReturnedRawStrictReplacementSuffix replacement driverFuel
      verifierFuel) :
    suffix.verifierHistory.length ≤ verifierFuel := by
  have extension := run_machine_exact_fresh_extension
    configuration.postForkController configuration.oracleLimits .verifier
    verifierFuel
    replacement.replacement.scheduled.scheduled.completed.continuationRun.oracle
    (rawStrictReplacementSuffixProgram replacement driverFuel)
  have steps := run_machine_steps_le_fuel configuration.postForkController
    configuration.oracleLimits .verifier verifierFuel
    replacement.replacement.scheduled.scheduled.completed.continuationRun.oracle
    (rawStrictReplacementSuffixProgram replacement driverFuel)
  have historyLeSteps : suffix.verifierHistory.length ≤
      (rawStrictReplacementSuffixRun replacement driverFuel verifierFuel).steps := by
    simpa [ReturnedRawStrictReplacementSuffix.verifierHistory,
      rawStrictReplacementSuffixRun] using extension.2.2
  have stepsLeFuel :
      (rawStrictReplacementSuffixRun replacement driverFuel verifierFuel).steps ≤
        verifierFuel := by
    simpa [rawStrictReplacementSuffixRun] using steps
  exact historyLeSteps.trans stepsLeFuel

theorem returned_raw_suffix_is_operational_trace
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    {replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration}
    {driverFuel verifierFuel : Nat}
    (suffix : ReturnedRawStrictReplacementSuffix replacement driverFuel
      verifierFuel) :
    ∃ pairs : List (ShaInput × ShaOutput),
      queryAnswerTrace suffix.verifierHistory = pairs ∧
      FutureFreeOperationalTrace execution.environment
        replacement.rawChildMessages replacement.restoredState pairs
        suffix.finalState := by
  obtain ⟨pairs, path, history, _actors, _answers⟩ :=
    returned_raw_suffix_has_exact_query_path suffix
  exact ⟨pairs, history,
    drive_raw_future_free_path_is_operational_trace execution.environment
      replacement.rawChildMessages driverFuel replacement.restoredState pairs
      suffix.finalState path⟩

theorem returned_raw_suffix_has_complete_nonempty_fixed_state
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    {replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration}
    {driverFuel verifierFuel : Nat}
    (suffix : ReturnedRawStrictReplacementSuffix replacement driverFuel
      verifierFuel) :
    FutureFreeRunInvariant
      (FixedBindings.ofContext replacement.rawChildMessages.context)
      suffix.finalState := by
  have ancestorInvariant :=
    restored_actual_checkpoint_is_complete_nonempty_and_fixed
      replacement.checkpoint
  have restoredInvariant : FutureFreeRunInvariant
      (FixedBindings.ofContext replacement.rawChildMessages.context)
      replacement.restoredState := by
    refine ⟨ancestorInvariant.1, suffix.childBindingExact.symm, ?_⟩
    intro snapshot member
    have childEqAncestor :=
      suffix.childBindingExact.trans ancestorInvariant.2.1
    exact (ancestorInvariant.2.2 snapshot member).trans childEqAncestor.symm
  obtain ⟨pairs, path, _history, _actors, _answers⟩ :=
    returned_raw_suffix_has_exact_query_path suffix
  exact ⟨
    drive_raw_future_free_path_preserves_history_closed execution.environment
      replacement.rawChildMessages driverFuel replacement.restoredState pairs
      suffix.finalState restoredInvariant.1 path,
    drive_raw_future_free_path_preserves_fixed_bindings
      (FixedBindings.ofContext replacement.rawChildMessages.context)
      execution.environment replacement.rawChildMessages driverFuel
      replacement.restoredState pairs suffix.finalState restoredInvariant.2
      path⟩

/-- `Q1` remains the first adversary halt history.  Replay-prefix and child
verifier calls are separately accounted and never retroactively appended to
this frozen value. -/
def ActualCheckpointedRawReplacement.frozenQ1
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    (_replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration) : List QueryRecord :=
  execution.q1

@[simp] theorem checkpointed_replacement_q1_is_exactly_first_run_q1
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    (replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration) :
    replacement.frozenQ1 = freezeAdversaryQ1
      source.firstExecution.oracle := by
  rfl

theorem checkpointed_replacement_frozen_q1_only_has_first_run_adversary_calls
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    (replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration) :
    ∀ record ∈ replacement.frozenQ1, record.actor = .adversary := by
  exact raw_verifier_execution_q1_only_has_adversary_calls execution

/-- This leaf performs exactly one strict restoration.  Recursive extraction
accounts a list of these leaves; no replay count is inferred from query
history or grinding work. -/
def ActualCheckpointedRawReplacement.restorationCount
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    (_replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration) : Nat :=
  1

@[simp] theorem checkpointed_raw_replacement_has_exactly_one_restoration
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    (replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration) :
    replacement.restorationCount = 1 := by
  rfl

def ReturnedRawStrictReplacementSuffix.strictReplayOracleSteps
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    {replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration}
    {driverFuel verifierFuel : Nat}
    (suffix : ReturnedRawStrictReplacementSuffix replacement driverFuel
      verifierFuel) : Nat :=
  (locatedReplayPrefix replacement.replacement.location.selectedLocation).steps +
    replacement.replacement.scheduled.scheduled.completed.continuationRun.steps +
    (rawStrictReplacementSuffixRun replacement driverFuel verifierFuel).steps

theorem returned_raw_suffix_exact_resource_accounting
    {HiddenTape TapeIdentity Observation Statement Proof Payload : Type*}
    {source : RawTag73SameTapeSource HiddenTape TapeIdentity Observation
      Statement Proof Payload}
    {execution : RawVerifierExecution source}
    {outputInput advanceInput : ShaInput}
    {configuration : AtomicPairReplayConfiguration}
    {replacement : ActualCheckpointedRawReplacement execution outputInput
      advanceInput configuration}
    {driverFuel verifierFuel : Nat}
    (suffix : ReturnedRawStrictReplacementSuffix replacement driverFuel
      verifierFuel) :
    (locatedReplayPrefix replacement.replacement.location.selectedLocation).steps =
        replacement.replacement.location.selectedLocation.occurrence.before.length ∧
      (replacement.replacement.scheduled.scheduled.completed.programming.afterBoth).programmingHistory.length =
        (locatedReplayPrefix
          replacement.replacement.location.selectedLocation).oracle.programmingHistory.length + 2 ∧
      replacement.replacement.scheduled.scheduled.completed.continuationRun.steps ≤
        configuration.replayFuel ∧
      (rawStrictReplacementSuffixRun replacement driverFuel verifierFuel).steps ≤
        verifierFuel ∧
      suffix.strictReplayOracleSteps ≤
        replacement.replacement.location.selectedLocation.occurrence.before.length +
          configuration.replayFuel + verifierFuel := by
  have prefixSteps := run_prefix_paused_steps_eq_fuel
    (recordedPrefixController
      replacement.replacement.location.selected.entryOracle.history.length
      replacement.replacement.location.selectedLocation.occurrence.before)
    replacement.replacement.location.selected.limits
    replacement.replacement.location.selected.actor
    replacement.replacement.location.selectedLocation.occurrence.before.length
    replacement.replacement.location.selected.entryOracle
    replacement.replacement.location.selected.entryProgram
    replacement.replacement.scheduled.scheduled.completed.paused.residualProgram
    (by simpa [locatedReplayPrefix] using
      replacement.replacement.scheduled.scheduled.completed.paused.pauseExact)
  have prefixSteps' :
      (locatedReplayPrefix
        replacement.replacement.location.selectedLocation).steps =
          replacement.replacement.location.selectedLocation.occurrence.before.length := by
    simpa [locatedReplayPrefix] using prefixSteps
  have programmingDelta := scheduled_pair_programming_appends_exactly_two_records
    outputInput advanceInput
    (locatedReplayPrefix replacement.replacement.location.selectedLocation).oracle
    configuration
    replacement.replacement.scheduled.scheduled.exactProgramming
  have proverSteps := run_machine_steps_le_fuel configuration.postForkController
    configuration.oracleLimits .extractorReplay configuration.replayFuel
    replacement.replacement.scheduled.scheduled.completed.programming.afterBoth
    replacement.replacement.scheduled.scheduled.completed.paused.residualProgram
  have proverRunExact :
      replacement.replacement.scheduled.scheduled.completed.continuationRun =
        runMachine configuration.postForkController configuration.oracleLimits
          .extractorReplay configuration.replayFuel
          replacement.replacement.scheduled.scheduled.completed.programming.afterBoth
          replacement.replacement.scheduled.scheduled.completed.paused.residualProgram := by
    simpa [ScheduledCompletedStrictReplacement.completed] using
      replacement.replacement.scheduled.scheduled.completed.runExact
  have proverSteps' :
      replacement.replacement.scheduled.scheduled.completed.continuationRun.steps ≤
        configuration.replayFuel := by
    rw [proverRunExact]
    exact proverSteps
  have verifierSteps := run_machine_steps_le_fuel
    configuration.postForkController configuration.oracleLimits .verifier
    verifierFuel
    replacement.replacement.scheduled.scheduled.completed.continuationRun.oracle
    (rawStrictReplacementSuffixProgram replacement driverFuel)
  have verifierSteps' :
      (rawStrictReplacementSuffixRun replacement driverFuel verifierFuel).steps ≤
        verifierFuel := by
    simpa [rawStrictReplacementSuffixRun] using verifierSteps
  refine ⟨prefixSteps', programmingDelta, proverSteps', verifierSteps', ?_⟩
  unfold ReturnedRawStrictReplacementSuffix.strictReplayOracleSteps
  rw [prefixSteps']
  exact Nat.add_le_add (Nat.add_le_add_left proverSteps'
    replacement.replacement.location.selectedLocation.occurrence.before.length)
    verifierSteps'

