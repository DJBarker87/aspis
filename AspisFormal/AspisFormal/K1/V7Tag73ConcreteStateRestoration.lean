import AspisFormal.K1.V7Tag73DagActionAlignment
import AspisFormal.K1.V7Tag73InteractiveExecution

/-!
# Concrete complete-state restoration points for deployed Tag-73

This module turns each replay prefix generated by the literal Tag-73 query DAG
into a boundary of one successful first execution.  The map has no caller-
supplied restore function: its cursor is computed from the action-alignment
checkpoint and its snapshot is read from `ConcreteFirstExecution.stateAtCursor`.

The cursor may be zero.  Cursor zero denotes the explicit dummy, nonempty
verifier round; it is not ruled out by an artificial positivity condition.
Every generated replay point is nevertheless strictly before its next complete
action, which is one atomic two-query squeeze.
-/

set_option autoImplicit false

namespace AspisK1.V7Tag73ConcreteStateRestoration

open AspisK1.V7Tag73TranscriptSchedule
open AspisK1.V7Tag73DeterministicRefinement
open AspisK1.V7Tag73ConcreteQueryDag
open AspisK1.V7Tag73InteractiveAncestor
open AspisK1.V7Tag73DagActionAlignment
open AspisK1.V7Tag73InteractiveExecution

/-! ## The generated map -/

/-- The only source data of a restoration record are an actually executable
first run and an actually generated DAG replay prefix.  All verifier data below
are functions of these two fields. -/
structure ConcreteRestorationRecord (table : FixedOracleTable)
    (dag : ConcreteDagInstance) where
  sourceExecution : ConcreteFirstExecution table dag.tape
  generatedPrefix : GeneratedReplayPrefix dag

/-- The concrete map requested by state restoration. -/
def concreteRestoration {table : FixedOracleTable}
    {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (generated : GeneratedReplayPrefix dag) :
    ConcreteRestorationRecord table dag where
  sourceExecution := execution
  generatedPrefix := generated

noncomputable def ConcreteRestorationRecord.checkpoint
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    SqueezeActionCheckpoint dag.tape :=
  checkpointForGenerated restoration.generatedPrefix

/-- This cursor indexes the exact next action, so it is strictly inside the
plan.  Its value is allowed to be zero. -/
noncomputable def ConcreteRestorationRecord.actionCursor
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    Fin (fullPlan dag.tape).length :=
  ⟨restoration.checkpoint.cursor,
    checkpoint_cursor_is_strictly_inside_full_plan restoration.checkpoint⟩

/-- The same boundary, embedded in the complete-snapshot cursor type. -/
noncomputable def ConcreteRestorationRecord.snapshotCursor
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    Fin (fullPlan dag.tape).length.succ :=
  ⟨restoration.actionCursor.val, Nat.lt.step restoration.actionCursor.isLt⟩

/-- The restored state is literally the first-run state at the generated
cursor. -/
noncomputable def ConcreteRestorationRecord.snapshot
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    CompleteSnapshot dag.tape :=
  restoration.sourceExecution.stateAtCursor restoration.snapshotCursor

noncomputable def ConcreteRestorationRecord.location
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    ConcreteReplayLocation :=
  replayLocation restoration.generatedPrefix

def ConcreteRestorationRecord.oracleTable
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) : FixedOracleTable :=
  restoration.sourceExecution.table

def ConcreteRestorationRecord.deployedTape
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) : DeployedFixedTape :=
  restoration.sourceExecution.tape

@[simp] theorem concrete_restoration_source_execution
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (generated : GeneratedReplayPrefix dag) :
    (concreteRestoration execution generated).sourceExecution = execution := by
  rfl

@[simp] theorem concrete_restoration_generated_prefix
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (generated : GeneratedReplayPrefix dag) :
    (concreteRestoration execution generated).generatedPrefix = generated := by
  rfl

@[simp] theorem restoration_cursor_is_checkpoint_cursor
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    restoration.actionCursor.val = restoration.checkpoint.cursor := by
  rfl

@[simp] theorem restoration_snapshot_cursor_is_action_cursor
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    restoration.snapshotCursor.val = restoration.actionCursor.val := by
  rfl

theorem restoration_snapshot_is_first_run_state_at_cursor
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    restoration.snapshot =
      restoration.sourceExecution.stateAtCursor
        restoration.snapshotCursor := by
  rfl

/-! ## Complete, seen, binding-preserving states -/

theorem restoration_next_action_is_exact_squeeze_pair
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    (fullPlan dag.tape).get restoration.actionCursor =
      .squeezePair restoration.checkpoint.owner
        restoration.checkpoint.block := by
  simpa [ConcreteRestorationRecord.actionCursor] using
    checkpoint_next_action_is_exact_squeeze_pair restoration.checkpoint

theorem restoration_snapshot_is_complete
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    IsComplete restoration.snapshot := by
  exact state_at_cursor_is_complete restoration.sourceExecution
    restoration.snapshotCursor

theorem restoration_first_run_history_is_nonempty
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    NonemptyVerifierHistory
      restoration.sourceExecution.interactiveState := by
  simpa [NonemptyVerifierHistory,
    ConcreteFirstExecution.interactiveState] using
      first_execution_history_is_nonempty restoration.sourceExecution

theorem restoration_snapshot_is_previously_seen
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    PreviouslySeen restoration.snapshot
      restoration.sourceExecution.interactiveState := by
  exact state_at_cursor_is_previously_seen restoration.sourceExecution
    restoration.snapshotCursor

theorem restoration_preserves_fixed_bindings
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    restoration.snapshot.bindings =
      FixedBindings.ofContext dag.tape.messages.context := by
  exact every_cursor_has_constant_bindings restoration.sourceExecution
    restoration.snapshotCursor

theorem restoration_preserves_program_release_statement_attempt_account
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    restoration.snapshot.bindings.programId =
        dag.tape.messages.context.programId ∧
      restoration.snapshot.bindings.releaseBinding =
        dag.tape.messages.context.releaseBinding ∧
      restoration.snapshot.bindings.statementDigest =
        dag.tape.messages.context.statementDigest ∧
      restoration.snapshot.bindings.attemptId =
        dag.tape.messages.context.attemptId ∧
      restoration.snapshot.bindings.proofAccountId =
        dag.tape.messages.context.attemptId := by
  simp [CompleteSnapshot.bindings, FixedBindings.ofContext]

@[simp] theorem restoration_retains_same_oracle_table
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    restoration.oracleTable = table := by
  exact first_execution_retains_same_table restoration.sourceExecution

@[simp] theorem restoration_retains_same_deployed_tape
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    restoration.deployedTape = dag.tape := by
  exact first_execution_retains_same_tape restoration.sourceExecution

/-! ## Dummy-round legality -/

def dummySnapshotCursor (tape : DeployedFixedTape) :
    Fin (fullPlan tape).length.succ :=
  ⟨0, Nat.zero_lt_succ _⟩

def dummyRestorationSnapshot {table : FixedOracleTable}
    {tape : DeployedFixedTape}
    (execution : ConcreteFirstExecution table tape) : CompleteSnapshot tape :=
  execution.stateAtCursor (dummySnapshotCursor tape)

/-- Cursor zero is the explicit dummy verifier round.  Legality means a
complete state in a nonempty first-run history, not a positive cursor. -/
theorem dummy_cursor_zero_is_legal_restoration_state
    {table : FixedOracleTable} {tape : DeployedFixedTape}
    (execution : ConcreteFirstExecution table tape) :
    (dummyRestorationSnapshot execution).cursor.val = 0 ∧
      (dummyRestorationSnapshot execution).phase = .dummyNonempty ∧
      IsComplete (dummyRestorationSnapshot execution) ∧
      PreviouslySeen (dummyRestorationSnapshot execution)
        execution.interactiveState ∧
      NonemptyVerifierHistory execution.interactiveState := by
  refine ⟨rfl, ?_, ?_, ?_, ?_⟩
  · exact (dummy_initial_state_is_retained execution).1
  · exact state_at_cursor_is_complete execution (dummySnapshotCursor tape)
  · exact state_at_cursor_is_previously_seen execution
      (dummySnapshotCursor tape)
  · simpa [NonemptyVerifierHistory,
      ConcreteFirstExecution.interactiveState] using
        first_execution_history_is_nonempty execution

/-! ## Atomic paired squeezes -/

/-- Pointwise form of `trace_contains_no_half_squeeze_reply`: the reply at any
plan index has the shape required by the literal action at that index. -/
theorem trace_reply_at_completes_plan_action
    {table : FixedOracleTable} {bindings : FixedBindings}
    {core : RuntimeCore} {actions : List VerifierAction}
    (trace : TableExecutionTrace table bindings core actions)
    (index : Fin actions.length) :
    ReplyCompletesAction (actions.get index)
      (trace.replies.get ⟨index.val, by simpa using index.isLt⟩) := by
  induction trace with
  | done core => exact Fin.elim0 index
  | @step core next action rest reply derived applied tail ih =>
      refine Fin.cases ?_ (fun tailIndex => ?_) index
      · simpa [TableExecutionTrace.replies] using
          derived_reply_completes_action table bindings core action reply derived
      · simpa [TableExecutionTrace.replies] using ih tailIndex

theorem restoration_reply_is_complete_paired_squeeze
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    ∃ output advance,
      restoration.sourceExecution.replyAt restoration.actionCursor =
        .squeeze output advance := by
  have complete := trace_reply_at_completes_plan_action
    restoration.sourceExecution.trace restoration.actionCursor
  rw [restoration_next_action_is_exact_squeeze_pair restoration] at complete
  simpa [ReplyCompletesAction, ConcreteFirstExecution.replyAt] using complete

theorem restoration_squeeze_is_one_atomic_two_query_action
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (restoration : ConcreteRestorationRecord table dag) :
    (fullPlan dag.tape).get restoration.actionCursor =
        .squeezePair restoration.checkpoint.owner
          restoration.checkpoint.block ∧
      actionInputs restoration.snapshot.bindings restoration.snapshot.core
          (.squeezePair restoration.checkpoint.owner
            restoration.checkpoint.block) =
        [bytes restoration.snapshot.core.digest ++ [1],
         bytes restoration.snapshot.core.digest ++ [2]] ∧
      bytes restoration.snapshot.core.digest ++ [1] ≠
        bytes restoration.snapshot.core.digest ++ [2] := by
  refine ⟨restoration_next_action_is_exact_squeeze_pair restoration, ?_⟩
  exact squeeze_action_has_exact_paired_inputs restoration.snapshot.bindings
    restoration.snapshot.core restoration.checkpoint.owner
      restoration.checkpoint.block

/-! ## q16 history versus current cloned path -/

theorem q16_restoration_location_has_exact_history_and_saved_base_path
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (fork : Q16ChallengeFork dag) :
    let restoration := concreteRestoration execution (.q16 fork)
    restoration.location.historyPrefix =
        beforeQ16Roles dag ++
          q16HistoryBeforeBranch dag fork.branch.counter ++
          rolesWithinQ16BranchBeforeBlock fork ∧
      restoration.location.statePath =
        beforeQ16Roles dag ++ rolesWithinQ16BranchBeforeBlock fork ∧
      restoration.location.clonedQ16Base = some (beforeQ16Roles dag) := by
  exact ⟨q16_replay_history_records_discarded_branches fork,
    q16_replay_state_path_uses_only_current_clone fork,
    (q16_replay_prefix_phase_index_and_base_are_exact fork).2.1⟩

theorem earlier_q16_restoration_action_history_contains_discarded_branches
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (fork : Q16ChallengeFork dag)
    (earlier : fork.branch.counter.val <
      dag.tape.search.selectedCounter.val) :
    q16CommonPlanPrefix dag ++ priorDiscardedActions dag fork.branch.counter <+:
      (concreteRestoration execution (.q16 fork)).checkpoint.actionsBefore := by
  have notSelected :
      fork.branch.counter ≠ dag.tape.search.selectedCounter := by
    intro equal
    have equalValues := congrArg Fin.val equal
    omega
  simpa [ConcreteRestorationRecord.checkpoint, concreteRestoration,
    checkpointForGenerated, q16Checkpoint, notSelected] using
      q16_checkpoint_history_contains_completed_discarded_branches fork earlier

theorem q16_restoration_current_path_begins_at_one_saved_base
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (fork : Q16ChallengeFork dag) :
    let restoration := concreteRestoration execution (.q16 fork)
    [.markQ16Base,
      .q16CandidateAbsorb fork.branch.counter
        (dag.tape.search.outcome fork.branch.counter)
        (decide (fork.branch.counter = dag.tape.search.selectedCounter))] <+:
      [.markQ16Base] ++
        [.q16CandidateAbsorb fork.branch.counter
          (dag.tape.search.outcome fork.branch.counter)
          (decide (fork.branch.counter = dag.tape.search.selectedCounter))] ++
        (q16SqueezeActions fork.branch.counter
          (dag.tape.search.outcome fork.branch.counter)).take
            restoration.checkpoint.block := by
  simpa [ConcreteRestorationRecord.checkpoint, concreteRestoration,
    checkpointForGenerated, q16Checkpoint] using
      q16_current_core_path_starts_at_saved_base fork

/-! ## Functional uniqueness -/

def IsConcreteRestorationOf {table : FixedOracleTable}
    {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (generated : GeneratedReplayPrefix dag)
    (restoration : ConcreteRestorationRecord table dag) : Prop :=
  restoration.sourceExecution = execution ∧
    restoration.generatedPrefix = generated

theorem concrete_restoration_exists_unique
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (generated : GeneratedReplayPrefix dag) :
    ∃! restoration : ConcreteRestorationRecord table dag,
      IsConcreteRestorationOf execution generated restoration := by
  refine ⟨concreteRestoration execution generated, ⟨rfl, rfl⟩, ?_⟩
  intro other hmatch
  rcases hmatch with ⟨hsource, hgenerated⟩
  cases other
  simp only at hsource hgenerated
  cases hsource
  cases hgenerated
  rfl

theorem concrete_restoration_phase_is_functional
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (generated : GeneratedReplayPrefix dag) :
    ∃! phase : VerifierPhase,
      phase = (concreteRestoration execution generated).snapshot.phase := by
  exact ⟨_, rfl, by intro other equal; exact equal⟩

