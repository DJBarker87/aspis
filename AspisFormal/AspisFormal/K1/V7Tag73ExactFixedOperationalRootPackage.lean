import AspisFormal.K1.V7Tag73ExactFixedInstanceEvent
import AspisFormal.K1.V7Tag73RootForcedFullProjection
import AspisFormal.K1.V7Tag73ExactProbabilityCoverageAudit
import AspisFormal.K1.V7Tag73ExactPlainRomTraceResourceCaps

/-!
# Fixed-instance operational root package for exact Tag-73 K1.6

This leaf packages the compiler facts that are already forced by membership
in the literal fixed-instance clean event.  It is deliberately below the
K1.2--K1.5 interface and below the restored-child lineage theorem:

* the deployed initial-only scheduler returned the fixed accepted proof;
* that successful root forces the result-carrying scheduler to complete;
* the completed full run has the literal projected root and append-only node
  store;
* the one sampled full-256 trace is chronologically target-clean; and
* its machine-fresh and atomic-fork coordinates satisfy the exact `M, 2R`
  caps.

No witness, extraction success, compiler cover, restore function, or
probability conclusion is a field.  The later child-lineage module extends
this root package with the concrete operational certificate for every node
actually generated by the restoration client.
-/

set_option autoImplicit false

namespace AspisK1.V7Tag73ExactFixedOperationalRootPackage

open AspisK1.V7FsAokExperiment
open AspisK1.V7Tag73RawFutureFreeDriver
open AspisK1.V7Tag73CanonicalFutureFreeFuel
open AspisK1.V7Tag73ExactCompilerResources
open AspisK1.V7Tag73ExactPlainRomRun
open AspisK1.V7Tag73ExactSourceAcceptanceModel
open AspisK1.V7Tag73ExactFixedInstanceEvent
open AspisK1.V7Tag73RootForcedFullProjection
open AspisK1.V7Tag73ExactProbabilityCoverageAudit
open AspisK1.V7Tag73ExactPlainRomTraceResourceCaps

noncomputable section

/-- Everything about the exact clean root and the completed full scheduler
that follows before reasoning about individual restored children. -/
structure ExactFixedCleanCompletedRootPackage
    {HiddenTape TapeIdentity Observation Statement Proof Payload Result : Type}
    {parameters : ExactCompilerResourceParameters}
    (transitionFuel : Nat)
    (configuration : ExactPlainRomConfiguration HiddenTape TapeIdentity
      Observation Statement Proof Payload Result parameters)
    (projection : AcceptedTapeProjection Statement Proof Payload)
    (fixedInstance : PublicInstance Statement)
    (sample : ExactCompilerSample HiddenTape parameters) : Type where
  fixedRoot : ExactFixedCleanSourceRootProjection transitionFuel configuration
    projection fixedInstance sample
  full : RootForcedCompletedFullProjection transitionFuel configuration sample
    fixedRoot.base.runtime
  wholeTraceClean : ExactCompilerWholeTraceCleanFacts parameters transitionFuel
    (exactPlainRomCursor configuration sample.1) sample.2
  traceCaps : TraceCoordinateCaps (full256MachineFreshCap parameters)
    (sameTapeStartCap parameters)
    (runExactPlainRom transitionFuel configuration sample).trace

/-- A literal fixed clean-event member constructs the entire root package.
The only additional hypotheses are static operational adequacy bounds: three
units of scheduler transition fuel and enough verifier-driver fuel for the
deployed Tag-73 schedule. -/
theorem fixed_legal_member_has_completed_root_package
    {HiddenTape TapeIdentity Observation Statement Proof Payload Result : Type}
    {parameters : ExactCompilerResourceParameters}
    (transitionFuel : Nat)
    (configuration : ExactPlainRomConfiguration HiddenTape TapeIdentity
      Observation Statement Proof Payload Result parameters)
    (projection : AcceptedTapeProjection Statement Proof Payload)
    (fixedInstance : PublicInstance Statement)
    (transitionRoom : 3 ≤ transitionFuel)
    (driverCoversProtocol :
      tag73CanonicalDriverFuelCap ≤ configuration.machine.driverFuel)
    (sample : ExactCompilerSample HiddenTape parameters)
    (member : sample ∈ exactFixedPlainRomLegalSameTapeEvent transitionFuel
      configuration projection fixedInstance) :
    Nonempty (ExactFixedCleanCompletedRootPackage transitionFuel configuration
      projection fixedInstance sample) := by
  let fixedRoot := fixed_legal_event_constructs_exact_clean_root transitionFuel
    (by omega) configuration projection fixedInstance driverCoversProtocol
      sample member
  let full := completed_root_forces_full_projection transitionFuel configuration
    sample fixedRoot.base.runtime fixedRoot.base.clientRun transitionRoom
      fixedRoot.base.rootCompleted
  have wholeTraceClean : ExactCompilerWholeTraceCleanFacts parameters
      transitionFuel (exactPlainRomCursor configuration sample.1) sample.2 :=
    exact_compiler_target_clean_has_whole_trace_facts parameters transitionFuel
      (exactPlainRomCursor configuration sample.1) sample.2
        fixedRoot.base.targetClean
  have traceCaps : TraceCoordinateCaps (full256MachineFreshCap parameters)
      (sameTapeStartCap parameters)
      (runExactPlainRom transitionFuel configuration sample).trace :=
    run_exact_plain_rom_trace_has_M_and_2R_caps transitionFuel configuration
      sample transitionRoom
  exact ⟨
    { fixedRoot := fixedRoot
      full := full
      wholeTraceClean := wholeTraceClean
      traceCaps := traceCaps }⟩

/-- Chosen proof-relevant package, selected only from the proved `Nonempty`
constructor above. -/
noncomputable def fixed_legal_member_completed_root_package
    {HiddenTape TapeIdentity Observation Statement Proof Payload Result : Type}
    {parameters : ExactCompilerResourceParameters}
    (transitionFuel : Nat)
    (configuration : ExactPlainRomConfiguration HiddenTape TapeIdentity
      Observation Statement Proof Payload Result parameters)
    (projection : AcceptedTapeProjection Statement Proof Payload)
    (fixedInstance : PublicInstance Statement)
    (transitionRoom : 3 ≤ transitionFuel)
    (driverCoversProtocol :
      tag73CanonicalDriverFuelCap ≤ configuration.machine.driverFuel)
    (sample : ExactCompilerSample HiddenTape parameters)
    (member : sample ∈ exactFixedPlainRomLegalSameTapeEvent transitionFuel
      configuration projection fixedInstance) :
    ExactFixedCleanCompletedRootPackage transitionFuel configuration projection
      fixedInstance sample :=
  Classical.choice
    (fixed_legal_member_has_completed_root_package transitionFuel configuration
      projection fixedInstance transitionRoom driverCoversProtocol sample
        member)

/-- The completed result-carrying run uses the same hidden-tape identity as
the exact deployed root returned on this sample. -/
theorem completed_root_package_same_hidden_tape
    {HiddenTape TapeIdentity Observation Statement Proof Payload Result : Type}
    {parameters : ExactCompilerResourceParameters}
    {transitionFuel : Nat}
    {configuration : ExactPlainRomConfiguration HiddenTape TapeIdentity
      Observation Statement Proof Payload Result parameters}
    {projection : AcceptedTapeProjection Statement Proof Payload}
    {fixedInstance : PublicInstance Statement}
    {sample : ExactCompilerSample HiddenTape parameters}
    (package : ExactFixedCleanCompletedRootPackage transitionFuel configuration
      projection fixedInstance sample) :
    package.fixedRoot.base.runtime.tapeIdentity =
      configuration.machine.tapeIdentity sample.1 :=
  package.full.projection.sameHiddenTapeIdentity

/-- The four deployed public bindings and opaque statement in the packaged
root are exactly those fixed before the hidden tape and ROM tape were sampled.
-/
theorem completed_root_package_preserves_fixed_instance
    {HiddenTape TapeIdentity Observation Statement Proof Payload Result : Type}
    {parameters : ExactCompilerResourceParameters}
    {transitionFuel : Nat}
    {configuration : ExactPlainRomConfiguration HiddenTape TapeIdentity
      Observation Statement Proof Payload Result parameters}
    {projection : AcceptedTapeProjection Statement Proof Payload}
    {fixedInstance : PublicInstance Statement}
    {sample : ExactCompilerSample HiddenTape parameters}
    (package : ExactFixedCleanCompletedRootPackage transitionFuel configuration
      projection fixedInstance sample) :
    package.fixedRoot.base.runtime.adversaryValue.1.publicProof.publicInstance =
      fixedInstance :=
  package.fixedRoot.fixedInstanceExact

#print axioms fixed_legal_member_has_completed_root_package
#print axioms fixed_legal_member_completed_root_package
#print axioms completed_root_package_same_hidden_tape
#print axioms completed_root_package_preserves_fixed_instance

end

end AspisK1.V7Tag73ExactFixedOperationalRootPackage
