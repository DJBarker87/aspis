open AspisK1.V7Tag73ResourceLazyOracle
open AspisK1.V7Tag73AtomicForkUniformScheduler
open AspisK1.V7Tag73ConcreteKnowledgeInsertion

noncomputable section

/-! ## The exact strict finite probability space -/

/-- The cap list used by the unified Tag-73 scheduler. -/
def strictSchedulerCaps (envelope : StrictTag73ResourceEnvelope) : List Nat :=
  tag73GlobalForwardReferenceCaps
    (strictUnifiedFull256ExposureCap envelope)
    (strictGlobalOracleCallCap envelope)

/-- One arbitrary hidden prover tape paired with the complete padded tape of
uniform 256-bit coordinates used by the strict scheduler. -/
abbrev StrictSchedulerSample (HiddenTape : Type)
    (envelope : StrictTag73ResourceEnvelope) :=
  HiddenTape × FreshAnswerTape Digest256 (strictSchedulerCaps envelope).length

/-- The literal joint law: arbitrary finite hidden-tape law followed by an
independent uniform fresh-answer tape of the fixed strict length. -/
def strictSchedulerJointLaw
    {HiddenTape : Type} [Fintype HiddenTape]
    (hiddenLaw : PMF HiddenTape) (envelope : StrictTag73ResourceEnvelope) :
    PMF (StrictSchedulerSample HiddenTape envelope) :=
  hiddenTapeUniformFreshJointLaw hiddenLaw
    (strictSchedulerCaps envelope).length

/-- The concrete target event generated by the same executable adaptive
cursor used by `runUnifiedExposureSchedule`. -/
def strictSchedulerTargetEvent
    {HiddenTape : Type}
    (envelope : StrictTag73ResourceEnvelope) (transitionFuel : Nat)
    (cursor : HiddenTape → UnifiedExposureCursor
      (strictGlobalOracleCallCap envelope)) :
    Set (StrictSchedulerSample HiddenTape envelope) :=
  hiddenDependentCausalHitEvent fun hidden =>
    strictUnifiedExposureTargetTree envelope transitionFuel (cursor hidden)

/-- Exact finite-count expression, valid even when `F = 0`. -/
def strictSchedulerExactCountError
    (envelope : StrictTag73ResourceEnvelope) : ENNReal :=
  ((tag73GlobalForwardReferenceCoefficient
      (strictUnifiedFull256ExposureCap envelope)
      (strictGlobalOracleCallCap envelope) *
    (2 ^ 256) ^ (strictUnifiedFull256ExposureCap envelope - 1) : Nat) :
      ENNReal) /
    (((2 : ENNReal) ^ 256) ^ strictUnifiedFull256ExposureCap envelope)

/-- Simplified positive-exposure expression.  This is not a BCS loss: its
coefficient is derived by the causal finite scheduler. -/
def strictSchedulerRawError
    (envelope : StrictTag73ResourceEnvelope) : ENNReal :=
  (tag73GlobalForwardReferenceCoefficient
      (strictUnifiedFull256ExposureCap envelope)
      (strictGlobalOracleCallCap envelope) : ENNReal) /
    ((2 : ENNReal) ^ 256)

/-- Composition-ready exact-count error.  It becomes the K1.6 raw extraction
error only after the missing operational acceptance inclusion is proved. -/
def strictCompositionExactCountError
    (terms : ConcreteUpstreamErrorTerms)
    (envelope : StrictTag73ResourceEnvelope) : ENNReal :=
  concreteUpstreamRawError terms + strictSchedulerExactCountError envelope

/-- Positive-exposure composition-ready error: four separately named
K1.2--K1.5 terms plus the one exact causal scheduler coefficient. -/
def strictCompositionRawError
    (terms : ConcreteUpstreamErrorTerms)
    (envelope : StrictTag73ResourceEnvelope) : ENNReal :=
  concreteUpstreamRawError terms + strictSchedulerRawError envelope

theorem strict_scheduler_caps_length_exact
    (envelope : StrictTag73ResourceEnvelope) :
    (strictSchedulerCaps envelope).length =
      envelope.full256FreshExposures + 2 * envelope.restorationCount := by
  exact strict_unified_target_caps_length_exact envelope

/-- The exact strict parameters exposed together for later resource audits. -/
theorem strict_scheduler_F_G_exact
    (envelope : StrictTag73ResourceEnvelope) :
    strictUnifiedFull256ExposureCap envelope =
        envelope.full256FreshExposures + 2 * envelope.restorationCount ∧
      strictGlobalOracleCallCap envelope =
        envelope.q1Calls + envelope.verifierOracleCalls +
          envelope.restorationCount * envelope.oracleCallsPerRestoration := by
  exact ⟨rfl, rfl⟩

/-- Kernel-visible expansion of the scheduler coefficient.  In particular,
the two coins per restoration are charged before the birthday and
forward-reference terms are formed. -/
theorem strict_scheduler_coefficient_exact
    (envelope : StrictTag73ResourceEnvelope) :
    tag73GlobalForwardReferenceCoefficient
        (strictUnifiedFull256ExposureCap envelope)
        (strictGlobalOracleCallCap envelope) =
      (envelope.full256FreshExposures +
          2 * envelope.restorationCount).choose 2 +
        (envelope.full256FreshExposures +
          2 * envelope.restorationCount) *
        (envelope.q1Calls + envelope.verifierOracleCalls +
          envelope.restorationCount *
            envelope.oracleCallsPerRestoration) := by
  exact strict_unified_target_coefficient_expansion envelope

theorem strict_scheduler_raw_error_expanded
    (envelope : StrictTag73ResourceEnvelope) :
    strictSchedulerRawError envelope =
      (((envelope.full256FreshExposures +
          2 * envelope.restorationCount).choose 2 +
        (envelope.full256FreshExposures +
          2 * envelope.restorationCount) *
        (envelope.q1Calls + envelope.verifierOracleCalls +
          envelope.restorationCount *
            envelope.oracleCallsPerRestoration) : Nat) : ENNReal) /
        ((2 : ENNReal) ^ 256) := by
  unfold strictSchedulerRawError
  rw [strict_scheduler_coefficient_exact]

theorem strict_composition_raw_error_expanded
    (terms : ConcreteUpstreamErrorTerms)
    (envelope : StrictTag73ResourceEnvelope) :
    strictCompositionRawError terms envelope =
      terms.k12TwoTreeMerkle208 + terms.k13CircleListDecoding +
        terms.k14CoherentChainSelection +
        terms.k15SpendWitnessRecovery +
      (((envelope.full256FreshExposures +
          2 * envelope.restorationCount).choose 2 +
        (envelope.full256FreshExposures +
          2 * envelope.restorationCount) *
        (envelope.q1Calls + envelope.verifierOracleCalls +
          envelope.restorationCount *
            envelope.oracleCallsPerRestoration) : Nat) : ENNReal) /
        ((2 : ENNReal) ^ 256) := by
  unfold strictCompositionRawError concreteUpstreamRawError
  rw [strict_scheduler_raw_error_expanded]

/-! ## Unconditional finite lazy-ROM target bounds -/

/-- Strong exact-count theorem for an arbitrary finite hidden-tape law.  The
cursor and every later target set may depend on earlier exposed coordinates;
causality is enforced by the scheduler tree itself. -/
theorem strict_scheduler_target_probability_le_exact_count
    {HiddenTape : Type} [Fintype HiddenTape]
    (hiddenLaw : PMF HiddenTape)
    (envelope : StrictTag73ResourceEnvelope)
    (transitionFuel : Nat)
    (cursor : HiddenTape → UnifiedExposureCursor
      (strictGlobalOracleCallCap envelope)) :
    (strictSchedulerJointLaw hiddenLaw envelope).toOuterMeasure
        (strictSchedulerTargetEvent envelope transitionFuel cursor) ≤
      strictSchedulerExactCountError envelope := by
  exact strict_unified_hidden_target_probability_le_exact_count hiddenLaw
    envelope transitionFuel cursor

/-- Positive-exposure specialization with the exact
`(choose(F,2) + F*G) / 2^256` expression. -/
theorem strict_scheduler_target_probability_le_raw_error
    {HiddenTape : Type} [Fintype HiddenTape]
    (hiddenLaw : PMF HiddenTape)
    (envelope : StrictTag73ResourceEnvelope)
    (positive : 0 < strictUnifiedFull256ExposureCap envelope)
    (transitionFuel : Nat)
    (cursor : HiddenTape → UnifiedExposureCursor
      (strictGlobalOracleCallCap envelope)) :
    (strictSchedulerJointLaw hiddenLaw envelope).toOuterMeasure
        (strictSchedulerTargetEvent envelope transitionFuel cursor) ≤
      strictSchedulerRawError envelope := by
  exact strict_unified_hidden_target_probability_le_div_two_pow_256
    hiddenLaw envelope positive transitionFuel cursor

/-! ## Strict query, restart, and runtime caps -/

/-- Actual total SHA calls recorded by the strict ledger.  The three work
search histories stay inside `q1`; they are not divided out or merged into a
new nonce allowance. -/
def ledgerGlobalOracleCalls (ledger : StrictTag73ResourceLedger) : Nat :=
  ledger.q1.length + ledger.verifierOracleCalls +
    restorationOracleCalls ledger

/-- Once the existing deterministic ledger theorem has established
`WithinBudget`, the exact global call, restart, and runtime ceilings follow
simultaneously. -/
theorem strict_ledger_query_restart_runtime_caps
    (ledger : StrictTag73ResourceLedger)
    (envelope : StrictTag73ResourceEnvelope)
    (within : WithinBudget (strictTag73ResourceUse ledger)
      (strictTag73ResourceBudget envelope)) :
    ledgerGlobalOracleCalls ledger ≤ strictGlobalOracleCallCap envelope ∧
      ledger.restorations.length ≤ envelope.restorationCount ∧
      ledger.firstRunRuntimeSteps + ledger.verifierRuntimeSteps +
          restorationRuntimeSteps ledger ≤
        envelope.firstRunRuntimeSteps + envelope.verifierRuntimeSteps +
          envelope.restorationCount *
            envelope.runtimeStepsPerRestoration := by
  unfold WithinBudget strictTag73ResourceUse strictTag73ResourceBudget at within
  rcases within with
    ⟨q1Bound, _simulatorBound, verifierBound, restorationCallsBound,
      _freshBound, _programmedBound, _simulatedProofBound, restartBound,
      runtimeBound, _batchBound, _foldBound, _finalBound,
      _candidateBound⟩
  change ledger.q1.length ≤ envelope.q1Calls at q1Bound
  change ledger.verifierOracleCalls ≤ envelope.verifierOracleCalls at verifierBound
  change restorationOracleCalls ledger ≤
    envelope.restorationCount * envelope.oracleCallsPerRestoration at restorationCallsBound
  change ledger.restorations.length ≤ envelope.restorationCount at restartBound
  change ledger.firstRunRuntimeSteps + ledger.verifierRuntimeSteps +
      restorationRuntimeSteps ledger ≤
    envelope.firstRunRuntimeSteps + envelope.verifierRuntimeSteps +
      envelope.restorationCount * envelope.runtimeStepsPerRestoration at runtimeBound
  constructor
  · unfold ledgerGlobalOracleCalls strictGlobalOracleCallCap
    omega
  · exact ⟨restartBound, runtimeBound⟩

/-- The three prover work-search regions remain three distinct ledger
inequalities.  They are already included in Q1 and are never used as a
denominator in the extraction error. -/
theorem strict_ledger_three_work_stage_caps
    (ledger : StrictTag73ResourceLedger)
    (envelope : StrictTag73ResourceEnvelope)
    (within : WithinBudget (strictTag73ResourceUse ledger)
      (strictTag73ResourceBudget envelope)) :
    ledger.batchGrindingQueries ≤ envelope.batchGrindingQueries ∧
      ledger.foldGrindingQueries ≤ envelope.foldGrindingQueries ∧
      ledger.finalGrindingQueries ≤ envelope.finalGrindingQueries := by
  unfold WithinBudget strictTag73ResourceUse strictTag73ResourceBudget at within
  rcases within with
    ⟨_q1Bound, _simulatorBound, _verifierBound, _restorationCallsBound,
      _freshBound, _programmedBound, _simulatedProofBound, _restartBound,
      _runtimeBound, batchBound, foldBound, finalBound,
      _candidateBound⟩
  exact ⟨batchBound, foldBound, finalBound⟩

/-- The strict experiment is the ordinary plain-ROM experiment: its budget
permits neither simulator calls nor previously simulated proofs.  Thus no WUR
or canonical-simulation term is silently included in the raw error. -/
theorem strict_budget_excludes_observed_proof_simulation
    (use : ResourceUse) (envelope : StrictTag73ResourceEnvelope)
    (within : WithinBudget use (strictTag73ResourceBudget envelope)) :
    use.simulatorOracleCalls = 0 ∧ use.simulatedProofs = 0 := by
  unfold WithinBudget strictTag73ResourceBudget at within
  exact ⟨Nat.eq_zero_of_le_zero within.2.1,
    Nat.eq_zero_of_le_zero within.2.2.2.2.2.2.1⟩

/-- The deployed verifier's complete SHA schedule fits any strict envelope
whose verifier component reserves the proved 1979-call ceiling. -/
theorem deployed_verifier_calls_fit_strict_envelope
    (envelope : StrictTag73ResourceEnvelope)
    (reservesDeployedVerifier : 1979 ≤ envelope.verifierOracleCalls)
    (messages : AspisK1.V7Tag73TranscriptSchedule.Messages)
    {frontierNodes : AspisK1.V7Tag73TranscriptSchedule.QuerySchedule → Nat}
    (search : AspisK1.V7Tag73TranscriptSchedule.FirstCap203Search
      frontierNodes) :
    tag73VerifierOracleCalls messages search ≤
      envelope.verifierOracleCalls :=
  (tag73_verifier_oracle_calls_le messages search).trans
    reservesDeployedVerifier

/-- The full-256 portion alone has the separately proved 1511-call ceiling;
the remaining 468 calls are the two typed Merkle authentication trees. -/
theorem deployed_full256_verifier_calls_fit_strict_envelope
    (envelope : StrictTag73ResourceEnvelope)
    (reservesFull256Verifier : 1511 ≤ envelope.full256FreshExposures)
    (messages : AspisK1.V7Tag73TranscriptSchedule.Messages)
    {frontierNodes : AspisK1.V7Tag73TranscriptSchedule.QuerySchedule → Nat}
    (search : AspisK1.V7Tag73TranscriptSchedule.FirstCap203Search
      frontierNodes) :
    tag73Full256VerifierOracleCalls messages search ≤
      envelope.full256FreshExposures :=
  (tag73_full256_verifier_oracle_calls_le_1511 messages search).trans
    reservesFull256Verifier

/-! ## One joint observed-proof experiment with the strict law and budget -/

/-- Observed-proof experiment data whose law and budget are fixed
definitionally to the strict finite scheduler experiment.  This carries no
acceptance-to-interactive cover and no extractor-correctness field. -/
structure StrictJointObservedProofExperiment
    (HiddenTape : Type) (TapeIdentity Statement Proof Witness : Type*)
    [Fintype HiddenTape]
    (envelope : StrictTag73ResourceEnvelope) where
  hiddenLaw : PMF HiddenTape
  outcome : StrictSchedulerSample HiddenTape envelope →
    ExperimentOutcome TapeIdentity Statement Proof Witness
  relation : PublicInstance Statement → Witness → Prop

def StrictJointObservedProofExperiment.toObservedProofExperiment
    {HiddenTape : Type}
    {TapeIdentity Statement Proof Witness : Type*}
    {envelope : StrictTag73ResourceEnvelope}
    [Fintype HiddenTape]
    [MeasurableSpace (StrictSchedulerSample HiddenTape envelope)]
    (experiment : StrictJointObservedProofExperiment HiddenTape TapeIdentity
      Statement Proof Witness envelope) :
    ObservedProofExperiment (StrictSchedulerSample HiddenTape envelope)
      TapeIdentity Statement Proof Witness where
  law := strictSchedulerJointLaw experiment.hiddenLaw envelope
  outcome := experiment.outcome
  relation := experiment.relation
  budget := strictTag73ResourceBudget envelope

@[simp] theorem strict_joint_observed_law_is_exact
    {HiddenTape : Type}
    {TapeIdentity Statement Proof Witness : Type*}
    {envelope : StrictTag73ResourceEnvelope}
    [Fintype HiddenTape]
    [MeasurableSpace (StrictSchedulerSample HiddenTape envelope)]
    (experiment : StrictJointObservedProofExperiment HiddenTape TapeIdentity
      Statement Proof Witness envelope) :
    experiment.toObservedProofExperiment.law =
      strictSchedulerJointLaw experiment.hiddenLaw envelope := by
  rfl

@[simp] theorem strict_joint_observed_budget_is_exact
    {HiddenTape : Type}
    {TapeIdentity Statement Proof Witness : Type*}
    {envelope : StrictTag73ResourceEnvelope}
    [Fintype HiddenTape]
    [MeasurableSpace (StrictSchedulerSample HiddenTape envelope)]
    (experiment : StrictJointObservedProofExperiment HiddenTape TapeIdentity
      Statement Proof Witness envelope) :
    experiment.toObservedProofExperiment.budget =
      strictTag73ResourceBudget envelope := by
  rfl

/-! ## Composition-ready AoK arithmetic -/

/-- Exact-count form.  The only theorem premise is the precisely typed
K1.2--K1.5 knowledge inequality on the concrete interactive event.  The
scheduler probability bound is proved above, not supplied by the caller.

This deliberately does **not** replace the left side by Fiat--Shamir
acceptance.  That final replacement needs the concrete operational inclusion
from fresh acceptance outside `strictSchedulerTargetEvent` into
`concreteInteractiveKnowledgeSet`. -/
theorem concrete_upstream_plus_strict_scheduler_exact_count_le
    {HiddenTape : Type}
    {TapeIdentity Observation Statement Proof Witness Result : Type*}
    {envelope : StrictTag73ResourceEnvelope}
    [Fintype HiddenTape]
    [MeasurableSpace (StrictSchedulerSample HiddenTape envelope)]
    (joint : StrictJointObservedProofExperiment HiddenTape TapeIdentity
      Statement Proof Witness envelope)
    (world : ConcreteK12ToK15World
      (StrictSchedulerSample HiddenTape envelope) HiddenTape TapeIdentity
      Observation Statement Proof Result)
    (polynomialLoss : ENNReal) (terms : ConcreteUpstreamErrorTerms)
    (transitionFuel : Nat)
    (cursor : HiddenTape → UnifiedExposureCursor
      (strictGlobalOracleCallCap envelope))
    (upstream : UpstreamConcreteK12ToK15KnowledgeInequality
      joint.toObservedProofExperiment world polynomialLoss terms) :
    concreteInteractiveKnowledgeProbability
        joint.toObservedProofExperiment world +
      joint.toObservedProofExperiment.law.toOuterMeasure
        (strictSchedulerTargetEvent envelope transitionFuel cursor) ≤
      polynomialLoss * concreteValidExtractionProbability
          joint.toObservedProofExperiment +
        strictCompositionExactCountError terms envelope := by
  have targetBound :=
    strict_scheduler_target_probability_le_exact_count joint.hiddenLaw
      envelope transitionFuel cursor
  have targetBound' :
      joint.toObservedProofExperiment.law.toOuterMeasure
          (strictSchedulerTargetEvent envelope transitionFuel cursor) ≤
        strictSchedulerExactCountError envelope := by
    simpa using targetBound
  calc
    concreteInteractiveKnowledgeProbability
          joint.toObservedProofExperiment world +
        joint.toObservedProofExperiment.law.toOuterMeasure
          (strictSchedulerTargetEvent envelope transitionFuel cursor) ≤
      concreteInteractiveKnowledgeProbability
          joint.toObservedProofExperiment world +
        strictSchedulerExactCountError envelope :=
      add_le_add_right targetBound' _
    _ ≤
      (polynomialLoss * concreteValidExtractionProbability
          joint.toObservedProofExperiment + concreteUpstreamRawError terms) +
        strictSchedulerExactCountError envelope :=
      by
        simpa [add_comm] using
          (add_le_add_right upstream (strictSchedulerExactCountError envelope))
    _ = polynomialLoss * concreteValidExtractionProbability
          joint.toObservedProofExperiment +
        strictCompositionExactCountError terms envelope := by
      unfold strictCompositionExactCountError
      ac_rfl

/-- Positive-exposure form with the transparent
`(choose(F,2)+F*G)/2^256` compiler-side term. -/
theorem concrete_upstream_plus_strict_scheduler_raw_le
    {HiddenTape : Type}
    {TapeIdentity Observation Statement Proof Witness Result : Type*}
    {envelope : StrictTag73ResourceEnvelope}
    [Fintype HiddenTape]
    [MeasurableSpace (StrictSchedulerSample HiddenTape envelope)]
    (joint : StrictJointObservedProofExperiment HiddenTape TapeIdentity
      Statement Proof Witness envelope)
    (world : ConcreteK12ToK15World
      (StrictSchedulerSample HiddenTape envelope) HiddenTape TapeIdentity
      Observation Statement Proof Result)
    (polynomialLoss : ENNReal) (terms : ConcreteUpstreamErrorTerms)
    (positive : 0 < strictUnifiedFull256ExposureCap envelope)
    (transitionFuel : Nat)
    (cursor : HiddenTape → UnifiedExposureCursor
      (strictGlobalOracleCallCap envelope))
    (upstream : UpstreamConcreteK12ToK15KnowledgeInequality
      joint.toObservedProofExperiment world polynomialLoss terms) :
    concreteInteractiveKnowledgeProbability
        joint.toObservedProofExperiment world +
      joint.toObservedProofExperiment.law.toOuterMeasure
        (strictSchedulerTargetEvent envelope transitionFuel cursor) ≤
      polynomialLoss * concreteValidExtractionProbability
          joint.toObservedProofExperiment +
        strictCompositionRawError terms envelope := by
  have targetBound :=
    strict_scheduler_target_probability_le_raw_error joint.hiddenLaw envelope
      positive transitionFuel cursor
  have targetBound' :
      joint.toObservedProofExperiment.law.toOuterMeasure
          (strictSchedulerTargetEvent envelope transitionFuel cursor) ≤
        strictSchedulerRawError envelope := by
    simpa using targetBound
  calc
    concreteInteractiveKnowledgeProbability
          joint.toObservedProofExperiment world +
        joint.toObservedProofExperiment.law.toOuterMeasure
          (strictSchedulerTargetEvent envelope transitionFuel cursor) ≤
      concreteInteractiveKnowledgeProbability
          joint.toObservedProofExperiment world +
        strictSchedulerRawError envelope :=
      add_le_add_right targetBound' _
    _ ≤
      (polynomialLoss * concreteValidExtractionProbability
          joint.toObservedProofExperiment + concreteUpstreamRawError terms) +
        strictSchedulerRawError envelope :=
      by
        simpa [add_comm] using
          (add_le_add_right upstream (strictSchedulerRawError envelope))
    _ = polynomialLoss * concreteValidExtractionProbability
          joint.toObservedProofExperiment +
        strictCompositionRawError terms envelope := by
      unfold strictCompositionRawError
      ac_rfl

/-- Direct union-event form of the exact-count theorem.  This is the precise
right-hand event into which the operational lane must inject fresh deployed
acceptance. -/
theorem concrete_interactive_union_strict_scheduler_exact_count_le
    {HiddenTape : Type}
    {TapeIdentity Observation Statement Proof Witness Result : Type*}
    {envelope : StrictTag73ResourceEnvelope}
    [Fintype HiddenTape]
    [MeasurableSpace (StrictSchedulerSample HiddenTape envelope)]
    (joint : StrictJointObservedProofExperiment HiddenTape TapeIdentity
      Statement Proof Witness envelope)
    (world : ConcreteK12ToK15World
      (StrictSchedulerSample HiddenTape envelope) HiddenTape TapeIdentity
      Observation Statement Proof Result)
    (polynomialLoss : ENNReal) (terms : ConcreteUpstreamErrorTerms)
    (transitionFuel : Nat)
    (cursor : HiddenTape → UnifiedExposureCursor
      (strictGlobalOracleCallCap envelope))
    (upstream : UpstreamConcreteK12ToK15KnowledgeInequality
      joint.toObservedProofExperiment world polynomialLoss terms) :
    joint.toObservedProofExperiment.law.toOuterMeasure
        (concreteInteractiveKnowledgeSet
            joint.toObservedProofExperiment world ∪
          strictSchedulerTargetEvent envelope transitionFuel cursor) ≤
      polynomialLoss * concreteValidExtractionProbability
          joint.toObservedProofExperiment +
        strictCompositionExactCountError terms envelope := by
  calc
    joint.toObservedProofExperiment.law.toOuterMeasure
        (concreteInteractiveKnowledgeSet
            joint.toObservedProofExperiment world ∪
          strictSchedulerTargetEvent envelope transitionFuel cursor) ≤
      concreteInteractiveKnowledgeProbability
          joint.toObservedProofExperiment world +
        joint.toObservedProofExperiment.law.toOuterMeasure
          (strictSchedulerTargetEvent envelope transitionFuel cursor) := by
      simpa [concreteInteractiveKnowledgeProbability] using
        (measure_union_le
          (μ := joint.toObservedProofExperiment.law.toOuterMeasure)
          (concreteInteractiveKnowledgeSet
            joint.toObservedProofExperiment world)
          (strictSchedulerTargetEvent envelope transitionFuel cursor))
    _ ≤ polynomialLoss * concreteValidExtractionProbability
          joint.toObservedProofExperiment +
        strictCompositionExactCountError terms envelope :=
      concrete_upstream_plus_strict_scheduler_exact_count_le joint world
        polynomialLoss terms transitionFuel cursor upstream

/-- Direct union-event form with the simplified positive-exposure raw error. -/
theorem concrete_interactive_union_strict_scheduler_raw_le
    {HiddenTape : Type}
    {TapeIdentity Observation Statement Proof Witness Result : Type*}
    {envelope : StrictTag73ResourceEnvelope}
    [Fintype HiddenTape]
    [MeasurableSpace (StrictSchedulerSample HiddenTape envelope)]
    (joint : StrictJointObservedProofExperiment HiddenTape TapeIdentity
      Statement Proof Witness envelope)
    (world : ConcreteK12ToK15World
      (StrictSchedulerSample HiddenTape envelope) HiddenTape TapeIdentity
      Observation Statement Proof Result)
    (polynomialLoss : ENNReal) (terms : ConcreteUpstreamErrorTerms)
    (positive : 0 < strictUnifiedFull256ExposureCap envelope)
    (transitionFuel : Nat)
    (cursor : HiddenTape → UnifiedExposureCursor
      (strictGlobalOracleCallCap envelope))
    (upstream : UpstreamConcreteK12ToK15KnowledgeInequality
      joint.toObservedProofExperiment world polynomialLoss terms) :
    joint.toObservedProofExperiment.law.toOuterMeasure
        (concreteInteractiveKnowledgeSet
            joint.toObservedProofExperiment world ∪
          strictSchedulerTargetEvent envelope transitionFuel cursor) ≤
      polynomialLoss * concreteValidExtractionProbability
          joint.toObservedProofExperiment +
        strictCompositionRawError terms envelope := by
  calc
    joint.toObservedProofExperiment.law.toOuterMeasure
        (concreteInteractiveKnowledgeSet
            joint.toObservedProofExperiment world ∪
          strictSchedulerTargetEvent envelope transitionFuel cursor) ≤
      concreteInteractiveKnowledgeProbability
          joint.toObservedProofExperiment world +
        joint.toObservedProofExperiment.law.toOuterMeasure
          (strictSchedulerTargetEvent envelope transitionFuel cursor) := by
