/-! ## Root-only operational initialization -/

/-- The only node without a parent request is the runtime root.  Its prover
starts with no programmed points, and ordinary oracle queries preserve that
empty ledger.  Its verifier checkpoints are generated by the already-emitted
root trace.  The exact plain-ROM root constructor discharges these facts from
`emptyOracle`; they are separated here only to keep the from-root induction
generic. -/
structure RootCausalInitialization
    {Statement Proof Payload : Type u}
    (root : ConcreteRestorationNode Statement Proof Payload)
    (rootTrace : List UnifiedExposureRecord) : Prop where
  parentRequestNone : root.parentRequest = none
  proverEntryProgrammingEmpty :
    root.proverEntryOracle.programmingHistory = []
  proverFinalProgrammingEmpty :
    root.proverFinalOracle.programmingHistory = []
  transitionDigestProvenance :
    ∀ transitionIndex transition,
      verifierTransitionAt? root transitionIndex = some transition →
        transition.before.core.digest = zeroDigest256 ∨
          ActiveExposureAnswer transition.before.core.digest rootTrace
  transitionQ16BaseProvenance :
    ∀ transitionIndex transition base,
      verifierTransitionAt? root transitionIndex = some transition →
      transition.before.core.q16Base = some base →
        base = zeroDigest256 ∨ ActiveExposureAnswer base rootTrace

/-- Append-only scheduler traces preserve every root digest witness. -/
def RootCausalInitialization.appendTrace
    {Statement Proof Payload : Type u}
    {root : ConcreteRestorationNode Statement Proof Payload}
    {rootTrace : List UnifiedExposureRecord}
    (initial : RootCausalInitialization root rootTrace)
    (suffix : List UnifiedExposureRecord) :
    RootCausalInitialization root (rootTrace ++ suffix) :=
  { parentRequestNone := initial.parentRequestNone
    proverEntryProgrammingEmpty := initial.proverEntryProgrammingEmpty
    proverFinalProgrammingEmpty := initial.proverFinalProgrammingEmpty
    transitionDigestProvenance := by
      intro transitionIndex transition found
      rcases initial.transitionDigestProvenance transitionIndex transition
          found with atZero | active
      · exact Or.inl atZero
      · rcases active with ⟨record, member, answerExact⟩
        exact Or.inr ⟨record, List.mem_append_left suffix member,
          answerExact⟩
    transitionQ16BaseProvenance := by
      intro transitionIndex transition base found saved
      rcases initial.transitionQ16BaseProvenance transitionIndex transition base
          found saved with atZero | active
      · exact Or.inl atZero
      · rcases active with ⟨record, member, answerExact⟩
        exact Or.inr ⟨record, List.mem_append_left suffix member,
          answerExact⟩ }

/-! ## Historical half of the final node certificate -/

/-- Causal data that is independent of the later cached/fresh reply
classification.  It already proves the exact request discipline and the full
inherited programming-ledger chronology required by
`CausallyProvenancedRestorationNodeExecution`. -/
structure HistoricallyProvenancedRestorationNodeExecution
    {Statement Proof Payload Final : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (fullTrace : List UnifiedExposureRecord)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (child : ConcreteRestorationNode Statement Proof Payload) : Type u where
  base : ProjectedRestorationNodeExecution (Final := Final) startProgram environment
    configuration fullTrace accumulator child
  requestIsStructurallyFresh :
    StructurallyFreshRestorationRequest base.prepared.request
  programmingHistoryHasEarlierPairProvenance :
    ∀ record ∈ child.proverEntryOracle.programmingHistory,
      ∃ (earlier : ScheduledForkCoins)
          (earlierBefore earlierAfter : List UnifiedExposureRecord)
          (inputState : Digest256),
        base.traceBeforePair ++ scheduledPairRecords base.scheduled =
          earlierBefore ++ scheduledPairRecords earlier ++ earlierAfter ∧
        ScheduledPairPrograms earlier record ∧
        ScheduledPairInputState earlier inputState ∧
        (inputState = zeroDigest256 ∨
          ActiveExposureAnswer inputState earlierBefore)

def EveryNodeOperationalWithHistoricalProvenance
    {Statement Proof Payload Final : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (fullTrace : List UnifiedExposureRecord)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload) :
    Prop :=
  ∀ child ∈ accumulator.nodes,
    child.parentRequest ≠ none →
      Nonempty (HistoricallyProvenancedRestorationNodeExecution
        (Final := Final) startProgram environment configuration fullTrace
        accumulator child)

/-! ## Whole-trace table-output provenance -/

/-- Every answer retained in an oracle table is either the public dummy
digest or has already been emitted by a nonpadding coordinate of the actual
unified scheduler trace.  This is an operational invariant: it mentions no
target-clean event and does not assert that a lookup is fresh. -/
def OracleTableOutputsHaveGlobalOrigin
    (state : OracleState) (fullTrace : List UnifiedExposureRecord) : Prop :=
  ∀ entry ∈ state.table,
    entry.output = zeroDigest256 ∨
      ActiveExposureAnswer entry.output fullTrace

/-- Every query record in a completed machine segment still has a matching
entry in the segment's final immutable table. -/
def SegmentHistoryAnswersRetained
    (entryState finalState : OracleState) : Prop :=
  ∀ record ∈ historySince entryState finalState,
    ∃ entry ∈ finalState.table,
      entry.input = record.input ∧ entry.output = record.output

/-- Appending scheduler coordinates cannot invalidate an existing table
answer origin. -/
theorem oracle_table_outputs_have_global_origin_append
    (state : OracleState) (trace suffix : List UnifiedExposureRecord)
    (origins : OracleTableOutputsHaveGlobalOrigin state trace) :
    OracleTableOutputsHaveGlobalOrigin state (trace ++ suffix) := by
  intro entry member
  rcases origins entry member with atZero | active
  · exact Or.inl atZero
  · rcases active with ⟨record, recordMember, answerExact⟩
    exact Or.inr ⟨record, List.mem_append_left suffix recordMember,
      answerExact⟩

/-- A successful fixed-table lookup selects a literal retained table entry,
so the table-output invariant classifies its answer. -/
theorem table_lookup_answer_has_global_origin
    (state : OracleState) (trace : List UnifiedExposureRecord)
    (origins : OracleTableOutputsHaveGlobalOrigin state trace)
    (input : ShaInput) (answer : Digest256)
    (found : tableLookup (fixedTableOfOracleState state) input = some answer) :
    answer = zeroDigest256 ∨ ActiveExposureAnswer answer trace := by
  rw [fixed_table_lookup_eq_lookup_entry_output] at found
  cases selected : lookupEntry state input with
  | none => simp [selected] at found
  | some entry =>
      have answerExact : entry.output = answer := by
        simpa [selected] using found
      unfold lookupEntry at selected
      have member : entry ∈ state.table := List.mem_of_find?_eq_some selected
      rcases origins entry member with atZero | active
      · exact Or.inl (by simpa [answerExact] using atZero)
      · rcases active with ⟨record, recordMember, outputExact⟩
        exact Or.inr ⟨record, recordMember, by
          simpa [answerExact] using outputExact⟩

/-- Membership in the machine-fresh projection retains the literal unified
exposure record that supplied that answer. -/
theorem machine_fresh_answer_mem_has_active_origin
    (records : List UnifiedExposureRecord) (answer : Digest256)
    (member : answer ∈ machineFreshAnswers records) :
    ActiveExposureAnswer answer records := by
  induction records with
  | nil => simp [machineFreshAnswers] at member
  | cons record rest ih =>
      cases record with
      | padding paddingAnswer =>
          rcases ih member with ⟨witness, witnessMember, exactAnswer⟩
          exact ⟨witness, List.mem_cons_of_mem _ witnessMember, exactAnswer⟩
      | machineFresh actor input freshAnswer =>
          simp only [machineFreshAnswers, List.mem_cons] at member
          rcases member with rfl | tailMember
          · exact ⟨.machineFresh actor input answer, by simp, rfl⟩
          · rcases ih tailMember with ⟨witness, witnessMember, exactAnswer⟩
            exact ⟨witness, List.mem_cons_of_mem _ witnessMember, exactAnswer⟩
      | forkOutput frozen outputInput advanceInput template forkOutput =>
          rcases ih member with ⟨witness, witnessMember, exactAnswer⟩
          exact ⟨witness, List.mem_cons_of_mem _ witnessMember, exactAnswer⟩
      | forkAdvance scheduled =>
          rcases ih member with ⟨witness, witnessMember, exactAnswer⟩
          exact ⟨witness, List.mem_cons_of_mem _ witnessMember, exactAnswer⟩

/-- A fresh-origin history record contributes its output to the exact fresh
answer enumeration. -/
theorem fresh_record_output_mem_fresh_answer_enumeration
    (records : List QueryRecord) (record : QueryRecord)
    (member : record ∈ records) (fresh : record.origin = .fresh) :
    record.output ∈ freshAnswerEnumeration records := by
  induction records with
  | nil => simp at member
  | cons head tail ih =>
      simp only [List.mem_cons] at member
      rcases member with rfl | tailMember
      · simp [freshAnswerEnumeration, fresh]
      · rcases head with ⟨input, output, actor, origin⟩
        cases origin <;>
          simp only [freshAnswerEnumeration, List.mem_cons]
        · exact Or.inr (ih tailMember)
        · exact ih tailMember
        · exact ih tailMember

/-- The concrete query path behind a returned projected segment proves that
all of its chronological query records remain represented in the final table.
This includes cached calls and does not require target cleanliness. -/
theorem projected_machine_prefix_retains_every_segment_answer
    {Result : Type u}
    (limits : OracleLimits) (actor : QueryActor) (fuel : Nat)
    (state : OracleState) (program : OracleMachine Result)
    (available : List Digest256)
    (returned : ProjectedMachinePrefixReturned limits actor fuel state program
      available) :
    SegmentHistoryAnswersRetained state returned.finalState := by
  have coherent : HistoryTotalCoherent state :=
    projected_returned_trace_entry_coherent limits actor fuel state program
      returned.freshQueries returned.result returned.finalState returned.steps
        returned.trace
  have runExact := projected_machine_prefix_returned_run_exact limits actor
    fuel state program available returned coherent
  have returnedHalt :
      (runMachine
        (controllerFromProjectedFreshAnswers state.history
          (returned.freshQueries.map Prod.snd))
        limits actor fuel state program).halt = .returned returned.result := by
    rw [runExact]
  obtain ⟨pairs, _path, traceExact, _actors, tableAnswers⟩ :=
    run_machine_returned_has_exact_query_path
      (controllerFromProjectedFreshAnswers state.history
        (returned.freshQueries.map Prod.snd))
      limits actor fuel state program returned.result returnedHalt
  have finalOracleExact :
      (runMachine
        (controllerFromProjectedFreshAnswers state.history
          (returned.freshQueries.map Prod.snd))
        limits actor fuel state program).oracle = returned.finalState := by
    rw [runExact]
  rw [finalOracleExact] at traceExact tableAnswers
  intro record recordMember
  have pairMember : (record.input, record.output) ∈
      queryAnswerTrace (historySince state returned.finalState) :=
    List.mem_map.mpr ⟨record, recordMember, rfl⟩
  rw [traceExact] at pairMember
  have found := tableAnswers (record.input, record.output) pairMember
  rw [fixed_table_lookup_eq_lookup_entry_output] at found
  cases selected : lookupEntry returned.finalState record.input with
  | none => simp [selected] at found
  | some entry =>
      have outputExact : entry.output = record.output := by
        simpa [selected] using found
      unfold lookupEntry at selected
      have predicate := List.find?_some selected
      have inputExact : entry.input = record.input :=
        of_decide_eq_true predicate
      have member : entry ∈ returned.finalState.table :=
        List.mem_of_find?_eq_some selected
      exact ⟨entry, member, inputExact, outputExact⟩

/-- A projected machine segment extends a globally justified entry table by
exactly its literal `.machineFresh` scheduler records.  Cached queries create
no table entry; every fresh entry is therefore witnessed by the record list,
while inherited entries retain their earlier origin. -/
theorem projected_machine_prefix_preserves_global_table_outputs
    {Result : Type u}
    (limits : OracleLimits) (actor : QueryActor) (fuel : Nat)
    (state : OracleState) (program : OracleMachine Result)
    (records : List UnifiedExposureRecord)
    (returned : ProjectedMachinePrefixReturned limits actor fuel state program
      (machineFreshAnswers records))
    (queriesExact : machineFreshQueryAnswers records = returned.freshQueries)
    (traceBefore : List UnifiedExposureRecord)
    (entryOrigins : OracleTableOutputsHaveGlobalOrigin state traceBefore) :
    OracleTableOutputsHaveGlobalOrigin returned.finalState
      (traceBefore ++ records) := by
  have coherent : HistoryTotalCoherent state :=
    projected_returned_trace_entry_coherent limits actor fuel state program
      returned.freshQueries returned.result returned.finalState returned.steps
        returned.trace
  have runExact := projected_machine_prefix_returned_run_exact limits actor
    fuel state program (machineFreshAnswers records) returned coherent
  have extension :=
    (run_machine_exact_fresh_extension
      (controllerFromProjectedFreshAnswers state.history
        (returned.freshQueries.map Prod.snd))
      limits actor fuel state program).1
  rw [runExact] at extension
  intro entry member
  rw [extension] at member
  rcases List.mem_append.mp member with inherited | appended
  · rcases entryOrigins entry inherited with atZero | active
    · exact Or.inl atZero
    · rcases active with ⟨witness, witnessMember, answerExact⟩
      exact Or.inr ⟨witness, List.mem_append_left records witnessMember,
        answerExact⟩
  · unfold verifierFreshTableEntries verifierFreshRecords at appended
    obtain ⟨record, filteredMember, rfl⟩ := List.mem_map.mp appended
    have filtered := List.mem_filter.mp filteredMember
    have fresh : record.origin = .fresh := of_decide_eq_true filtered.2
    have enumerated :
        record.output ∈ freshAnswerEnumeration
          (historySince state returned.finalState) :=
      fresh_record_output_mem_fresh_answer_enumeration _ record filtered.1
        fresh
    rw [projected_machine_prefix_fresh_answers_are_history_suffix limits actor
      fuel state program (machineFreshAnswers records) returned] at enumerated
    have projected : record.output ∈ machineFreshAnswers records := by
      rw [machine_fresh_answers_eq_query_answers_map, queriesExact]
      exact enumerated
    rcases machine_fresh_answer_mem_has_active_origin records record.output
        projected with ⟨witness, witnessMember, answerExact⟩
    exact Or.inr ⟨witness, List.mem_append_right traceBefore witnessMember,
      answerExact⟩

/-- The four concrete lazy-oracle boundaries retained by one runtime node all
refer only to answers already exposed in the scheduler trace (or to the public
dummy digest). -/
structure ConcreteNodeTableOutputsHaveGlobalOrigin
    {Statement Proof Payload : Type u}
    (node : ConcreteRestorationNode Statement Proof Payload)
    (fullTrace : List UnifiedExposureRecord) : Prop where
  proverEntry : OracleTableOutputsHaveGlobalOrigin node.proverEntryOracle
    fullTrace
  proverFinal : OracleTableOutputsHaveGlobalOrigin node.proverFinalOracle
    fullTrace
  verifierEntry : OracleTableOutputsHaveGlobalOrigin node.verifierEntryOracle
    fullTrace
  verifierFinal : OracleTableOutputsHaveGlobalOrigin node.verifierFinalOracle
    fullTrace

def ConcreteNodeTableOutputsHaveGlobalOrigin.appendTrace
    {Statement Proof Payload : Type u}
    {node : ConcreteRestorationNode Statement Proof Payload}
    {trace : List UnifiedExposureRecord}
    (origins : ConcreteNodeTableOutputsHaveGlobalOrigin node trace)
    (suffix : List UnifiedExposureRecord) :
    ConcreteNodeTableOutputsHaveGlobalOrigin node (trace ++ suffix) :=
  { proverEntry := oracle_table_outputs_have_global_origin_append
      node.proverEntryOracle trace suffix origins.proverEntry
    proverFinal := oracle_table_outputs_have_global_origin_append
      node.proverFinalOracle trace suffix origins.proverFinal
    verifierEntry := oracle_table_outputs_have_global_origin_append
      node.verifierEntryOracle trace suffix origins.verifierEntry
    verifierFinal := oracle_table_outputs_have_global_origin_append
      node.verifierFinalOracle trace suffix origins.verifierFinal }

/-- Noncircular operational intermediary for arbitrary-depth dispatch.  Every
transition digest is traced to the public zero root or some earlier active
coordinate in the *whole actual scheduler trace*.  Unlike the stronger local
field in `CausallyProvenancedRestorationNodeExecution`, this statement follows
from ordinary table/query/program provenance and does not presuppose target
cleanliness. -/
structure GloballyProvenancedRestorationNodeExecution
    {Statement Proof Payload Final : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (fullTrace : List UnifiedExposureRecord)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (child : ConcreteRestorationNode Statement Proof Payload) : Type u where
  historical : HistoricallyProvenancedRestorationNodeExecution
    (Final := Final) startProgram environment configuration fullTrace
      accumulator child
  tableOutputsHaveGlobalOrigin :
    ConcreteNodeTableOutputsHaveGlobalOrigin child fullTrace
  proverHistoryAnswersRetained :
    SegmentHistoryAnswersRetained child.proverEntryOracle
      child.proverFinalOracle
  transitionDigestHasGlobalOrigin :
    ∀ transitionIndex transition,
      verifierTransitionAt? child transitionIndex = some transition →
        transition.before.core.digest = zeroDigest256 ∨
          ActiveExposureAnswer transition.before.core.digest fullTrace
  transitionQ16BaseHasGlobalOrigin :
    ∀ transitionIndex transition base,
      verifierTransitionAt? child transitionIndex = some transition →
      transition.before.core.q16Base = some base →
        base = zeroDigest256 ∨ ActiveExposureAnswer base fullTrace

def EveryNodeOperationalWithGlobalProvenance
    {Statement Proof Payload Final : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (fullTrace : List UnifiedExposureRecord)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload) :
    Prop :=
  ∀ child ∈ accumulator.nodes,
    child.parentRequest ≠ none →
      Nonempty (GloballyProvenancedRestorationNodeExecution
        (Final := Final) startProgram environment configuration fullTrace
          accumulator child)

/-- Forget only the positive-transition field of a full causal node
certificate. -/
def HistoricallyProvenancedRestorationNodeExecution.ofCausal
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {child : ConcreteRestorationNode Statement Proof Payload}
    (execution : CausallyProvenancedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
      accumulator child) :
    HistoricallyProvenancedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
      accumulator child :=
  { base := execution.base
    requestIsStructurallyFresh := execution.requestIsStructurallyFresh
    programmingHistoryHasEarlierPairProvenance :=
      execution.programmingHistoryHasEarlierPairProvenance }

theorem every_node_historical_provenance_of_causal
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    (causal : EveryNodeOperationalWithCausalProvenance
      (Final := Final) startProgram environment configuration fullTrace
      accumulator) :
    EveryNodeOperationalWithHistoricalProvenance
      (Final := Final) startProgram environment configuration fullTrace
      accumulator := by
  intro child member nonroot
  obtain ⟨execution⟩ := causal child member nonroot
  exact ⟨HistoricallyProvenancedRestorationNodeExecution.ofCausal execution⟩

/-- Forgetting whole-trace transition origins retains the purely historical
part of the operational certificate. -/
def GloballyProvenancedRestorationNodeExecution.toHistorical
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {child : ConcreteRestorationNode Statement Proof Payload}
    (execution : GloballyProvenancedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
        accumulator child) :
    HistoricallyProvenancedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
        accumulator child :=
  execution.historical

theorem every_node_historical_provenance_of_global
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    (global : EveryNodeOperationalWithGlobalProvenance
      (Final := Final) startProgram environment configuration fullTrace
        accumulator) :
    EveryNodeOperationalWithHistoricalProvenance
      (Final := Final) startProgram environment configuration fullTrace
        accumulator := by
  intro child member nonroot
  obtain ⟨execution⟩ := global child member nonroot
  exact ⟨execution.toHistorical⟩

/-- In the append-only runtime store, every parentless node is the unique
initialized root.  This closes the otherwise-real counterexample in which an
arbitrary caller inserts a second parentless node with a fabricated
programming ledger. -/
def ParentlessNodeIsRoot
    {Statement Proof Payload : Type u}
    (root : ConcreteRestorationNode Statement Proof Payload)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload) :
    Prop :=
  ∀ node ∈ accumulator.nodes, node.parentRequest = none → node = root

def RootStoredAtZero
    {Statement Proof Payload : Type u}
    (root : ConcreteRestorationNode Statement Proof Payload)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload) :
    Prop :=
  accumulator.node? 0 = some root

/- The following first draft threaded a single fixed normalization fuel across
machine-return boundaries.  That equation is false for a zero-coordinate
machine segment: returning consumes one normalization transition.  It is kept
inside this nested source comment solely as design history; no declaration
from the block is compiled.  The operational Stage-1 invariant below records
trace and causal provenance only.  Stage 2 is indexed by the actual completed
list-run continuation fuel. -/

/-
/-- Combined append-only invariant carried by the one actual dispatcher
traversal.  The native-entry conjunct retains the exact callback request
states; the causal conjunct retains the earlier-pair and transition-digest
facts.  Neither one is reconstructed from a flat trace after the run. -/
structure ActualNodeCausalDispatcherInvariant
    {Statement Proof Payload Final : Type u} {globalOracleCalls : Nat}
    (transitionFuel : Nat)
    (rootCursor : SchedulerNativeCursor globalOracleCalls Final)
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (root : ConcreteRestorationNode Statement Proof Payload)
    (trace : List UnifiedExposureRecord)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload) :
    Prop where
  rootInitial : RootCausalInitialization root trace
  parentlessIsRoot : ParentlessNodeIsRoot root accumulator
  rootStored : RootStoredAtZero root accumulator
  everyNodeCausal : EveryNodeOperationalWithCausalProvenance
    (Final := Final) startProgram environment configuration trace accumulator
  everyNodeNativeEntry : EveryNodeOperationalWithNativeEntryPrefix
    transitionFuel rootCursor startProgram environment configuration trace
      accumulator

/-- Bookkeeping projection of the full causal dispatcher invariant.  It keeps
structural request safety, inherited-programming chronology, and
proof-relevant native entry-prefix states while forgetting positive-transition
provenance.  It is useful for local append lemmas, but is deliberately *not*
claimed sufficient for arbitrary-depth recursion: constructing a grandchild's
inherited-programming witness needs the parent's positive-transition causal
fact.  The concrete recursive theorem must therefore carry the full causal
invariant under the one constructed target-clean certificate. -/
structure ActualNodeHistoricalDispatcherInvariant
    {Statement Proof Payload Final : Type u} {globalOracleCalls : Nat}
    (transitionFuel : Nat)
    (rootCursor : SchedulerNativeCursor globalOracleCalls Final)
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (root : ConcreteRestorationNode Statement Proof Payload)
    (trace : List UnifiedExposureRecord)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload) :
    Prop where
  rootInitial : RootCausalInitialization root trace
  parentlessIsRoot : ParentlessNodeIsRoot root accumulator
  rootStored : RootStoredAtZero root accumulator
  everyNodeHistorical : EveryNodeOperationalWithHistoricalProvenance
    (Final := Final) startProgram environment configuration trace accumulator
  everyNodeNativeEntry : EveryNodeOperationalWithNativeEntryPrefix
    transitionFuel rootCursor startProgram environment configuration trace
      accumulator

/-- The operational arbitrary-depth invariant before target-clean upgrading.
It retains whole-trace transition origins rather than assuming the stronger
node-local causal conclusion.  The concrete dispatcher is responsible for
constructing `everyNodeGlobal`; it is not a caller-facing premise. -/
structure ActualNodeGlobalDispatcherInvariant
    {Statement Proof Payload Final : Type u} {globalOracleCalls : Nat}
    (transitionFuel : Nat)
    (rootCursor : SchedulerNativeCursor globalOracleCalls Final)
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (root : ConcreteRestorationNode Statement Proof Payload)
    (trace : List UnifiedExposureRecord)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload) :
    Prop where
  rootInitial : RootCausalInitialization root trace
  rootTableOutputs : ConcreteNodeTableOutputsHaveGlobalOrigin root trace
  rootProverHistoryAnswersRetained :
    SegmentHistoryAnswersRetained root.proverEntryOracle root.proverFinalOracle
  parentlessIsRoot : ParentlessNodeIsRoot root accumulator
  rootStored : RootStoredAtZero root accumulator
  everyNodeGlobal : EveryNodeOperationalWithGlobalProvenance
    (Final := Final) startProgram environment configuration trace accumulator
  everyNodeNativeEntry : EveryNodeOperationalWithNativeEntryPrefix
    transitionFuel rootCursor startProgram environment configuration trace
      accumulator

/-- Forgetting the target-clean-dependent positive-transition field is an
internal projection, not a caller-supplied compiler premise. -/
def ActualNodeCausalDispatcherInvariant.toHistorical
    {Statement Proof Payload Final : Type u} {globalOracleCalls : Nat}
    {transitionFuel : Nat}
    {rootCursor : SchedulerNativeCursor globalOracleCalls Final}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {root : ConcreteRestorationNode Statement Proof Payload}
    {trace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    (invariant : ActualNodeCausalDispatcherInvariant transitionFuel rootCursor
      startProgram environment configuration root trace accumulator) :
    ActualNodeHistoricalDispatcherInvariant transitionFuel rootCursor
      startProgram environment configuration root trace accumulator :=
  { rootInitial := invariant.rootInitial
    parentlessIsRoot := invariant.parentlessIsRoot
    rootStored := invariant.rootStored
    everyNodeHistorical :=
      every_node_historical_provenance_of_causal invariant.everyNodeCausal
    everyNodeNativeEntry := invariant.everyNodeNativeEntry }

/-- The whole-trace operational invariant projects to the historical/native
bookkeeping used by the concrete child constructors. -/
def ActualNodeGlobalDispatcherInvariant.toHistorical
    {Statement Proof Payload Final : Type u} {globalOracleCalls : Nat}
    {transitionFuel : Nat}
    {rootCursor : SchedulerNativeCursor globalOracleCalls Final}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {root : ConcreteRestorationNode Statement Proof Payload}
    {trace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    (invariant : ActualNodeGlobalDispatcherInvariant transitionFuel rootCursor
      startProgram environment configuration root trace accumulator) :
    ActualNodeHistoricalDispatcherInvariant transitionFuel rootCursor
      startProgram environment configuration root trace accumulator :=
  { rootInitial := invariant.rootInitial
    parentlessIsRoot := invariant.parentlessIsRoot
    rootStored := invariant.rootStored
    everyNodeHistorical :=
      every_node_historical_provenance_of_global invariant.everyNodeGlobal
    everyNodeNativeEntry := invariant.everyNodeNativeEntry }

/-- Local continuation property used inside the full causal dispatcher
induction.  On its own this historical projection is not an arbitrary-depth
closure theorem; the request step additionally consumes the constructed
positive-transition proof before recursing.  The alignment argument is the
equation obtained by consuming the *actual* chronological prefix from
`rootCursor` and is never exported by the final from-root theorem. -/
def ConcreteClientPreservesHistoricalNativeLineage
    {Statement Proof Payload Result : Type u} {globalOracleCalls : Nat}
    (transitionFuel : Nat)
    (rootCursor : SchedulerNativeCursor globalOracleCalls
      (ConcreteRestorationClientRun Statement Proof Payload Result))
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (root : ConcreteRestorationNode Statement Proof Payload)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (cursor : SchedulerNativeCursor globalOracleCalls
      (ConcreteRestorationClientRun Statement Proof Payload Result)) : Prop :=
  ∀ trace,
    NativeRequestAlignedAtGlobalPrefix transitionFuel rootCursor cursor trace →
      ActualNodeHistoricalDispatcherInvariant transitionFuel rootCursor
        startProgram environment configuration root trace accumulator →
      SchedulerNativeCursorAllProjectedTracedReturned
        (fun run suffix =>
          ActualNodeHistoricalDispatcherInvariant transitionFuel rootCursor
            startProgram environment configuration root (trace ++ suffix)
              run.accumulator)
        cursor

/-- Recursive continuation property for the noncircular whole-trace
provenance invariant.  The initial root constructor and every successful child
callback build its table, history, transition and native-prefix fields from
the actual operational data; callers do not provide a provenance map. -/
def ConcreteClientPreservesGlobalNativeLineage
    {Statement Proof Payload Result : Type u} {globalOracleCalls : Nat}
    (transitionFuel : Nat)
    (rootCursor : SchedulerNativeCursor globalOracleCalls
      (ConcreteRestorationClientRun Statement Proof Payload Result))
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (root : ConcreteRestorationNode Statement Proof Payload)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (cursor : SchedulerNativeCursor globalOracleCalls
      (ConcreteRestorationClientRun Statement Proof Payload Result)) : Prop :=
  ∀ trace,
    NativeRequestAlignedAtGlobalPrefix transitionFuel rootCursor cursor trace →
      ActualNodeGlobalDispatcherInvariant transitionFuel rootCursor
        startProgram environment configuration root trace accumulator →
      SchedulerNativeCursorAllProjectedTracedReturned
        (fun run suffix =>
          ActualNodeGlobalDispatcherInvariant transitionFuel rootCursor
            startProgram environment configuration root (trace ++ suffix)
              run.accumulator)
        cursor

/-- Equality of the next exposed native request is stable under consuming the
same concrete answer prefix.  This is the exact congruence needed to thread
root-to-local alignment through callbacks; it does not identify hidden cursor
proof fields or choose a restoration function. -/
theorem seek_native_prefix_congr
    {globalOracleCalls : Nat} {Final : Type u}
    (transitionFuel : Nat)
    (left right : SchedulerNativeCursor globalOracleCalls Final)
    (answers : List Digest256)
    (aligned : seekSchedulerNativeExposure transitionFuel left =
      seekSchedulerNativeExposure transitionFuel right) :
    seekSchedulerNativeExposure transitionFuel
        (schedulerNativePrefixCursor transitionFuel left answers) =
      seekSchedulerNativeExposure transitionFuel
        (schedulerNativePrefixCursor transitionFuel right answers) := by
  induction answers generalizing left right with
  | nil => exact aligned
  | cons answer rest ih =>
      simp only [schedulerNativePrefixCursor]
      rw [aligned]

/-- Extend an actual root/local alignment by a literal local record prefix.
The reached local cursor is characterized only by its next exposed request,
which is the proof-relevant equality needed by the dispatcher. -/
theorem native_request_alignment_extend
    {globalOracleCalls : Nat} {Final : Type u}
    (transitionFuel : Nat)
    (rootCursor currentCursor nextCursor :
      SchedulerNativeCursor globalOracleCalls Final)
    (globalPrior localRecords : List UnifiedExposureRecord)
    (aligned : NativeRequestAlignedAtGlobalPrefix transitionFuel rootCursor
      currentCursor globalPrior)
    (localReached :
      seekSchedulerNativeExposure transitionFuel
          (schedulerNativePrefixCursor transitionFuel currentCursor
            (localRecords.map UnifiedExposureRecord.answer)) =
        seekSchedulerNativeExposure transitionFuel nextCursor) :
    NativeRequestAlignedAtGlobalPrefix transitionFuel rootCursor nextCursor
      (globalPrior ++ localRecords) := by
  unfold NativeRequestAlignedAtGlobalPrefix at aligned ⊢
  rw [List.map_append, scheduler_native_prefix_cursor_append]
  exact (seek_native_prefix_congr transitionFuel
    (schedulerNativePrefixCursor transitionFuel rootCursor
      (globalPrior.map UnifiedExposureRecord.answer)) currentCursor
    (localRecords.map UnifiedExposureRecord.answer) aligned).trans localReached

/-- Raw prefix equation used while destructing the executable dispatcher.  A
branch-specific simplification of the right side identifies the actual next
callback cursor; no callback is supplied to this theorem. -/
theorem native_request_alignment_prefix_equation
    {globalOracleCalls : Nat} {Final : Type u}
    (transitionFuel : Nat)
    (rootCursor currentCursor : SchedulerNativeCursor globalOracleCalls Final)
    (globalPrior localRecords : List UnifiedExposureRecord)
    (aligned : NativeRequestAlignedAtGlobalPrefix transitionFuel rootCursor
      currentCursor globalPrior) :
    seekSchedulerNativeExposure transitionFuel
        (schedulerNativePrefixCursor transitionFuel rootCursor
          ((globalPrior ++ localRecords).map
            UnifiedExposureRecord.answer)) =
      seekSchedulerNativeExposure transitionFuel
        (schedulerNativePrefixCursor transitionFuel currentCursor
          (localRecords.map UnifiedExposureRecord.answer)) := by
  unfold NativeRequestAlignedAtGlobalPrefix at aligned
  rw [List.map_append, scheduler_native_prefix_cursor_append]
  exact seek_native_prefix_congr transitionFuel
    (schedulerNativePrefixCursor transitionFuel rootCursor
      (globalPrior.map UnifiedExposureRecord.answer)) currentCursor
    (localRecords.map UnifiedExposureRecord.answer) aligned

@[simp] theorem native_request_alignment_root
    {globalOracleCalls : Nat} {Final : Type u}
    (transitionFuel : Nat)
    (rootCursor : SchedulerNativeCursor globalOracleCalls Final) :
    NativeRequestAlignedAtGlobalPrefix transitionFuel rootCursor rootCursor
      [] := by
  rfl

/-- Consuming every fresh coordinate certified by one returned projected
machine segment reaches the exact callback continuation, up to equality of
the next exposed scheduler request.  Cached oracle steps are normalized by
`seekSchedulerNativeExposure`; no flat trace is used to guess the callback
state. -/
theorem projected_fresh_trace_reaches_returned_native_request
    {globalOracleCalls : Nat} {Final MachineResult : Type u}
    (transitionFuel : Nat) (positive : 0 < transitionFuel)
    (limits : OracleLimits)
    (limitBound : limits.totalCalls ≤ globalOracleCalls)
    (actor : QueryActor)
    (onReturned : (result : MachineResult) → (state : OracleState) →
      HistoryTotalCoherent state →
        SchedulerNativeCursor globalOracleCalls Final) :
    ∀ {fuel : Nat} {entryState : OracleState}
      {program : OracleMachine MachineResult}
      {freshQueries : List (ShaInput × Digest256)}
      {result : MachineResult} {finalState : OracleState} {steps : Nat}
      (coherent : HistoryTotalCoherent entryState)
      (trace : ProjectedFreshReturnedTrace limits actor fuel entryState program
        freshQueries result finalState steps)
      (finalCoherent : HistoryTotalCoherent finalState),
      seekSchedulerNativeExposure transitionFuel
          (schedulerNativePrefixCursor transitionFuel
            (.machine limits limitBound actor entryState program fuel coherent
              onReturned)
            (freshQueries.map Prod.snd)) =
        seekSchedulerNativeExposure transitionFuel
          (onReturned result finalState finalCoherent) := by
  intro fuel entryState program freshQueries result finalState steps coherent
    trace
  induction trace with
  | returned fuel state program traceCoherent result finalState steps sought =>
      intro finalCoherent
      have coherentExact : coherent = traceCoherent := Subsingleton.elim _ _
      cases coherentExact
      cases transitionFuel with
      | zero => omega
      | succ current =>
          simp only [List.map_nil, schedulerNativePrefixCursor]
          rw [seek_scheduler_native_exposure_machine_of_returned current limits
            limitBound actor fuel state program traceCoherent onReturned result
              finalState steps sought]
          congr 2
  | fresh fuel state requestState program traceCoherent input next
      remainingFuel cachedSteps requestCoherent totalRoom freshRoom missing
      sought answer rest result finalState tailSteps tail ih =>
      intro finalCoherent
      have coherentExact : coherent = traceCoherent := Subsingleton.elim _ _
      cases coherentExact
      cases transitionFuel with
      | zero => omega
      | succ current =>
          simp only [List.map_cons, schedulerNativePrefixCursor]
          rw [seek_scheduler_native_exposure_machine_of_fresh current limits
            limitBound actor fuel state requestState program traceCoherent input
              next remainingFuel cachedSteps requestCoherent totalRoom freshRoom
                missing onReturned sought]
          exact ih
            (fresh_query_state_preserves_history_total_coherent actor
              requestState input answer requestCoherent)
            finalCoherent

/-- Structure-level form used at the two literal machine callbacks of one
successful concrete restoration. -/
theorem projected_machine_prefix_reaches_returned_native_request
    {globalOracleCalls : Nat} {Final MachineResult : Type u}
    (transitionFuel : Nat) (positive : 0 < transitionFuel)
    (limits : OracleLimits)
    (limitBound : limits.totalCalls ≤ globalOracleCalls)
    (actor : QueryActor) (fuel : Nat) (entryState : OracleState)
    (program : OracleMachine MachineResult)
    (coherent : HistoryTotalCoherent entryState)
    (onReturned : (result : MachineResult) → (state : OracleState) →
      HistoryTotalCoherent state →
        SchedulerNativeCursor globalOracleCalls Final)
    (available : List Digest256)
    (returned : ProjectedMachinePrefixReturned limits actor fuel entryState
      program available) :
    seekSchedulerNativeExposure transitionFuel
        (schedulerNativePrefixCursor transitionFuel
          (.machine limits limitBound actor entryState program fuel coherent
            onReturned)
          (returned.freshQueries.map Prod.snd)) =
      seekSchedulerNativeExposure transitionFuel
        (onReturned returned.result returned.finalState
          returned.finalCoherent) := by
  exact projected_fresh_trace_reaches_returned_native_request transitionFuel
    positive limits limitBound actor onReturned coherent returned.trace
      returned.finalCoherent

/-- Extend a root-indexed cursor alignment through the exact fresh-record
slice returned by one projected machine callback.  This is the reusable
callback hook for the concrete dispatcher induction; cached oracle steps are
normalized by the scheduler and therefore emit no record here. -/
theorem projected_machine_prefix_extends_native_alignment
    {globalOracleCalls : Nat} {Final MachineResult : Type u}
    (transitionFuel : Nat) (positive : 0 < transitionFuel)
    (rootCursor : SchedulerNativeCursor globalOracleCalls Final)
    (limits : OracleLimits)
    (limitBound : limits.totalCalls ≤ globalOracleCalls)
    (actor : QueryActor) (fuel : Nat) (entryState : OracleState)
    (program : OracleMachine MachineResult)
    (coherent : HistoryTotalCoherent entryState)
    (onReturned : (result : MachineResult) → (state : OracleState) →
      HistoryTotalCoherent state →
        SchedulerNativeCursor globalOracleCalls Final)
    (available : List Digest256)
    (returned : ProjectedMachinePrefixReturned limits actor fuel entryState
      program available)
    (globalPrior : List UnifiedExposureRecord)
    (startAligned : NativeRequestAlignedAtGlobalPrefix transitionFuel
      rootCursor
      (.machine limits limitBound actor entryState program fuel coherent
        onReturned)
      globalPrior) :
    NativeRequestAlignedAtGlobalPrefix transitionFuel rootCursor
      (onReturned returned.result returned.finalState returned.finalCoherent)
      (globalPrior ++
        projectedMachineFreshRecords actor returned.freshQueries) := by
  apply native_request_alignment_extend transitionFuel rootCursor
    (.machine limits limitBound actor entryState program fuel coherent
      onReturned)
    (onReturned returned.result returned.finalState returned.finalCoherent)
    globalPrior (projectedMachineFreshRecords actor returned.freshQueries)
    startAligned
  simpa only [projected_machine_fresh_record_answers] using
    (projected_machine_prefix_reaches_returned_native_request transitionFuel
      positive limits limitBound actor fuel entryState program coherent
        onReturned available returned)

/-- A fork callback consumes exactly its adjacent output/advance coordinates
and reaches the scheduled continuation.  Both records are tied to the same
frozen history; there is no intermediate complete verifier snapshot. -/
theorem fork_pair_records_reach_scheduled_native_request
    {globalOracleCalls : Nat} {Final : Type u}
    (transitionFuel : Nat) (positive : 0 < transitionFuel)
    (frozenHistory : List QueryRecord)
    (pairRoom : frozenHistory.length + 2 ≤ globalOracleCalls)
    (outputInput advanceInput : ShaInput)
    (template : AtomicPairReplayConfiguration)
    (next : AtomicPairReplayConfiguration →
      SchedulerNativeCursor globalOracleCalls Final)
    (scheduled : ScheduledForkCoins)
    (frozenExact : scheduled.frozenHistory = frozenHistory)
    (outputExact : scheduled.outputInput = outputInput)
    (advanceExact : scheduled.advanceInput = advanceInput)
    (templateExact : scheduled.template = template) :
    seekSchedulerNativeExposure transitionFuel
        (schedulerNativePrefixCursor transitionFuel
          (.forkPair frozenHistory pairRoom outputInput advanceInput template
            next)
          ((scheduledPairRecords scheduled).map
            UnifiedExposureRecord.answer)) =
      seekSchedulerNativeExposure transitionFuel
        (next scheduled.configuration) := by
  cases transitionFuel with
  | zero => omega
  | succ current =>
      subst frozenHistory
      subst outputInput
      subst advanceInput
      subst template
      rfl

/-- Extend a root-indexed cursor alignment through one literal adjacent
output/advance fork pair. -/
theorem fork_pair_extends_native_alignment
    {globalOracleCalls : Nat} {Final : Type u}
    (transitionFuel : Nat) (positive : 0 < transitionFuel)
    (rootCursor : SchedulerNativeCursor globalOracleCalls Final)
    (frozenHistory : List QueryRecord)
    (pairRoom : frozenHistory.length + 2 ≤ globalOracleCalls)
    (outputInput advanceInput : ShaInput)
    (template : AtomicPairReplayConfiguration)
    (next : AtomicPairReplayConfiguration →
      SchedulerNativeCursor globalOracleCalls Final)
    (scheduled : ScheduledForkCoins)
    (frozenExact : scheduled.frozenHistory = frozenHistory)
    (outputExact : scheduled.outputInput = outputInput)
    (advanceExact : scheduled.advanceInput = advanceInput)
    (templateExact : scheduled.template = template)
    (globalPrior : List UnifiedExposureRecord)
    (startAligned : NativeRequestAlignedAtGlobalPrefix transitionFuel
      rootCursor
      (.forkPair frozenHistory pairRoom outputInput advanceInput template next)
      globalPrior) :
    NativeRequestAlignedAtGlobalPrefix transitionFuel rootCursor
      (next scheduled.configuration)
      (globalPrior ++ scheduledPairRecords scheduled) := by
  apply native_request_alignment_extend transitionFuel rootCursor
    (.forkPair frozenHistory pairRoom outputInput advanceInput template next)
    (next scheduled.configuration) globalPrior
      (scheduledPairRecords scheduled) startAligned
  exact fork_pair_records_reach_scheduled_native_request transitionFuel positive
    frozenHistory pairRoom outputInput advanceInput template next scheduled
      frozenExact outputExact advanceExact templateExact

/-- A list certified to contain only fresh records for one actor is recovered
exactly from its input/answer projection.  This makes positional projected
machine lemmas usable with the record lists stored in a node certificate. -/
theorem only_machine_fresh_records_reconstruct
    (actor : QueryActor) : ∀ records : List UnifiedExposureRecord,
    OnlyMachineFreshActor actor records →
      projectedMachineFreshRecords actor (machineFreshQueryAnswers records) =
        records
  | [], _only => rfl
  | record :: rest, only => by
      obtain ⟨input, answer, recordExact⟩ := only record (by simp)
      subst record
      simp only [machineFreshQueryAnswers, projectedMachineFreshRecords,
        List.cons.injEq, true_and]
      apply only_machine_fresh_records_reconstruct actor rest
      intro candidate member
      exact only candidate (by simp [member])

theorem projected_node_prover_records_are_literal
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {child : ConcreteRestorationNode Statement Proof Payload}
    (base : ProjectedRestorationNodeExecution (Final := Final) startProgram
      environment configuration fullTrace accumulator child) :
    projectedMachineFreshRecords .extractorReplay
        base.proverPrefix.freshQueries =
      base.proverRecords := by
  rw [← base.proverQueriesExact]
  exact only_machine_fresh_records_reconstruct .extractorReplay
    base.proverRecords base.proverRecordsOnly

theorem projected_node_verifier_records_are_literal
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {child : ConcreteRestorationNode Statement Proof Payload}
    (base : ProjectedRestorationNodeExecution (Final := Final) startProgram
      environment configuration fullTrace accumulator child) :
    projectedMachineFreshRecords .verifier
        base.verifierPrefix.freshQueries =
      base.verifierRecords := by
  rw [← base.verifierQueriesExact]
  exact only_machine_fresh_records_reconstruct .verifier base.verifierRecords
    base.verifierRecordsOnly

/-- One exact record decomposition of an actual projected callback yields the
global root-indexed request certificate.  The local request state comes from
the proof-relevant projected trace; root alignment is extended by precisely
`priorRecords`, so duplicate query values cannot select the wrong occurrence. -/
theorem projected_machine_record_has_global_entry_prefix
    {globalOracleCalls : Nat} {Final MachineResult : Type u}
    (transitionFuel : Nat) (positive : 0 < transitionFuel)
    (rootCursor : SchedulerNativeCursor globalOracleCalls Final)
    (limits : OracleLimits)
    (limitBound : limits.totalCalls ≤ globalOracleCalls)
    (actor : QueryActor) (fuel : Nat) (entryState : OracleState)
    (program : OracleMachine MachineResult)
    (coherent : HistoryTotalCoherent entryState)
    (onReturned : (result : MachineResult) → (state : OracleState) →
      HistoryTotalCoherent state →
        SchedulerNativeCursor globalOracleCalls Final)
    (available : List Digest256)
    (returned : ProjectedMachinePrefixReturned limits actor fuel entryState
      program available)
    (globalPrior priorRecords : List UnifiedExposureRecord)
    (input : ShaInput) (answer : Digest256)
    (laterRecords : List UnifiedExposureRecord)
    (startAligned : NativeRequestAlignedAtGlobalPrefix transitionFuel
      rootCursor
      (.machine limits limitBound actor entryState program fuel coherent
        onReturned)
      globalPrior)
    (decomposition : projectedMachineFreshRecords actor returned.freshQueries =
      priorRecords ++ .machineFresh actor input answer :: laterRecords) :
    NativeMachineRecordHasEntryPrefix transitionFuel rootCursor entryState
      actor (globalPrior ++ priorRecords) input := by
  obtain ⟨requestState, historyPrefix, localExact⟩ :=
    projected_machine_prefix_has_exact_native_request_at_record_prefix
      transitionFuel positive limits limitBound actor fuel entryState program
        coherent onReturned available returned priorRecords input answer
          laterRecords decomposition
  let localCursor := schedulerNativePrefixCursor transitionFuel
    (.machine limits limitBound actor entryState program fuel coherent
      onReturned)
    (priorRecords.map UnifiedExposureRecord.answer)
  have prefixAligned : NativeRequestAlignedAtGlobalPrefix transitionFuel
      rootCursor localCursor (globalPrior ++ priorRecords) := by
    apply native_request_alignment_extend transitionFuel rootCursor
      (.machine limits limitBound actor entryState program fuel coherent
        onReturned)
      localCursor globalPrior priorRecords startAligned
    rfl
  exact native_machine_record_has_entry_prefix_of_local_alignment
    transitionFuel rootCursor localCursor entryState requestState actor
      (globalPrior ++ priorRecords) input historyPrefix localExact prefixAligned

abbrev ConcreteProverCallbackResult
    (Final Statement Proof Payload : Type u) :=
  SchedulerStageResult Final
    (Except TotalizedMachineFailure
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))

abbrev ConcreteVerifierCallbackResult (Final : Type u) :=
  SchedulerStageResult Final
    (Except TotalizedMachineFailure FutureFreeVerifierState)

/-- Package both actual machine callbacks of a returned child into the native
entry-prefix certificate.  The two `startAligned` arguments are internal
dispatcher invariants at the literal callback sites; the from-root theorem
constructs them by fork/machine prefix traversal and never exposes them to the
compiler statement. -/
def projected_child_has_native_entry_prefixes_from_actual_callbacks
    {Statement Proof Payload Final : Type u} {globalOracleCalls : Nat}
    (transitionFuel : Nat) (positive : 0 < transitionFuel)
    (rootCursor : SchedulerNativeCursor globalOracleCalls Final)
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (fullTrace : List UnifiedExposureRecord)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (child : ConcreteRestorationNode Statement Proof Payload)
    (base : ProjectedRestorationNodeExecution (Final := Final) startProgram
      environment configuration fullTrace accumulator child)
    (proverLimitBound :
      configuration.oracleLimits.totalCalls ≤ globalOracleCalls)
    (proverCoherent : HistoryTotalCoherent child.proverEntryOracle)
    (proverOnReturned :
      (result : ConcreteProverCallbackResult Final Statement Proof Payload) →
        (state : OracleState) → HistoryTotalCoherent state →
          SchedulerNativeCursor globalOracleCalls Final)
    (proverStartAligned : NativeRequestAlignedAtGlobalPrefix transitionFuel
      rootCursor
      (.machine configuration.oracleLimits proverLimitBound .extractorReplay
        child.proverEntryOracle
        (schedulerStageProgram Final
          (totalizeOracleMachine configuration.proverReplayFuel startProgram))
        configuration.proverReplayFuel proverCoherent proverOnReturned)
      (base.traceBeforePair ++ scheduledPairRecords base.scheduled))
    (verifierLimitBound :
      configuration.oracleLimits.totalCalls ≤ globalOracleCalls)
    (verifierCoherent : HistoryTotalCoherent child.verifierEntryOracle)
    (verifierOnReturned :
      (result : ConcreteVerifierCallbackResult Final) →
        (state : OracleState) → HistoryTotalCoherent state →
          SchedulerNativeCursor globalOracleCalls Final)
    (verifierStartAligned : NativeRequestAlignedAtGlobalPrefix transitionFuel
      rootCursor
      (.machine configuration.oracleLimits verifierLimitBound .verifier
        child.verifierEntryOracle
        (schedulerStageProgram Final
          (totalizeOracleMachine configuration.verifierFuel
            (driveRawFutureFree environment child.adversaryValue.rawMessages
              configuration.driverFuel child.verifierEntryState)))
        configuration.verifierFuel verifierCoherent verifierOnReturned)
      (base.traceBeforePair ++ scheduledPairRecords base.scheduled ++
        base.proverRecords)) :
    NativeEntryAlignedRestorationNodeExecution transitionFuel rootCursor
      startProgram environment configuration fullTrace accumulator child := by
  apply native_entry_aligned_child_of_exact_machine_prefixes transitionFuel
    rootCursor startProgram environment configuration fullTrace accumulator
      child base
  · intro localPrior input answer localLater decomposition
    apply projected_machine_record_has_global_entry_prefix transitionFuel
      positive rootCursor configuration.oracleLimits proverLimitBound
        .extractorReplay configuration.proverReplayFuel child.proverEntryOracle
        (schedulerStageProgram Final
          (totalizeOracleMachine configuration.proverReplayFuel startProgram))
        proverCoherent proverOnReturned (machineFreshAnswers base.proverRecords)
        base.proverPrefix
        (base.traceBeforePair ++ scheduledPairRecords base.scheduled) localPrior
          input answer localLater proverStartAligned
    exact (projected_node_prover_records_are_literal base).trans decomposition
  · intro localPrior input answer localLater decomposition
    apply projected_machine_record_has_global_entry_prefix transitionFuel
      positive rootCursor configuration.oracleLimits verifierLimitBound
        .verifier configuration.verifierFuel child.verifierEntryOracle
        (schedulerStageProgram Final
          (totalizeOracleMachine configuration.verifierFuel
            (driveRawFutureFree environment child.adversaryValue.rawMessages
              configuration.driverFuel child.verifierEntryState)))
        verifierCoherent verifierOnReturned
        (machineFreshAnswers base.verifierRecords) base.verifierPrefix
        (base.traceBeforePair ++ scheduledPairRecords base.scheduled ++
          base.proverRecords)
        localPrior input answer localLater verifierStartAligned
    exact (projected_node_verifier_records_are_literal base).trans decomposition

-/

/-! ## Stage-1 trace/global-causal dispatcher invariant -/

/-! ### Every emitted fork pair already has a complete restoration target

The node-store invariant alone covers only successful children.  A scheduler
pair is emitted earlier: programming, prover replay, or verifier replay may
subsequently fail.  The following certificate is therefore attached at the
literal `.forkAdvance` coordinate, before any of those fallible operations.
It retains the actual executable preparation and its selected parent
transition, rather than reconstructing a convenient state from the trace. -/

/-- Every stored verifier run has a nonempty, closed complete-state history.
This invariant supplies the `previously seen` fact at the exact transition
selected by a later preparation. -/
def EveryStoredNodeHistoryClosed
    {Statement Proof Payload : Type u}
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload) :
    Prop :=
  ∀ node ∈ accumulator.nodes,
    FutureFreeHistoryClosed node.verifierFinalState

/-- Every stored verifier run obeys the executable q16 block cap at its live
snapshot and at every complete snapshot retained for later restoration. -/
def EveryStoredNodeQ16SlotInvariant
    {Statement Proof Payload : Type u}
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload) :
    Prop :=
  ∀ node ∈ accumulator.nodes,
    FutureFreeQ16SlotInvariant node.verifierFinalState

/-- Every stored verifier run carries the stronger phase/certificate
invariant at its live snapshot and every snapshot available to restoration. -/
def EveryStoredNodeQ16LedgerInvariant
    {Statement Proof Payload : Type u}
    (environment : FutureFreeEnvironment)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload) :
    Prop :=
  ∀ node ∈ accumulator.nodes,
    FutureFreeQ16LedgerInvariant environment node.verifierFinalState

/-- Every stored verifier run retains exact gamma and alpha-zero records at
every snapshot where the corresponding schedule slots have been consumed. -/
def EveryStoredNodeK13ChallengeInvariant
    {Statement Proof Payload : Type u}
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload) :
    Prop :=
  ∀ node ∈ accumulator.nodes,
    FutureFreeK13ChallengeInvariant node.verifierFinalState

theorem every_stored_node_k13_challenge_invariant_of_nodes_eq
    {Statement Proof Payload : Type u}
    (oldAccumulator newAccumulator :
      ConcreteRestorationAccumulator Statement Proof Payload)
    (nodesExact : newAccumulator.nodes = oldAccumulator.nodes)
    (invariant : EveryStoredNodeK13ChallengeInvariant oldAccumulator) :
    EveryStoredNodeK13ChallengeInvariant newAccumulator := by
  intro node member
  apply invariant node
  rw [← nodesExact]
  exact member

theorem every_stored_node_k13_challenge_invariant_add_child
    {Statement Proof Payload : Type u}
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (child : ConcreteRestorationNode Statement Proof Payload)
    (invariant : EveryStoredNodeK13ChallengeInvariant accumulator)
    (childInvariant : FutureFreeK13ChallengeInvariant
      child.verifierFinalState) :
    EveryStoredNodeK13ChallengeInvariant (accumulator.addNode child).2 := by
  intro candidate member
  simp only [ConcreteRestorationAccumulator.addNode, List.mem_append,
    List.mem_singleton] at member
  rcases member with old | rfl
  · exact invariant candidate old
  · exact childInvariant

theorem every_stored_node_q16_ledger_invariant_of_nodes_eq
    {Statement Proof Payload : Type u}
    (environment : FutureFreeEnvironment)
    (oldAccumulator newAccumulator :
      ConcreteRestorationAccumulator Statement Proof Payload)
    (nodesExact : newAccumulator.nodes = oldAccumulator.nodes)
    (invariant : EveryStoredNodeQ16LedgerInvariant environment oldAccumulator) :
    EveryStoredNodeQ16LedgerInvariant environment newAccumulator := by
  intro node member
  apply invariant node
  rw [← nodesExact]
  exact member

theorem every_stored_node_q16_ledger_invariant_add_child
    {Statement Proof Payload : Type u}
    (environment : FutureFreeEnvironment)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (child : ConcreteRestorationNode Statement Proof Payload)
    (invariant : EveryStoredNodeQ16LedgerInvariant environment accumulator)
    (childInvariant : FutureFreeQ16LedgerInvariant environment
      child.verifierFinalState) :
    EveryStoredNodeQ16LedgerInvariant environment
      (accumulator.addNode child).2 := by
  intro candidate member
  simp only [ConcreteRestorationAccumulator.addNode, List.mem_append,
    List.mem_singleton] at member
  rcases member with old | rfl
  · exact invariant candidate old
  · exact childInvariant

theorem every_stored_node_q16_slot_invariant_of_nodes_eq
    {Statement Proof Payload : Type u}
    (oldAccumulator newAccumulator :
      ConcreteRestorationAccumulator Statement Proof Payload)
    (nodesExact : newAccumulator.nodes = oldAccumulator.nodes)
    (invariant : EveryStoredNodeQ16SlotInvariant oldAccumulator) :
    EveryStoredNodeQ16SlotInvariant newAccumulator := by
  intro node member
  apply invariant node
  rw [← nodesExact]
  exact member

theorem every_stored_node_q16_slot_invariant_add_child
    {Statement Proof Payload : Type u}
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (child : ConcreteRestorationNode Statement Proof Payload)
    (invariant : EveryStoredNodeQ16SlotInvariant accumulator)
    (childInvariant :
      FutureFreeQ16SlotInvariant child.verifierFinalState) :
    EveryStoredNodeQ16SlotInvariant (accumulator.addNode child).2 := by
  intro candidate member
  simp only [ConcreteRestorationAccumulator.addNode, List.mem_append,
    List.mem_singleton] at member
  rcases member with old | rfl
  · exact invariant candidate old
  · exact childInvariant

/-- The actual operational object associated with one emitted adjacent fork
pair.  `preparationExact` and `selectionExact` jointly prove that the parent,
indexed transition, and restored state came from the executable preparer.
The endpoint fields state directly that restoration is complete, nonempty,
and targets a snapshot previously seen in that parent's verifier history. -/
structure EmittedPairConcreteRestoration
    {Statement Proof Payload : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (configuration : ConcreteRestorationConfiguration)
    (trace : List UnifiedExposureRecord)
    (scheduled : ScheduledForkCoins) : Type u where
  preparationAccumulator :
    ConcreteRestorationAccumulator Statement Proof Payload
  prepared : PreparedConcreteRestoration Statement Proof Payload
  preparationExact :
    prepareConcreteRestorationFromStartProgram startProgram configuration
        preparationAccumulator prepared.request = .ready prepared
  selectionExact :
    PreparedSelectionIsExact preparationAccumulator prepared
  traceBefore : List UnifiedExposureRecord
  traceAfter : List UnifiedExposureRecord
  traceExact :
    trace = traceBefore ++ scheduledPairRecords scheduled ++ traceAfter
  scheduledFrozenHistoryExact :
    scheduled.frozenHistory = prepared.programmingBase.history
  scheduledOutputInputExact : scheduled.outputInput = prepared.outputInput
  scheduledAdvanceInputExact : scheduled.advanceInput = prepared.advanceInput
  scheduledTemplateExact :
    scheduled.template = canonicalForkTemplate configuration
  scheduledInputStateExact :
    ScheduledPairInputState scheduled prepared.transition.before.core.digest
  parentHistoryClosed :
    FutureFreeHistoryClosed prepared.parentNode.verifierFinalState
  transitionBeforePreviouslySeen :
    prepared.transition.before ∈ prepared.parentNode.verifierFinalState.seen
  restoredStateExact :
    prepared.restoredState = restoreIndexedTransition prepared.transition
  restoredHistoryClosed : FutureFreeHistoryClosed prepared.restoredState
  restoredHistoryNonempty : prepared.restoredState.seen ≠ []
  restoredCurrentPreviouslySeen :
    prepared.restoredState.current ∈
      prepared.parentNode.verifierFinalState.seen
  restoredCurrentBindingsExact :
    prepared.restoredState.current.bindings =
      prepared.transition.before.bindings

/-- Exhaustive trace-level map: every actual advance coordinate has the
concrete preparation certificate for its immediately preceding output
coordinate.  This quantifies over the literal emitted trace, so failed
post-pair attempts remain covered. -/
def EveryEmittedPairHasConcreteRestoration
    {Statement Proof Payload : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (configuration : ConcreteRestorationConfiguration)
    (trace : List UnifiedExposureRecord) : Prop :=
  ∀ scheduled,
    (.forkAdvance scheduled : UnifiedExposureRecord) ∈ trace →
      Nonempty
        (EmittedPairConcreteRestoration startProgram configuration trace
          scheduled)

/-- Preparation is operationally functional at a fixed accumulator and
request.  Thus the scheduler callback cannot associate two different parent
transitions or restored verifier states with the same concrete request
state. -/
theorem ready_preparation_is_functional
    {Statement Proof Payload : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (configuration : ConcreteRestorationConfiguration)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (request : ConcreteRestorationRequest)
    (first second : PreparedConcreteRestoration Statement Proof Payload)
    (firstReady : prepareConcreteRestorationFromStartProgram startProgram
      configuration accumulator request = .ready first)
    (secondReady : prepareConcreteRestorationFromStartProgram startProgram
      configuration accumulator request = .ready second) :
    first = second := by
  rw [firstReady] at secondReady
  cases secondReady
  rfl

/-- In particular, the complete state selected at one actual preparation
phase is unique.  This is a consequence of the executable preparer, not a
caller-supplied restore function. -/
theorem ready_preparation_restored_state_is_functional
    {Statement Proof Payload : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (configuration : ConcreteRestorationConfiguration)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (request : ConcreteRestorationRequest)
    (first second : PreparedConcreteRestoration Statement Proof Payload)
    (firstReady : prepareConcreteRestorationFromStartProgram startProgram
      configuration accumulator request = .ready first)
    (secondReady : prepareConcreteRestorationFromStartProgram startProgram
      configuration accumulator request = .ready second) :
    first.restoredState = second.restoredState := by
  exact congrArg PreparedConcreteRestoration.restoredState
    (ready_preparation_is_functional startProgram configuration accumulator
      request first second firstReady secondReady)

/-- Extract membership of an indexed transition from the literal `get?`
equation. -/
theorem verifier_transition_at_mem
    {Statement Proof Payload : Type u}
    (node : ConcreteRestorationNode Statement Proof Payload)
    (transitionIndex : Nat) (transition : FutureFreeTransition)
    (found : verifierTransitionAt? node transitionIndex = some transition) :
    transition ∈ node.verifierFinalState.transitions := by
  unfold verifierTransitionAt? at found
  rw [List.getElem?_eq_some_iff] at found
  rcases found with ⟨within, valueExact⟩
  have member := List.getElem_mem within
  simpa [valueExact] using member

/-- A selected transition in a closed complete verifier history has an actual
previously-seen `before` snapshot. -/
theorem selected_transition_before_is_previously_seen
    {Statement Proof Payload : Type u}
    (node : ConcreteRestorationNode Statement Proof Payload)
    (transitionIndex : Nat) (transition : FutureFreeTransition)
    (found : verifierTransitionAt? node transitionIndex = some transition)
    (closed : FutureFreeHistoryClosed node.verifierFinalState) :
    transition.before ∈ node.verifierFinalState.seen := by
  exact (closed.2.2 transition
    (verifier_transition_at_mem node transitionIndex transition found)).1

/-- `restoreIndexedTransition` is itself a complete nonempty history whose
current snapshot is exactly the selected previously-seen snapshot. -/
theorem restore_indexed_transition_is_history_closed
    (transition : FutureFreeTransition) :
    FutureFreeHistoryClosed (restoreIndexedTransition transition) := by
  simp [FutureFreeHistoryClosed, restoreIndexedTransition]

/-- Construct the emitted-pair endpoint immediately from the actual `.ready`
preparation and scheduler configuration, before either programming half is
attempted. -/
def emitted_pair_concrete_restoration_of_ready
    {Statement Proof Payload : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (configuration : ConcreteRestorationConfiguration)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (prepared : PreparedConcreteRestoration Statement Proof Payload)
    (ready : prepareConcreteRestorationFromStartProgram startProgram
      configuration accumulator prepared.request = .ready prepared)
    (closed : EveryStoredNodeHistoryClosed accumulator)
    (trace : List UnifiedExposureRecord)
    (scheduled : ScheduledForkCoins)
    (frozenExact :
      scheduled.frozenHistory = prepared.programmingBase.history)
    (outputExact : scheduled.outputInput = prepared.outputInput)
    (advanceExact : scheduled.advanceInput = prepared.advanceInput)
    (templateExact :
      scheduled.template = canonicalForkTemplate configuration)
    (inputStateExact : ScheduledPairInputState scheduled
      prepared.transition.before.core.digest) :
    EmittedPairConcreteRestoration startProgram configuration
      (trace ++ scheduledPairRecords scheduled) scheduled := by
  have selection := prepare_concrete_restoration_ready_selection_exact
    startProgram configuration accumulator prepared.request prepared ready
  have parentMember :=
    AspisK1.V7Tag73ConcreteClientTableCoverage.ready_preparation_parent_is_stored
      startProgram configuration accumulator prepared.request prepared ready
  have parentClosed := closed prepared.parentNode parentMember
  have beforeSeen := selected_transition_before_is_previously_seen
    prepared.parentNode prepared.request.verifierTransitionIndex
      prepared.transition selection.2.1 parentClosed
  refine
    { preparationAccumulator := accumulator
      prepared := prepared
      preparationExact := ready
      selectionExact := selection
      traceBefore := trace
      traceAfter := []
      traceExact := by simp
      scheduledFrozenHistoryExact := frozenExact
      scheduledOutputInputExact := outputExact
      scheduledAdvanceInputExact := advanceExact
      scheduledTemplateExact := templateExact
      scheduledInputStateExact := inputStateExact
      parentHistoryClosed := parentClosed
      transitionBeforePreviouslySeen := beforeSeen
      restoredStateExact := selection.2.2.2
      restoredHistoryClosed := ?_
      restoredHistoryNonempty := ?_
      restoredCurrentPreviouslySeen := ?_
      restoredCurrentBindingsExact := ?_ }
  · simpa [selection.2.2.2] using
      restore_indexed_transition_is_history_closed prepared.transition
  · rw [selection.2.2.2]
    exact restore_indexed_transition_is_nonempty prepared.transition
  · rw [selection.2.2.2]
    simpa [restoreIndexedTransition] using beforeSeen
  · rw [selection.2.2.2]
    rfl

/-- Append-only trace transport for a concrete emitted-pair certificate. -/
def EmittedPairConcreteRestoration.appendTrace
    {Statement Proof Payload : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {configuration : ConcreteRestorationConfiguration}
    {trace : List UnifiedExposureRecord} {scheduled : ScheduledForkCoins}
    (certificate : EmittedPairConcreteRestoration startProgram configuration
      trace scheduled)
    (suffix : List UnifiedExposureRecord) :
    EmittedPairConcreteRestoration startProgram configuration
      (trace ++ suffix) scheduled :=
  { certificate with
    traceAfter := certificate.traceAfter ++ suffix
    traceExact := by
      calc
        trace ++ suffix =
            (certificate.traceBefore ++ scheduledPairRecords scheduled ++
              certificate.traceAfter) ++ suffix :=
          congrArg (fun records => records ++ suffix) certificate.traceExact
        _ = certificate.traceBefore ++ scheduledPairRecords scheduled ++
              (certificate.traceAfter ++ suffix) := by
          simp only [List.append_assoc] }

/-- A suffix with no advance coordinate cannot introduce an uncovered pair. -/
theorem every_emitted_pair_append_without_fork_advance
    {Statement Proof Payload : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (configuration : ConcreteRestorationConfiguration)
    (trace suffix : List UnifiedExposureRecord)
    (covered : EveryEmittedPairHasConcreteRestoration startProgram
      configuration trace)
    (noAdvance : ∀ scheduled,
      (.forkAdvance scheduled : UnifiedExposureRecord) ∉ suffix) :
    EveryEmittedPairHasConcreteRestoration startProgram configuration
      (trace ++ suffix) := by
  intro scheduled member
  rcases List.mem_append.mp member with old | new
  · rcases covered scheduled old with ⟨certificate⟩
    exact ⟨certificate.appendTrace suffix⟩
  · exact (noAdvance scheduled new).elim

/-- One literal pair append adds exactly the preparation-derived certificate
for that pair and preserves all earlier certificates. -/
theorem every_emitted_pair_append_scheduled_pair
    {Statement Proof Payload : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (configuration : ConcreteRestorationConfiguration)
    (trace : List UnifiedExposureRecord)
    (scheduled : ScheduledForkCoins)
    (covered : EveryEmittedPairHasConcreteRestoration startProgram
      configuration trace)
    (current : EmittedPairConcreteRestoration startProgram configuration
      (trace ++ scheduledPairRecords scheduled) scheduled) :
    EveryEmittedPairHasConcreteRestoration startProgram configuration
      (trace ++ scheduledPairRecords scheduled) := by
  intro candidate member
  rcases List.mem_append.mp member with old | new
  · rcases covered candidate old with ⟨certificate⟩
    exact ⟨certificate.appendTrace (scheduledPairRecords scheduled)⟩
  · simp only [scheduledPairRecords, List.mem_cons, List.mem_singleton] at new
    rcases new with impossible | exactAdvance
    · cases impossible
    · have candidateExact : candidate = scheduled := by
        simpa using exactAdvance
      subst candidate
      exact ⟨current⟩

/-- Machine-fresh and padding traces contain no fork-advance coordinate. -/
theorem no_fork_advance_of_only_machine_fresh_actor
    (actor : QueryActor) (records : List UnifiedExposureRecord)
    (onlyFresh : OnlyMachineFreshActor actor records) :
    ∀ scheduled,
      (.forkAdvance scheduled : UnifiedExposureRecord) ∉ records := by
  intro scheduled member
  obtain ⟨input, answer, exact⟩ := onlyFresh (.forkAdvance scheduled) member
  cases exact

theorem no_fork_advance_padding_records
    (answers : List Digest256) :
    ∀ scheduled,
      (.forkAdvance scheduled : UnifiedExposureRecord) ∉
        paddingRecords answers := by
  intro scheduled member
  simp [paddingRecords] at member

/-- A trace with no advance constructor has the exhaustive emitted-pair map
vacuously.  This discharges the concrete root prefix, whose records are only
adversary/verifier machine-fresh coordinates. -/
theorem every_emitted_pair_of_no_fork_advance
    {Statement Proof Payload : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (configuration : ConcreteRestorationConfiguration)
    (trace : List UnifiedExposureRecord)
    (noAdvance : ∀ scheduled,
      (.forkAdvance scheduled : UnifiedExposureRecord) ∉ trace) :
    EveryEmittedPairHasConcreteRestoration startProgram configuration trace := by
  intro scheduled member
  exact (noAdvance scheduled member).elim

/-- Node-store transport for the closed-history invariant. -/
theorem every_stored_node_history_closed_of_nodes_eq
    {Statement Proof Payload : Type u}
    (oldAccumulator newAccumulator :
      ConcreteRestorationAccumulator Statement Proof Payload)
    (nodesExact : newAccumulator.nodes = oldAccumulator.nodes)
    (closed : EveryStoredNodeHistoryClosed oldAccumulator) :
    EveryStoredNodeHistoryClosed newAccumulator := by
  intro node member
  rw [nodesExact] at member
  exact closed node member

/-- Append one actually returned child whose future-free verifier path starts
from a closed restored singleton. -/
theorem every_stored_node_history_closed_add_child
    {Statement Proof Payload : Type u}
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (child : ConcreteRestorationNode Statement Proof Payload)
    (closed : EveryStoredNodeHistoryClosed accumulator)
    (childClosed : FutureFreeHistoryClosed child.verifierFinalState) :
    EveryStoredNodeHistoryClosed (accumulator.addNode child).2 := by
  intro candidate member
  simp only [ConcreteRestorationAccumulator.addNode, List.mem_append,
    List.mem_singleton] at member
  rcases member with old | rfl
  · exact closed candidate old
  · exact childClosed

/-- Operational information carried through the literal finite restoration
client before any target-clean/native-state upgrade.  It contains only facts
constructed from the actual trace and append-only node store.  In particular,
there is no root/local seek equation and no caller-selected normalization
fuel. -/
structure ActualNodeTraceCausalInvariant
    {Statement Proof Payload Final : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (root : ConcreteRestorationNode Statement Proof Payload)
    (trace : List UnifiedExposureRecord)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload) :
    Prop where
  rootInitial : RootCausalInitialization root trace
  rootTableOutputs : ConcreteNodeTableOutputsHaveGlobalOrigin root trace
  rootProverHistoryAnswersRetained :
    SegmentHistoryAnswersRetained root.proverEntryOracle root.proverFinalOracle
  parentlessIsRoot : ParentlessNodeIsRoot root accumulator
  rootStored : RootStoredAtZero root accumulator
  everyNodeHistoryClosed : EveryStoredNodeHistoryClosed accumulator
  everyEmittedPairRestored : EveryEmittedPairHasConcreteRestoration
    startProgram configuration trace
  everyNodeGlobal : EveryNodeOperationalWithGlobalProvenance
    (Final := Final) startProgram environment configuration trace accumulator

/-- Every result of the literal client cursor carries the same trace/global
causal invariant after prefixing the exact records emitted by that result.
This predicate uses the proof-relevant scheduler traversal directly and does
not compare two cursors. -/
def ConcreteClientPreservesTraceCausalLineage
    {Statement Proof Payload Result : Type u} {globalOracleCalls : Nat}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (root : ConcreteRestorationNode Statement Proof Payload)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (cursor : SchedulerNativeCursor globalOracleCalls
      (ConcreteRestorationClientRun Statement Proof Payload Result)) : Prop :=
  ∀ trace,
    ActualNodeTraceCausalInvariant
      (Final := ConcreteRestorationClientRun Statement Proof Payload Result)
      startProgram environment configuration root trace accumulator →
    SchedulerNativeCursorAllProjectedTracedReturned
      (fun run suffix =>
        ActualNodeTraceCausalInvariant
          (Final := ConcreteRestorationClientRun Statement Proof Payload Result)
          startProgram environment configuration root (trace ++ suffix)
            run.accumulator)
      cursor

/-! ## Exact pair-programming ledger -/

theorem program_concrete_pair_ready_programming_history_cases
    (limits : OracleLimits) (order : PairProgrammingOrder)
    (state afterBoth : OracleState)
    (scheduled : ScheduledForkCoins)
    (ready : programConcretePair limits order state scheduled.outputInput
      scheduled.advanceInput scheduled.forkOutput scheduled.forkAdvance =
        .ready afterBoth) :
    ∀ record ∈ afterBoth.programmingHistory,
      record ∈ state.programmingHistory ∨
        ScheduledPairPrograms scheduled record := by
  intro record recordMember
  by_cases aliased : scheduled.outputInput = scheduled.advanceInput
  · simp [programConcretePair, aliased] at ready
  cases outputFound : lookupEntry state scheduled.outputInput with
  | some entry =>
      simp [programConcretePair, aliased, outputFound] at ready
  | none =>
      cases advanceFound : lookupEntry state scheduled.advanceInput with
      | some entry =>
          simp [programConcretePair, aliased, outputFound, advanceFound] at ready
      | none =>
          cases order with
          | outputThenAdvance =>
              cases first : programConcreteHalf limits state
                  scheduled.outputInput scheduled.forkOutput with
              | error reason =>
                  simp [programConcretePair, aliased, outputFound, advanceFound,
                    first] at ready
              | ok afterFirst =>
                  cases second : programConcreteHalf limits afterFirst
                      scheduled.advanceInput scheduled.forkAdvance with
                  | error reason =>
                      simp [programConcretePair, aliased, outputFound,
                        advanceFound, first, second] at ready
                  | ok finalState =>
                      have finalExact : finalState = afterBoth := by
                        simpa [programConcretePair, aliased, outputFound,
                          advanceFound, first, second] using ready
                      subst finalState
                      have first' : programOracle limits .extractorReplay state
                          { input := scheduled.outputInput
                            output := scheduled.forkOutput } = .ok afterFirst := by
                        simpa [programConcreteHalf] using first
                      have second' : programOracle limits .extractorReplay
                          afterFirst
                          { input := scheduled.advanceInput
                            output := scheduled.forkAdvance } = .ok afterBoth := by
                        simpa [programConcreteHalf] using second
                      have firstHistory :=
                        (program_oracle_success_appends_exact_programming_record
                          limits .extractorReplay state afterFirst _ first')
                      have secondHistory :=
                        (program_oracle_success_appends_exact_programming_record
                          limits .extractorReplay afterFirst afterBoth _ second')
                      rw [secondHistory, firstHistory] at recordMember
                      simp only [List.mem_append, List.mem_cons,
                        List.mem_singleton] at recordMember
                      rcases recordMember with prior | last
                      · rcases prior with old | firstOrEmpty
                        · exact Or.inl old
                        · rcases firstOrEmpty with rfl | impossible
                          · exact Or.inr ⟨rfl, Or.inl ⟨rfl, rfl⟩⟩
                          · simp at impossible
                      · rcases last with rfl | impossible
                        · exact Or.inr ⟨rfl, Or.inr ⟨rfl, rfl⟩⟩
                        · simp at impossible
          | advanceThenOutput =>
              cases first : programConcreteHalf limits state
                  scheduled.advanceInput scheduled.forkAdvance with
              | error reason =>
                  simp [programConcretePair, aliased, outputFound, advanceFound,
                    first] at ready
              | ok afterFirst =>
                  cases second : programConcreteHalf limits afterFirst
                      scheduled.outputInput scheduled.forkOutput with
                  | error reason =>
                      simp [programConcretePair, aliased, outputFound,
                        advanceFound, first, second] at ready
                  | ok finalState =>
                      have finalExact : finalState = afterBoth := by
                        simpa [programConcretePair, aliased, outputFound,
                          advanceFound, first, second] using ready
                      subst finalState
                      have first' : programOracle limits .extractorReplay state
                          { input := scheduled.advanceInput
                            output := scheduled.forkAdvance } = .ok afterFirst := by
                        simpa [programConcreteHalf] using first
                      have second' : programOracle limits .extractorReplay
                          afterFirst
                          { input := scheduled.outputInput
                            output := scheduled.forkOutput } = .ok afterBoth := by
                        simpa [programConcreteHalf] using second
                      have firstHistory :=
                        (program_oracle_success_appends_exact_programming_record
                          limits .extractorReplay state afterFirst _ first')
                      have secondHistory :=
                        (program_oracle_success_appends_exact_programming_record
                          limits .extractorReplay afterFirst afterBoth _ second')
                      rw [secondHistory, firstHistory] at recordMember
                      simp only [List.mem_append, List.mem_cons,
                        List.mem_singleton] at recordMember
                      rcases recordMember with prior | last
                      · rcases prior with old | firstOrEmpty
                        · exact Or.inl old
                        · rcases firstOrEmpty with rfl | impossible
                          · exact Or.inr ⟨rfl, Or.inr ⟨rfl, rfl⟩⟩
                          · simp at impossible
                      · rcases last with rfl | impossible
                        · exact Or.inr ⟨rfl, Or.inl ⟨rfl, rfl⟩⟩
                        · simp at impossible

/-! ## Preparation preserves the selected parent's ledger -/

theorem ready_preparation_parent_is_stored
    {Statement Proof Payload : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (configuration : ConcreteRestorationConfiguration)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (request : ConcreteRestorationRequest)
    (prepared : PreparedConcreteRestoration Statement Proof Payload)
    (ready : prepareConcreteRestorationFromStartProgram startProgram
      configuration accumulator request = .ready prepared) :
    accumulator.node? request.nodeId = some prepared.parentNode ∧
      prepared.parentNode ∈ accumulator.nodes ∧
      prepared.request = request ∧
      verifierTransitionAt? prepared.parentNode
        prepared.request.verifierTransitionIndex = some prepared.transition := by
  cases selectedNode : accumulator.node? request.nodeId with
  | none =>
      simp [prepareConcreteRestorationFromStartProgram, selectedNode] at ready
  | some parentNode =>
      cases selectedTransition : verifierTransitionAt? parentNode
          request.verifierTransitionIndex with
      | none =>
          simp [prepareConcreteRestorationFromStartProgram, selectedNode,
            selectedTransition] at ready
      | some transition =>
          cases selectedPair : squeezePairInputsOfTransition transition with
          | none =>
              simp [prepareConcreteRestorationFromStartProgram, selectedNode,
                selectedTransition, selectedPair] at ready
          | some pair =>
              rcases pair with ⟨outputInput, advanceInput⟩
              cases selectedOccurrence : firstEitherInputOccurrence outputInput
                  advanceInput parentNode.proverHistory with
              | none =>
                  simp [prepareConcreteRestorationFromStartProgram,
                    selectedNode, selectedTransition, selectedPair,
                    selectedOccurrence] at ready
                  subst prepared
                  unfold ConcreteRestorationAccumulator.node? at selectedNode
                  rw [List.getElem?_eq_some_iff] at selectedNode
                  rcases selectedNode with ⟨within, valueExact⟩
                  have member := List.getElem_mem within
                  exact ⟨rfl,
                    by simpa [valueExact] using member, rfl,
                      selectedTransition⟩
              | some occurrence =>
                  let prefixRun := runPrefix
                    (recordedPrefixController
                      parentNode.proverEntryOracle.history.length
                      occurrence.before)
                    configuration.oracleLimits .extractorReplay
                    occurrence.before.length parentNode.proverEntryOracle
                    startProgram
                  cases halted : prefixRun.halt with
                  | returned result =>
                      simp [prepareConcreteRestorationFromStartProgram,
                        selectedNode, selectedTransition, selectedPair,
                        selectedOccurrence, prefixRun, halted] at ready
                  | oracleAbort reason =>
                      simp [prepareConcreteRestorationFromStartProgram,
                        selectedNode, selectedTransition, selectedPair,
                        selectedOccurrence, prefixRun, halted] at ready
                  | paused residual =>
                      cases residual with
                      | pure result =>
                          simp [prepareConcreteRestorationFromStartProgram,
                            selectedNode, selectedTransition, selectedPair,
                            selectedOccurrence, prefixRun, halted] at ready
                      | abort reason =>
                          simp [prepareConcreteRestorationFromStartProgram,
                            selectedNode, selectedTransition, selectedPair,
                            selectedOccurrence, prefixRun, halted] at ready
                      | query pendingInput next =>
                          by_cases pendingMismatch :
                              pendingInput ≠ occurrence.chosen.input
                          · simp [prepareConcreteRestorationFromStartProgram,
                              selectedNode, selectedTransition, selectedPair,
                              selectedOccurrence, prefixRun, halted,
                              pendingMismatch] at ready
                          · by_cases traceMismatch : queryAnswerTrace
                                (historySince parentNode.proverEntryOracle
                                  prefixRun.oracle) ≠
                                queryAnswerTrace occurrence.before
                            · simp [prepareConcreteRestorationFromStartProgram,
                                selectedNode, selectedTransition, selectedPair,
                                selectedOccurrence, prefixRun, halted,
                                pendingMismatch, traceMismatch] at ready
                            · simp [prepareConcreteRestorationFromStartProgram,
                                selectedNode, selectedTransition, selectedPair,
                                selectedOccurrence, prefixRun, halted,
                                pendingMismatch, traceMismatch] at ready
                              subst prepared
                              unfold ConcreteRestorationAccumulator.node? at selectedNode
                              rw [List.getElem?_eq_some_iff] at selectedNode
                              rcases selectedNode with ⟨within, valueExact⟩
                              have member := List.getElem_mem within
                              exact ⟨rfl,
                                by simpa [valueExact] using member, rfl,
                                  selectedTransition⟩

/-- A successful preparation runs only ordinary oracle queries before pair
programming.  Hence its programming base has exactly the selected parent's
entry ledger, provided the selected parent's own complete prover run preserves
that ledger. -/
theorem ready_preparation_programming_history_eq_parent_entry
    {Statement Proof Payload : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (configuration : ConcreteRestorationConfiguration)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (request : ConcreteRestorationRequest)
    (prepared : PreparedConcreteRestoration Statement Proof Payload)
    (ready : prepareConcreteRestorationFromStartProgram startProgram
      configuration accumulator request = .ready prepared)
    (parentCompletePreserves :
      prepared.parentNode.proverFinalOracle.programmingHistory =
        prepared.parentNode.proverEntryOracle.programmingHistory) :
    prepared.programmingBase.programmingHistory =
      prepared.parentNode.proverEntryOracle.programmingHistory := by
  cases selectedNode : accumulator.node? request.nodeId with
  | none =>
      simp [prepareConcreteRestorationFromStartProgram, selectedNode] at ready
  | some parentNode =>
      cases selectedTransition : verifierTransitionAt? parentNode
          request.verifierTransitionIndex with
      | none =>
          simp [prepareConcreteRestorationFromStartProgram, selectedNode,
            selectedTransition] at ready
      | some transition =>
          cases selectedPair : squeezePairInputsOfTransition transition with
          | none =>
              simp [prepareConcreteRestorationFromStartProgram, selectedNode,
                selectedTransition, selectedPair] at ready
          | some pair =>
              rcases pair with ⟨outputInput, advanceInput⟩
              cases selectedOccurrence : firstEitherInputOccurrence outputInput
                  advanceInput parentNode.proverHistory with
              | none =>
                  simp [prepareConcreteRestorationFromStartProgram,
                    selectedNode, selectedTransition, selectedPair,
                    selectedOccurrence] at ready
                  subst prepared
                  exact parentCompletePreserves
              | some occurrence =>
                  let prefixRun := runPrefix
                    (recordedPrefixController
                      parentNode.proverEntryOracle.history.length
                      occurrence.before)
                    configuration.oracleLimits .extractorReplay
                    occurrence.before.length parentNode.proverEntryOracle
                    startProgram
                  cases halted : prefixRun.halt with
                  | returned result =>
                      simp [prepareConcreteRestorationFromStartProgram,
                        selectedNode, selectedTransition, selectedPair,
                        selectedOccurrence, prefixRun, halted] at ready
                  | oracleAbort reason =>
                      simp [prepareConcreteRestorationFromStartProgram,
                        selectedNode, selectedTransition, selectedPair,
                        selectedOccurrence, prefixRun, halted] at ready
                  | paused residual =>
                      cases residual with
                      | pure result =>
                          simp [prepareConcreteRestorationFromStartProgram,
                            selectedNode, selectedTransition, selectedPair,
                            selectedOccurrence, prefixRun, halted] at ready
                      | abort reason =>
                          simp [prepareConcreteRestorationFromStartProgram,
                            selectedNode, selectedTransition, selectedPair,
                            selectedOccurrence, prefixRun, halted] at ready
                      | query pendingInput next =>
                          by_cases pendingMismatch :
                              pendingInput ≠ occurrence.chosen.input
                          · simp [prepareConcreteRestorationFromStartProgram,
                              selectedNode, selectedTransition, selectedPair,
                              selectedOccurrence, prefixRun, halted,
                              pendingMismatch] at ready
                          · by_cases traceMismatch : queryAnswerTrace
                                (historySince parentNode.proverEntryOracle
                                  prefixRun.oracle) ≠
                                queryAnswerTrace occurrence.before
                            · simp [prepareConcreteRestorationFromStartProgram,
                                selectedNode, selectedTransition, selectedPair,
                                selectedOccurrence, prefixRun, halted,
                                pendingMismatch, traceMismatch] at ready
                            · simp [prepareConcreteRestorationFromStartProgram,
                                selectedNode, selectedTransition, selectedPair,
                                selectedOccurrence, prefixRun, halted,
                                pendingMismatch, traceMismatch] at ready
                              subst prepared
                              exact run_prefix_preserves_programming_history
                                (recordedPrefixController
                                  parentNode.proverEntryOracle.history.length
                                  occurrence.before)
                                configuration.oracleLimits .extractorReplay
                                occurrence.before.length
                                parentNode.proverEntryOracle startProgram

/-- A projected complete machine stage performs queries only and therefore
preserves the cumulative programming ledger of its exact entry oracle. -/
theorem projected_machine_prefix_preserves_programming_history
    {MachineResult : Type u}
    (limits : OracleLimits) (actor : QueryActor)
    (fuel : Nat) (entryState : OracleState)
    (program : OracleMachine MachineResult) (available : List Digest256)
    (returned : ProjectedMachinePrefixReturned limits actor fuel entryState
      program available) :
    returned.finalState.programmingHistory =
      entryState.programmingHistory := by
  have coherent := projected_returned_trace_entry_coherent limits actor
    fuel entryState program returned.freshQueries returned.result
      returned.finalState returned.steps returned.trace
  have runExact := projected_fresh_returned_trace_run_machine_exact limits actor
    entryState.history [] returned.freshQueries fuel entryState program
      returned.result returned.finalState returned.steps coherent
      (projected_fresh_suffix_initial entryState) returned.trace
  simp only [List.nil_append] at runExact
  have preserved := run_machine_preserves_cumulative_programming_history
    (controllerFromProjectedFreshAnswers entryState.history
      (returned.freshQueries.map Prod.snd)) limits actor fuel entryState program
  rw [runExact] at preserved
  exact preserved

theorem historical_node_prover_run_preserves_programming_history
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {child : ConcreteRestorationNode Statement Proof Payload}
    (execution : HistoricallyProvenancedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
      accumulator child) :
    child.proverFinalOracle.programmingHistory =
      child.proverEntryOracle.programmingHistory := by
  have preserved := projected_machine_prefix_preserves_programming_history
    configuration.oracleLimits .extractorReplay
      configuration.proverReplayFuel child.proverEntryOracle
      (schedulerStageProgram Final
        (totalizeOracleMachine configuration.proverReplayFuel startProgram))
      (machineFreshAnswers execution.base.proverRecords)
      execution.base.proverPrefix
  rw [execution.base.proverFinalExact] at preserved
  exact preserved

/-! ## Selected-parent causal facts -/

/-- The complete prover segment of every stored parent preserves its
programming ledger.  The root case is discharged by the actual empty-ledger
initialization; the nonroot case is obtained from the projected execution
stored by the historical induction. -/
theorem selected_parent_complete_preserves_programming_history
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {trace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {root parent : ConcreteRestorationNode Statement Proof Payload}
    (rootInitial : RootCausalInitialization root trace)
    (parentless : ParentlessNodeIsRoot root accumulator)
    (historical : EveryNodeOperationalWithHistoricalProvenance
      (Final := Final) startProgram environment configuration trace
      accumulator)
    (parentMember : parent ∈ accumulator.nodes) :
    parent.proverFinalOracle.programmingHistory =
      parent.proverEntryOracle.programmingHistory := by
  by_cases parentIsRoot : parent.parentRequest = none
  · have parentExact := parentless parent parentMember parentIsRoot
    subst parent
    rw [rootInitial.proverFinalProgrammingEmpty,
      rootInitial.proverEntryProgrammingEmpty]
  · obtain ⟨execution⟩ := historical parent parentMember parentIsRoot
    exact historical_node_prover_run_preserves_programming_history execution

/-- Every inherited programming record of the selected parent already has a
literal earlier adjacent-pair witness in the scheduler trace before the
current pair.  The root contributes no inherited records because its
programming ledger starts empty. -/
theorem selected_parent_programming_history_has_earlier_pair_provenance
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {trace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {root parent : ConcreteRestorationNode Statement Proof Payload}
    (rootInitial : RootCausalInitialization root trace)
    (parentless : ParentlessNodeIsRoot root accumulator)
    (historical : EveryNodeOperationalWithHistoricalProvenance
      (Final := Final) startProgram environment configuration trace
      accumulator)
    (parentMember : parent ∈ accumulator.nodes)
    (record : ProgrammingRecord)
    (recordMember : record ∈ parent.proverEntryOracle.programmingHistory) :
    ∃ (earlier : ScheduledForkCoins)
        (earlierBefore earlierAfter : List UnifiedExposureRecord)
        (inputState : Digest256),
      trace = earlierBefore ++ scheduledPairRecords earlier ++ earlierAfter ∧
      ScheduledPairPrograms earlier record ∧
      ScheduledPairInputState earlier inputState ∧
      (inputState = zeroDigest256 ∨
        ActiveExposureAnswer inputState earlierBefore) := by
  by_cases parentIsRoot : parent.parentRequest = none
  · have parentExact := parentless parent parentMember parentIsRoot
    subst parent
    rw [rootInitial.proverEntryProgrammingEmpty] at recordMember
    simp at recordMember
  · obtain ⟨execution⟩ := historical parent parentMember parentIsRoot
    obtain ⟨earlier, earlierBefore, earlierAfter, inputState, prefixExact,
        programs, inputs, origin⟩ :=
      execution.programmingHistoryHasEarlierPairProvenance record recordMember
    refine ⟨earlier, earlierBefore,
      earlierAfter ++ execution.base.proverRecords ++
        execution.base.verifierRecords ++ execution.base.traceAfterVerifier,
      inputState, ?_, programs, inputs, origin⟩
    calc
      trace =
          (execution.base.traceBeforePair ++
              scheduledPairRecords execution.base.scheduled) ++
            execution.base.proverRecords ++
              execution.base.verifierRecords ++
                execution.base.traceAfterVerifier :=
        execution.base.fullTraceExact
      _ =
          (earlierBefore ++ scheduledPairRecords earlier ++ earlierAfter) ++
            execution.base.proverRecords ++
              execution.base.verifierRecords ++
                execution.base.traceAfterVerifier :=
        congrArg
          (fun xs => xs ++ execution.base.proverRecords ++
            execution.base.verifierRecords ++
              execution.base.traceAfterVerifier)
          prefixExact
      _ = earlierBefore ++ scheduledPairRecords earlier ++
          (earlierAfter ++ execution.base.proverRecords ++
            execution.base.verifierRecords ++
              execution.base.traceAfterVerifier) := by
        simp [List.append_assoc]

/-- The positive-transition provenance carried by a nonroot parent embeds in
that parent's complete scheduler trace.  The distinguished fork-advance case
is itself a literal active exposure in the trace. -/
theorem causal_parent_positive_transition_digest_is_active
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {trace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {parent : ConcreteRestorationNode Statement Proof Payload}
    (causal : EveryNodeOperationalWithCausalProvenance
      (Final := Final) startProgram environment configuration trace
      accumulator)
    (parentMember : parent ∈ accumulator.nodes)
    (parentNonroot : parent.parentRequest ≠ none)
    (transitionIndex : Nat) (transition : FutureFreeTransition)
    (positive : transitionIndex ≠ 0)
    (transitionExact :
      verifierTransitionAt? parent transitionIndex = some transition) :
    ActiveExposureAnswer transition.before.core.digest trace := by
  obtain ⟨execution⟩ := causal parent parentMember parentNonroot
  rcases execution.positiveTransitionDigestProvenance transitionIndex
      transition positive transitionExact with atAdvance | active
  · let before := execution.base.traceBeforePair
    let scheduled := execution.base.scheduled
    let proverRecords := execution.base.proverRecords
    let verifierRecords := execution.base.verifierRecords
    let after := execution.base.traceAfterVerifier
    have traceExact : trace = before ++ scheduledPairRecords scheduled ++
        proverRecords ++ verifierRecords ++ after := by
      simpa only [before, scheduled, proverRecords, verifierRecords, after] using
        execution.base.fullTraceExact
    refine ⟨.forkAdvance scheduled, ?_, ?_⟩
    · rw [traceExact]
      simp [scheduledPairRecords]
    · simpa [UnifiedExposureRecord.answer] using atAdvance.symm
  · rcases active with ⟨record, member, answerExact⟩
    let before := execution.base.traceBeforePair
    let scheduled := execution.base.scheduled
    let proverRecords := execution.base.proverRecords
    let verifierRecords := execution.base.verifierRecords
    let after := execution.base.traceAfterVerifier
    have traceExact : trace = before ++ scheduledPairRecords scheduled ++
        proverRecords ++ verifierRecords ++ after := by
      simpa only [before, scheduled, proverRecords, verifierRecords, after] using
        execution.base.fullTraceExact
    have member' : record ∈ proverRecords ++ verifierRecords := by
      simpa only [proverRecords, verifierRecords] using member
    refine ⟨record, ?_, answerExact⟩
    rw [traceExact]
    simp only [List.mem_append]
    rcases List.mem_append.mp member' with proverMember | verifierMember
    · exact Or.inl (Or.inl (Or.inr proverMember))
    · exact Or.inl (Or.inr verifierMember)

/-- A replay-base-safe actual request always selects a parent transition whose
preceding digest is either the public dummy digest or an already emitted
active coordinate.  This is the exact causal fact needed to justify the next
pair's programming record; no lookup-freshness assertion appears here. -/
theorem selected_parent_transition_digest_has_causal_origin
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {trace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {root parent : ConcreteRestorationNode Statement Proof Payload}
    (rootInitial : RootCausalInitialization root trace)
    (parentless : ParentlessNodeIsRoot root accumulator)
    (rootStored : RootStoredAtZero root accumulator)
    (causal : EveryNodeOperationalWithCausalProvenance
      (Final := Final) startProgram environment configuration trace
      accumulator)
    (request : ConcreteRestorationRequest)
    (safe : ReplayBaseSafeRequest request)
    (selected : accumulator.node? request.nodeId = some parent)
    (transition : FutureFreeTransition)
    (transitionExact : verifierTransitionAt? parent
      request.verifierTransitionIndex = some transition) :
    transition.before.core.digest = zeroDigest256 ∨
      ActiveExposureAnswer transition.before.core.digest trace := by
  have parentMember : parent ∈ accumulator.nodes := by
    have selectedForMember := selected
    unfold ConcreteRestorationAccumulator.node? at selectedForMember
    rw [List.getElem?_eq_some_iff] at selectedForMember
    rcases selectedForMember with ⟨within, valueExact⟩
    have member := List.getElem_mem within
    simpa [valueExact] using member
  by_cases parentIsRoot : parent.parentRequest = none
  · have parentExact := parentless parent parentMember parentIsRoot
    subst parent
    exact rootInitial.transitionDigestProvenance
      request.verifierTransitionIndex transition transitionExact
  · have nodePositive : request.nodeId ≠ 0 := by
      intro atZero
      have selectedAtRoot := selected
      rw [atZero, rootStored] at selectedAtRoot
      have parentExact : root = parent := Option.some.inj selectedAtRoot
      subst parent
      exact parentIsRoot rootInitial.parentRequestNone
    have transitionPositive : request.verifierTransitionIndex ≠ 0 :=
      replay_base_safe_child_excludes_transition_zero request safe nodePositive
    exact Or.inr (causal_parent_positive_transition_digest_is_active causal
      parentMember parentIsRoot request.verifierTransitionIndex transition
        transitionPositive transitionExact)

/-- Whole-trace form used by the noncircular dispatcher induction.  The root
case comes from its concrete initialization; every nonroot case is read from
the already-constructed global node certificate.  No target-clean or local
positive-transition field is needed. -/
theorem selected_parent_transition_digest_has_global_origin
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {trace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {root parent : ConcreteRestorationNode Statement Proof Payload}
    (rootInitial : RootCausalInitialization root trace)
    (parentless : ParentlessNodeIsRoot root accumulator)
    (global : EveryNodeOperationalWithGlobalProvenance
      (Final := Final) startProgram environment configuration trace
        accumulator)
    (request : ConcreteRestorationRequest)
    (selected : accumulator.node? request.nodeId = some parent)
    (transition : FutureFreeTransition)
    (transitionExact : verifierTransitionAt? parent
      request.verifierTransitionIndex = some transition) :
    transition.before.core.digest = zeroDigest256 ∨
      ActiveExposureAnswer transition.before.core.digest trace := by
  have parentMember : parent ∈ accumulator.nodes := by
    have selectedForMember := selected
    unfold ConcreteRestorationAccumulator.node? at selectedForMember
    rw [List.getElem?_eq_some_iff] at selectedForMember
    rcases selectedForMember with ⟨within, valueExact⟩
    have member := List.getElem_mem within
    simpa [valueExact] using member
  by_cases parentIsRoot : parent.parentRequest = none
  · have parentExact := parentless parent parentMember parentIsRoot
    subst parent
    exact rootInitial.transitionDigestProvenance
      request.verifierTransitionIndex transition transitionExact
  · obtain ⟨execution⟩ := global parent parentMember parentIsRoot
    exact execution.transitionDigestHasGlobalOrigin
      request.verifierTransitionIndex transition transitionExact

/-- The saved q16 base in the selected complete snapshot has the same
whole-trace provenance.  This second component is essential: a later child
`q16Restore` may reinstall that saved state without making an oracle call. -/
theorem selected_parent_transition_q16_base_has_global_origin
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {trace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {root parent : ConcreteRestorationNode Statement Proof Payload}
    (rootInitial : RootCausalInitialization root trace)
    (parentless : ParentlessNodeIsRoot root accumulator)
    (global : EveryNodeOperationalWithGlobalProvenance
      (Final := Final) startProgram environment configuration trace
        accumulator)
    (request : ConcreteRestorationRequest)
    (selected : accumulator.node? request.nodeId = some parent)
    (transition : FutureFreeTransition) (base : Digest256)
    (transitionExact : verifierTransitionAt? parent
      request.verifierTransitionIndex = some transition)
    (saved : transition.before.core.q16Base = some base) :
    base = zeroDigest256 ∨ ActiveExposureAnswer base trace := by
  have parentMember : parent ∈ accumulator.nodes := by
    have selectedForMember := selected
    unfold ConcreteRestorationAccumulator.node? at selectedForMember
    rw [List.getElem?_eq_some_iff] at selectedForMember
    rcases selectedForMember with ⟨within, valueExact⟩
    have member := List.getElem_mem within
    simpa [valueExact] using member
  by_cases parentIsRoot : parent.parentRequest = none
  · have parentExact := parentless parent parentMember parentIsRoot
    subst parent
    exact rootInitial.transitionQ16BaseProvenance
      request.verifierTransitionIndex transition base transitionExact saved
  · obtain ⟨execution⟩ := global parent parentMember parentIsRoot
    exact execution.transitionQ16BaseHasGlobalOrigin
      request.verifierTransitionIndex transition base transitionExact saved

/-- Select the retained table-output invariant from either the concrete root
or an already-emitted nonroot node. -/
theorem selected_parent_table_outputs_have_global_origin
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {trace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {root parent : ConcreteRestorationNode Statement Proof Payload}
    (rootTables : ConcreteNodeTableOutputsHaveGlobalOrigin root trace)
    (parentless : ParentlessNodeIsRoot root accumulator)
    (global : EveryNodeOperationalWithGlobalProvenance
      (Final := Final) startProgram environment configuration trace
        accumulator)
    (nodeId : Nat) (selected : accumulator.node? nodeId = some parent) :
    ConcreteNodeTableOutputsHaveGlobalOrigin parent trace := by
  have parentMember : parent ∈ accumulator.nodes := by
    have selectedForMember := selected
    unfold ConcreteRestorationAccumulator.node? at selectedForMember
    rw [List.getElem?_eq_some_iff] at selectedForMember
    rcases selectedForMember with ⟨within, valueExact⟩
    have member := List.getElem_mem within
    simpa [valueExact] using member
  by_cases parentIsRoot : parent.parentRequest = none
  · have parentExact := parentless parent parentMember parentIsRoot
    simpa [parentExact] using rootTables
  · obtain ⟨execution⟩ := global parent parentMember parentIsRoot
    exact execution.tableOutputsHaveGlobalOrigin

/-- The analogous selector for the operational fact that the complete parent
prover segment retains every queried answer in its final table. -/
theorem selected_parent_prover_history_answers_retained
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {trace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {root parent : ConcreteRestorationNode Statement Proof Payload}
    (rootRetained : SegmentHistoryAnswersRetained root.proverEntryOracle
      root.proverFinalOracle)
    (parentless : ParentlessNodeIsRoot root accumulator)
    (global : EveryNodeOperationalWithGlobalProvenance
      (Final := Final) startProgram environment configuration trace
        accumulator)
    (nodeId : Nat) (selected : accumulator.node? nodeId = some parent) :
    SegmentHistoryAnswersRetained parent.proverEntryOracle
      parent.proverFinalOracle := by
  have parentMember : parent ∈ accumulator.nodes := by
    have selectedForMember := selected
    unfold ConcreteRestorationAccumulator.node? at selectedForMember
    rw [List.getElem?_eq_some_iff] at selectedForMember
    rcases selectedForMember with ⟨within, valueExact⟩
    have member := List.getElem_mem within
    simpa [valueExact] using member
  by_cases parentIsRoot : parent.parentRequest = none
  · have parentExact := parentless parent parentMember parentIsRoot
    simpa [parentExact] using rootRetained
  · obtain ⟨execution⟩ := global parent parentMember parentIsRoot
    exact execution.proverHistoryAnswersRetained

/-- A paused prefix can only retain entry-table answers or answers appearing
in its exact recorded query trace.  Supplying origins for that literal
reference trace therefore constructs origins for the prefix table itself. -/
theorem run_prefix_table_outputs_have_global_origin_of_reference
    {Result : Type u}
    (controller : AdaptiveController) (limits : OracleLimits)
    (actor : QueryActor) (fuel : Nat) (entryState : OracleState)
    (program : OracleMachine Result) (reference : List QueryRecord)
    (trace : List UnifiedExposureRecord)
    (entryOrigins : OracleTableOutputsHaveGlobalOrigin entryState trace)
    (referenceOrigins : ∀ record ∈ reference,
      record.output = zeroDigest256 ∨
        ActiveExposureAnswer record.output trace)
    (traceExact : queryAnswerTrace
      (historySince entryState
        (runPrefix controller limits actor fuel entryState program).oracle) =
      queryAnswerTrace reference) :
    OracleTableOutputsHaveGlobalOrigin
      (runPrefix controller limits actor fuel entryState program).oracle
      trace := by
  intro entry member
  rcases run_prefix_table_covered_by_entry_or_history_since controller limits
      actor fuel entryState program entry member with inherited | queried
  · exact entryOrigins entry inherited
  · rcases queried with ⟨record, recordMember, inputExact, outputExact⟩
    have pairMember : (record.input, record.output) ∈
        queryAnswerTrace (historySince entryState
          (runPrefix controller limits actor fuel entryState program).oracle) :=
      List.mem_map.mpr ⟨record, recordMember, rfl⟩
    rw [traceExact] at pairMember
    obtain ⟨referenceRecord, referenceMember, pairExact⟩ :=
      List.mem_map.mp pairMember
    have outputOrigin := referenceOrigins referenceRecord referenceMember
    have referenceOutputExact : referenceRecord.output = record.output := by
      exact congrArg Prod.snd pairExact
    rcases outputOrigin with atZero | active
    · exact Or.inl (outputExact.symm.trans (referenceOutputExact.symm.trans atZero))
    · rcases active with ⟨witness, witnessMember, answerExact⟩
      cases witness with
      | padding answer => exact answerExact.elim
      | machineFresh actor input answer =>
          exact Or.inr ⟨.machineFresh actor input answer, witnessMember,
            answerExact.trans (referenceOutputExact.trans outputExact)⟩
      | forkOutput history outputInput advanceInput template answer =>
          exact Or.inr
            ⟨.forkOutput history outputInput advanceInput template answer,
              witnessMember,
              answerExact.trans (referenceOutputExact.trans outputExact)⟩
      | forkAdvance scheduled =>
          exact Or.inr ⟨.forkAdvance scheduled, witnessMember,
            answerExact.trans (referenceOutputExact.trans outputExact)⟩

/-- The executable preparation's selected programming base inherits whole-
trace table-output origins.  In the no-pair branch it is the parent's complete
prover table.  In the occurrence branch the exact paused prefix is justified
by the literal earlier records of that same parent prover run. -/
theorem ready_preparation_programming_base_has_global_table_outputs
    {Statement Proof Payload : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (configuration : ConcreteRestorationConfiguration)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (request : ConcreteRestorationRequest)
    (prepared : PreparedConcreteRestoration Statement Proof Payload)
    (ready : prepareConcreteRestorationFromStartProgram startProgram
      configuration accumulator request = .ready prepared)
    (trace : List UnifiedExposureRecord)
    (parentTables : ConcreteNodeTableOutputsHaveGlobalOrigin
      prepared.parentNode trace)
    (parentRetained : SegmentHistoryAnswersRetained
      prepared.parentNode.proverEntryOracle
      prepared.parentNode.proverFinalOracle) :
    OracleTableOutputsHaveGlobalOrigin prepared.programmingBase trace := by
  cases selectedNode : accumulator.node? request.nodeId with
  | none =>
      simp [prepareConcreteRestorationFromStartProgram, selectedNode] at ready
  | some parentNode =>
      cases selectedTransition : verifierTransitionAt? parentNode
          request.verifierTransitionIndex with
      | none =>
          simp [prepareConcreteRestorationFromStartProgram, selectedNode,
            selectedTransition] at ready
      | some transition =>
          cases selectedPair : squeezePairInputsOfTransition transition with
          | none =>
              simp [prepareConcreteRestorationFromStartProgram, selectedNode,
                selectedTransition, selectedPair] at ready
          | some pair =>
              rcases pair with ⟨outputInput, advanceInput⟩
              cases selectedOccurrence : firstEitherInputOccurrence outputInput
                  advanceInput parentNode.proverHistory with
              | none =>
                  simp [prepareConcreteRestorationFromStartProgram,
                    selectedNode, selectedTransition, selectedPair,
                    selectedOccurrence] at ready
                  subst prepared
                  exact parentTables.proverFinal
              | some occurrence =>
                  have occurrenceSpec := first_either_input_occurrence_spec
                    outputInput advanceInput parentNode.proverHistory occurrence
                      selectedOccurrence
                  let prefixRun := runPrefix
                    (recordedPrefixController
                      parentNode.proverEntryOracle.history.length
                        occurrence.before)
                    configuration.oracleLimits .extractorReplay
                    occurrence.before.length parentNode.proverEntryOracle
                    startProgram
                  cases halted : prefixRun.halt with
                  | returned result =>
                      simp [prepareConcreteRestorationFromStartProgram,
                        selectedNode, selectedTransition, selectedPair,
                        selectedOccurrence, prefixRun, halted] at ready
                  | oracleAbort reason =>
                      simp [prepareConcreteRestorationFromStartProgram,
                        selectedNode, selectedTransition, selectedPair,
                        selectedOccurrence, prefixRun, halted] at ready
                  | paused residual =>
                      cases residual with
                      | pure result =>
                          simp [prepareConcreteRestorationFromStartProgram,
                            selectedNode, selectedTransition, selectedPair,
                            selectedOccurrence, prefixRun, halted] at ready
                      | abort reason =>
                          simp [prepareConcreteRestorationFromStartProgram,
                            selectedNode, selectedTransition, selectedPair,
                            selectedOccurrence, prefixRun, halted] at ready
                      | query pendingInput next =>
                          by_cases pendingMismatch :
                              pendingInput ≠ occurrence.chosen.input
                          · simp [prepareConcreteRestorationFromStartProgram,
                              selectedNode, selectedTransition, selectedPair,
                              selectedOccurrence, prefixRun, halted,
                              pendingMismatch] at ready
                          · by_cases traceMismatch : queryAnswerTrace
                                (historySince parentNode.proverEntryOracle
                                  prefixRun.oracle) ≠
                                queryAnswerTrace occurrence.before
                            · simp [prepareConcreteRestorationFromStartProgram,
                                selectedNode, selectedTransition, selectedPair,
                                selectedOccurrence, prefixRun, halted,
                                pendingMismatch, traceMismatch] at ready
                            · have exactTrace : queryAnswerTrace
                                  (historySince parentNode.proverEntryOracle
                                    prefixRun.oracle) =
                                  queryAnswerTrace occurrence.before :=
                                not_ne_iff.mp traceMismatch
                              simp [prepareConcreteRestorationFromStartProgram,
                                selectedNode, selectedTransition, selectedPair,
                                selectedOccurrence, prefixRun, halted,
                                pendingMismatch, traceMismatch] at ready
                              subst prepared
                              apply
                                run_prefix_table_outputs_have_global_origin_of_reference
                                  (recordedPrefixController
                                    parentNode.proverEntryOracle.history.length
                                      occurrence.before)
                                  configuration.oracleLimits .extractorReplay
                                  occurrence.before.length
                                  parentNode.proverEntryOracle startProgram
                                  occurrence.before trace
                                  parentTables.proverEntry
                              · intro record recordMember
                                have parentMember :
                                    record ∈ parentNode.proverHistory := by
                                  rw [occurrenceSpec.1]
                                  exact List.mem_append_left _ recordMember
                                obtain ⟨entry, entryMember, _inputExact,
                                    outputExact⟩ :=
                                  parentRetained record parentMember
                                rcases parentTables.proverFinal entry entryMember
                                    with atZero | active
                                · exact Or.inl (by simpa [outputExact] using atZero)
                                · rcases active with
                                    ⟨witness, witnessMember, answerExact⟩
                                  exact Or.inr ⟨witness, witnessMember, by
                                    simpa [outputExact] using answerExact⟩
                              · simpa [prefixRun] using exactTrace

/-- One actual successful `programConcreteHalf` appends exactly one table
entry, so a supplied active-coordinate witness for its output extends the
whole-table origin invariant. -/
theorem program_concrete_half_preserves_global_table_outputs
    (limits : OracleLimits) (state nextState : OracleState)
    (input : ShaInput) (output : Digest256)
    (trace : List UnifiedExposureRecord)
    (origins : OracleTableOutputsHaveGlobalOrigin state trace)
    (outputOrigin : ActiveExposureAnswer output trace)
    (success : programConcreteHalf limits state input output = .ok nextState) :
    OracleTableOutputsHaveGlobalOrigin nextState trace := by
  have programmed : programOracle limits .extractorReplay state
      { input := input, output := output } = .ok nextState := by
    simpa [programConcreteHalf] using success
  have tableExact :=
    (program_oracle_success_exact limits .extractorReplay state nextState
      { input := input, output := output } programmed).2.2.1
  intro entry member
  rw [tableExact] at member
  rcases List.mem_append.mp member with inherited | current
  · exact origins entry inherited
  · simp only [List.mem_singleton] at current
    subst entry
    exact Or.inr outputOrigin

/-- The two successful pair-programming operations are justified by the two
literal adjacent fork coordinates, independently of their configured write
order. -/
theorem program_concrete_pair_ready_has_global_table_outputs
    (limits : OracleLimits) (order : PairProgrammingOrder)
    (state afterBoth : OracleState) (scheduled : ScheduledForkCoins)
    (traceBefore : List UnifiedExposureRecord)
    (origins : OracleTableOutputsHaveGlobalOrigin state traceBefore)
    (ready : programConcretePair limits order state scheduled.outputInput
      scheduled.advanceInput scheduled.forkOutput scheduled.forkAdvance =
        .ready afterBoth) :
    OracleTableOutputsHaveGlobalOrigin afterBoth
      (traceBefore ++ scheduledPairRecords scheduled) := by
  have inherited := oracle_table_outputs_have_global_origin_append state
    traceBefore (scheduledPairRecords scheduled) origins
  have outputOrigin : ActiveExposureAnswer scheduled.forkOutput
      (traceBefore ++ scheduledPairRecords scheduled) := by
    exact ⟨.forkOutput scheduled.frozenHistory scheduled.outputInput
      scheduled.advanceInput scheduled.template scheduled.forkOutput,
        List.mem_append_right traceBefore (by simp [scheduledPairRecords]), rfl⟩
  have advanceOrigin : ActiveExposureAnswer scheduled.forkAdvance
      (traceBefore ++ scheduledPairRecords scheduled) := by
    exact ⟨.forkAdvance scheduled,
      List.mem_append_right traceBefore (by simp [scheduledPairRecords]), rfl⟩
  by_cases aliased : scheduled.outputInput = scheduled.advanceInput
  · simp [programConcretePair, aliased] at ready
  cases outputFound : lookupEntry state scheduled.outputInput with
  | some entry =>
      simp [programConcretePair, aliased, outputFound] at ready
  | none =>
      cases advanceFound : lookupEntry state scheduled.advanceInput with
      | some entry =>
          simp [programConcretePair, aliased, outputFound, advanceFound] at ready
      | none =>
          cases order with
          | outputThenAdvance =>
              cases first : programConcreteHalf limits state
                  scheduled.outputInput scheduled.forkOutput with
              | error reason =>
                  simp [programConcretePair, aliased, outputFound, advanceFound,
                    first] at ready
              | ok afterFirst =>
                  cases second : programConcreteHalf limits afterFirst
                      scheduled.advanceInput scheduled.forkAdvance with
                  | error reason =>
                      simp [programConcretePair, aliased, outputFound,
                        advanceFound, first, second] at ready
                  | ok finalState =>
                      have finalExact : finalState = afterBoth := by
                        simpa [programConcretePair, aliased, outputFound,
                          advanceFound, first, second] using ready
                      subst finalState
                      exact program_concrete_half_preserves_global_table_outputs
                        limits afterFirst afterBoth scheduled.advanceInput
                        scheduled.forkAdvance
                        (traceBefore ++ scheduledPairRecords scheduled)
                        (program_concrete_half_preserves_global_table_outputs
                          limits state afterFirst scheduled.outputInput
                          scheduled.forkOutput
                          (traceBefore ++ scheduledPairRecords scheduled)
                          inherited outputOrigin first)
                        advanceOrigin second
          | advanceThenOutput =>
              cases first : programConcreteHalf limits state
                  scheduled.advanceInput scheduled.forkAdvance with
              | error reason =>
                  simp [programConcretePair, aliased, outputFound, advanceFound,
                    first] at ready
              | ok afterFirst =>
                  cases second : programConcreteHalf limits afterFirst
                      scheduled.outputInput scheduled.forkOutput with
                  | error reason =>
                      simp [programConcretePair, aliased, outputFound,
                        advanceFound, first, second] at ready
                  | ok finalState =>
                      have finalExact : finalState = afterBoth := by
                        simpa [programConcretePair, aliased, outputFound,
                          advanceFound, first, second] using ready
                      subst finalState
                      exact program_concrete_half_preserves_global_table_outputs
                        limits afterFirst afterBoth scheduled.outputInput
                        scheduled.forkOutput
                        (traceBefore ++ scheduledPairRecords scheduled)
                        (program_concrete_half_preserves_global_table_outputs
                          limits state afterFirst scheduled.advanceInput
                          scheduled.forkAdvance
                          (traceBefore ++ scheduledPairRecords scheduled)
                          inherited advanceOrigin first)
                        outputOrigin second

/-- Construct all four table-output provenance fields of the actual child
from the selected parent, the two adjacent programmed coordinates, and the
two literal projected machine segments. -/
theorem projected_child_table_outputs_have_global_origin_of_global
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {oldAccumulator newAccumulator :
      ConcreteRestorationAccumulator Statement Proof Payload}
    {root child : ConcreteRestorationNode Statement Proof Payload}
    (base : ProjectedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
        newAccumulator child)
    (oldPreparationExact :
      prepareConcreteRestorationFromStartProgram startProgram configuration
          oldAccumulator base.prepared.request = .ready base.prepared)
    (rootTables : ConcreteNodeTableOutputsHaveGlobalOrigin root
      base.traceBeforePair)
    (rootRetained : SegmentHistoryAnswersRetained root.proverEntryOracle
      root.proverFinalOracle)
    (parentless : ParentlessNodeIsRoot root oldAccumulator)
    (global : EveryNodeOperationalWithGlobalProvenance
      (Final := Final) startProgram environment configuration
        base.traceBeforePair oldAccumulator) :
    ConcreteNodeTableOutputsHaveGlobalOrigin child fullTrace := by
  obtain ⟨selected, _parentMember, _requestExact, _transitionExact⟩ :=
    ready_preparation_parent_is_stored startProgram configuration
      oldAccumulator base.prepared.request base.prepared oldPreparationExact
  have parentTables := selected_parent_table_outputs_have_global_origin
    (Final := Final) rootTables parentless global
      base.prepared.request.nodeId selected
  have parentRetained := selected_parent_prover_history_answers_retained
    (Final := Final) rootRetained parentless global
      base.prepared.request.nodeId selected
  have programmingBaseOrigins :=
    ready_preparation_programming_base_has_global_table_outputs startProgram
      configuration oldAccumulator base.prepared.request base.prepared
        oldPreparationExact base.traceBeforePair parentTables parentRetained
  have programmingScheduled :
      programConcretePair configuration.oracleLimits
          configuration.pairProgrammingOrder base.prepared.programmingBase
          base.scheduled.outputInput base.scheduled.advanceInput
          base.scheduled.forkOutput base.scheduled.forkAdvance =
        .ready child.proverEntryOracle := by
    simpa [base.scheduledOutputInputExact, base.scheduledAdvanceInputExact,
      ScheduledForkCoins.configuration] using base.programmingExact
  have entryAtPair :=
    program_concrete_pair_ready_has_global_table_outputs
      configuration.oracleLimits configuration.pairProgrammingOrder
      base.prepared.programmingBase child.proverEntryOracle base.scheduled
      base.traceBeforePair programmingBaseOrigins programmingScheduled
  have proverAtPrefix := projected_machine_prefix_preserves_global_table_outputs
    configuration.oracleLimits .extractorReplay
      configuration.proverReplayFuel child.proverEntryOracle
      (schedulerStageProgram Final
        (totalizeOracleMachine configuration.proverReplayFuel startProgram))
      base.proverRecords base.proverPrefix base.proverQueriesExact
      (base.traceBeforePair ++ scheduledPairRecords base.scheduled) entryAtPair
  rw [base.proverFinalExact] at proverAtPrefix
  have verifierEntryAtPrefix : OracleTableOutputsHaveGlobalOrigin
      child.verifierEntryOracle
      ((base.traceBeforePair ++ scheduledPairRecords base.scheduled) ++
        base.proverRecords) := by
    simpa [base.verifierEntryOracleExact] using proverAtPrefix
  have verifierAtPrefix := projected_machine_prefix_preserves_global_table_outputs
    configuration.oracleLimits .verifier configuration.verifierFuel
      child.verifierEntryOracle
      (schedulerStageProgram Final
        (totalizeOracleMachine configuration.verifierFuel
          (driveRawFutureFree environment child.adversaryValue.rawMessages
            configuration.driverFuel child.verifierEntryState)))
      base.verifierRecords base.verifierPrefix base.verifierQueriesExact
      ((base.traceBeforePair ++ scheduledPairRecords base.scheduled) ++
        base.proverRecords) verifierEntryAtPrefix
  rw [base.verifierFinalExact] at verifierAtPrefix
  have entryFull := oracle_table_outputs_have_global_origin_append
    child.proverEntryOracle
    (base.traceBeforePair ++ scheduledPairRecords base.scheduled)
    (base.proverRecords ++ base.verifierRecords ++ base.traceAfterVerifier)
    entryAtPair
  have proverFull := oracle_table_outputs_have_global_origin_append
    child.proverFinalOracle
    ((base.traceBeforePair ++ scheduledPairRecords base.scheduled) ++
      base.proverRecords)
    (base.verifierRecords ++ base.traceAfterVerifier) proverAtPrefix
  have verifierEntryFull := oracle_table_outputs_have_global_origin_append
    child.verifierEntryOracle
    ((base.traceBeforePair ++ scheduledPairRecords base.scheduled) ++
      base.proverRecords)
    (base.verifierRecords ++ base.traceAfterVerifier) verifierEntryAtPrefix
  have verifierFull := oracle_table_outputs_have_global_origin_append
    child.verifierFinalOracle
    (((base.traceBeforePair ++ scheduledPairRecords base.scheduled) ++
      base.proverRecords) ++ base.verifierRecords)
    base.traceAfterVerifier verifierAtPrefix
  rw [base.fullTraceExact]
  exact
    { proverEntry := by simpa [List.append_assoc] using entryFull
      proverFinal := by simpa [List.append_assoc] using proverFull
      verifierEntry := by simpa [List.append_assoc] using verifierEntryFull
      verifierFinal := by simpa [List.append_assoc] using verifierFull }

/-- The child prover segment itself retains every queried answer, directly
from its projected machine execution. -/
theorem projected_child_prover_history_answers_retained
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {child : ConcreteRestorationNode Statement Proof Payload}
    (base : ProjectedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
        accumulator child) :
    SegmentHistoryAnswersRetained child.proverEntryOracle
      child.proverFinalOracle := by
  have retained := projected_machine_prefix_retains_every_segment_answer
    configuration.oracleLimits .extractorReplay
      configuration.proverReplayFuel child.proverEntryOracle
      (schedulerStageProgram Final
        (totalizeOracleMachine configuration.proverReplayFuel startProgram))
      (machineFreshAnswers base.proverRecords) base.proverPrefix
  rw [base.proverFinalExact] at retained
  exact retained

/-- Reflect the actual returned totalized verifier callback to its literal
raw future-free driver, recover the exact ordered query path, and interpret
that path as the operational verifier trace. -/
theorem projected_restoration_node_verifier_has_operational_trace
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {child : ConcreteRestorationNode Statement Proof Payload}
    (base : ProjectedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
        accumulator child) :
    ∃ pairs : List (ShaInput × ShaOutput),
      MachineQueryPath
        (driveRawFutureFree environment child.adversaryValue.rawMessages
          configuration.driverFuel child.verifierEntryState)
        pairs child.verifierFinalState ∧
      queryAnswerTrace child.verifierHistory = pairs ∧
      FutureFreeOperationalTrace environment child.adversaryValue.rawMessages
        child.verifierEntryState pairs child.verifierFinalState ∧
      ∀ pair ∈ pairs,
        tableLookup (fixedTableOfOracleState child.verifierFinalOracle)
          pair.1 = some pair.2 := by
  have coherent : HistoryTotalCoherent child.verifierEntryOracle :=
    projected_returned_trace_entry_coherent configuration.oracleLimits
      .verifier configuration.verifierFuel child.verifierEntryOracle
      (schedulerStageProgram Final
        (totalizeOracleMachine configuration.verifierFuel
          (driveRawFutureFree environment child.adversaryValue.rawMessages
            configuration.driverFuel child.verifierEntryState)))
      base.verifierPrefix.freshQueries base.verifierPrefix.result
      base.verifierPrefix.finalState base.verifierPrefix.steps
      base.verifierPrefix.trace
  have totalized := projected_scheduler_stage_prefix_underlying_run_exact
    (Final := Final) configuration.oracleLimits .verifier
      configuration.verifierFuel child.verifierEntryOracle
      (totalizeOracleMachine configuration.verifierFuel
        (driveRawFutureFree environment child.adversaryValue.rawMessages
          configuration.driverFuel child.verifierEntryState))
      (machineFreshAnswers base.verifierRecords) base.verifierPrefix
      (.ok child.verifierFinalState) base.verifierReturned coherent
  rw [base.verifierFinalExact] at totalized
  have reflected := run_machine_totalized_ok_reflects
    (controllerFromProjectedFreshAnswers child.verifierEntryOracle.history
      (machineFreshAnswers base.verifierRecords))
    configuration.oracleLimits .verifier configuration.verifierFuel
      child.verifierEntryOracle
      (driveRawFutureFree environment child.adversaryValue.rawMessages
        configuration.driverFuel child.verifierEntryState)
      child.verifierFinalState child.verifierFinalOracle
      base.verifierPrefix.steps totalized
  have returnedHalt :
      (runMachine
        (controllerFromProjectedFreshAnswers child.verifierEntryOracle.history
          (machineFreshAnswers base.verifierRecords))
        configuration.oracleLimits .verifier configuration.verifierFuel
        child.verifierEntryOracle
        (driveRawFutureFree environment child.adversaryValue.rawMessages
          configuration.driverFuel child.verifierEntryState)).halt =
        .returned child.verifierFinalState := by
    rw [reflected]
  obtain ⟨pairs, path, historyExact, _actors, tableAnswers⟩ :=
    run_machine_returned_has_exact_query_path
      (controllerFromProjectedFreshAnswers child.verifierEntryOracle.history
        (machineFreshAnswers base.verifierRecords))
      configuration.oracleLimits .verifier configuration.verifierFuel
      child.verifierEntryOracle
      (driveRawFutureFree environment child.adversaryValue.rawMessages
        configuration.driverFuel child.verifierEntryState)
      child.verifierFinalState returnedHalt
  rw [reflected] at historyExact
  refine ⟨pairs, path, ?_, ?_, ?_⟩
  · simpa [ConcreteRestorationNode.verifierHistory] using historyExact
  · exact drive_raw_future_free_path_is_operational_trace environment
      child.adversaryValue.rawMessages configuration.driverFuel
      child.verifierEntryState pairs child.verifierFinalState path
  · intro pair member
    have found := tableAnswers pair member
    rw [reflected] at found
    exact found

/-- A projected successful child has a closed final verifier history because
its entry is the exact restored singleton and its literal raw-driver path
preserves closure. -/
theorem projected_restoration_child_history_closed
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {child : ConcreteRestorationNode Statement Proof Payload}
    (base : ProjectedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
        accumulator child) :
    FutureFreeHistoryClosed child.verifierFinalState := by
  have selection := prepare_concrete_restoration_ready_selection_exact
    startProgram configuration accumulator base.prepared.request base.prepared
      base.preparationExact
  have entryClosed : FutureFreeHistoryClosed child.verifierEntryState := by
    rw [base.restoredEntryExact, selection.2.2.2]
    exact restore_indexed_transition_is_history_closed base.prepared.transition
  obtain ⟨pairs, path, _historyExact, _operational, _tableAnswers⟩ :=
    projected_restoration_node_verifier_has_operational_trace base
  exact drive_raw_future_free_path_preserves_history_closed environment
    child.adversaryValue.rawMessages configuration.driverFuel
      child.verifierEntryState pairs child.verifierFinalState entryClosed path

/-- A projected child inherits the q16 cap from the exact parent snapshot to
which preparation restores, and its literal future-free verifier trace
preserves that cap through the returned final state. -/
theorem projected_restoration_child_q16_slot_invariant
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {child : ConcreteRestorationNode Statement Proof Payload}
    (base : ProjectedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
        accumulator child)
    (parentInvariant : FutureFreeQ16SlotInvariant
      base.prepared.parentNode.verifierFinalState)
    (beforeSeen : base.prepared.transition.before ∈
      base.prepared.parentNode.verifierFinalState.seen) :
    FutureFreeQ16SlotInvariant child.verifierFinalState := by
  have selection := prepare_concrete_restoration_ready_selection_exact
    startProgram configuration accumulator base.prepared.request base.prepared
      base.preparationExact
  have beforeBound : Q16SnapshotSlotBound base.prepared.transition.before :=
    parentInvariant.2 base.prepared.transition.before beforeSeen
  have restoredInvariant :
      FutureFreeQ16SlotInvariant base.prepared.restoredState := by
    rw [selection.2.2.2]
    constructor
    · exact beforeBound
    · intro snapshot member
      simp only [restoreIndexedTransition, List.mem_singleton] at member
      subst snapshot
      exact beforeBound
  have entryInvariant :
      FutureFreeQ16SlotInvariant child.verifierEntryState := by
    rw [base.restoredEntryExact]
    exact restoredInvariant
  obtain ⟨pairs, _path, _historyExact, operational, _tableAnswers⟩ :=
    projected_restoration_node_verifier_has_operational_trace base
  exact future_free_operational_trace_preserves_q16_slot_invariant environment
    child.adversaryValue.rawMessages operational entryInvariant

