/-- Attach a constructed whole-trace transition-origin proof to the
historical node.  This helper is used only inside the executable dispatcher
induction; callers never supply the field to the final compiler theorem. -/
def HistoricallyProvenancedRestorationNodeExecution.withGlobalTransitions
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {child : ConcreteRestorationNode Statement Proof Payload}
    (historical : HistoricallyProvenancedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
      accumulator child)
    (tableOrigins : ConcreteNodeTableOutputsHaveGlobalOrigin child fullTrace)
    (historyRetained : SegmentHistoryAnswersRetained child.proverEntryOracle
      child.proverFinalOracle)
    (global : ∀ transitionIndex transition,
      verifierTransitionAt? child transitionIndex = some transition →
        transition.before.core.digest = zeroDigest256 ∨
          ActiveExposureAnswer transition.before.core.digest fullTrace)
    (savedGlobal : ∀ transitionIndex transition base,
      verifierTransitionAt? child transitionIndex = some transition →
      transition.before.core.q16Base = some base →
        base = zeroDigest256 ∨ ActiveExposureAnswer base fullTrace) :
    GloballyProvenancedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
      accumulator child :=
  { historical := historical
    tableOutputsHaveGlobalOrigin := tableOrigins
    proverHistoryAnswersRetained := historyRetained
    transitionDigestHasGlobalOrigin := global
    transitionQ16BaseHasGlobalOrigin := savedGlobal }

/-- Attach the protocol-specific positive-transition result to the already
constructed historical certificate.  The `positive` argument is supplied by
the synchronized native-entry-prefix induction; it is not an assumed
lookup-freshness or compiler-cover statement. -/
def HistoricallyProvenancedRestorationNodeExecution.withPositiveTransitions
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {accumulator : ConcreteRestorationAccumulator Statement Proof Payload}
    {child : ConcreteRestorationNode Statement Proof Payload}
    (historical : HistoricallyProvenancedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
      accumulator child)
    (positive : ∀ transitionIndex transition,
      transitionIndex ≠ 0 →
      verifierTransitionAt? child transitionIndex = some transition →
      transition.before.core.digest = historical.base.scheduled.forkAdvance ∨
        ActiveExposureAnswer transition.before.core.digest
          (historical.base.proverRecords ++ historical.base.verifierRecords)) :
    CausallyProvenancedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
      accumulator child :=
  { base := historical.base
    requestIsStructurallyFresh := historical.requestIsStructurallyFresh
    programmingHistoryHasEarlierPairProvenance :=
      historical.programmingHistoryHasEarlierPairProvenance
    positiveTransitionDigestProvenance := positive }

