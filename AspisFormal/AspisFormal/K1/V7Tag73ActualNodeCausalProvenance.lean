      environment configuration root (trace ++ suffix) newAccumulator := by
  have lookupExact : newAccumulator.node? 0 = oldAccumulator.node? 0 := by
    unfold ConcreteRestorationAccumulator.node?
    rw [nodesExact]
  exact
    { rootInitial := invariant.rootInitial.appendTrace suffix
