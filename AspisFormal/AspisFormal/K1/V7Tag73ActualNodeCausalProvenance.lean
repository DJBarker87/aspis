/-! ## Trace-only append transport -/

theorem actual_node_trace_causal_invariant_of_nodes_eq
    {Statement Proof Payload Final : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (root : ConcreteRestorationNode Statement Proof Payload)
    (trace suffix : List UnifiedExposureRecord)
    (oldAccumulator newAccumulator :
      ConcreteRestorationAccumulator Statement Proof Payload)
    (nodesExact : newAccumulator.nodes = oldAccumulator.nodes)
    (pairsCovered : EveryEmittedPairHasConcreteRestoration startProgram
      configuration (trace ++ suffix))
    (invariant : ActualNodeTraceCausalInvariant (Final := Final) startProgram
      environment configuration root trace oldAccumulator) :
    ActualNodeTraceCausalInvariant (Final := Final) startProgram environment
      configuration root (trace ++ suffix) newAccumulator := by
  have lookupExact : newAccumulator.node? 0 = oldAccumulator.node? 0 := by
    unfold ConcreteRestorationAccumulator.node?
    rw [nodesExact]
  exact
    { rootInitial := invariant.rootInitial.appendTrace suffix
      rootTableOutputs := invariant.rootTableOutputs.appendTrace suffix
      rootProverHistoryAnswersRetained :=
        invariant.rootProverHistoryAnswersRetained
      parentlessIsRoot := parentless_node_is_root_of_nodes_eq root
        oldAccumulator newAccumulator nodesExact invariant.parentlessIsRoot
      rootStored := root_stored_at_zero_of_node_lookup_eq root oldAccumulator
        newAccumulator lookupExact invariant.rootStored
      everyNodeHistoryClosed :=
        every_stored_node_history_closed_of_nodes_eq oldAccumulator
          newAccumulator nodesExact invariant.everyNodeHistoryClosed
      everyEmittedPairRestored := pairsCovered
      everyNodeGlobal := every_node_global_provenance_of_nodes_eq startProgram
        environment configuration trace suffix oldAccumulator newAccumulator
          nodesExact invariant.everyNodeGlobal }

theorem initial_actual_node_trace_causal_invariant
    {Statement Proof Payload Final : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (root : ConcreteRestorationNode Statement Proof Payload)
    (trace : List UnifiedExposureRecord)
    (rootInitial : RootCausalInitialization root trace)
    (rootTableOutputs : ConcreteNodeTableOutputsHaveGlobalOrigin root trace)
    (rootProverHistoryAnswersRetained : SegmentHistoryAnswersRetained
      root.proverEntryOracle root.proverFinalOracle)
    (rootHistoryClosed : FutureFreeHistoryClosed root.verifierFinalState)
    (rootPairsCovered : EveryEmittedPairHasConcreteRestoration startProgram
      configuration trace) :
    ActualNodeTraceCausalInvariant (Final := Final) startProgram environment
      configuration root trace (initialRestorationAccumulatorFromRoot root) :=
  { rootInitial := rootInitial
    rootTableOutputs := rootTableOutputs
    rootProverHistoryAnswersRetained := rootProverHistoryAnswersRetained
    parentlessIsRoot := initial_parentless_node_is_root root
    rootStored := initial_root_stored_at_zero root
    everyNodeHistoryClosed := by
      intro node member
      simp only [initialRestorationAccumulatorFromRoot,
        List.mem_singleton] at member
      subst node
      exact rootHistoryClosed
    everyEmittedPairRestored := rootPairsCovered
    everyNodeGlobal := initial_every_node_global_provenance startProgram
      environment configuration trace root rootInitial.parentRequestNone }

theorem every_node_global_provenance_add_actual_child
    {Statement Proof Payload Final : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (trace suffix : List UnifiedExposureRecord)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (child : ConcreteRestorationNode Statement Proof Payload)
    (invariant : EveryNodeOperationalWithGlobalProvenance
      (Final := Final) startProgram environment configuration trace accumulator)
    (childExecution : GloballyProvenancedRestorationNodeExecution
      (Final := Final) startProgram environment configuration (trace ++ suffix)
        (accumulator.addNode child).2 child) :
    EveryNodeOperationalWithGlobalProvenance
      (Final := Final) startProgram environment configuration (trace ++ suffix)
        (accumulator.addNode child).2 := by
  intro candidate member parentRequest
  have memberCases : candidate ∈ accumulator.nodes ∨ candidate = child := by
    simpa [ConcreteRestorationAccumulator.addNode] using member
  rcases memberCases with oldMember | candidateExact
  · obtain ⟨execution⟩ := invariant candidate oldMember parentRequest
    obtain ⟨parent, selected⟩ := ready_preparation_has_selected_parent
      startProgram configuration accumulator
        execution.historical.base.prepared.request
        execution.historical.base.prepared
        execution.historical.base.preparationExact
    refine ⟨transport_globally_provenanced_restoration_node_execution
      startProgram environment configuration trace (trace ++ suffix) suffix
        accumulator (accumulator.addNode child).2 candidate execution rfl ?_⟩
    rw [selected]
    exact node_lookup_preserved_by_add_node accumulator child parent
      execution.historical.base.prepared.request.nodeId selected
  · subst candidate
    exact ⟨childExecution⟩

theorem parentless_node_is_root_add_actual_child
    {Statement Proof Payload : Type u}
    (root child : ConcreteRestorationNode Statement Proof Payload)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (invariant : ParentlessNodeIsRoot root accumulator)
    (childHasParent : child.parentRequest ≠ none) :
    ParentlessNodeIsRoot root (accumulator.addNode child).2 := by
  intro node member parentless
  simp only [ConcreteRestorationAccumulator.addNode, List.mem_append,
    List.mem_singleton] at member
  rcases member with old | rfl
  · exact invariant node old parentless
  · exact (childHasParent parentless).elim

theorem root_stored_at_zero_add_actual_child
    {Statement Proof Payload : Type u}
    (root child : ConcreteRestorationNode Statement Proof Payload)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (invariant : RootStoredAtZero root accumulator) :
    RootStoredAtZero root (accumulator.addNode child).2 := by
  exact node_lookup_preserved_by_add_node accumulator child root 0 invariant

theorem actual_node_trace_causal_invariant_add_actual_child
    {Statement Proof Payload Final : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (root child : ConcreteRestorationNode Statement Proof Payload)
    (trace suffix : List UnifiedExposureRecord)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (invariant : ActualNodeTraceCausalInvariant (Final := Final) startProgram
      environment configuration root trace accumulator)
    (childGlobal : GloballyProvenancedRestorationNodeExecution
      (Final := Final) startProgram environment configuration (trace ++ suffix)
        (accumulator.addNode child).2 child)
    (pairsCovered : EveryEmittedPairHasConcreteRestoration startProgram
      configuration (trace ++ suffix)) :
    ActualNodeTraceCausalInvariant (Final := Final) startProgram environment
      configuration root (trace ++ suffix) (accumulator.addNode child).2 :=
  { rootInitial := invariant.rootInitial.appendTrace suffix
    rootTableOutputs := invariant.rootTableOutputs.appendTrace suffix
    rootProverHistoryAnswersRetained :=
      invariant.rootProverHistoryAnswersRetained
    parentlessIsRoot := parentless_node_is_root_add_actual_child root child accumulator
      invariant.parentlessIsRoot (by
        rw [childGlobal.historical.base.parentRequestExact]
        simp)
    rootStored := root_stored_at_zero_add_actual_child root child accumulator
      invariant.rootStored
    everyNodeHistoryClosed := by
      exact every_stored_node_history_closed_add_child accumulator child
        invariant.everyNodeHistoryClosed
          (projected_restoration_child_history_closed
            childGlobal.historical.base)
    everyEmittedPairRestored := pairsCovered
    everyNodeGlobal := every_node_global_provenance_add_actual_child
      startProgram environment configuration trace suffix accumulator child
        invariant.everyNodeGlobal childGlobal }

theorem unchanged_continuation_preserves_trace_causal_lineage
    {Statement Proof Payload Result : Type u} {globalOracleCalls : Nat}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (root : ConcreteRestorationNode Statement Proof Payload)
    (resume : ConcreteRestorationReply →
      ConcreteRestorationAccumulator Statement Proof Payload →
        SchedulerNativeCursor globalOracleCalls
          (ConcreteRestorationClientRun Statement Proof Payload Result))
    (continuations : ∀ reply nextAccumulator,
      ConcreteClientPreservesTraceCausalLineage startProgram environment
        configuration root nextAccumulator (resume reply nextAccumulator))
    (trace suffix : List UnifiedExposureRecord)
    (accumulator nextAccumulator :
      ConcreteRestorationAccumulator Statement Proof Payload)
    (reply : ConcreteRestorationReply)
    (nodesExact : nextAccumulator.nodes = accumulator.nodes)
    (pairsCovered : EveryEmittedPairHasConcreteRestoration startProgram
      configuration (trace ++ suffix))
    (invariant : ActualNodeTraceCausalInvariant
      (Final := ConcreteRestorationClientRun Statement Proof Payload Result)
      startProgram environment configuration root trace accumulator) :
    SchedulerNativeCursorAllProjectedTracedReturned
      (fun run later => ActualNodeTraceCausalInvariant
        (Final := ConcreteRestorationClientRun Statement Proof Payload Result)
        startProgram environment configuration root
          (trace ++ suffix ++ later) run.accumulator)
      (resume reply nextAccumulator) := by
  apply continuations reply nextAccumulator (trace ++ suffix)
  exact actual_node_trace_causal_invariant_of_nodes_eq startProgram environment
    configuration root trace suffix accumulator nextAccumulator nodesExact
      pairsCovered invariant

/-! ## Failure-inclusive restoration-state map

The global-provenance invariant above is useful for later algebraic
extraction, but the compiler bridge needs a smaller operational fact first:
every fork pair emitted by the real client restores a complete state already
present in the selected parent's history.  Keeping this invariant separate
avoids any cursor-equality or normalization-fuel premise. -/

/-- State needed to construct the exact restoration map.  Both components are
about the literal append-only accumulator and trace. -/
structure ActualRestorationStateMapInvariant
    {Statement Proof Payload : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (trace : List UnifiedExposureRecord)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload) :
    Prop where
  everyNodeHistoryClosed : EveryStoredNodeHistoryClosed accumulator
  everyNodeQ16SlotInvariant : EveryStoredNodeQ16SlotInvariant accumulator
  everyNodeQ16LedgerInvariant :
    EveryStoredNodeQ16LedgerInvariant environment accumulator
  everyNodeK13ChallengeInvariant :
    EveryStoredNodeK13ChallengeInvariant accumulator
  everyEmittedPairRestored : EveryEmittedPairHasConcreteRestoration
    startProgram configuration trace

/-- Every projected terminal below the actual client cursor retains the
failure-inclusive restoration-state map on its literal emitted suffix. -/
def ConcreteClientPreservesRestorationStateMap
    {Statement Proof Payload Result : Type u} {globalOracleCalls : Nat}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (cursor : SchedulerNativeCursor globalOracleCalls
      (ConcreteRestorationClientRun Statement Proof Payload Result)) : Prop :=
  ∀ trace,
    ActualRestorationStateMapInvariant startProgram environment configuration trace
        accumulator →
      SchedulerNativeCursorAllProjectedTracedReturned
        (fun run suffix => ActualRestorationStateMapInvariant startProgram
          environment configuration (trace ++ suffix) run.accumulator)
        cursor

/-- Store-preserving bookkeeping and an explicitly certified trace suffix
transport the restoration-state map. -/
theorem restoration_state_map_of_nodes_eq
    {Statement Proof Payload : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (trace suffix : List UnifiedExposureRecord)
    (oldAccumulator newAccumulator :
      ConcreteRestorationAccumulator Statement Proof Payload)
    (nodesExact : newAccumulator.nodes = oldAccumulator.nodes)
    (pairsCovered : EveryEmittedPairHasConcreteRestoration startProgram
      configuration (trace ++ suffix))
    (invariant : ActualRestorationStateMapInvariant startProgram environment
      configuration trace oldAccumulator) :
    ActualRestorationStateMapInvariant startProgram environment configuration
      (trace ++ suffix) newAccumulator :=
  { everyNodeHistoryClosed :=
      every_stored_node_history_closed_of_nodes_eq oldAccumulator
        newAccumulator nodesExact invariant.everyNodeHistoryClosed
    everyNodeQ16SlotInvariant :=
      every_stored_node_q16_slot_invariant_of_nodes_eq oldAccumulator
        newAccumulator nodesExact invariant.everyNodeQ16SlotInvariant
    everyNodeQ16LedgerInvariant :=
      every_stored_node_q16_ledger_invariant_of_nodes_eq environment
        oldAccumulator newAccumulator nodesExact
          invariant.everyNodeQ16LedgerInvariant
    everyNodeK13ChallengeInvariant :=
      every_stored_node_k13_challenge_invariant_of_nodes_eq oldAccumulator
        newAccumulator nodesExact invariant.everyNodeK13ChallengeInvariant
    everyEmittedPairRestored := pairsCovered }

/-- Appending one actually returned child preserves closed histories and the
already constructed map for all emitted pairs, including the current pair. -/
theorem restoration_state_map_add_child
    {Statement Proof Payload : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (trace suffix : List UnifiedExposureRecord)
    (accumulator : ConcreteRestorationAccumulator Statement Proof Payload)
    (child : ConcreteRestorationNode Statement Proof Payload)
    (childClosed : FutureFreeHistoryClosed child.verifierFinalState)
    (childQ16 : FutureFreeQ16SlotInvariant child.verifierFinalState)
    (childQ16Ledger : FutureFreeQ16LedgerInvariant environment
      child.verifierFinalState)
    (childK13Challenges : FutureFreeK13ChallengeInvariant
      child.verifierFinalState)
    (pairsCovered : EveryEmittedPairHasConcreteRestoration startProgram
      configuration (trace ++ suffix))
    (invariant : ActualRestorationStateMapInvariant startProgram environment
      configuration trace accumulator) :
    ActualRestorationStateMapInvariant startProgram environment configuration
      (trace ++ suffix) (accumulator.addNode child).2 :=
  { everyNodeHistoryClosed :=
      every_stored_node_history_closed_add_child accumulator child
        invariant.everyNodeHistoryClosed childClosed
    everyNodeQ16SlotInvariant :=
      every_stored_node_q16_slot_invariant_add_child accumulator child
        invariant.everyNodeQ16SlotInvariant childQ16
    everyNodeQ16LedgerInvariant :=
      every_stored_node_q16_ledger_invariant_add_child environment accumulator
        child invariant.everyNodeQ16LedgerInvariant childQ16Ledger
    everyNodeK13ChallengeInvariant :=
      every_stored_node_k13_challenge_invariant_add_child accumulator child
        invariant.everyNodeK13ChallengeInvariant childK13Challenges
    everyEmittedPairRestored := pairsCovered }

/-- The singleton root initializes the map on any fork-free root prefix. -/
theorem initial_restoration_state_map
    {Statement Proof Payload : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (root : ConcreteRestorationNode Statement Proof Payload)
    (trace : List UnifiedExposureRecord)
    (rootClosed : FutureFreeHistoryClosed root.verifierFinalState)
    (rootQ16 : FutureFreeQ16SlotInvariant root.verifierFinalState)
    (rootQ16Ledger : FutureFreeQ16LedgerInvariant environment
      root.verifierFinalState)
    (rootK13Challenges : FutureFreeK13ChallengeInvariant
      root.verifierFinalState)
    (noAdvance : ∀ scheduled,
      (.forkAdvance scheduled : UnifiedExposureRecord) ∉ trace) :
    ActualRestorationStateMapInvariant startProgram environment configuration trace
      (initialRestorationAccumulatorFromRoot root) :=
  { everyNodeHistoryClosed := by
      intro node member
      have nodeExact : node = root := by
        simpa [initialRestorationAccumulatorFromRoot] using member
      subst node
      exact rootClosed
    everyNodeQ16SlotInvariant := by
      intro node member
      have nodeExact : node = root := by
        simpa [initialRestorationAccumulatorFromRoot] using member
      subst node
      exact rootQ16
    everyNodeQ16LedgerInvariant := by
      intro node member
      have nodeExact : node = root := by
        simpa [initialRestorationAccumulatorFromRoot] using member
      subst node
      exact rootQ16Ledger
    everyNodeK13ChallengeInvariant := by
      intro node member
      have nodeExact : node = root := by
        simpa [initialRestorationAccumulatorFromRoot] using member
      subst node
      exact rootK13Challenges
    everyEmittedPairRestored :=
      every_emitted_pair_of_no_fork_advance startProgram configuration trace
        noAdvance }

/-- Pointwise continuation helper for every branch that changes only charges
or failures and appends a certified exposure suffix. -/
theorem unchanged_continuation_preserves_restoration_state_map
    {Statement Proof Payload Result : Type u} {globalOracleCalls : Nat}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (resume : ConcreteRestorationReply →
      ConcreteRestorationAccumulator Statement Proof Payload →
        SchedulerNativeCursor globalOracleCalls
          (ConcreteRestorationClientRun Statement Proof Payload Result))
    (continuations : ∀ reply nextAccumulator,
      ConcreteClientPreservesRestorationStateMap startProgram environment
        configuration nextAccumulator (resume reply nextAccumulator))
    (trace suffix : List UnifiedExposureRecord)
    (accumulator nextAccumulator :
      ConcreteRestorationAccumulator Statement Proof Payload)
    (reply : ConcreteRestorationReply)
    (nodesExact : nextAccumulator.nodes = accumulator.nodes)
    (pairsCovered : EveryEmittedPairHasConcreteRestoration startProgram
      configuration (trace ++ suffix))
    (invariant : ActualRestorationStateMapInvariant startProgram environment
      configuration trace accumulator) :
    SchedulerNativeCursorAllProjectedTracedReturned
      (fun run later => ActualRestorationStateMapInvariant startProgram
        environment configuration (trace ++ suffix ++ later) run.accumulator)
      (resume reply nextAccumulator) := by
  apply continuations reply nextAccumulator (trace ++ suffix)
  exact restoration_state_map_of_nodes_eq startProgram environment configuration
    trace suffix accumulator nextAccumulator nodesExact pairsCovered invariant

