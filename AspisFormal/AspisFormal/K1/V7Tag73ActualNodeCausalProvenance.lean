/-- Historical programming-ledger constructor factored ahead of the global
transition/table constructor.  Factoring it here keeps the dependency order
noncircular: the selected parent's digest origin comes from the already-built
whole-trace invariant, while the new pair is witnessed literally at the end
of `traceBeforePair`. -/
def historical_child_of_global_parent
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {oldAccumulator newAccumulator :
      ConcreteRestorationAccumulator Statement Proof Payload}
    {root child : ConcreteRestorationNode Statement Proof Payload}
    (base : ProjectedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
      newAccumulator child)
    (oldPreparationExact :
      prepareConcreteRestorationFromStartProgram startProgram configuration
          oldAccumulator base.prepared.request =
        .ready base.prepared)
    (rootInitial : RootCausalInitialization root base.traceBeforePair)
    (parentless : ParentlessNodeIsRoot root oldAccumulator)
    (historical : EveryNodeOperationalWithHistoricalProvenance
      (Final := Final) startProgram environment configuration
      base.traceBeforePair oldAccumulator)
    (global : EveryNodeOperationalWithGlobalProvenance
      (Final := Final) startProgram environment configuration
      base.traceBeforePair oldAccumulator)
    (safe : ReplayBaseSafeRequest base.prepared.request) :
    HistoricallyProvenancedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
      newAccumulator child := by
  obtain ⟨selected, parentMember, _requestExact, transitionExact⟩ :=
    ready_preparation_parent_is_stored startProgram configuration
      oldAccumulator base.prepared.request base.prepared oldPreparationExact
  have parentComplete :=
    selected_parent_complete_preserves_programming_history
      (Final := Final) rootInitial parentless historical parentMember
  have programmingBaseExact :=
    ready_preparation_programming_history_eq_parent_entry startProgram
      configuration oldAccumulator base.prepared.request base.prepared
        oldPreparationExact parentComplete
  have inputOrigin := selected_parent_transition_digest_has_global_origin
    (Final := Final) rootInitial parentless global base.prepared.request
      selected base.prepared.transition transitionExact
  have programmingScheduled :
      programConcretePair configuration.oracleLimits
          configuration.pairProgrammingOrder base.prepared.programmingBase
          base.scheduled.outputInput base.scheduled.advanceInput
          base.scheduled.forkOutput base.scheduled.forkAdvance =
        .ready child.proverEntryOracle := by
    simpa [base.scheduledOutputInputExact,
      base.scheduledAdvanceInputExact, ScheduledForkCoins.configuration] using
        base.programmingExact
  refine
    { base := base
      requestIsStructurallyFresh := safe
      programmingHistoryHasEarlierPairProvenance := ?_ }
  intro record recordMember
  rcases program_concrete_pair_ready_programming_history_cases
      configuration.oracleLimits configuration.pairProgrammingOrder
      base.prepared.programmingBase child.proverEntryOracle base.scheduled
      programmingScheduled record recordMember with inherited | current
  · have parentRecord :
        record ∈ base.prepared.parentNode.proverEntryOracle.programmingHistory := by
      rw [← programmingBaseExact]
      exact inherited
    obtain ⟨earlier, earlierBefore, earlierAfter, inputState,
        traceExact, programs, inputs, origin⟩ :=
      selected_parent_programming_history_has_earlier_pair_provenance
        (Final := Final) rootInitial parentless historical parentMember record
          parentRecord
    exact ⟨earlier, earlierBefore,
      earlierAfter ++ scheduledPairRecords base.scheduled, inputState, by
        rw [traceExact]
        simp [List.append_assoc], programs, inputs, origin⟩
  · exact ⟨base.scheduled, base.traceBeforePair, [],
      base.prepared.transition.before.core.digest, by simp, current,
        base.scheduledInputStateExact, inputOrigin⟩

/-- The central noncircular child constructor.  It combines the actual
preparation, pair programming, same-tape prover replay, and returned raw
future-free verifier path.  Every transition digest and saved q16 base is
then classified from the restored parent snapshot or an answer in the exact
query path; cached path answers are discharged by the already-constructed
final table-output invariant. -/
def projected_child_has_global_provenance
    {Statement Proof Payload Final : Type u}
    {startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload)}
    {environment : FutureFreeEnvironment}
    {configuration : ConcreteRestorationConfiguration}
    {fullTrace : List UnifiedExposureRecord}
    {oldAccumulator newAccumulator :
      ConcreteRestorationAccumulator Statement Proof Payload}
    {root child : ConcreteRestorationNode Statement Proof Payload}
    (base : ProjectedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
        newAccumulator child)
    (oldPreparationExact :
      prepareConcreteRestorationFromStartProgram startProgram configuration
          oldAccumulator base.prepared.request = .ready base.prepared)
    (rootInitial : RootCausalInitialization root base.traceBeforePair)
    (rootTables : ConcreteNodeTableOutputsHaveGlobalOrigin root
      base.traceBeforePair)
    (rootRetained : SegmentHistoryAnswersRetained root.proverEntryOracle
      root.proverFinalOracle)
    (parentless : ParentlessNodeIsRoot root oldAccumulator)
    (global : EveryNodeOperationalWithGlobalProvenance
      (Final := Final) startProgram environment configuration
        base.traceBeforePair oldAccumulator)
    (safe : ReplayBaseSafeRequest base.prepared.request) :
    Nonempty (GloballyProvenancedRestorationNodeExecution
      (Final := Final) startProgram environment configuration fullTrace
        newAccumulator child) := by
  have historical := historical_child_of_global_parent base
    oldPreparationExact rootInitial parentless
      (every_node_historical_provenance_of_global global) global safe
  have childTables :=
    projected_child_table_outputs_have_global_origin_of_global base
      oldPreparationExact rootTables rootRetained parentless global
  have childRetained := projected_child_prover_history_answers_retained base
  obtain ⟨selected, _parentMember, _requestExact, transitionExact⟩ :=
    ready_preparation_parent_is_stored startProgram configuration
      oldAccumulator base.prepared.request base.prepared oldPreparationExact
  have restoredExact : base.prepared.restoredState =
      restoreIndexedTransition base.prepared.transition :=
    (prepare_concrete_restoration_ready_selection_exact startProgram
      configuration oldAccumulator base.prepared.request base.prepared
        oldPreparationExact).2.2.2
  let globalOrigin : Digest256 → Prop := fun digest =>
    digest = zeroDigest256 ∨ ActiveExposureAnswer digest fullTrace
  have liftOrigin : ∀ digest,
      digest = zeroDigest256 ∨
        ActiveExposureAnswer digest base.traceBeforePair →
      globalOrigin digest := by
    intro digest origin
    rcases origin with atZero | active
    · exact Or.inl atZero
    · rcases active with ⟨record, member, answerExact⟩
      exact Or.inr ⟨record, by
        rw [base.fullTraceExact]
        simp [List.mem_append, member], answerExact⟩
  have entryDigest := selected_parent_transition_digest_has_global_origin
    (Final := Final) rootInitial parentless global base.prepared.request
      selected base.prepared.transition transitionExact
  have entryCoreOrigins : RuntimeCoreHasPathOrigins globalOrigin []
      child.verifierEntryState.current.core := by
    rw [base.restoredEntryExact, restoredExact]
    constructor
    · exact Or.inl (liftOrigin _ entryDigest)
    · intro savedBase saved
      have savedAtParent :
          base.prepared.transition.before.core.q16Base = some savedBase := by
        simpa [restoreIndexedTransition] using saved
      exact Or.inl (liftOrigin _
        (selected_parent_transition_q16_base_has_global_origin
          (Final := Final) rootInitial parentless global base.prepared.request
            selected base.prepared.transition savedBase transitionExact
              savedAtParent))
  have entryNoTransitions : child.verifierEntryState.transitions = [] := by
    rw [base.restoredEntryExact, restoredExact]
    rfl
  have entryOrigins := restored_state_initializes_path_origins globalOrigin
    child.verifierEntryState entryNoTransitions entryCoreOrigins
  obtain ⟨pairs, _path, _historyExact, operational, tableAnswers⟩ :=
    projected_restoration_node_verifier_has_operational_trace base
  have finalOrigins := future_free_operational_trace_preserves_path_origins
    environment child.adversaryValue.rawMessages globalOrigin operational []
      entryOrigins
  simp only [List.nil_append] at finalOrigins
  have queryOrigin : ∀ digest,
      MachineQueryAnswer digest pairs → globalOrigin digest := by
    intro digest query
    rcases query with ⟨input, member⟩
    exact table_lookup_answer_has_global_origin child.verifierFinalOracle
      fullTrace childTables.verifierFinal input digest
        (tableAnswers (input, digest) member)
  have pathOrigin : ∀ digest,
      DigestHasPathOrigin globalOrigin pairs digest → globalOrigin digest := by
    intro digest origin
    rcases origin with inherited | queried
    · exact inherited
    · exact queryOrigin digest queried
  refine ⟨
    { historical := historical
      tableOutputsHaveGlobalOrigin := childTables
      proverHistoryAnswersRetained := childRetained
      transitionDigestHasGlobalOrigin := ?_
      transitionQ16BaseHasGlobalOrigin := ?_ }⟩
  · intro transitionIndex transition found
    have transitionMember : transition ∈ child.verifierFinalState.transitions := by
      unfold verifierTransitionAt? at found
      rw [List.getElem?_eq_some_iff] at found
      rcases found with ⟨within, valueExact⟩
      have member := List.getElem_mem within
      simpa [valueExact] using member
    exact pathOrigin transition.before.core.digest
      (finalOrigins.2 transition transitionMember).1
  · intro transitionIndex transition savedBase found saved
    have transitionMember : transition ∈ child.verifierFinalState.transitions := by
      unfold verifierTransitionAt? at found
      rw [List.getElem?_eq_some_iff] at found
      rcases found with ⟨within, valueExact⟩
      have member := List.getElem_mem within
      simpa [valueExact] using member
    exact pathOrigin savedBase
      ((finalOrigins.2 transition transitionMember).2 savedBase saved)

