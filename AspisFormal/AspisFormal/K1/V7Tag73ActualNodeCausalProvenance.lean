    (continuations : ∀ reply nextAccumulator,
      ConcreteClientPreservesHistoricalNativeLineage transitionFuel rootCursor
        startProgram environment configuration root nextAccumulator
          (resume reply nextAccumulator))
    (trace suffix : List UnifiedExposureRecord)
    (oldAccumulator nextAccumulator :
      ConcreteRestorationAccumulator Statement Proof Payload)
