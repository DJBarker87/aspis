/-- Append-only transport of whole-trace origins.  An old active coordinate
remains active in the longer scheduler trace. -/
def transport_globally_provenanced_restoration_node_execution
    {Statement Proof Payload Final : Type u}
    (startProgram : OracleMachine
      (CheckedRawTag73AdversaryReturnedValue Statement Proof Payload))
    (environment : FutureFreeEnvironment)
    (configuration : ConcreteRestorationConfiguration)
    (oldTrace newTrace suffix : List UnifiedExposureRecord)
    (oldAccumulator newAccumulator :
      ConcreteRestorationAccumulator Statement Proof Payload)
    (child : ConcreteRestorationNode Statement Proof Payload)
    (execution : GloballyProvenancedRestorationNodeExecution
      (Final := Final) startProgram environment configuration oldTrace
        oldAccumulator child)
    (traceExact : newTrace = oldTrace ++ suffix)
    (selectedExact :
      newAccumulator.node? execution.historical.base.prepared.request.nodeId =
        oldAccumulator.node? execution.historical.base.prepared.request.nodeId) :
    GloballyProvenancedRestorationNodeExecution
      (Final := Final) startProgram environment configuration newTrace
        newAccumulator child :=
  { historical :=
      transport_historically_provenanced_restoration_node_execution
        startProgram environment configuration oldTrace newTrace suffix
          oldAccumulator newAccumulator child execution.historical traceExact
            selectedExact
    tableOutputsHaveGlobalOrigin := by
      rw [traceExact]
      exact execution.tableOutputsHaveGlobalOrigin.appendTrace suffix
    proverHistoryAnswersRetained := execution.proverHistoryAnswersRetained
    transitionDigestHasGlobalOrigin := by
      intro transitionIndex transition found
      rcases execution.transitionDigestHasGlobalOrigin transitionIndex
          transition found with atZero | active
      · exact Or.inl atZero
      · rcases active with ⟨record, member, answerExact⟩
        exact Or.inr ⟨record, by
          rw [traceExact]
          exact List.mem_append_left suffix member, answerExact⟩
    transitionQ16BaseHasGlobalOrigin := by
      intro transitionIndex transition base found saved
      rcases execution.transitionQ16BaseHasGlobalOrigin transitionIndex
          transition base found saved with atZero | active
      · exact Or.inl atZero
      · rcases active with ⟨record, member, answerExact⟩
        exact Or.inr ⟨record, by
          rw [traceExact]
          exact List.mem_append_left suffix member, answerExact⟩ }

