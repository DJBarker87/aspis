import AspisFormal.K1.V7Tag73SamplerDecoder

/-!
# Concrete deployed Tag-73 query DAG

This module gives addresses to the SHA queries generated by the deployed
Tag-73 schedule.  It is deliberately operational and finite:

* a linear query is indexed by an actual event in one of the four literal
  event segments;
* a challenge block has two nodes, output and advance, attached to the same
  pre-block verifier state;
* each work query is indexed by one of the three actual `GrindingChoice`s;
* an accepting q16 forest contains exactly the earlier counter branches and
  the selected counter branch, while the potential forest still has all 64
  counters;
* query history and continuing transcript path are different objects across
  q16 restoration; discarded branches occur in the former and not the latter;
* the C1 and C2 authentication boundaries are indexed by distinct tree types
  carrying 208-bit nodes, never by the 256-bit transcript-state type.

No verifier-state restoration function is a parameter here.  The generated
replay prefixes below are constructors from this DAG, not arbitrary list
prefixes.  The next compiler layer may execute their concrete `historyPrefix`
and `statePath` against the ROM-free verifier and prove that the resulting
state is complete and previously seen.
-/

set_option autoImplicit false

namespace AspisK1.V7Tag73ConcreteQueryDag

open AspisK1.V7Tag73TranscriptSchedule
open AspisK1.V7Tag73DeterministicRefinement
open AspisK1.V7Tag73SamplerDecoder

/-! ## Width-separated authenticated trees -/

/-- The two deployed authentication trees have distinct type indices even
though they share one public query topology. -/
inductive AuthTreeKind where
  | c1
  | c2
  deriving DecidableEq, Repr

def AuthTreeKind.tag : AuthTreeKind → UInt8
  | .c1 => c1TreeTag
  | .c2 => c2TreeTag

/-- A transcript state is a full SHA-256 output. -/
structure TranscriptStateDigest where
  value : Digest256

/-- A node of one authentication tree is a typed 208-bit prefix. -/
structure TypedMerkleNode (tree : AuthTreeKind) where
  value : Digest208

def transcriptStateBytes : Nat := 32
def typedMerkleNodeBytes : Nat := 26
def authenticatedTreeDepth : Nat := 18
def q16CandidateCount : Nat := 64
def q16DrawCap : Nat := 64
def q16WordsPerBlock : Nat := 8

theorem transcript_and_merkle_widths_are_distinct :
    transcriptStateBytes = 32 ∧ typedMerkleNodeBytes = 26 ∧
      transcriptStateBytes ≠ typedMerkleNodeBytes := by
  decide

theorem authentication_tree_tags_are_distinct :
    AuthTreeKind.c1.tag = 113 ∧ AuthTreeKind.c2.tag = 241 ∧
      AuthTreeKind.c1.tag ≠ AuthTreeKind.c2.tag := by
  decide

theorem q16_eight_blocks_are_sixty_four_draws :
    8 * q16WordsPerBlock = q16DrawCap := by
  decide

/-! ## Literal linear event segments -/

/-- Root-salt calls and root absorbs occur between these four literal event
segments.  q16 branches occur between `afterC2` and `afterQ16`. -/
inductive LinearSegment where
  | beforeC1
  | lambdaChi
  | afterC2
  | afterQ16
  deriving DecidableEq, Repr

def eventsInSegment (messages : Messages) : LinearSegment → List MachineEvent
  | .beforeC1 => prefixBeforeC1 messages
  | .lambdaChi =>
      [challengeEvent messages .lambda, challengeEvent messages .chi]
  | .afterC2 => prefixAfterC2 messages
  | .afterQ16 => afterAcceptedQueryScan messages

/-- The exact SHA-query slots generated by one deployed machine event.  A
checkpoint has no constructor, hence cannot be mislabeled as an oracle query.
-/
inductive EventQuerySlot : MachineEvent → Type
  | absorb (payload : Payload) : EventQuerySlot (.absorb payload)
  | challengeOutput (id : ChallengeId) (use : SamplerUse id)
      (block : Fin use.blocksUsed) : EventQuerySlot (.challenge id use)
  | challengeAdvance (id : ChallengeId) (use : SamplerUse id)
      (block : Fin use.blocksUsed) : EventQuerySlot (.challenge id use)

def EventQuerySlot.role {event : MachineEvent} :
    EventQuerySlot event → RawQueryRole
  | .absorb payload => .absorb payload
  | .challengeOutput id _ block =>
      .squeezeOutput (.challenge id) block.val
  | .challengeAdvance id _ block =>
      .squeezeAdvance (.challenge id) block.val

/-- One linear node is tied to a literal event index and a query slot admitted
by that event.  There is no free-form `RawQueryRole` constructor. -/
structure LinearEventQuery (messages : Messages) where
  segment : LinearSegment
  eventIndex : Fin (eventsInSegment messages segment).length
  slot : EventQuerySlot ((eventsInSegment messages segment).get eventIndex)

def LinearEventQuery.role {messages : Messages}
    (node : LinearEventQuery messages) : RawQueryRole :=
  node.slot.role

/-! ## Role lists generated by events -/

inductive SqueezeHalf where
  | output
  | advance
  deriving DecidableEq, Repr

def pairedSqueezeRoles (owner : SqueezeOwner) (count : Nat) :
    List RawQueryRole :=
  (List.range count).flatMap fun block =>
    [.squeezeOutput owner block, .squeezeAdvance owner block]

def eventQueryRoles : MachineEvent → List RawQueryRole
  | .absorb payload => [.absorb payload]
  | .challenge id use => pairedSqueezeRoles (.challenge id) use.blocksUsed
  | .grind stage choice =>
      choice.probesBeforeSelected.map (RawQueryRole.grind stage) ++
        [.grind stage choice.selected]
  | .check _ => []

def eventListQueryRoles (events : List MachineEvent) : List RawQueryRole :=
  events.flatMap eventQueryRoles

@[simp] theorem paired_squeeze_roles_length (owner : SqueezeOwner)
    (count : Nat) :
    (pairedSqueezeRoles owner count).length = 2 * count := by
  simp [pairedSqueezeRoles, Nat.mul_comm]

@[simp] theorem challenge_event_query_count (id : ChallengeId)
    (use : SamplerUse id) :
    (eventQueryRoles (.challenge id use)).length = 2 * use.blocksUsed := by
  simp [eventQueryRoles]

@[simp] theorem grinding_event_query_count (stage : WorkStage)
    (choice : GrindingChoice stage) :
    (eventQueryRoles (.grind stage choice)).length =
      choice.probesBeforeSelected.length + 1 := by
  simp [eventQueryRoles]

theorem challenge_block_within_deployed_cap (id : ChallengeId)
    (use : SamplerUse id) (block : Fin use.blocksUsed) :
    block.val < samplerBlockCap (samplerMode id) := by
  exact Nat.lt_of_lt_of_le block.isLt use.withinDeployedCap

theorem exact_deployed_sampler_mode_caps :
    samplerBlockCap (samplerMode .theta) = 4 ∧
    samplerBlockCap (samplerMode .eta) = 12 ∧
    samplerBlockCap (samplerMode (.circlePoint 0)) = 12 ∧
    samplerBlockCap (samplerMode (.circlePoint 1)) = 12 ∧
    samplerBlockCap (samplerMode (.oodMix 0)) = 4 ∧
    samplerBlockCap (samplerMode (.oodMix 1)) = 4 ∧
    samplerBlockCap (samplerMode .gamma) = 12 ∧
    samplerBlockCap (samplerMode .kappa) = 12 ∧
    samplerBlockCap (samplerMode .queryBatch) = 12 := by
  decide

/-- Output and advance are the two distinct queries of one block.  The output
half leaves the digest unchanged, so both inputs are associated with the same
pre-block verifier state. -/
theorem paired_squeeze_has_one_state_and_two_inputs
    (before output advance : Digest256) (owner : SqueezeOwner) (block : Nat) :
    (RawQueryRole.squeezeOutput owner block).input before =
        bytes before ++ [domSqueeze] ∧
    (RawQueryRole.squeezeAdvance owner block).input before =
        bytes before ++ [domAdvance] ∧
    (RawQueryRole.squeezeOutput owner block).nextDigest before output = before ∧
    bytes before ++ [domSqueeze] ≠ bytes before ++ [domAdvance] := by
  exact ⟨rfl, rfl, rfl,
    squeeze_output_and_advance_inputs_are_distinct before⟩

/-! ## Concrete instance and exact pre-q16 path -/

/-- Root-salt answers are explicit because their SHA calls precede the
corresponding root absorbs.  `tape.search` is the exact first-cap-203 accepting
scan already tied to the deployed fixed tape. -/
structure ConcreteDagInstance where
  tape : DeployedFixedTape
  c1Salt : Digest256
  c2Salt : Digest256

def ConcreteDagInstance.messages (dag : ConcreteDagInstance) : Messages :=
  dag.tape.messages

def c1BridgeRoles (dag : ConcreteDagInstance) : List RawQueryRole :=
  [.publicRootSalt dag.messages.context c1TreeTag,
   .absorb (.c1Root dag.messages.c1Root dag.c1Salt)]

def c2BridgeRoles (dag : ConcreteDagInstance) : List RawQueryRole :=
  [.publicRootSalt dag.messages.context c2TreeTag,
   .absorb (.c2Root dag.messages.c2.root dag.c2Salt)]

def beforeC1Roles (dag : ConcreteDagInstance) : List RawQueryRole :=
  eventListQueryRoles (eventsInSegment dag.messages .beforeC1)

def lambdaChiRoles (dag : ConcreteDagInstance) : List RawQueryRole :=
  eventListQueryRoles (eventsInSegment dag.messages .lambdaChi)

def afterC2Roles (dag : ConcreteDagInstance) : List RawQueryRole :=
  eventListQueryRoles (eventsInSegment dag.messages .afterC2)

def beforeQ16Roles (dag : ConcreteDagInstance) : List RawQueryRole :=
  beforeC1Roles dag ++ c1BridgeRoles dag ++ lambdaChiRoles dag ++
    c2BridgeRoles dag ++ afterC2Roles dag

theorem c2_bridge_is_after_both_adaptive_challenges
    (dag : ConcreteDagInstance) :
    beforeQ16Roles dag =
      beforeC1Roles dag ++ c1BridgeRoles dag ++
        eventListQueryRoles
          [challengeEvent dag.messages .lambda,
           challengeEvent dag.messages .chi] ++
        c2BridgeRoles dag ++ afterC2Roles dag := by
  rfl

/-! ## Three separate stage-local work regions -/

def workChoice (messages : Messages) :
    (stage : WorkStage) → GrindingChoice stage
  | .batch => messages.batchGrinding
  | .fold => messages.foldGrinding
  | .final => messages.finalGrinding

inductive WorkProbeSlot (messages : Messages) (stage : WorkStage) where
  | earlier (probe : Fin (workChoice messages stage).probesBeforeSelected.length)
  | selected

structure WorkQueryNode (messages : Messages) where
  stage : WorkStage
  slot : WorkProbeSlot messages stage

def WorkProbeSlot.nonce {messages : Messages} {stage : WorkStage} :
    WorkProbeSlot messages stage → NonceBytes
  | .earlier probe => (workChoice messages stage).probesBeforeSelected.get probe
  | .selected => (workChoice messages stage).selected

def WorkQueryNode.role {messages : Messages}
    (node : WorkQueryNode messages) : RawQueryRole :=
  .grind node.stage node.slot.nonce

inductive WorkRegionPhase where
  | afterPointClaimsBeforeGamma
  | afterRelationRoundZeroBeforeAlphaZero
  | afterFinal256BeforeQ16
  deriving DecidableEq, Repr

def workRegionPhase : WorkStage → WorkRegionPhase
  | .batch => .afterPointClaimsBeforeGamma
  | .fold => .afterRelationRoundZeroBeforeAlphaZero
  | .final => .afterFinal256BeforeQ16

theorem three_work_regions_are_separate :
    workRegionPhase .batch ≠ workRegionPhase .fold ∧
    workRegionPhase .batch ≠ workRegionPhase .final ∧
    workRegionPhase .fold ≠ workRegionPhase .final := by
  decide

theorem work_query_has_exact_stage_and_nonce {messages : Messages}
    (node : WorkQueryNode messages) :
    node.role = .grind node.stage node.slot.nonce := by
  rfl

theorem work_regions_have_exact_thresholds :
    workBits .batch = 35 ∧ workBits .fold = 31 ∧ workBits .final = 34 := by
  exact three_work_stages_are_distinct

/-! ## Operational q16 scan and cloned forest -/

inductive Q16ScanResult where
  | selected (counter : Fin 64) (schedule : QuerySchedule)
  | decoderAbort (counter : Fin 64)
  | allNoncompact

/-- Scan consecutive counters.  A decoder abort rejects immediately; a
compact schedule returns immediately; exhausting the fuel returns all-fail.
The deployed entry point is `scanQ16Outcome` with `next = 0`, `fuel = 64`. -/
def scanQ16OutcomeFrom (frontierNodes : QuerySchedule → Nat)
    (outcome : Fin 64 → CandidateOutcome) : Nat → Nat → Q16ScanResult
  | _, 0 => .allNoncompact
  | next, fuel + 1 =>
      if inRange : next < 64 then
        let counter : Fin 64 := ⟨next, inRange⟩
        match outcome counter with
        | .samplerAbort => .decoderAbort counter
        | .schedule schedule =>
            if frontierNodes schedule ≤ 203 then
              .selected counter schedule
            else
              scanQ16OutcomeFrom frontierNodes outcome (next + 1) fuel
      else
        .allNoncompact

def scanQ16Outcome (frontierNodes : QuerySchedule → Nat)
    (outcome : Fin 64 → CandidateOutcome) : Q16ScanResult :=
  scanQ16OutcomeFrom frontierNodes outcome 0 64

theorem scan_q16_decoder_abort_is_immediate
    (frontierNodes : QuerySchedule → Nat)
    (outcome : Fin 64 → CandidateOutcome)
    (next fuel : Nat) (inRange : next < 64)
    (abort : outcome ⟨next, inRange⟩ = .samplerAbort) :
    scanQ16OutcomeFrom frontierNodes outcome next (fuel + 1) =
      .decoderAbort ⟨next, inRange⟩ := by
  simp [scanQ16OutcomeFrom, inRange, abort]

theorem scan_q16_compact_is_immediate
    (frontierNodes : QuerySchedule → Nat)
    (outcome : Fin 64 → CandidateOutcome)
    (next fuel : Nat) (inRange : next < 64)
    (schedule : QuerySchedule)
    (sampled : outcome ⟨next, inRange⟩ = .schedule schedule)
    (compact : frontierNodes schedule ≤ 203) :
    scanQ16OutcomeFrom frontierNodes outcome next (fuel + 1) =
      .selected ⟨next, inRange⟩ schedule := by
  simp [scanQ16OutcomeFrom, inRange, sampled, compact]

theorem scan_q16_all_noncompact_from
    (frontierNodes : QuerySchedule → Nat)
    (outcome : Fin 64 → CandidateOutcome)
    (allNoncompact : ∀ counter,
      ∃ schedule, outcome counter = .schedule schedule ∧
        203 < frontierNodes schedule)
    (next fuel : Nat) :
    scanQ16OutcomeFrom frontierNodes outcome next fuel = .allNoncompact := by
  induction fuel generalizing next with
  | zero => rfl
  | succ fuel ih =>
      rw [scanQ16OutcomeFrom]
      split
      · rename_i inRange
        dsimp only
        obtain ⟨schedule, sampled, large⟩ :=
          allNoncompact ⟨next, inRange⟩
        rw [sampled]
        simpa only [CandidateOutcome.rec,
          if_neg (Nat.not_le_of_lt large)] using ih (next + 1)
      · rfl

theorem scan_q16_all_noncompact
    (frontierNodes : QuerySchedule → Nat)
    (outcome : Fin 64 → CandidateOutcome)
    (allNoncompact : ∀ counter,
      ∃ schedule, outcome counter = .schedule schedule ∧
        203 < frontierNodes schedule) :
    scanQ16Outcome frontierNodes outcome = .allNoncompact := by
  exact scan_q16_all_noncompact_from frontierNodes outcome allNoncompact 0 64

/-- Generic first-hit lemma used to connect the executable scan to the
relational `FirstCap203Search`. -/
theorem scan_q16_reaches_first_selected
    (frontierNodes : QuerySchedule → Nat)
    (outcome : Fin 64 → CandidateOutcome)
    (target : Fin 64) (selectedSchedule : QuerySchedule)
    (selectedOutcome : outcome target = .schedule selectedSchedule)
    (selectedCompact : frontierNodes selectedSchedule ≤ 203)
    (earlierNoncompact : ∀ counter,
      counter.val < target.val →
        ∃ schedule, outcome counter = .schedule schedule ∧
          203 < frontierNodes schedule) :
    scanQ16Outcome frontierNodes outcome =
      .selected target selectedSchedule := by
  have general : ∀ fuel next,
      next ≤ target.val → target.val < next + fuel →
      scanQ16OutcomeFrom frontierNodes outcome next fuel =
        .selected target selectedSchedule := by
    intro fuel
    induction fuel with
    | zero =>
        intro next _ impossible
        omega
    | succ fuel ih =>
        intro next beforeTarget targetWithin
        have nextInRange : next < 64 := by
          exact Nat.lt_of_le_of_lt beforeTarget target.isLt
        let counter : Fin 64 := ⟨next, nextInRange⟩
        rw [scanQ16OutcomeFrom]
        simp only [dif_pos nextInRange]
        change
          (match outcome counter with
          | .samplerAbort => Q16ScanResult.decoderAbort counter
          | .schedule schedule =>
              if frontierNodes schedule ≤ 203 then
                Q16ScanResult.selected counter schedule
              else
                scanQ16OutcomeFrom frontierNodes outcome (next + 1) fuel) =
            Q16ScanResult.selected target selectedSchedule
        by_cases atTarget : next = target.val
        · have counterEq : counter = target := by
            apply Fin.ext
            exact atTarget
          rw [counterEq, selectedOutcome]
          simp only [CandidateOutcome.rec, if_pos selectedCompact]
        · have strictlyEarlier : next < target.val := by omega
          obtain ⟨schedule, sampled, large⟩ :=
            earlierNoncompact counter strictlyEarlier
          rw [sampled]
          simp only [CandidateOutcome.rec,
            if_neg (Nat.not_le_of_lt large)]
          apply ih (next := next + 1)
          · omega
          · omega
  unfold scanQ16Outcome
  apply general 64 0
  · omega
  · exact target.isLt

theorem first_cap203_search_is_exact_executable_scan
    (frontierNodes : QuerySchedule → Nat)
    (search : FirstCap203Search frontierNodes) :
    scanQ16Outcome frontierNodes search.outcome =
      .selected search.selectedCounter search.selectedSchedule := by
  apply scan_q16_reaches_first_selected frontierNodes search.outcome
    search.selectedCounter search.selectedSchedule
  · exact search.selectedOutcome
  · exact search.selectedCompact
  · intro counter earlier
    exact search.everyEarlierSampledAndNoncompact counter earlier

theorem candidate_outcome_block_cap (outcome : CandidateOutcome) :
    outcome.blocksUsed ≤ 8 := by
  cases outcome with
  | samplerAbort => decide
  | schedule schedule => exact schedule.withinSixtyFourDraws

theorem candidate_outcome_draw_cap (outcome : CandidateOutcome) :
    outcome.blocksUsed * q16WordsPerBlock ≤ q16DrawCap := by
  have blocks := candidate_outcome_block_cap outcome
  simp [q16WordsPerBlock, q16DrawCap]
  omega

/-- All 64 potential branch roots exist as addresses, but only counters no
later than the first accepted counter are generated in an accepting scan. -/
abbrev PotentialQ16Branch := Fin 64

theorem potential_q16_branch_count :
    Fintype.card PotentialQ16Branch = 64 := by
  exact Fintype.card_fin 64

structure ScannedQ16Branch (dag : ConcreteDagInstance) where
  counter : Fin 64
  noLaterThanSelected : counter.val ≤ dag.tape.search.selectedCounter.val

structure Q16BranchBlock (dag : ConcreteDagInstance) where
  branch : ScannedQ16Branch dag
  block : Fin (dag.tape.search.outcome branch.counter).blocksUsed

theorem scanned_q16_branch_is_sampled_not_abort
    (dag : ConcreteDagInstance) (branch : ScannedQ16Branch dag) :
    ∃ schedule,
      dag.tape.search.outcome branch.counter = .schedule schedule ∧
      (branch.counter.val < dag.tape.search.selectedCounter.val →
        203 < dag.tape.frontierNodes schedule) ∧
      (branch.counter = dag.tape.search.selectedCounter →
        dag.tape.frontierNodes schedule ≤ 203) := by
  rcases Nat.lt_or_eq_of_le branch.noLaterThanSelected with earlier | equal
  · obtain ⟨schedule, sampled, large⟩ :=
      dag.tape.search.everyEarlierSampledAndNoncompact branch.counter earlier
    exact ⟨schedule, sampled, fun _ => large, fun same => by
      exact False.elim
        ((Nat.ne_of_lt earlier) (congrArg Fin.val same))⟩
  · have counterEq : branch.counter = dag.tape.search.selectedCounter := by
      apply Fin.ext
      exact equal
    exact ⟨dag.tape.search.selectedSchedule,
      by simpa [counterEq] using dag.tape.search.selectedOutcome,
      fun impossible => by
        exact False.elim ((Nat.ne_of_lt impossible) equal),
      fun _ => dag.tape.search.selectedCompact⟩

/-- Exact roles for one potential q16 branch: one counter absorb followed by
the recorded number of paired squeeze calls. -/
def q16BranchRoles (counter : Fin 64) (outcome : CandidateOutcome) :
    List RawQueryRole :=
  [.absorb (.queryCandidate counter)] ++
    pairedSqueezeRoles (.queryCandidate counter) outcome.blocksUsed

def q16SpecsBefore (dag : ConcreteDagInstance) (counter : Fin 64) :
    List CandidateSpec :=
  (List.finRange counter.val).map fun earlier =>
    let lifted : Fin 64 :=
      ⟨earlier.val, Nat.lt_trans earlier.isLt counter.isLt⟩
    { counter := lifted, outcome := dag.tape.search.outcome lifted }

def q16HistoryBeforeBranch (dag : ConcreteDagInstance)
    (counter : Fin 64) : List RawQueryRole :=
  (q16SpecsBefore dag counter).flatMap fun spec =>
    q16BranchRoles spec.counter spec.outcome

def selectedQ16BranchRoles (dag : ConcreteDagInstance) : List RawQueryRole :=
  q16BranchRoles dag.tape.search.selectedCounter
    (.schedule dag.tape.search.selectedSchedule)

def acceptingQ16HistoryRoles (dag : ConcreteDagInstance) : List RawQueryRole :=
  q16HistoryBeforeBranch dag dag.tape.search.selectedCounter ++
    selectedQ16BranchRoles dag

def q16SymbolicBase (dag : ConcreteDagInstance) (_counter : Fin 64) :
    List RawQueryRole :=
  beforeQ16Roles dag

theorem every_q16_branch_has_same_symbolic_base
    (dag : ConcreteDagInstance) (first second : Fin 64) :
    q16SymbolicBase dag first = q16SymbolicBase dag second := by
  rfl

/-! ## Typed authentication boundary -/

def selectedQuerySchedule (dag : ConcreteDagInstance) : QuerySchedule :=
  dag.tape.search.selectedSchedule

structure TypedOpenedLeaf (dag : ConcreteDagInstance)
    (tree : AuthTreeKind) where
  ordinal : Fin 16

def TypedOpenedLeaf.position {dag : ConcreteDagInstance}
    {tree : AuthTreeKind} (leaf : TypedOpenedLeaf dag tree) : Fin (2 ^ 18) :=
  (selectedQuerySchedule dag).positions leaf.ordinal

structure TypedFrontierNode (dag : ConcreteDagInstance)
    (tree : AuthTreeKind) where
  ordinal : Fin (dag.tape.frontierNodes dag.tape.search.selectedSchedule)
  digest : TypedMerkleNode tree

def typedRoot (dag : ConcreteDagInstance) :
    (tree : AuthTreeKind) → TypedMerkleNode tree
  | .c1 => ⟨dag.messages.c1Root⟩
  | .c2 => ⟨dag.messages.c2.root⟩

theorem both_trees_share_only_the_selected_topology
    (dag : ConcreteDagInstance) (ordinal : Fin 16) :
    ((⟨ordinal⟩ : TypedOpenedLeaf dag .c1).position) =
      ((⟨ordinal⟩ : TypedOpenedLeaf dag .c2).position) := by
  rfl

theorem selected_frontier_is_cap203 (dag : ConcreteDagInstance) :
    dag.tape.frontierNodes dag.tape.search.selectedSchedule ≤ 203 :=
  dag.tape.search.selectedCompact

/-! ## Generated DAG nodes and replay prefixes -/

inductive RootBridgeQuery (dag : ConcreteDagInstance) where
  | c1Salt
  | c1Absorb
  | c2Salt
  | c2Absorb

def RootBridgeQuery.role {dag : ConcreteDagInstance} :
    RootBridgeQuery dag → RawQueryRole
  | .c1Salt => .publicRootSalt dag.messages.context c1TreeTag
  | .c1Absorb => .absorb (.c1Root dag.messages.c1Root dag.c1Salt)
  | .c2Salt => .publicRootSalt dag.messages.context c2TreeTag
  | .c2Absorb => .absorb (.c2Root dag.messages.c2.root dag.c2Salt)

theorem both_root_salt_queries_bind_the_fixed_instance
    (dag : ConcreteDagInstance) (before : Digest256) :
    (RootBridgeQuery.role (dag := dag) .c1Salt).input before =
      publicRootSaltDomain ++ profileBinding ++
        bytes dag.messages.context.programId ++
        bytes dag.messages.context.releaseBinding ++
        bytes dag.messages.context.statementDigest ++
        bytes dag.messages.context.attemptId ++ [c1TreeTag] ∧
    (RootBridgeQuery.role (dag := dag) .c2Salt).input before =
      publicRootSaltDomain ++ profileBinding ++
        bytes dag.messages.context.programId ++
        bytes dag.messages.context.releaseBinding ++
        bytes dag.messages.context.statementDigest ++
        bytes dag.messages.context.attemptId ++ [c2TreeTag] := by
  exact ⟨rfl, rfl⟩

theorem c2_root_query_uses_the_lambda_chi_indexed_commitment
    (dag : ConcreteDagInstance) :
    RootBridgeQuery.role (dag := dag) .c2Absorb =
      .absorb (.c2Root dag.messages.c2.root dag.c2Salt) := by
  rfl

inductive Q16QuerySlot (dag : ConcreteDagInstance)
    (branch : ScannedQ16Branch dag) where
  | candidateAbsorb
  | squeezeOutput
      (block : Fin (dag.tape.search.outcome branch.counter).blocksUsed)
  | squeezeAdvance
      (block : Fin (dag.tape.search.outcome branch.counter).blocksUsed)

structure Q16QueryNode (dag : ConcreteDagInstance) where
  branch : ScannedQ16Branch dag
  slot : Q16QuerySlot dag branch

inductive ConcreteQueryNode (dag : ConcreteDagInstance) where
  | linear (node : LinearEventQuery dag.messages)
  | rootBridge (node : RootBridgeQuery dag)
  | work (node : WorkQueryNode dag.messages)
  | q16 (node : Q16QueryNode dag)
  | openedLeaf (tree : AuthTreeKind) (node : TypedOpenedLeaf dag tree)
  | frontier (tree : AuthTreeKind) (node : TypedFrontierNode dag tree)

/-- A linear fork is admitted only by an actual challenge event in one of the
four deployed event lists. -/
structure LinearChallengeFork (dag : ConcreteDagInstance) where
  segment : LinearSegment
  eventIndex : Fin (eventsInSegment dag.messages segment).length
  id : ChallengeId
  use : SamplerUse id
  atEvent : (eventsInSegment dag.messages segment).get eventIndex =
    .challenge id use
  block : Fin use.blocksUsed

structure Q16ChallengeFork (dag : ConcreteDagInstance) where
  branch : ScannedQ16Branch dag
  block : Fin (dag.tape.search.outcome branch.counter).blocksUsed

/-- These are all and only the squeeze-block restoration points generated by
the concrete accepting query DAG. -/
inductive GeneratedReplayPrefix (dag : ConcreteDagInstance) where
  | linear (fork : LinearChallengeFork dag)
  | q16 (fork : Q16ChallengeFork dag)

inductive ConcreteVerifierPhase where
  | linearChallenge (segment : LinearSegment) (eventIndex : Nat)
      (id : ChallengeId) (block : Nat)
  | q16Candidate (counter : Fin 64) (block : Nat)
  deriving DecidableEq, Repr

structure ConcreteReplayLocation where
  phase : ConcreteVerifierPhase
  /-- All oracle calls observed before this fork. -/
  historyPrefix : List RawQueryRole
  /-- Only calls on the continuing verifier-state path. -/
  statePath : List RawQueryRole
  /-- The common pre-candidate path for q16, absent for a linear challenge. -/
  clonedQ16Base : Option (List RawQueryRole)

def segmentHistoryPrelude (dag : ConcreteDagInstance) :
    LinearSegment → List RawQueryRole
  | .beforeC1 => []
  | .lambdaChi => beforeC1Roles dag ++ c1BridgeRoles dag
  | .afterC2 =>
      beforeC1Roles dag ++ c1BridgeRoles dag ++ lambdaChiRoles dag ++
        c2BridgeRoles dag
  | .afterQ16 => beforeQ16Roles dag ++ acceptingQ16HistoryRoles dag

def segmentStatePrelude (dag : ConcreteDagInstance) :
    LinearSegment → List RawQueryRole
  | .beforeC1 => []
  | .lambdaChi => beforeC1Roles dag ++ c1BridgeRoles dag
  | .afterC2 =>
      beforeC1Roles dag ++ c1BridgeRoles dag ++ lambdaChiRoles dag ++
        c2BridgeRoles dag
  | .afterQ16 => beforeQ16Roles dag ++ selectedQ16BranchRoles dag

def rolesBeforeLinearFork {dag : ConcreteDagInstance}
    (fork : LinearChallengeFork dag) :
    List RawQueryRole :=
  eventListQueryRoles
      ((eventsInSegment dag.messages fork.segment).take fork.eventIndex.val) ++
    pairedSqueezeRoles (.challenge fork.id) fork.block.val

def rolesWithinQ16BranchBeforeBlock {dag : ConcreteDagInstance}
    (fork : Q16ChallengeFork dag) :
    List RawQueryRole :=
  [.absorb (.queryCandidate fork.branch.counter)] ++
    pairedSqueezeRoles (.queryCandidate fork.branch.counter) fork.block.val

def replayLocation {dag : ConcreteDagInstance} :
    GeneratedReplayPrefix dag → ConcreteReplayLocation
  | .linear fork =>
      let localRoles := rolesBeforeLinearFork fork
      { phase := .linearChallenge fork.segment fork.eventIndex.val
          fork.id fork.block.val
        historyPrefix := segmentHistoryPrelude dag fork.segment ++ localRoles
        statePath := segmentStatePrelude dag fork.segment ++ localRoles
        clonedQ16Base := none }
  | .q16 fork =>
      let localRoles := rolesWithinQ16BranchBeforeBlock fork
      { phase := .q16Candidate fork.branch.counter fork.block.val
        historyPrefix := beforeQ16Roles dag ++
          q16HistoryBeforeBranch dag fork.branch.counter ++ localRoles
        statePath := beforeQ16Roles dag ++ localRoles
        clonedQ16Base := some (beforeQ16Roles dag) }

/-- The concrete map is functional; a generated prefix cannot acquire two
different phase/index/base records. -/
theorem generated_replay_prefix_has_unique_location
    {dag : ConcreteDagInstance} (generated : GeneratedReplayPrefix dag) :
    ∃! location : ConcreteReplayLocation,
      location = replayLocation generated := by
  exact ⟨replayLocation generated, rfl, by
    intro other equal
    exact equal⟩

theorem linear_replay_prefix_phase_is_exact
    {dag : ConcreteDagInstance} (fork : LinearChallengeFork dag) :
    (replayLocation (.linear fork)).phase =
      .linearChallenge fork.segment fork.eventIndex.val fork.id fork.block.val := by
  rfl

theorem q16_replay_prefix_phase_index_and_base_are_exact
    {dag : ConcreteDagInstance} (fork : Q16ChallengeFork dag) :
    (replayLocation (.q16 fork)).phase =
        .q16Candidate fork.branch.counter fork.block.val ∧
    (replayLocation (.q16 fork)).clonedQ16Base =
        some (beforeQ16Roles dag) ∧
    (replayLocation (.q16 fork)).statePath =
        beforeQ16Roles dag ++ rolesWithinQ16BranchBeforeBlock fork := by
  exact ⟨rfl, rfl, rfl⟩

theorem q16_replay_history_records_discarded_branches
    {dag : ConcreteDagInstance} (fork : Q16ChallengeFork dag) :
    (replayLocation (.q16 fork)).historyPrefix =
      beforeQ16Roles dag ++
        q16HistoryBeforeBranch dag fork.branch.counter ++
        rolesWithinQ16BranchBeforeBlock fork := by
  rfl

theorem q16_replay_state_path_uses_only_current_clone
    {dag : ConcreteDagInstance} (fork : Q16ChallengeFork dag) :
    (replayLocation (.q16 fork)).statePath =
      beforeQ16Roles dag ++ rolesWithinQ16BranchBeforeBlock fork := by
  rfl

theorem q16_common_base_is_a_prefix_of_every_branch_state_path
    {dag : ConcreteDagInstance} (fork : Q16ChallengeFork dag) :
    beforeQ16Roles dag <+:
      (replayLocation (.q16 fork)).statePath := by
  rw [q16_replay_state_path_uses_only_current_clone]
  exact List.prefix_append _ _

theorem q16_fork_block_within_eight
    {dag : ConcreteDagInstance} (fork : Q16ChallengeFork dag) :
    fork.block.val < 8 := by
  exact Nat.lt_of_lt_of_le fork.block.isLt
    (candidate_outcome_block_cap
      (dag.tape.search.outcome fork.branch.counter))

theorem q16_fork_has_paired_output_and_advance
    {dag : ConcreteDagInstance} (fork : Q16ChallengeFork dag) :
    let owner := SqueezeOwner.queryCandidate fork.branch.counter
    let block := fork.block.val
    (RawQueryRole.squeezeOutput owner block,
      RawQueryRole.squeezeAdvance owner block) =
    (.squeezeOutput (.queryCandidate fork.branch.counter) fork.block.val,
      .squeezeAdvance (.queryCandidate fork.branch.counter) fork.block.val) := by
  rfl

