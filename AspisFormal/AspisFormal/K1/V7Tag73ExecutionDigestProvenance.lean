import AspisFormal.K1.V7Tag73ConcreteStateRestoration
import AspisFormal.K1.V7Tag73AtomicPairFork

/-!
# Digest provenance in an operational Tag-73 verifier execution

This module proves that the digest at every complete verifier checkpoint is
generated by the execution itself.  Starting from the explicit all-zero dummy
state, the only new digest sources are literal single-query replies and the two
replies of an atomic squeeze.  A q16 restore can only reinstall the one base
that was saved earlier in the same execution.

The result is deterministic.  It does not claim that a reply was fresh or
uniform; the later lazy-oracle coupling must classify the table entry that
supplied it as fresh, programmed, or cached and retain the corresponding
chronological exposure index.
-/

set_option autoImplicit false

namespace AspisK1.V7Tag73ExecutionDigestProvenance

open AspisK1.V7Tag73TranscriptSchedule
open AspisK1.V7Tag73DeterministicRefinement
open AspisK1.V7Tag73ConcreteQueryDag
open AspisK1.V7Tag73InteractiveAncestor
open AspisK1.V7Tag73InteractiveExecution
open AspisK1.V7Tag73ConcreteStateRestoration
open AspisK1.V7Tag73AtomicPairFork

/-! ## One-step source preservation -/

def replyDigests : VerifierReply → List Digest256
  | .none => []
  | .single output => [output]
  | .squeeze output advance => [output, advance]

def CoreDigestSources (sources : List Digest256) (core : RuntimeCore) : Prop :=
  core.digest ∈ sources ∧
    ∀ base, core.q16Base = some base → base ∈ sources

theorem initial_core_digest_sources :
    CoreDigestSources [initialCore.digest] initialCore := by
  simp [CoreDigestSources, initialCore]

theorem core_digest_sources_mono
    {first second : List Digest256} {core : RuntimeCore}
    (covered : CoreDigestSources first core)
    (subset : ∀ digest, digest ∈ first → digest ∈ second) :
    CoreDigestSources second core := by
  exact ⟨subset core.digest covered.1,
    fun base saved => subset base (covered.2 base saved)⟩

theorem apply_action_work_erased_preserves_digest_sources
    (sources : List Digest256) (core next : RuntimeCore)
    (action : VerifierAction) (reply : VerifierReply)
    (covered : CoreDigestSources sources core)
    (applied : applyActionWorkErased core action reply = some next) :
    CoreDigestSources (sources ++ replyDigests reply) next := by
  rcases covered with ⟨digestCovered, baseCovered⟩
  cases action with
  | absorb payload =>
      cases reply <;> simp [applyActionWorkErased] at applied
      rename_i output
      subst next
      exact ⟨by simp [replyDigests], fun base saved =>
        List.mem_append_left _ (baseCovered base saved)⟩
  | requestRootSalt tree =>
      cases tree <;> cases reply <;>
        simp [applyActionWorkErased] at applied
      all_goals rename_i output
      all_goals subst next
      all_goals exact ⟨List.mem_append_left _ digestCovered,
        fun base saved => List.mem_append_left _ (baseCovered base saved)⟩
  | absorbC1 root =>
      cases reply <;> simp [applyActionWorkErased] at applied
      rename_i output
      cases salt : core.c1Salt <;> simp [salt] at applied
      subst next
      exact ⟨by simp [replyDigests], fun base saved =>
        List.mem_append_left _ (baseCovered base saved)⟩
  | absorbC2 lambda chi commitment =>
      cases reply <;> simp [applyActionWorkErased] at applied
      rename_i output
      cases salt : core.c2Salt <;> simp [salt] at applied
      subst next
      exact ⟨by simp [replyDigests], fun base saved =>
        List.mem_append_left _ (baseCovered base saved)⟩
  | squeezePair owner block =>
      cases reply <;> simp [applyActionWorkErased] at applied
      rename_i output advance
      subst next
      exact ⟨by simp [replyDigests], fun base saved =>
        List.mem_append_left _ (baseCovered base saved)⟩
  | workProbe stage nonce kind =>
      cases reply <;> simp [applyActionWorkErased] at applied
      rename_i output
      subst next
      exact ⟨List.mem_append_left _ digestCovered,
        fun base saved => List.mem_append_left _ (baseCovered base saved)⟩
  | checkpoint checkpoint =>
      cases reply <;> simp [applyActionWorkErased] at applied
      subst next
      exact ⟨by simpa [replyDigests] using digestCovered,
        fun base saved => by
          simpa [replyDigests] using baseCovered base saved⟩
  | markQ16Base =>
      cases reply <;> simp [applyActionWorkErased] at applied
      subst next
      refine ⟨by simpa [replyDigests] using digestCovered, ?_⟩
      intro base saved
      simp at saved
      subst base
      simpa [replyDigests] using digestCovered
  | q16CandidateAbsorb counter outcome selected =>
      cases reply <;> simp [applyActionWorkErased] at applied
      rename_i output
      cases savedBase : core.q16Base <;> simp [savedBase] at applied
      rename_i savedValue
      subst next
      refine ⟨by simp [replyDigests], ?_⟩
      intro base saved
      simp at saved
      subst base
      exact List.mem_append_left _ (baseCovered savedValue savedBase)
  | q16Restore counter =>
      cases reply <;> simp [applyActionWorkErased] at applied
      cases savedBase : core.q16Base <;> simp [savedBase] at applied
      rename_i base
      subst next
      refine ⟨by simpa [replyDigests] using baseCovered base savedBase, ?_⟩
      intro candidate candidateSaved
      simp at candidateSaved
      subst candidate
      simpa [replyDigests] using baseCovered base savedBase
  | q16Selected counter =>
      cases reply <;> simp [applyActionWorkErased] at applied
      subst next
      exact ⟨by simpa [replyDigests] using digestCovered,
        fun base saved => by
          simpa [replyDigests] using baseCovered base saved⟩
  | q16SamplerAbortReject counter =>
      cases reply <;> simp [applyActionWorkErased] at applied
      subst next
      exact ⟨by simpa [replyDigests] using digestCovered,
        fun base saved => by
          simpa [replyDigests] using baseCovered base saved⟩
  | q16AllNoncompactReject =>
      cases reply <;> simp [applyActionWorkErased] at applied
      subst next
      exact ⟨by simpa [replyDigests] using digestCovered,
        fun base saved => by
          simpa [replyDigests] using baseCovered base saved⟩
  | terminal =>
      cases reply <;> simp [applyActionWorkErased] at applied
      subst next
      exact ⟨by simpa [replyDigests] using digestCovered,
        fun base saved => by
          simpa [replyDigests] using baseCovered base saved⟩

/-! ## Whole-trace coverage -/

def traceReplyDigests
    {table : FixedOracleTable} {bindings : FixedBindings}
    {core : RuntimeCore} {actions : List VerifierAction}
    (trace : TableExecutionTrace table bindings core actions) :
    List Digest256 :=
  trace.replies.flatMap replyDigests

@[simp] theorem trace_reply_digests_done
    {table : FixedOracleTable} {bindings : FixedBindings}
    (core : RuntimeCore) :
    traceReplyDigests
      (TableExecutionTrace.done (table := table) (bindings := bindings) core) =
        [] := by
  rfl

@[simp] theorem trace_reply_digests_step
    {table : FixedOracleTable} {bindings : FixedBindings}
    {core next : RuntimeCore} {action : VerifierAction}
    {rest : List VerifierAction}
    (reply : VerifierReply)
    (derived : deriveReply table bindings core action = some reply)
    (applied : applyActionWorkErased core action reply = some next)
    (tail : TableExecutionTrace table bindings next rest) :
    traceReplyDigests (.step reply derived applied tail) =
      replyDigests reply ++ traceReplyDigests tail := by
  rfl

theorem trace_cores_have_digest_sources
    {table : FixedOracleTable} {bindings : FixedBindings}
    {core : RuntimeCore} {actions : List VerifierAction}
    (trace : TableExecutionTrace table bindings core actions)
    (sources : List Digest256) (covered : CoreDigestSources sources core) :
    (∀ state ∈ trace.cores,
      state.digest ∈ sources ++ traceReplyDigests trace) ∧
    (∀ state ∈ trace.cores, ∀ base,
      state.q16Base = some base →
        base ∈ sources ++ traceReplyDigests trace) := by
  induction trace generalizing sources with
  | done current =>
      constructor <;> intro state member
      · have stateEq : state = current := by
          simpa [TableExecutionTrace.cores] using member
        subst state
        simpa using covered.1
      · intro base saved
        have stateEq : state = current := by
          simpa [TableExecutionTrace.cores] using member
        subst state
        simpa using covered.2 base saved
  | @step current next action rest reply derived applied tail ih =>
      have nextCovered := apply_action_work_erased_preserves_digest_sources
        sources current next action reply covered applied
      obtain ⟨tailDigests, tailBases⟩ :=
        ih (sources ++ replyDigests reply) nextCovered
      constructor
      · intro state member
        simp only [TableExecutionTrace.cores, List.mem_cons] at member
        rcases member with rfl | member
        · exact List.mem_append_left _ covered.1
        · have tailMember := tailDigests state member
          simpa [traceReplyDigests, TableExecutionTrace.replies,
            List.flatMap_cons, List.append_assoc] using tailMember
      · intro state member base saved
        simp only [TableExecutionTrace.cores, List.mem_cons] at member
        rcases member with rfl | member
        · exact List.mem_append_left _ (covered.2 base saved)
        · have tailMember := tailBases state member base saved
          simpa [traceReplyDigests, TableExecutionTrace.replies,
            List.flatMap_cons, List.append_assoc] using tailMember

theorem first_execution_every_core_digest_is_initial_or_reply
    {table : FixedOracleTable} {tape : DeployedFixedTape}
    (execution : ConcreteFirstExecution table tape)
    (state : RuntimeCore) (member : state ∈ execution.cores) :
    state.digest = initialCore.digest ∨
      state.digest ∈ traceReplyDigests execution.trace := by
  have covered := (trace_cores_have_digest_sources execution.trace
    [initialCore.digest] initial_core_digest_sources).1 state member
  simpa [traceReplyDigests] using covered

/-! ## Generated replay checkpoints inherit the execution provenance -/

theorem generated_pair_state_is_initial_or_execution_reply
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (generated : GeneratedReplayPrefix dag) :
    generatedPairState execution generated = initialCore.digest ∨
      generatedPairState execution generated ∈
        traceReplyDigests execution.trace := by
  let restoration := concreteRestoration execution generated
  have member : restoration.snapshot.core ∈ execution.cores := by
    change execution.coreAt restoration.snapshotCursor ∈ execution.cores
    exact List.get_mem execution.cores _
  simpa [generatedPairState, restoration,
    ConcreteRestorationRecord.snapshot,
    ConcreteRestorationRecord.sourceExecution] using
      first_execution_every_core_digest_is_initial_or_reply execution
        restoration.snapshot.core member

theorem generated_pair_state_is_zero_or_execution_reply
    {table : FixedOracleTable} {dag : ConcreteDagInstance}
    (execution : ConcreteFirstExecution table dag.tape)
    (generated : GeneratedReplayPrefix dag) :
    generatedPairState execution generated = zeroBytes 32 ∨
      generatedPairState execution generated ∈
        traceReplyDigests execution.trace := by
  simpa [initialCore] using
    generated_pair_state_is_initial_or_execution_reply execution generated

