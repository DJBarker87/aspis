noncomputable section

/-! ## Direct replacement for the abstract state-map marker -/

/-- Successful checked refinement produces one complete first execution and
the concrete restoration family for every prefix generated by the deployed
query DAG.  Every listed fact is proved from that execution; none is supplied
as a field by the caller. -/
theorem checked_refinement_constructs_complete_restoration_family
    (table : FixedOracleTable) (decoders : DeterministicDecoders)
    (dag : ConcreteDagInstance) (raw : InteractiveRawTrace)
    (run : checkedRefine table decoders dag.tape = some raw) :
    ∃ execution : ConcreteFirstExecution table dag.tape,
      ∀ generated : GeneratedReplayPrefix dag,
        let restoration := concreteRestoration execution generated
        IsComplete restoration.snapshot ∧
          PreviouslySeen restoration.snapshot
            execution.interactiveState ∧
          NonemptyVerifierHistory execution.interactiveState ∧
          restoration.snapshot.bindings =
            FixedBindings.ofContext dag.tape.messages.context ∧
          (fullPlan dag.tape).get restoration.actionCursor =
            .squeezePair restoration.checkpoint.owner
              restoration.checkpoint.block ∧
          restoration.oracleTable = table ∧
          restoration.deployedTape = dag.tape := by
  obtain ⟨execution⟩ :=
    checked_refine_constructs_concrete_first_execution table decoders dag.tape
      raw run
  refine ⟨execution, ?_⟩
  intro generated
  let restoration := concreteRestoration execution generated
  exact ⟨restoration_snapshot_is_complete restoration,
    restoration_snapshot_is_previously_seen restoration,
    restoration_first_run_history_is_nonempty restoration,
    restoration_preserves_fixed_bindings restoration,
    restoration_next_action_is_exact_squeeze_pair restoration,
    restoration_retains_same_oracle_table restoration,
    restoration_retains_same_deployed_tape restoration⟩

/-! ## A source-constructed same-hidden-tape origin -/

/-- All inputs to `makeSameTapeExperimentOrigin`.  Retaining these inputs
prevents an arbitrary `SameTapeExperimentOrigin` record from masquerading as
one produced by a common hidden adversary tape. -/
structure SameTapeOriginSource
    (HiddenTape TapeIdentity Observation Statement Proof Result : Type*) where
  blackBox : SameTapeBlackBox HiddenTape Observation Result
  hiddenTape : HiddenTape
  tapeIdentity : TapeIdentity
  observation : Observation
  controller : AdaptiveController
  oracleLimits : OracleLimits
  firstRunFuel : Nat
  initialOracle : OracleState
  forgeryOf : Result → Option (PublicProof Statement Proof)

def SameTapeOriginSource.origin
    {HiddenTape TapeIdentity Observation Statement Proof Result : Type*}
    (source : SameTapeOriginSource HiddenTape TapeIdentity Observation
      Statement Proof Result) :
    SameTapeExperimentOrigin TapeIdentity Observation Statement Proof Result :=
  makeSameTapeExperimentOrigin source.blackBox source.hiddenTape
    source.tapeIdentity source.observation source.controller source.oracleLimits
    source.firstRunFuel source.initialOracle source.forgeryOf

@[simp] theorem source_origin_identity
    {HiddenTape TapeIdentity Observation Statement Proof Result : Type*}
    (source : SameTapeOriginSource HiddenTape TapeIdentity Observation
      Statement Proof Result) :
    source.origin.firstRun.tapeIdentity =
      source.origin.capability.tapeIdentity := by
  rfl

theorem source_origin_first_execution_starts_capability
    {HiddenTape TapeIdentity Observation Statement Proof Result : Type*}
    (source : SameTapeOriginSource HiddenTape TapeIdentity Observation
      Statement Proof Result) :
    source.origin.firstExecution =
      runMachine source.controller source.oracleLimits .adversary
        source.firstRunFuel source.initialOracle
        (source.origin.capability.start source.observation) := by
  rfl

theorem source_origin_capability_uses_same_hidden_tape
    {HiddenTape TapeIdentity Observation Statement Proof Result : Type*}
    (source : SameTapeOriginSource HiddenTape TapeIdentity Observation
      Statement Proof Result) :
    source.origin.capability.start source.observation =
      source.blackBox.start source.hiddenTape source.observation := by
  rfl

/-! ## Exact interactive input offered to K1.2--K1.5 -/

/-- A concrete interactive input indexed by the table frozen at the end of
the actual same-tape first run.  Its restoration family is defined below and
is deliberately not a structure field. -/
structure ConcreteK12ToK15Input
    (HiddenTape TapeIdentity Observation Statement Proof Result : Type*) where
  source : SameTapeOriginSource HiddenTape TapeIdentity Observation
    Statement Proof Result
  dag : ConcreteDagInstance
  execution : ConcreteFirstExecution
    (fixedTableOfOracleState source.origin.firstRun.stateAtAdversaryHalt)
    dag.tape

noncomputable def ConcreteK12ToK15Input.restorationFamily
    {HiddenTape TapeIdentity Observation Statement Proof Result : Type*}
    (input : ConcreteK12ToK15Input HiddenTape TapeIdentity Observation
      Statement Proof Result)
    (generated : GeneratedReplayPrefix input.dag) :
    ConcreteRestorationRecord
      (fixedTableOfOracleState
        input.source.origin.firstRun.stateAtAdversaryHalt) input.dag :=
  concreteRestoration input.execution generated

theorem concrete_input_restoration_family_is_legal
    {HiddenTape TapeIdentity Observation Statement Proof Result : Type*}
    (input : ConcreteK12ToK15Input HiddenTape TapeIdentity Observation
      Statement Proof Result)
    (generated : GeneratedReplayPrefix input.dag) :
    let restoration := input.restorationFamily generated
    IsComplete restoration.snapshot ∧
      PreviouslySeen restoration.snapshot
        input.execution.interactiveState ∧
      NonemptyVerifierHistory input.execution.interactiveState ∧
      restoration.snapshot.bindings =
        FixedBindings.ofContext input.dag.tape.messages.context ∧
      (fullPlan input.dag.tape).get restoration.actionCursor =
        .squeezePair restoration.checkpoint.owner
          restoration.checkpoint.block ∧
      restoration.oracleTable =
        fixedTableOfOracleState
          input.source.origin.firstRun.stateAtAdversaryHalt ∧
      restoration.deployedTape = input.dag.tape := by
  let restoration := input.restorationFamily generated
  exact ⟨restoration_snapshot_is_complete restoration,
    restoration_snapshot_is_previously_seen restoration,
    restoration_first_run_history_is_nonempty restoration,
    restoration_preserves_fixed_bindings restoration,
    restoration_next_action_is_exact_squeeze_pair restoration,
    restoration_retains_same_oracle_table restoration,
    restoration_retains_same_deployed_tape restoration⟩

theorem concrete_input_restoration_family_is_functional
    {HiddenTape TapeIdentity Observation Statement Proof Result : Type*}
    (input : ConcreteK12ToK15Input HiddenTape TapeIdentity Observation
      Statement Proof Result)
    (generated : GeneratedReplayPrefix input.dag) :
    ∃! restoration : ConcreteRestorationRecord
        (fixedTableOfOracleState
          input.source.origin.firstRun.stateAtAdversaryHalt) input.dag,
      IsConcreteRestorationOf input.execution generated restoration := by
  exact concrete_restoration_exists_unique input.execution generated

/-! ## Sample event and the sole allowed upstream theorem premise -/

abbrev ConcreteK12ToK15World
    (Sample HiddenTape TapeIdentity Observation Statement Proof Result : Type*) :=
  Sample → Option (ConcreteK12ToK15Input HiddenTape TapeIdentity Observation
    Statement Proof Result)

/-- Samples for which an accepted, budget-respecting experiment outcome is
identified with an actually source-constructed same-tape interactive input.
This is not an FS cover: no theorem here claims that every fresh accepting
sample belongs to this set. -/
def concreteInteractiveKnowledgeSet
    {Sample HiddenTape TapeIdentity Observation Statement Proof Witness Result :
      Type*}
    [Fintype Sample] [MeasurableSpace Sample]
    (experiment : ObservedProofExperiment Sample TapeIdentity Statement Proof
      Witness)
    (world : ConcreteK12ToK15World Sample HiddenTape TapeIdentity Observation
      Statement Proof Result) : Set Sample :=
  {sample | ∃ input,
    world sample = some input ∧
      input.source.origin.firstRun =
        (experiment.outcome sample).firstRun ∧
      (experiment.outcome sample).verifierAccepted = true ∧
      WithinBudget (experiment.outcome sample).use experiment.budget}

def concreteInteractiveKnowledgeProbability
    {Sample HiddenTape TapeIdentity Observation Statement Proof Witness Result :
      Type*}
    [Fintype Sample] [MeasurableSpace Sample]
    (experiment : ObservedProofExperiment Sample TapeIdentity Statement Proof
      Witness)
    (world : ConcreteK12ToK15World Sample HiddenTape TapeIdentity Observation
      Statement Proof Result) : ENNReal :=
  experiment.law.toOuterMeasure
    (concreteInteractiveKnowledgeSet experiment world)

def concreteValidExtractionProbability
    {Sample TapeIdentity Statement Proof Witness : Type*}
    [Fintype Sample] [MeasurableSpace Sample]
    (experiment : ObservedProofExperiment Sample TapeIdentity Statement Proof
      Witness) : ENNReal :=
  experiment.law.toOuterMeasure (ValidExtractionEvent experiment)

/-- The four upstream failures remain separately named and are never divided
by any grinding budget. -/
structure ConcreteUpstreamErrorTerms where
  k12TwoTreeMerkle208 : ENNReal
  k13CircleListDecoding : ENNReal
  k14CoherentChainSelection : ENNReal
  k15SpendWitnessRecovery : ENNReal

def concreteUpstreamRawError (terms : ConcreteUpstreamErrorTerms) : ENNReal :=
  terms.k12TwoTreeMerkle208 +
    terms.k13CircleListDecoding +
    terms.k14CoherentChainSelection +
    terms.k15SpendWitnessRecovery

/-- Exact typed insertion point for the theorem supplied by K1.2--K1.5.
Its left side is already the concrete interactive state-restoration event, not
the Fiat--Shamir acceptance event. -/
def UpstreamConcreteK12ToK15KnowledgeInequality
    {Sample HiddenTape TapeIdentity Observation Statement Proof Witness Result :
      Type*}
    [Fintype Sample] [MeasurableSpace Sample]
    (experiment : ObservedProofExperiment Sample TapeIdentity Statement Proof
      Witness)
    (world : ConcreteK12ToK15World Sample HiddenTape TapeIdentity Observation
      Statement Proof Result)
    (polynomialLoss : ENNReal) (terms : ConcreteUpstreamErrorTerms) : Prop :=
  concreteInteractiveKnowledgeProbability experiment world ≤
    polynomialLoss * concreteValidExtractionProbability experiment +
      concreteUpstreamRawError terms

/-- Kernel-visible expanded form of the sole upstream inequality. -/
theorem concrete_k12_to_k15_knowledge_bound_expanded
    {Sample HiddenTape TapeIdentity Observation Statement Proof Witness Result :
      Type*}
    [Fintype Sample] [MeasurableSpace Sample]
    (experiment : ObservedProofExperiment Sample TapeIdentity Statement Proof
      Witness)
    (world : ConcreteK12ToK15World Sample HiddenTape TapeIdentity Observation
      Statement Proof Result)
    (polynomialLoss : ENNReal) (terms : ConcreteUpstreamErrorTerms)
    (upstream : UpstreamConcreteK12ToK15KnowledgeInequality experiment world
      polynomialLoss terms) :
    concreteInteractiveKnowledgeProbability experiment world ≤
      polynomialLoss * concreteValidExtractionProbability experiment +
        terms.k12TwoTreeMerkle208 + terms.k13CircleListDecoding +
        terms.k14CoherentChainSelection + terms.k15SpendWitnessRecovery := by
  simpa [UpstreamConcreteK12ToK15KnowledgeInequality,
    concreteUpstreamRawError, add_assoc] using upstream

/-- Normalized upstream extraction statement.  This arithmetic consumes only
the K1.2--K1.5 inequality and finite nonzero loss; it contains no compiler
cover or compiler error term. -/
theorem concrete_k12_to_k15_knowledge_bound_normalized
    {Sample HiddenTape TapeIdentity Observation Statement Proof Witness Result :
      Type*}
    [Fintype Sample] [MeasurableSpace Sample]
    (experiment : ObservedProofExperiment Sample TapeIdentity Statement Proof
      Witness)
    (world : ConcreteK12ToK15World Sample HiddenTape TapeIdentity Observation
      Statement Proof Result)
    (polynomialLoss : ENNReal) (terms : ConcreteUpstreamErrorTerms)
    (lossNonzero : polynomialLoss ≠ 0) (lossFinite : polynomialLoss ≠ ⊤)
    (upstream : UpstreamConcreteK12ToK15KnowledgeInequality experiment world
      polynomialLoss terms) :
    (concreteInteractiveKnowledgeProbability experiment world -
        concreteUpstreamRawError terms) / polynomialLoss ≤
      concreteValidExtractionProbability experiment := by
  rw [ENNReal.div_le_iff' lossNonzero lossFinite, tsub_le_iff_right]
  exact upstream

