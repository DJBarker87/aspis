import AspisFormal.V5FunctionalBatching

/-!
# The degree-three correlated-agreement step used by arity-four FRI

This file formalizes the final, elementary part of S-two's correlated-
agreement argument.  It does not assume that a FRI predecessor exists.

For four fixed received lanes `f_0,...,f_3`, a challenge `z` produces the
degree-three curve `f_0 + z f_1 + z^2 f_2 + z^3 f_3`.  A fixed prover strategy
chooses a codeword and an agreement set for every challenge.  The set of good
challenges is therefore fixed before the sampled challenge; it does not depend
on an extracted predecessor witness.

The sole external coding-theory premise below is degree-three
curve-decodability: if there are more than `a` good challenges, more than
`3 * |D|` of their selected codewords lie on one degree-three curve of
codewords.  This is S-two Theorem 25 (used in its Theorem 28/29 proof).

Lean proves the rest of Theorem 28's finalization argument.  At every domain
point where the four received lanes disagree with that codeword curve, at most
three challenges hide the discrepancy.  A union bound leaves one selected
challenge whose whole agreement set is a joint agreement set for all four
lanes.  Consequently, if no such joint agreement exists, the explicit good-
challenge set has cardinality at most `a`.
-/

namespace AspisV5FriDegreeThreeCorrelatedAgreement

open AspisV5FunctionalBatching

variable {K Domain Message : Type*}
  [Field K] [Fintype K] [DecidableEq K]
  [Fintype Domain] [DecidableEq Domain]

/-- Evaluate four fixed functions along the scalar-power degree-three curve. -/
def curveValue (lanes : Fin 4 -> Domain -> K) (z : K) (x : Domain) : K :=
  batchedDiscrepancy (fun i => lanes i x) z

/-- A deterministic response strategy after the four curve lanes have been
fixed.  For each possible challenge it specifies both a candidate codeword and
the set on which that codeword is claimed to agree. -/
structure ProximateStrategy (K Domain Message : Type*) where
  candidate : K -> Message
  support : K -> Finset Domain

/-- One strategy response is a valid proximity witness. -/
def ValidResponse
    (encoder : Message -> Domain -> K) (agreementThreshold : Nat)
    (lanes : Fin 4 -> Domain -> K)
    (strategy : ProximateStrategy K Domain Message) (z : K) : Prop :=
  agreementThreshold < (strategy.support z).card /\
    ∀ x ∈ strategy.support z,
      curveValue lanes z x = encoder (strategy.candidate z) x

/-- The response-independent good-challenge set for a fixed strategy. -/
noncomputable def goodChallenges
    (encoder : Message -> Domain -> K) (agreementThreshold : Nat)
    (lanes : Fin 4 -> Domain -> K)
    (strategy : ProximateStrategy K Domain Message) : Finset K := by
  classical
  exact Finset.univ.filter
    (ValidResponse encoder agreementThreshold lanes strategy)

@[simp] theorem mem_goodChallenges_iff
    (encoder : Message -> Domain -> K) (agreementThreshold : Nat)
    (lanes : Fin 4 -> Domain -> K)
    (strategy : ProximateStrategy K Domain Message) (z : K) :
    z ∈ goodChallenges encoder agreementThreshold lanes strategy <->
      ValidResponse encoder agreementThreshold lanes strategy z := by
  classical
  simp [goodChallenges]

/-- Coordinates where all four received lanes agree with four encoded
messages simultaneously. -/
noncomputable def jointAgreementSet
    (encoder : Message -> Domain -> K)
    (lanes : Fin 4 -> Domain -> K) (components : Fin 4 -> Message) :
    Finset Domain := by
  classical
  exact Finset.univ.filter fun x =>
    ∀ i, lanes i x = encoder (components i) x

/-- The previous-round correlated proximity relation. -/
def HasJointAgreement
    (encoder : Message -> Domain -> K) (agreementThreshold : Nat)
    (lanes : Fin 4 -> Domain -> K) : Prop :=
  ∃ components : Fin 4 -> Message,
    agreementThreshold < (jointAgreementSet encoder lanes components).card

/-- A selected codeword lies on the degree-three curve generated by four
component codewords. -/
def CandidateOnCurve
    (encoder : Message -> Domain -> K)
    (strategy : ProximateStrategy K Domain Message)
    (components : Fin 4 -> Message) (z : K) : Prop :=
  encoder (strategy.candidate z) =
    fun x => curveValue (fun i => encoder (components i)) z x

/-- Exact external theorem interface: degree-three curve-decodability with
enough concurrency for the root-union argument.  This is strictly a statement
about a fixed code, degree-three curves, and selected close codewords.  It does
not mention FRI acceptance, predecessor folds, or a relation-repair event. -/
def DegreeThreeCurveDecodable
    (encoder : Message -> Domain -> K)
    (agreementThreshold challengeThreshold : Nat) : Prop :=
  ∀ (lanes : Fin 4 -> Domain -> K)
      (strategy : ProximateStrategy K Domain Message),
    challengeThreshold <
        (goodChallenges encoder agreementThreshold lanes strategy).card ->
      ∃ (components : Fin 4 -> Message) (selected : Finset K),
        selected ⊆ goodChallenges encoder agreementThreshold lanes strategy /\
        3 * Fintype.card Domain < selected.card /\
        ∀ z ∈ selected, CandidateOnCurve encoder strategy components z

/-! ## The root-union part of correlated agreement -/

/-- The four discrepancies at one domain coordinate. -/
def coordinateDiscrepancy
    (encoder : Message -> Domain -> K)
    (lanes : Fin 4 -> Domain -> K) (components : Fin 4 -> Message)
    (x : Domain) : Fin 4 -> K :=
  fun i => lanes i x - encoder (components i) x

theorem coordinateDiscrepancy_ne_zero_of_not_joint
    (encoder : Message -> Domain -> K)
    (lanes : Fin 4 -> Domain -> K) (components : Fin 4 -> Message)
    (x : Domain)
    (hx : x ∉ jointAgreementSet encoder lanes components) :
    coordinateDiscrepancy encoder lanes components x ≠ 0 := by
  classical
  intro hzero
  apply hx
  simp only [jointAgreementSet, Finset.mem_filter, Finset.mem_univ, true_and]
  intro i
  have hi := congrFun hzero i
  simpa [coordinateDiscrepancy] using sub_eq_zero.mp hi

theorem curveValue_sub_curveValue
    (encoder : Message -> Domain -> K)
    (lanes : Fin 4 -> Domain -> K) (components : Fin 4 -> Message)
    (z : K) (x : Domain) :
    curveValue lanes z x -
        curveValue (fun i => encoder (components i)) z x =
      batchedDiscrepancy
        (coordinateDiscrepancy encoder lanes components x) z := by
  simp only [curveValue, coordinateDiscrepancy, batchedDiscrepancy]
  ring

/-- Challenges that hide at least one coordinate where the four lanes are not
jointly consistent with the component-codeword curve. -/
noncomputable def resolvingChallenges
    (encoder : Message -> Domain -> K)
    (lanes : Fin 4 -> Domain -> K) (components : Fin 4 -> Message) :
    Finset K := by
  classical
  exact (Finset.univ.filter fun x =>
      x ∉ jointAgreementSet encoder lanes components).biUnion fun x =>
    collisionSet (coordinateDiscrepancy encoder lanes components x)

/-- Each disagreeing coordinate contributes at most three roots, so all roots
that hide any disagreement number at most `3 * |Domain|`. -/
theorem resolvingChallenges_card_le
    (encoder : Message -> Domain -> K)
    (lanes : Fin 4 -> Domain -> K) (components : Fin 4 -> Message) :
    (resolvingChallenges encoder lanes components).card ≤
      3 * Fintype.card Domain := by
  classical
  let outside := Finset.univ.filter fun x =>
    x ∉ jointAgreementSet encoder lanes components
  have hroot : ∀ x ∈ outside,
      (collisionSet (coordinateDiscrepancy encoder lanes components x)).card ≤ 3 := by
    intro x hx
    have hxnot : x ∉ jointAgreementSet encoder lanes components := by
      simpa [outside] using hx
    exact collision_card_le_three _
      (coordinateDiscrepancy_ne_zero_of_not_joint
        encoder lanes components x hxnot)
  calc
    (resolvingChallenges encoder lanes components).card =
        (outside.biUnion fun x =>
          collisionSet (coordinateDiscrepancy encoder lanes components x)).card := by
            rfl
    _ ≤ outside.card * 3 :=
      Finset.card_biUnion_le_card_mul outside _ 3 hroot
    _ ≤ Fintype.card Domain * 3 := by
      gcongr
      exact Finset.card_le_card (Finset.filter_subset _ _)
    _ = 3 * Fintype.card Domain := by omega

/-- One sufficiently large selected set contains a challenge that resolves no
disagreement coordinate. -/
theorem exists_selected_not_resolving
    (encoder : Message -> Domain -> K)
    (lanes : Fin 4 -> Domain -> K) (components : Fin 4 -> Message)
    (selected : Finset K)
    (hlarge : 3 * Fintype.card Domain < selected.card) :
    ∃ z ∈ selected,
      z ∉ resolvingChallenges encoder lanes components := by
  classical
  by_contra hnone
  push Not at hnone
  have hsubset : selected ⊆ resolvingChallenges encoder lanes components := by
    intro z hz
    exact hnone z hz
  have := (Finset.card_le_card hsubset).trans
    (resolvingChallenges_card_le encoder lanes components)
  omega

/-- The agreement set selected at a non-resolving challenge is a joint
agreement set for all four component functions. -/
theorem support_subset_jointAgreement
    (encoder : Message -> Domain -> K) (agreementThreshold : Nat)
    (lanes : Fin 4 -> Domain -> K)
    (strategy : ProximateStrategy K Domain Message)
    (components : Fin 4 -> Message) (z : K)
    (hvalid : ValidResponse encoder agreementThreshold lanes strategy z)
    (honcurve : CandidateOnCurve encoder strategy components z)
    (hresolve : z ∉ resolvingChallenges encoder lanes components) :
    strategy.support z ⊆ jointAgreementSet encoder lanes components := by
  classical
  intro x hx
  have hagree := hvalid.2 x hx
  have hcurve := congrFun honcurve x
  by_contra hnotjoint
  have hdelta : batchedDiscrepancy
      (coordinateDiscrepancy encoder lanes components x) z = 0 := by
    rw [← curveValue_sub_curveValue encoder lanes components z x]
    rw [hagree, hcurve]
    exact sub_self _
  apply hresolve
  simp only [resolvingChallenges, Finset.mem_biUnion]
  refine ⟨x, ?_, ?_⟩
  · simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact hnotjoint
  · simpa [collisionSet] using hdelta

/-! ## Correlated agreement from curve decoding -/

/-- Formalized Theorem-28 finalization: curve-decodability implies correlated
agreement over one of the strategy's actual agreement sets. -/
theorem hasJointAgreement_of_many_good
    (encoder : Message -> Domain -> K)
    (agreementThreshold challengeThreshold : Nat)
    (hcurve : DegreeThreeCurveDecodable
      encoder agreementThreshold challengeThreshold)
    (lanes : Fin 4 -> Domain -> K)
    (strategy : ProximateStrategy K Domain Message)
    (hmany : challengeThreshold <
      (goodChallenges encoder agreementThreshold lanes strategy).card) :
    HasJointAgreement encoder agreementThreshold lanes := by
  classical
  obtain ⟨components, selected, hselected, hlarge, honcurve⟩ :=
    hcurve lanes strategy hmany
  obtain ⟨z, hzselected, hzresolve⟩ :=
    exists_selected_not_resolving encoder lanes components selected hlarge
  have hzgood := hselected hzselected
  have hvalid :=
    (mem_goodChallenges_iff encoder agreementThreshold lanes strategy z).mp hzgood
  refine ⟨components, hvalid.1.trans_le ?_⟩
  exact Finset.card_le_card
    (support_subset_jointAgreement encoder agreementThreshold lanes strategy
      components z hvalid (honcurve z hzselected) hzresolve)

/-- Contrapositive/cardinality form used by a randomized reduction.  The bad
set is the explicit good-challenge set for the fixed response strategy, not a
predicate saying merely that no predecessor was found. -/
theorem goodChallenges_card_le_of_no_jointAgreement
    (encoder : Message -> Domain -> K)
    (agreementThreshold challengeThreshold : Nat)
    (hcurve : DegreeThreeCurveDecodable
      encoder agreementThreshold challengeThreshold)
    (lanes : Fin 4 -> Domain -> K)
    (strategy : ProximateStrategy K Domain Message)
    (hfalse : ¬ HasJointAgreement encoder agreementThreshold lanes) :
    (goodChallenges encoder agreementThreshold lanes strategy).card ≤
      challengeThreshold := by
  by_contra hnot
  exact hfalse (hasJointAgreement_of_many_good
    encoder agreementThreshold challengeThreshold hcurve lanes strategy
    (Nat.lt_of_not_ge hnot))

/-- Inclusion form for one accepted round. -/
theorem accepted_response_is_counted
    (encoder : Message -> Domain -> K)
    (agreementThreshold challengeThreshold : Nat)
    (hcurve : DegreeThreeCurveDecodable
      encoder agreementThreshold challengeThreshold)
    (lanes : Fin 4 -> Domain -> K)
    (strategy : ProximateStrategy K Domain Message) (z : K)
    (hvalid : ValidResponse encoder agreementThreshold lanes strategy z) :
    HasJointAgreement encoder agreementThreshold lanes ∨
      (z ∈ goodChallenges encoder agreementThreshold lanes strategy ∧
        (goodChallenges encoder agreementThreshold lanes strategy).card ≤
          challengeThreshold) := by
  by_cases hprevious : HasJointAgreement encoder agreementThreshold lanes
  · exact Or.inl hprevious
  · exact Or.inr ⟨
      (mem_goodChallenges_iff encoder agreementThreshold lanes strategy z).mpr hvalid,
      goodChallenges_card_le_of_no_jointAgreement
        encoder agreementThreshold challengeThreshold hcurve lanes strategy hprevious⟩

#print axioms resolvingChallenges_card_le
#print axioms exists_selected_not_resolving
#print axioms support_subset_jointAgreement
#print axioms hasJointAgreement_of_many_good
#print axioms goodChallenges_card_le_of_no_jointAgreement
#print axioms accepted_response_is_counted

end AspisV5FriDegreeThreeCorrelatedAgreement
