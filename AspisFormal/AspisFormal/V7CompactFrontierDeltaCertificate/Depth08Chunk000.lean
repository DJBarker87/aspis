            frontierCoeff 7 (3 - (offset + 1))
              (15 - leftFrontier)) = 2 := by
    have offsets : Finset.range (3 - 1) = {0, 1} := by decide
    rw [offsets]
    calc
      (∑ offset ∈ {0, 1},
          ∑ leftFrontier ∈ supportedSplitFrontiers 7 (offset + 1)
              (3 - (offset + 1)) 15,
            frontierCoeff 7 (offset + 1) leftFrontier *
              frontierCoeff 7 (3 - (offset + 1))
                (15 - leftFrontier)) =
          ∑ offset ∈ {0, 1},
            if offset = 0 then 1 else if offset = 1 then 1 else 0 := by
        apply Finset.sum_congr rfl
        intro offset member
        simp only [Finset.mem_insert, Finset.mem_singleton] at member
        rcases member with (rfl | rfl) <;>
          norm_num only [split0, split1] <;> simp
      _ = 2 := by norm_num
  rw [frontierCoeff_succ_eq_supported]
  norm_num only [outer, certificate_7_3_14] <;> simp

