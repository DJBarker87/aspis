        apply Finset.sum_congr rfl
        intro offset member
        simp only [Finset.mem_insert, Finset.mem_singleton] at member
        rcases member with (rfl | rfl) <;>
          norm_num only [split0, split1] <;> simp
      _ = 0 := by norm_num
  rw [frontierCoeff_succ_eq_supported]
  norm_num only [outer, certificate_10_3_16] <;> simp

end AspisV7CompactFrontierDeltaCertificate
